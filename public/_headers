# Cloudflare Pages Custom Headers Configuration

# Static build assets (Astro hash-named bundles, immutable 1 year)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static media assets & images (Cache 30 days, SWR 7 days)
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# User uploads & document files (Cache 30 days, SWR 7 days)
/uploads/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Favicons, vector icons, and system assets
/favicon.*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/robots.txt
  Cache-Control: public, max-age=86400

# Global Security Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
