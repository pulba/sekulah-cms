---
import "../styles/global.css";
import SvgSprite from "../components/SvgSprite.astro";
import Icon from "../components/Icon.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";
import ToastContainer from "../components/ToastContainer.astro";
import { db, settings } from "../db";
import { resolveThemeConfig, buildThemeCss } from "../utils/themeSystem";
import { getSettingsMap } from "../utils/settingsCache";

interface Props {
  title?: string;
  activeNav?: string;
  settingsMap?: Record<string, string>;
}

const {
  title = "Dashboard Admin",
  activeNav = "dashboard",
  settingsMap: passedSettings,
} = Astro.props;

// Reuse settings from parent page if already fetched, otherwise use cached settings
const schoolSettings: Record<string, string> =
  passedSettings || (await getSettingsMap());

const schoolName = schoolSettings["school_name"] || "SMAN 1 Unggulan";
const logoUrl = schoolSettings["logo_url"] || "";
const faviconUrl = schoolSettings["favicon_url"] || "/favicon.svg";
const resolvedTheme = resolveThemeConfig(schoolSettings);
const themeCss = buildThemeCss(resolvedTheme);
const defaultThemeMode = resolvedTheme.mode;
const schoolInitial = (schoolName.trim().charAt(0) || "S").toUpperCase();

// Deteksi status madrasah vs sekolah negeri/umum untuk label OSIS/OSIM
const schoolType = (
  schoolSettings["school_type"] ||
  schoolSettings["school_level"] ||
  "SMA"
).toUpperCase();
const isMadrasah = ["MA", "MTS", "MI"].includes(schoolType);
const isSmk = schoolType === "SMK";
const customStudentOrg = (
  schoolSettings["student_org_type"] ||
  schoolSettings["student_org_label"] ||
  ""
).trim();
const studentOrgLabel = customStudentOrg || (isMadrasah ? "OSIM" : "OSIS");

// Ambil data user dari locals (disiapkan oleh middleware)
const user = Astro.locals.user || {
  name: "Administrator IT",
  email: "admin@sman1unggulan.sch.id",
  role: "super_admin",
};

const isSuperAdmin = user.role === "super_admin";

interface PrimaryNavItem {
  id: string;
  label: string;
  href: string;
  icon: string;
}

interface NavGroupItem {
  id: string;
  label: string;
  href: string;
}

interface NavGroup {
  id: string;
  label: string;
  icon: string;
  children: NavGroupItem[];
}

// Menu mandiri untuk fitur yang sering digunakan (akses cepat langsung tanpa dropdown)
const primaryNavItems: PrimaryNavItem[] = [
  {
    id: "dashboard",
    label: "Dashboard",
    href: "/admin",
    icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z",
  },
  {
    id: "berita",
    label: "Berita & Artikel",
    href: "/admin/berita",
    icon: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z",
  },
  {
    id: "agenda",
    label: "Agenda Kegiatan",
    href: "/admin/agenda",
    icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
  {
    id: "media",
    label: "Media Library",
    href: "/admin/media",
    icon: "M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z",
  },
  {
    id: "galeri",
    label: "Galeri Kegiatan",
    href: "/admin/galeri",
    icon: "M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
];

// Menu kelompok dropdown untuk fitur serumpun/berdekatan
const navGroups: NavGroup[] = [
  {
    id: "pendaftaran_kelulusan",
    label: "Pendaftaran & Kelulusan",
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4",
    children: [
      {
        id: "pendaftar",
        label: "Data Pendaftar (Calon Siswa)",
        href: "/admin/pendaftaran/pendaftar",
      },
      {
        id: "pendaftaran",
        label: "Pengaturan Pendaftaran",
        href: "/admin/pendaftaran",
      },
      {
        id: "kelulusan",
        label: "Pengumuman Kelulusan",
        href: "/admin/kelulusan",
      },
      {
        id: "pengumuman",
        label: "Banner Pengumuman",
        href: "/admin/pengumuman",
      },
    ],
  },
  {
    id: "kesiswaan",
    label: "Kesiswaan & Alumni",
    icon: "M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z M12 14v7",
    children: [
      { id: "osis", label: studentOrgLabel, href: "/admin/osis" },
      ...(isSmk
        ? [{ id: "bkk", label: "BKK & Mitra Industri", href: "/admin/bkk" }]
        : []),
      ...(isMadrasah
        ? [{ id: "mahad", label: "Ma'had & Tahfidz", href: "/admin/mahad" }]
        : []),
      { id: "prestasi", label: "Prestasi Siswa", href: "/admin/prestasi" },
      { id: "ekskul", label: "Ekstrakurikuler", href: "/admin/ekskul" },
      { id: "alumni", label: "Tracer Alumni", href: "/admin/alumni" },
      { id: "rekap-kesiswaan", label: "Statistik Kesiswaan", href: "/admin/kesiswaan" },
    ],
  },
  {
    id: "kelembagaan",
    label: "Kelembagaan & Sarana",
    icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
    children: [
      ...(isSuperAdmin
        ? [{ id: "profil", label: "Profil Sekolah", href: "/admin/profil" }]
        : []),
      {
        id: "direktori",
        label: "Direktori Guru & Staf",
        href: "/admin/direktori",
      },
      { id: "fasilitas", label: "Fasilitas Sekolah", href: "/admin/fasilitas" },
      { id: "mitra", label: "Mitra & Kerja Sama", href: "/admin/mitra" },
    ],
  },
  {
    id: "pengaturan",
    label: "Pengaturan",
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z",
    children: [
      ...(isSuperAdmin
        ? [
            {
              id: "pengaturan",
              label: "Pengaturan Sekolah",
              href: "/admin/pengaturan",
            },
          ]
        : []),
      { id: "slider", label: "Tampilan & Navigasi", href: "/admin/slider" },
      { id: "dokumen", label: "Repositori Dokumen", href: "/admin/dokumen" },
    ],
  },
];

// Menu sistem khusus super admin (di dalam dropdown User Profile & Logout)
const systemNavItems = isSuperAdmin
  ? [
      {
        id: "users",
        label: "Pengguna & Staf",
        href: "/admin/users",
        icon: "M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z",
      },
      {
        id: "pemeliharaan",
        label: "Pemeliharaan & Backup",
        href: "/admin/pemeliharaan",
        icon: "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4",
      },
      {
        id: "logs",
        label: "Audit Trail",
        href: "/admin/logs",
        icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
      },
    ]
  : [];

// Resolve label nama halaman aktif untuk header topbar
const currentNavLabel =
  primaryNavItems.find((i) => i.id === activeNav)?.label ||
  navGroups
    .flatMap((g) => g.children)
    .find(
      (c) =>
        c.id === activeNav ||
        (c.id === "pendaftaran" && activeNav === "ppdb") ||
        (c.id === "ppdb" && activeNav === "pendaftaran") ||
        (c.id === "osis" && (activeNav === "osis" || activeNav === "osim")),
    )?.label ||
  systemNavItems.find((s) => s.id === activeNav)?.label;

const pageName =
  title && title !== "Ringkasan Sistem" && title !== "Dashboard Admin"
    ? title
    : currentNavLabel || title || "Dashboard";
---

<!doctype html>
<html lang="id" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`Panel kendali dan dashboard CMS ${schoolName}`}
    />
    <title>{title} — CMS {schoolName}</title>
    <link rel="icon" href={faviconUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap"
    />

    <!-- Dark Mode Init (Mencegah FOUT, mendukung Light / Dark / System) -->
    <script is:inline define:vars={{ defaultThemeMode }}>
      (function () {
        function applyInitialTheme() {
          try {
            var stored = localStorage.getItem("theme");
            var activeMode =
              stored === "light" || stored === "dark" || stored === "system"
                ? stored
                : defaultThemeMode;
            var isDark =
              activeMode === "dark" ||
              (activeMode === "system" &&
                window.matchMedia("(prefers-color-scheme: dark)").matches);
            document.documentElement.classList.toggle("dark", isDark);
          } catch (e) {}
        }
        applyInitialTheme();

        if (window.matchMedia) {
          window
            .matchMedia("(prefers-color-scheme: dark)")
            .addEventListener?.("change", function (e) {
              var cur = localStorage.getItem("theme");
              if (!cur || cur === "system") {
                document.documentElement.classList.toggle("dark", e.matches);
              }
            });
        }
      })();
    </script>

    {/* Dynamic Semantic Theme Tokens dari Pengaturan Sekolah */}
    <style is:inline set:html={themeCss}></style>

    <style>
      /* Desktop Collapsed Mini Sidebar Styles */
      @media (min-width: 768px) {
        #admin-sidebar.is-collapsed,
        html.sidebar-collapsed-init #admin-sidebar {
          width: 72px !important;
        }
        #admin-sidebar.is-collapsed .sidebar-header,
        html.sidebar-collapsed-init #admin-sidebar .sidebar-header {
          height: 76px !important;
          padding: 8px 6px !important;
          flex-direction: column !important;
          justify-content: center !important;
          gap: 6px !important;
        }
        #admin-sidebar.is-collapsed .sidebar-text,
        html.sidebar-collapsed-init #admin-sidebar .sidebar-text,
        #admin-sidebar.is-collapsed .sidebar-section-title,
        html.sidebar-collapsed-init #admin-sidebar .sidebar-section-title,
        #admin-sidebar.is-collapsed .sidebar-chevron,
        html.sidebar-collapsed-init #admin-sidebar .sidebar-chevron,
        #admin-sidebar.is-collapsed .nav-group-content,
        html.sidebar-collapsed-init #admin-sidebar .nav-group-content {
          display: none !important;
        }
        #admin-sidebar.is-collapsed .sidebar-nav-item,
        html.sidebar-collapsed-init #admin-sidebar .sidebar-nav-item,
        #admin-sidebar.is-collapsed .sidebar-group-btn,
        html.sidebar-collapsed-init #admin-sidebar .sidebar-group-btn {
          justify-content: center !important;
          padding-left: 0 !important;
          padding-right: 0 !important;
          width: 44px !important;
          height: 40px !important;
          margin-left: auto !important;
          margin-right: auto !important;
        }
        #admin-sidebar.is-collapsed .sidebar-divider,
        html.sidebar-collapsed-init #admin-sidebar .sidebar-divider {
          display: block !important;
          margin-left: 14px;
          margin-right: 14px;
        }
        #admin-sidebar.is-collapsed .sidebar-brand-link,
        html.sidebar-collapsed-init #admin-sidebar .sidebar-brand-link {
          flex: none !important;
          justify-content: center !important;
          padding-left: 0 !important;
          padding-right: 0 !important;
        }
        #admin-sidebar.is-collapsed #desktop-collapse-btn,
        html.sidebar-collapsed-init #admin-sidebar #desktop-collapse-btn {
          width: 36px !important;
          height: 24px !important;
          margin-left: auto !important;
          margin-right: auto !important;
        }
      }
    </style>

    {/* Pre-hydration check to avoid sidebar layout shift */}
    <script is:inline>
      try {
        if (
          window.innerWidth >= 768 &&
          localStorage.getItem("admin_sidebar_collapsed") === "true"
        ) {
          document.documentElement.classList.add("sidebar-collapsed-init");
        }
      } catch (e) {}
    </script>
  </head>
  <body class="h-full h-[100dvh] overflow-hidden bg-background text-body font-body antialiased flex flex-col md:flex-row">
    <SvgSprite />
    <!-- Mobile Sidebar Backdrop -->
    <div
      id="sidebar-backdrop"
      class="fixed inset-0 bg-black/40 backdrop-blur-xs z-40 transition-opacity duration-200 opacity-0 pointer-events-none md:hidden hidden"
      aria-hidden="true"
    ></div>

    <!-- Sidebar Kiri (Mendukung Expanded dan Collapsed Mini Mode) -->
    <aside
      id="admin-sidebar"
      class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] h-full bg-heading flex flex-col transition-[width,transform] duration-200 ease-in-out -translate-x-full md:translate-x-0 md:static md:w-64 shrink-0 shadow-lg md:shadow-none overflow-x-hidden"
    >
      <div class="flex-1 flex flex-col min-h-0 overflow-hidden">
        <!-- Brand Header & Collapse Toggle Button -->
        <div class="sidebar-header h-16 px-3.5 flex items-center justify-between shrink-0 gap-1.5 transition-all">
          <a
            href="/admin"
            class="sidebar-brand-link flex items-center gap-2.5 min-w-0 flex-1 group"
            title={`CMS ${schoolName}`}
            data-nav-tooltip={`CMS ${schoolName}`}
          >
            {logoUrl ? (
              <>
                <img
                  id="sidebar-logo-img"
                  src={logoUrl}
                  alt={schoolName}
                  width="32"
                  height="32"
                  loading="eager"
                  decoding="async"
                  class="h-8 w-8 rounded-[6px] object-contain shrink-0"
                  onerror="this.style.display='none'; document.getElementById('sidebar-logo-fallback')?.classList.remove('hidden');"
                />
                <div
                  id="sidebar-logo-fallback"
                  class="hidden flex h-8 w-8 items-center justify-center rounded-[6px] bg-primary text-surface border border-border font-display font-bold text-xs shrink-0"
                >
                  {schoolInitial}
                </div>
              </>
            ) : (
              <div
                id="sidebar-logo-fallback"
                class="flex h-8 w-8 items-center justify-center rounded-[6px] bg-primary text-surface border border-border font-display font-bold text-xs shrink-0"
              >
                {schoolInitial}
              </div>
            )}
            <div class="min-w-0 flex flex-col sidebar-text">
              <span
                id="sidebar-school-name"
                class="font-display text-xs font-bold tracking-tight text-surface truncate leading-tight group-hover:text-accent transition-colors"
              >
                {schoolName}
              </span>
              <span class="text-[10px] font-medium text-surface tracking-wider uppercase leading-tight mt-0.5">
                Portal CMS
              </span>
            </div>
          </a>

          <!-- Desktop Collapse / Expand Button -->
          <button
            id="desktop-collapse-btn"
            type="button"
            class="hidden md:inline-flex h-8 w-8 items-center justify-center rounded-[6px] border border-transparent text-surface hover:bg-primary hover:text-surface transition-colors shrink-0 cursor-pointer"
            title="Ciutkan / Perluas Sidebar"
            aria-label="Ciutkan / Perluas Sidebar"
          >
            <svg
              id="collapse-icon"
              class="h-4 w-4 transition-transform duration-200"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11 19l-7-7 7-7m8 14l-7-7 7-7"
              />
            </svg>
          </button>

          <!-- Mobile Close Button -->
          <button
            id="sidebar-close-btn"
            type="button"
            class="md:hidden p-1.5 rounded-[6px] text-surface hover:bg-primary hover:text-surface transition-colors shrink-0 cursor-pointer"
            aria-label="Tutup menu navigasi"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>

        <!-- Nav Items -->
        <nav class="flex-1 p-3 space-y-1 overflow-y-auto no-scrollbar">
          {primaryNavItems.map((item) => {
            const isActive = activeNav === item.id;
            return (
              <a
                href={item.href}
                data-nav-tooltip={item.label}
                class:list={[
                  "sidebar-nav-item flex items-center gap-3 rounded-[6px] px-3 py-2 text-xs font-medium transition-colors",
                  isActive
                    ? "bg-accent text-accent-foreground font-semibold"
                    : "text-surface hover:bg-primary hover:text-surface",
                ]}
                title={item.label}
              >
                <svg
                  class="h-4 w-4 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d={item.icon}
                  />
                </svg>
                <span class="sidebar-text truncate">{item.label}</span>
              </a>
            );
          })}

          <!-- Menu Terpadu (Collapsible Dropdowns) -->
          <div class="sidebar-section-title pt-3 pb-1 px-3 text-[10px] font-bold uppercase tracking-wider text-surface mt-2">
            Kelola Portal
          </div>
          <div class="sidebar-divider hidden border-t border-primary-hover my-2"></div>

          {navGroups.map((group) => {
            const hasActiveChild = group.children.some(
              (c) =>
                c.id === activeNav ||
                (c.id === "pendaftaran" && activeNav === "ppdb") ||
                (c.id === "ppdb" && activeNav === "pendaftaran") ||
                (c.id === "osis" &&
                  (activeNav === "osis" || activeNav === "osim")),
            );
            return (
              <div class="nav-group py-0.5" data-group-id={group.id}>
                <button
                  type="button"
                  class:list={[
                    "sidebar-group-btn w-full flex items-center justify-between gap-2 rounded-[6px] px-3 py-2 text-xs font-medium transition-colors cursor-pointer text-left select-none",
                    hasActiveChild
                      ? "bg-primary text-surface font-semibold"
                      : "text-surface hover:bg-primary hover:text-surface",
                  ]}
                  aria-expanded={hasActiveChild ? "true" : "false"}
                  data-group-toggle={group.id}
                  data-group-label={group.label}
                  data-group-children={JSON.stringify(group.children)}
                  title={group.label}
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <svg
                      class:list={[
                        "h-4 w-4 shrink-0 transition-colors",
                        hasActiveChild ? "text-accent" : "text-surface",
                      ]}
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d={group.icon}
                      />
                    </svg>
                    <span class="sidebar-text truncate">{group.label}</span>
                  </div>
                  <svg
                    class:list={[
                      "sidebar-chevron chevron-icon h-3.5 w-3.5 shrink-0 transition-transform duration-200 text-surface",
                      hasActiveChild && "rotate-180",
                    ]}
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </button>

                <div
                  id={`group-${group.id}`}
                  class:list={[
                    "nav-group-content space-y-0.5 pl-3.5 my-1 transition-all",
                    !hasActiveChild && "hidden",
                  ]}
                >
                  {group.children.map((child) => {
                    const isChildActive =
                      activeNav === child.id ||
                      (child.id === "pendaftaran" && activeNav === "ppdb") ||
                      (child.id === "ppdb" && activeNav === "pendaftaran") ||
                      (child.id === "osis" &&
                        (activeNav === "osis" || activeNav === "osim"));
                    return (
                      <a
                        href={child.href}
                        class:list={[
                          "flex items-center gap-2 rounded-[6px] ml-1 px-2.5 py-1.5 text-xs font-medium transition-colors",
                          isChildActive
                            ? "bg-accent text-accent-foreground font-semibold shadow-xs"
                            : "text-surface hover:bg-primary hover:text-surface",
                        ]}
                      >
                        <span class="truncate">{child.label}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </nav>
      </div>
    </aside>

    <!-- Floating Flyout Submenu for Collapsed Mode -->
    <div
      id="sidebar-flyout"
      class="hidden fixed top-0 left-0 z-50 w-56 rounded-[10px] border border-border bg-surface shadow-2xl p-2.5 space-y-1 transition-all"
    >
      <div class="px-2 py-1.5 border-b border-border mb-1 flex items-center justify-between">
        <span
          id="flyout-title"
          class="font-display text-xs font-bold text-heading truncate"
