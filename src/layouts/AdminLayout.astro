    <!-- Floating Tooltip for Standalone Items in Collapsed Mode -->
    <div
      id="sidebar-tooltip"
      class="hidden fixed top-0 left-0 z-50 pointer-events-none px-2.5 py-1 rounded-[6px] bg-heading text-surface text-[11px] font-medium shadow-md whitespace-nowrap"
    >
      <span id="tooltip-text"></span>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col h-full min-w-0 overflow-hidden">
      <!-- Topbar Header -->
      <header class="h-14 border-b border-border bg-surface px-4 sm:px-6 flex items-center justify-between shrink-0 z-10">
        <div class="flex items-center gap-3">
          <button
            id="sidebar-toggle-btn"
            type="button"
            class="md:hidden p-1.5 -ml-1.5 rounded-[6px] text-muted hover:bg-surface-subtle hover:text-heading transition-colors"
            aria-label="Buka menu navigasi"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"
              />
            </svg>
          </button>
          <span class="font-display text-xs font-semibold text-heading truncate">
            {pageName}
          </span>
        </div>

        <div class="flex items-center gap-3 text-xs shrink-0">
          <span class="text-muted font-mono hidden md:inline text-[11px]">
            {new Date().toLocaleDateString("id-ID", {
              weekday: "long",
              day: "numeric",
              month: "short",
              year: "numeric",
            })}
          </span>
          <a
            href="/"
            target="_blank"
            class="h-8 w-8 inline-flex items-center justify-center rounded-[6px] border border-border bg-surface text-muted hover:text-heading hover:bg-surface-subtle transition-colors cursor-pointer"
            title="Buka Website Publik Sekolah"
            aria-label="Buka Website Publik Sekolah"
          >
            <Icon name="external-link" class="h-4 w-4" />
          </a>

          <!-- Dark Mode Toggle Button Admin -->
          <button
            type="button"
            id="admin-theme-toggle"
            class="relative h-8 w-8 inline-flex items-center justify-center rounded-[6px] border border-border bg-surface text-muted hover:text-heading hover:bg-surface-subtle transition-colors cursor-pointer overflow-hidden group"
            title="Ganti Mode Gelap / Terang"
            aria-label="Ganti Mode Gelap / Terang"
          >
            <svg
              id="admin-theme-sun"
              class="absolute h-4 w-4 text-warning transition-all duration-300 ease-in-out transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              />
            </svg>
            <svg
              id="admin-theme-moon"
              class="absolute h-4 w-4 text-muted group-hover:text-heading transition-all duration-300 ease-in-out transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              />
            </svg>
          </button>

          <div class="hidden sm:block h-4 w-px bg-border"></div>

          <!-- User Profile Dropdown Menu in Header -->
          <div class="relative" id="user-menu-container">
            <button
              id="user-menu-btn"
              type="button"
              class="flex items-center gap-2 p-1 pl-1.5 pr-2 rounded-md hover:bg-surface-subtle border border-transparent hover:border-border transition-colors cursor-pointer select-none group"
              aria-expanded="false"
              aria-haspopup="true"
              aria-label={`${user.name} - ${user.role === "super_admin" ? "Super Admin" : "Editor"}`}
            >
              <div
                aria-hidden="true"
                class="h-7 w-7 rounded-full bg-primary text-surface border border-primary/20 flex items-center justify-center font-display text-xs font-bold shrink-0"
              >
                {user.name.trim().charAt(0).toUpperCase()}
              </div>
              <div class="hidden md:flex flex-col text-left leading-tight">
                <span class="font-display text-xs font-semibold text-heading group-hover:text-primary transition-colors max-w-[120px] truncate">
                  {user.name}
                </span>
                <span class="text-[10px] text-muted capitalize">
                  {user.role === "super_admin" ? "Super Admin" : "Editor"}
                </span>
              </div>
              <svg
                aria-hidden="true"
                class="chevron-user h-3.5 w-3.5 text-muted group-hover:text-heading transition-transform duration-200"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </button>

            <!-- Dropdown Popover -->
            <div
              id="user-menu-dropdown"
              class="hidden absolute right-0 top-full mt-1.5 w-56 rounded-[10px] border border-border bg-surface shadow-2xl py-1.5 z-50 transform origin-top-right transition-all duration-150 ease-out opacity-0 scale-95 pointer-events-none text-xs"
            >
              <div class="px-3.5 py-2.5 border-b border-border/80 space-y-1 bg-surface-subtle">
                <div class="flex items-center justify-between gap-1.5">
                  <p class="font-display text-xs font-bold text-heading truncate">
                    {user.name}
                  </p>
                  <span class="rounded-xs px-1.5 py-0.2 text-[9px] font-semibold bg-primary text-surface border border-primary/20 capitalize shrink-0">
                    {user.role === "super_admin" ? "Super Admin" : "Editor"}
                  </span>
                </div>
                <p
                  class="text-[10px] text-muted font-mono truncate"
                  title={user.email}
                >
                  {user.email}
                </p>
              </div>

              {isSuperAdmin && systemNavItems.length > 0 && (
                <div class="py-1">
                  <div class="px-3.5 pt-1.5 pb-1 text-[9px] font-bold uppercase tracking-wider text-muted/70">
                    Sistem & Pengaturan
                  </div>
                  {systemNavItems.map((item) => {
                    const isActive = activeNav === item.id;
                    return (
                      <a
                        href={item.href}
                        class:list={[
                          "flex items-center gap-2.5 px-3 py-1.5 text-xs transition-colors rounded-xs mx-1",
                          isActive
                            ? "bg-primary text-surface font-semibold shadow-xs"
                            : "text-muted hover:text-heading hover:bg-surface-subtle",
                        ]}
                      >
                        <svg
                          class:list={[
                            "h-3.5 w-3.5 shrink-0",
                            isActive ? "text-surface" : "text-muted",
                          ]}
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d={item.icon}
                          />
                        </svg>
                        <span class="truncate">{item.label}</span>
                      </a>
                    );
                  })}
                </div>
              )}

              <div class="sm:hidden border-t border-border/60 py-1">
                <a
                  href="/"
                  target="_blank"
                  class="flex items-center gap-2.5 px-3 py-1.5 text-xs text-muted hover:text-heading hover:bg-surface-subtle transition-colors rounded-xs mx-1"
                >
                  <Icon
                    name="external-link"
                    class="h-3.5 w-3.5 shrink-0 text-muted"
                  />
                  <span>Buka Web Publik</span>
                </a>
              </div>

              <div class="border-t border-border pt-1">
                <button
                  id="change-password-btn"
                  type="button"
                  class="w-full flex items-center gap-2.5 px-3 py-1.5 text-xs text-muted hover:text-heading hover:bg-surface-subtle transition-colors cursor-pointer text-left rounded-xs mx-1"
                >
                  <svg
                    class="h-3.5 w-3.5 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
                    />
                  </svg>
                  <span class="font-medium">Ganti Kata Sandi</span>
                </button>
                <button
                  id="logout-btn"
                  type="button"
                  class="w-full flex items-center gap-2.5 px-3 py-1.5 text-xs text-muted hover:text-error hover:bg-error-light transition-colors cursor-pointer text-left rounded-xs mx-1"
                >
                  <svg
                    class="h-3.5 w-3.5 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                    />
                  </svg>
                  <span class="font-medium">Keluar Sesi</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- Page Body Content -->
      <main
        id="admin-main-viewport"
        class="flex-1 min-h-0 p-4 sm:p-6 md:p-8 overflow-y-auto framer-viewport-enter"
        transition:name="admin-viewport"
      >
        <slot />
      </main>
    </div>

    <!-- Modal Ganti Kata Sandi Mandiri -->
    <div
      id="password-modal-backdrop"
      class="fixed inset-0 bg-heading/40 backdrop-blur-xs z-50 items-center justify-center p-4 hidden"
    >
      <div class="w-full max-w-md rounded-[12px] border border-border bg-surface shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
        <div class="p-5 border-b border-border flex items-center justify-between">
          <div>
            <h3 class="font-display text-sm font-bold text-heading">
              Ganti Kata Sandi
            </h3>
            <p class="font-body text-xs text-muted mt-0.5">
              Perbarui kata sandi akun dinas Anda secara berkala.
            </p>
          </div>
          <button
            type="button"
            id="close-password-modal"
            class="text-muted hover:text-heading p-1 rounded-[6px] hover:bg-surface-subtle transition-colors"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>

        <form id="change-password-form" class="p-5 space-y-4">
          <div
            id="password-alert"
            class="hidden p-3 rounded-[6px] text-xs"
          ></div>

          <div class="space-y-1.5">
            <label
              for="current-password"
              class="block font-body text-xs font-semibold text-heading"
            >
              Kata Sandi Saat Ini <span class="text-error">*</span>
            </label>
            <input
              id="current-password"
              name="currentPassword"
              type="password"
              required
              placeholder="Masukkan sandi saat ini"
              class="h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading placeholder:text-muted/60 transition-colors"
            />
          </div>

          <div class="space-y-1.5">
            <label
              for="new-password"
              class="block font-body text-xs font-semibold text-heading"
            >
              Kata Sandi Baru <span class="text-error">*</span>
            </label>
            <input
              id="new-password"
              name="newPassword"
              type="password"
              required
              minlength="8"
              placeholder="Minimal 8 karakter"
              class="h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading placeholder:text-muted/60 transition-colors"
            />
          </div>

          <div class="space-y-1.5">
            <label
              for="confirm-password"
              class="block font-body text-xs font-semibold text-heading"
            >
              Konfirmasi Kata Sandi Baru <span class="text-error">*</span>
            </label>
            <input
              id="confirm-password"
              name="confirmPassword"
              type="password"
              required
              minlength="8"
              placeholder="Ketik ulang sandi baru"
              class="h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading placeholder:text-muted/60 transition-colors"
            />
          </div>

          <div class="pt-2 flex items-center justify-end gap-2 border-t border-border">
            <button
              type="button"
              id="cancel-password-modal"
              class="inline-flex h-[36px] items-center justify-center rounded-[6px] border border-border bg-surface px-4 font-body text-xs font-semibold text-heading transition-colors hover:bg-surface-subtle"
            >
              Batal
            </button>
            <button
              type="submit"
              id="submit-password-btn"
              class="inline-flex h-[36px] items-center justify-center rounded-[6px] bg-primary px-4 font-body text-xs font-semibold text-white transition-all hover:bg-primary-hover shadow-xs"
            >
              Simpan Perubahan
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Native Body-Level Slot for Modals, Dialogs & Overlay Pickers -->
    <slot name="modals" />

    <script define:vars={{ activeNav }}>
      const activeNavId = activeNav;
      const sidebar = document.getElementById("admin-sidebar");
      const desktopCollapseBtn = document.getElementById(
        "desktop-collapse-btn",
      );
      const collapseIcon = document.getElementById("collapse-icon");
      const toggleBtn = document.getElementById("sidebar-toggle-btn");
      const closeBtn = document.getElementById("sidebar-close-btn");
      const backdrop = document.getElementById("sidebar-backdrop");
      const flyout = document.getElementById("sidebar-flyout");
      const flyoutTitle = document.getElementById("flyout-title");
      const flyoutLinks = document.getElementById("flyout-links");
      const tooltip = document.getElementById("sidebar-tooltip");
      const tooltipText = document.getElementById("tooltip-text");

      let isCollapsed = false;
      let activeFlyoutGroup = null;

      // Initialize Desktop Sidebar Collapse State
      function setCollapsedState(collapsed, save = true) {
        isCollapsed = collapsed;
        document.documentElement.classList.remove("sidebar-collapsed-init");
        if (!sidebar) return;

        if (collapsed) {
          sidebar.classList.add("is-collapsed");
          collapseIcon?.classList.add("rotate-180");
          desktopCollapseBtn?.setAttribute("title", "Perluas Sidebar");
          desktopCollapseBtn?.setAttribute(
            "data-nav-tooltip",
            "Perluas Sidebar",
          );
        } else {
          sidebar.classList.remove("is-collapsed");
          collapseIcon?.classList.remove("rotate-180");
          desktopCollapseBtn?.setAttribute("title", "Ciutkan Sidebar");
          desktopCollapseBtn?.removeAttribute("data-nav-tooltip");
        }

        // Close any active flyouts or tooltips
        closeFlyout();
        hideTooltip();

        if (save) {
          try {
            localStorage.setItem(
              "admin_sidebar_collapsed",
              collapsed ? "true" : "false",
            );
          } catch {}
        }
      }

      // Check saved preference on load
      try {
        const saved = localStorage.getItem("admin_sidebar_collapsed");
        if (saved === "true" && window.innerWidth >= 768) {
          setCollapsedState(true, false);
        } else {
          setCollapsedState(false, false);
        }
      } catch {}

      // Desktop Toggle Button Click
      desktopCollapseBtn?.addEventListener("click", () => {
        setCollapsedState(!isCollapsed, true);
      });

      // Flyout Logic for Collapsed Mode
      function openFlyout(btn, label, children) {
        if (!flyout || !flyoutTitle || !flyoutLinks) return;
        const rect = btn.getBoundingClientRect();
        flyoutTitle.textContent = label;

        flyoutLinks.innerHTML = children
          .map((child) => {
            const isChildActive = child.id === activeNavId;
            return `
              <a
                href="${child.href}"
                class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-xs transition-colors ${
                  isChildActive
                    ? "bg-primary text-surface font-semibold shadow-xs"
                    : "text-muted hover:bg-surface-subtle hover:text-heading"
                }"
              >
                <span class="truncate">${child.label}</span>
              </a>
            `;
          })
          .join("");

        // Calculate vertical position avoiding screen overflow
        const top = Math.min(Math.max(rect.top, 12), window.innerHeight - 260);
        const left = rect.right + 10;
        flyout.style.top = `${top}px`;
        flyout.style.left = `${left}px`;
        flyout.classList.remove("hidden");
        activeFlyoutGroup = btn;
      }

      function closeFlyout() {
        flyout?.classList.add("hidden");
        activeFlyoutGroup = null;
      }

      // Tooltip Logic for Mini Mode
      function showTooltip(el, text) {
        if (!isCollapsed || window.innerWidth < 768 || !tooltip || !tooltipText)
          return;
        const rect = el.getBoundingClientRect();
        tooltipText.textContent = text;
        tooltip.style.top = `${rect.top + rect.height / 2 - 12}px`;
        tooltip.style.left = `${rect.right + 10}px`;
        tooltip.classList.remove("hidden");
      }

      function hideTooltip() {
        tooltip?.classList.add("hidden");
      }

      // Tooltip hover triggers for standalone items
      document.querySelectorAll("[data-nav-tooltip]").forEach((el) => {
        el.addEventListener("mouseenter", () => {
          const text = el.getAttribute("data-nav-tooltip");
          if (text) showTooltip(el, text);
        });
        el.addEventListener("mouseleave", hideTooltip);
        el.addEventListener("focus", () => {
          const text = el.getAttribute("data-nav-tooltip");
          if (text) showTooltip(el, text);
        });
        el.addEventListener("blur", hideTooltip);
      });

      // Group Button Click (Accordion when Expanded, Popover Flyout when Collapsed)
      document.querySelectorAll("[data-group-toggle]").forEach((btn) => {
        // Tooltip on hover when collapsed
        btn.addEventListener("mouseenter", () => {
          if (isCollapsed && !activeFlyoutGroup) {
            const text = btn.getAttribute("data-group-label");
            if (text) showTooltip(btn, text);
          }
        });
        btn.addEventListener("mouseleave", hideTooltip);

        // Click handler
        btn.addEventListener("click", (e) => {
          hideTooltip();

          // Collapsed Mode -> Popover Flyout
          if (isCollapsed && window.innerWidth >= 768) {
            e.stopPropagation();
            if (activeFlyoutGroup === btn) {
              closeFlyout();
            } else {
              const label = btn.getAttribute("data-group-label") || "";
              const children = JSON.parse(
                btn.getAttribute("data-group-children") || "[]",
              );
              openFlyout(btn, label, children);
            }
            return;
          }

          // Expanded Mode -> Single-open Accordion (auto-close other groups)
          const groupId = btn.getAttribute("data-group-toggle");
          const content = document.getElementById(`group-${groupId}`);
          const chevron = btn.querySelector(".chevron-icon");
          if (!content) return;

          const isExpanded = btn.getAttribute("aria-expanded") === "true";

          // Close all other group accordions
          document
            .querySelectorAll("[data-group-toggle]")
            .forEach((otherBtn) => {
              if (otherBtn !== btn) {
                otherBtn.setAttribute("aria-expanded", "false");
                const otherId = otherBtn.getAttribute("data-group-toggle");
                const otherContent = document.getElementById(
                  `group-${otherId}`,
                );
                const otherChevron = otherBtn.querySelector(".chevron-icon");
                otherContent?.classList.add("hidden");
                otherChevron?.classList.remove("rotate-180");
              }
            });

          // Toggle current group
          if (isExpanded) {
            btn.setAttribute("aria-expanded", "false");
            content.classList.add("hidden");
            chevron?.classList.remove("rotate-180");
          } else {
            btn.setAttribute("aria-expanded", "true");
            content.classList.remove("hidden");
            chevron?.classList.add("rotate-180");
          }
        });
      });

      // User Menu Dropdown Toggle in Topbar Header
      const userMenuBtn = document.getElementById("user-menu-btn");
      const userMenuDropdown = document.getElementById("user-menu-dropdown");
      const userMenuChevron = userMenuBtn?.querySelector(".chevron-user");

      function toggleUserMenu(show) {
        if (!userMenuDropdown) return;
        const isOpen = userMenuDropdown.getAttribute("data-open") === "true";
        const willShow = typeof show === "boolean" ? show : !isOpen;
        if (willShow) {
          userMenuDropdown.classList.remove("hidden");
          requestAnimationFrame(() => {
            userMenuDropdown.setAttribute("data-open", "true");
            userMenuDropdown.classList.remove(
              "opacity-0",
              "scale-95",
              "pointer-events-none",
            );
            userMenuDropdown.classList.add(
              "opacity-100",
              "scale-100",
              "pointer-events-auto",
            );
          });
          userMenuBtn?.setAttribute("aria-expanded", "true");
          userMenuChevron?.classList.add("rotate-180");
        } else {
          userMenuDropdown.setAttribute("data-open", "false");
          userMenuDropdown.classList.remove(
            "opacity-100",
            "scale-100",
            "pointer-events-auto",
          );
          userMenuDropdown.classList.add(
            "opacity-0",
            "scale-95",
            "pointer-events-none",
          );
          userMenuBtn?.setAttribute("aria-expanded", "false");
          userMenuChevron?.classList.remove("rotate-180");
          setTimeout(() => {
            if (userMenuDropdown.getAttribute("data-open") !== "true") {
              userMenuDropdown.classList.add("hidden");
            }
          }, 150);
        }
      }

      userMenuBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleUserMenu();
      });

      // Close Flyout and User Menu when clicking outside or scrolling
      document.addEventListener("click", (e) => {
        if (
          flyout &&
          !flyout.contains(e.target) &&
          !e.target.closest("[data-group-toggle]")
        ) {
          closeFlyout();
        }
        if (
          userMenuDropdown &&
          !userMenuDropdown.contains(e.target) &&
          !userMenuBtn?.contains(e.target)
        ) {
          toggleUserMenu(false);
        }
      });

      window.addEventListener(
        "scroll",
        () => {
          closeFlyout();
          toggleUserMenu(false);
        },
        true,
      );

      // Mobile Drawer Toggle
      function openSidebar() {
        if (!sidebar || !backdrop) return;
        backdrop.classList.remove("hidden");
        requestAnimationFrame(() => {
          sidebar.classList.remove("-translate-x-full");
          backdrop.classList.remove("opacity-0", "pointer-events-none");
          backdrop.classList.add("opacity-100");
        });
      }

      function closeSidebar() {
        if (!sidebar || !backdrop) return;
        sidebar.classList.add("-translate-x-full");
        backdrop.classList.remove("opacity-100");
        backdrop.classList.add("opacity-0", "pointer-events-none");
        setTimeout(() => {
          if (backdrop.classList.contains("opacity-0")) {
            backdrop.classList.add("hidden");
          }
        }, 200);
      }

      toggleBtn?.addEventListener("click", openSidebar);
      closeBtn?.addEventListener("click", closeSidebar);
      backdrop?.addEventListener("click", closeSidebar);

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeFlyout();
          hideTooltip();
          closeSidebar();
          toggleUserMenu(false);
        }
      });

      sidebar?.querySelectorAll("nav a").forEach((link) => {
        link.addEventListener("click", () => {
          if (window.innerWidth < 768) {
            closeSidebar();
          }
        });
      });

      // Theme Toggle — dipasang via is:inline terpisah di bawah

      // Change Password Modal Logic
      const changePasswordBtn = document.getElementById("change-password-btn");
      const passwordModal = document.getElementById("password-modal-backdrop");
      const closePasswordBtn = document.getElementById("close-password-modal");
      const cancelPasswordBtn = document.getElementById(
        "cancel-password-modal",
      );
      const changePasswordForm = document.getElementById(
        "change-password-form",
      );
      const passwordAlert = document.getElementById("password-alert");
      const submitPasswordBtn = document.getElementById("submit-password-btn");

      function openPasswordModal() {
        toggleUserMenu(false);
        if (changePasswordForm) changePasswordForm.reset();
        if (passwordAlert) {
          passwordAlert.classList.add("hidden");
          passwordAlert.textContent = "";
        }
        if (passwordModal) {
          passwordModal.classList.remove("hidden");
          passwordModal.classList.add("flex");
        }
      }

      function closePasswordModal() {
        if (passwordModal) {
          passwordModal.classList.add("is-closing");
          setTimeout(() => {
            passwordModal.classList.remove("is-closing");
            passwordModal.classList.add("hidden");
            passwordModal.classList.remove("flex");
          }, 180);
        }
      }

      changePasswordBtn?.addEventListener("click", openPasswordModal);
      closePasswordBtn?.addEventListener("click", closePasswordModal);
      cancelPasswordBtn?.addEventListener("click", closePasswordModal);
      passwordModal?.addEventListener("click", (e) => {
        if (e.target === passwordModal) closePasswordModal();
      });

      changePasswordForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const currentPasswordInput =
          document.getElementById("current-password");
        const newPasswordInput = document.getElementById("new-password");
        const confirmPasswordInput =
          document.getElementById("confirm-password");

        const currentPassword = currentPasswordInput
          ? currentPasswordInput.value
          : "";
        const newPassword = newPasswordInput ? newPasswordInput.value : "";
        const confirmPassword = confirmPasswordInput
          ? confirmPasswordInput.value
          : "";

        if (passwordAlert) {
          passwordAlert.classList.add("hidden");
          passwordAlert.className = "hidden p-3 rounded-[6px] text-xs";
        }

        if (newPassword !== confirmPassword) {
          if (passwordAlert) {
            passwordAlert.textContent =
              "Konfirmasi kata sandi baru tidak cocok.";
            passwordAlert.className =
              "p-3 rounded-[6px] text-xs bg-error-light text-error-text border border-error/20";
            passwordAlert.classList.remove("hidden");
          }
          return;
        }

        if (newPassword.length < 8) {
          if (passwordAlert) {
            passwordAlert.textContent = "Kata sandi baru minimal 8 karakter.";
            passwordAlert.className =
              "p-3 rounded-[6px] text-xs bg-error-light text-error-text border border-error/20";
            passwordAlert.classList.remove("hidden");
          }
          return;
        }

        if (submitPasswordBtn) {
          submitPasswordBtn.disabled = true;
          submitPasswordBtn.textContent = "Menyimpan...";
        }

        try {
          const res = await fetch("/api/auth/change-password", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ currentPassword, newPassword }),
          });
          const data = await res.json();

          if (data.success) {
            if (passwordAlert) {
              passwordAlert.textContent = "Kata sandi berhasil diperbarui.";
              passwordAlert.className =
                "p-3 rounded-[6px] text-xs bg-accent-light text-accent-text border border-accent/20";
              passwordAlert.classList.remove("hidden");
            }
            if (changePasswordForm) changePasswordForm.reset();
            setTimeout(() => {
              closePasswordModal();
            }, 1200);
          } else {
            if (passwordAlert) {
              passwordAlert.textContent =
                data.error || "Gagal mengubah kata sandi.";
              passwordAlert.className =
                "p-3 rounded-[6px] text-xs bg-error-light text-error-text border border-error/20";
              passwordAlert.classList.remove("hidden");
            }
          }
        } catch {
          if (passwordAlert) {
            passwordAlert.textContent = "Terjadi kesalahan jaringan.";
            passwordAlert.className =
              "p-3 rounded-[6px] text-xs bg-error-light text-error-text border border-error/20";
            passwordAlert.classList.remove("hidden");
          }
        } finally {
          if (submitPasswordBtn) {
            submitPasswordBtn.disabled = false;
            submitPasswordBtn.textContent = "Simpan Perubahan";
          }
        }
      });

      // Logout handler
      const logoutBtn = document.getElementById("logout-btn");
      logoutBtn?.addEventListener("click", async () => {
        try {
          await fetch("/api/auth/logout", { method: "POST" });
          window.location.href = "/admin/login";
        } catch {
          window.location.href = "/admin/login";
        }
      });
      // Centralized Modal Scroll-Lock & Body Portal Engine
      (function initModalScrollLock() {
        const viewport = document.getElementById("admin-main-viewport");

        // Auto-portal modal elements to document.body so position:fixed covers full viewport (outside <main>)
        function portalModalsToBody() {
          const modalElements = document.querySelectorAll(
            '[role="dialog"], [aria-modal="true"], .modal, .modal-backdrop, div[id$="-modal"], div[id^="modal-"], div[id$="-backdrop"]',
          );
          modalElements.forEach((el) => {
            if (el.id === "sidebar-backdrop") return;
            if (el.parentElement && el.parentElement !== document.body) {
              if (el.id) {
                const existingInBody = document.body.querySelector(
                  `:scope > #${el.id}`,
                );
                if (existingInBody && existingInBody !== el) {
                  existingInBody.remove();
                }
              }
              document.body.appendChild(el);
            }
          });
        }

        portalModalsToBody();
        document.addEventListener("astro:page-load", portalModalsToBody);

        function isModalActive(el) {
          if (!el || el.id === "sidebar-backdrop") return false;
          // Must not have hidden class, and no ancestor should have hidden class
          if (el.classList.contains("hidden") || el.closest(".hidden"))
            return false;

          const style = window.getComputedStyle(el);
          if (
            style.display === "none" ||
            style.visibility === "hidden" ||
            style.opacity === "0"
          ) {
            return false;
          }

          // Check if this is actually a dialog or fixed/absolute modal overlay
          const isDialog =
            el.getAttribute("role") === "dialog" ||
            el.getAttribute("aria-modal") === "true";
          const isOverlay =
            (style.position === "fixed" || style.position === "absolute") &&
            (el.classList.contains("modal") ||
              el.classList.contains("modal-backdrop") ||
              (el.id &&
                (el.id.endsWith("-modal") ||
                  el.id.startsWith("modal-") ||
                  el.id.endsWith("-backdrop"))));

          return isDialog || isOverlay;
        }

        function updateScrollLock() {
          const candidates = document.querySelectorAll(
            '[role="dialog"], [aria-modal="true"], .modal, .modal-backdrop, div[id$="-modal"], div[id^="modal-"], div[id$="-backdrop"]',
          );
          let hasOpen = false;
          for (const el of candidates) {
            if (isModalActive(el)) {
              hasOpen = true;
              break;
            }
          }

          document.documentElement.classList.toggle("has-modal-open", hasOpen);
          document.body.classList.toggle("has-modal-open", hasOpen);
          if (viewport) {
            if (hasOpen) {
              viewport.style.overflow = "hidden";
            } else {
              viewport.style.overflow = "";
            }
          }
        }

        const modalObserver = new MutationObserver((mutations) => {
          let shouldCheck = false;
          for (const m of mutations) {
            if (m.type === "attributes" && m.attributeName === "class") {
              shouldCheck = true;
              break;
            }
          }
          if (shouldCheck) {
            portalModalsToBody();
            updateScrollLock();
          }
        });

        modalObserver.observe(document.body, {
          attributes: true,
          subtree: true,
          attributeFilter: ["class"],
        });

        window.lockAdminScroll = function (locked) {
          document.documentElement.classList.toggle(
            "has-modal-open",
            Boolean(locked),
          );
          document.body.classList.toggle("has-modal-open", Boolean(locked));
          if (viewport) {
            viewport.style.overflow = locked ? "hidden" : "";
          }
        };

        updateScrollLock();
      })();
    </script>
    <!-- Centralized Feedback: Modal Konfirmasi & Toast Notifikasi -->
    <ConfirmDialog />
    <ToastContainer />
  </body>

  <!-- Admin Dark Mode Toggle (is:inline — tidak di-bundle, langsung inline) -->
  <script is:inline>
    (function () {
      function applyTheme(dark) {
        if (dark) document.documentElement.classList.add("dark");
        else document.documentElement.classList.remove("dark");
        try {
          localStorage.setItem("theme", dark ? "dark" : "light");
        } catch (_) {}
      }

      function attachAdminThemeToggle() {
        var btn = document.getElementById("admin-theme-toggle");
        if (!btn || btn.dataset.themeAttached) return;
        btn.dataset.themeAttached = "1";

        btn.addEventListener("click", function (event) {
          var nextDark = !document.documentElement.classList.contains("dark");
          var reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          var hasVT = typeof document.startViewTransition === "function";

          if (!hasVT || reducedMotion) {
            document.documentElement.classList.add("theme-transition");
            applyTheme(nextDark);
            setTimeout(function () {
              document.documentElement.classList.remove("theme-transition");
            }, 400);
            return;
          }

          var r = btn.getBoundingClientRect();
          var x = event.clientX || r.left + r.width / 2;
          var y = event.clientY || r.top + r.height / 2;
          var endRadius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y),
          );

          document.documentElement.classList.add("theme-changing");
          var vt = document.startViewTransition(function () {
            applyTheme(nextDark);
          });
          vt.ready
            .then(function () {
              document.documentElement.animate(
                {
                  clipPath: [
                    "circle(0px at " + x + "px " + y + "px)",
                    "circle(" + endRadius + "px at " + x + "px " + y + "px)",
                  ],
                },
                {
                  duration: 420,
                  easing: "ease-in-out",
                  pseudoElement: "::view-transition-new(root)",
                },
              );
            })
            .catch(function () {
              applyTheme(nextDark);
            })
            .finally(function () {
              document.documentElement.classList.remove("theme-changing");
            });
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", attachAdminThemeToggle);
      } else {
        attachAdminThemeToggle();
      }
    })();
  </script>

  <!-- ============================================================
       ANIME.JS CMS ANIMATION ENGINE (KPI Stagger, Counter Up, Panel Entrance)
