---
import "../styles/global.css";
import SvgSprite from "../components/SvgSprite.astro";

interface Props {
  title: string;
  autoPrint?: boolean;
  favicon?: string;
}

const { title, autoPrint = false, favicon = "/favicon.svg" } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href={favicon} />
  </head>
  <body class="bg-surface-subtle font-body text-heading antialiased print:bg-white print:m-0">
    <SvgSprite />
    <slot name="toolbar" />
    <slot />
    {autoPrint && (
      <script is:inline>
        window.addEventListener("load", () => {
          setTimeout(() => {
            window.print();
          }, 350);
        });
      </script>
    )}
  </body>
</html>
