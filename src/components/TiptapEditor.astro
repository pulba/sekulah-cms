<style is:global>
  /* ============================================================
     Tiptap ProseMirror Visual Styles — Editorial Modern & Bersih
  ============================================================ */
  .tiptap-prose .ProseMirror {
    outline: none;
    min-height: 280px;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: #1e293b;
    font-weight: 400 !important; /* PENTING: teks default normal 400, tidak bold */
  }

  /* Paragraph — normal weight 400, tidak bold kecuali ada <strong> */
  .tiptap-prose .ProseMirror p {
    margin-bottom: 0.75rem;
    font-weight: 400 !important;
    line-height: 1.75;
    color: #1e293b;
  }

  /* Headings — tegas, elegan */
  .tiptap-prose .ProseMirror h1 { font-size: 1.75rem; font-weight: 700; margin: 1.5rem 0 0.5rem; line-height: 1.25; color: #0f172a; }
  .tiptap-prose .ProseMirror h2 { font-size: 1.35rem; font-weight: 700; margin: 1.25rem 0 0.4rem; line-height: 1.3; color: #0f172a; }
  .tiptap-prose .ProseMirror h3 { font-size: 1.15rem; font-weight: 600; margin: 1rem 0 0.35rem; color: #0f172a; }
  .tiptap-prose .ProseMirror h4 { font-size: 1rem; font-weight: 600; margin: 0.75rem 0 0.25rem; color: #0f172a; }
  .tiptap-prose .ProseMirror h5, .tiptap-prose .ProseMirror h6 { font-size: 0.9rem; font-weight: 600; margin: 0.5rem 0 0.2rem; color: #0f172a; }

  /* Marks — Bold HANYA ketika diberi <strong> */
  .tiptap-prose .ProseMirror strong { font-weight: 700 !important; color: #0f172a; }
  .tiptap-prose .ProseMirror em { font-style: italic; }
