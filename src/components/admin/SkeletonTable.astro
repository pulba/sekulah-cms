---
interface Props {
  rows?: number;
  columns?: number;
  showHeader?: boolean;
  class?: string;
}

const { rows = 5, columns = 5, showHeader = true, class: className = '' } = Astro.props;
---

<div class:list={["w-full overflow-hidden rounded-[10px] border border-border bg-surface", className]} aria-busy="true" aria-live="polite">
  {showHeader && (
    <div class="bg-surface-subtle px-4 py-3.5 flex items-center gap-4">
      <div class="h-4 w-28 skeleton-shimmer"></div>
      <div class="ml-auto flex items-center gap-2">
        <div class="h-8 w-24 skeleton-shimmer"></div>
        <div class="h-8 w-20 skeleton-shimmer"></div>
      </div>
    </div>
  )}

  <table class="w-full text-left font-body text-xs">
    {showHeader && (
      <thead class="bg-surface-subtle/50 text-[11px] font-bold uppercase tracking-wider text-muted">
        <tr class="*:px-4 *:py-3">
          {Array.from({ length: columns }).map((_, idx) => (
            <th>
              <div class="h-3.5 w-16 skeleton-shimmer"></div>
            </th>
          ))}
        </tr>
      </thead>
    )}
    <tbody class="divide-y divide-border">
      {Array.from({ length: rows }).map((_, rIdx) => (
        <tr class="*:px-4 *:py-3.5">
          {Array.from({ length: columns }).map((_, cIdx) => (
            <td>
              {cIdx === 0 ? (
                <div class="flex items-center gap-3">
                  <div class="h-8 w-8 rounded-[6px] skeleton-shimmer shrink-0"></div>
                  <div class="space-y-1.5 flex-1 min-w-0">
                    <div class="h-3.5 w-3/4 skeleton-shimmer"></div>
                    <div class="h-2.5 w-1/2 skeleton-shimmer"></div>
                  </div>
                </div>
              ) : cIdx === columns - 1 ? (
                <div class="flex items-center justify-end gap-1.5">
                  <div class="h-7 w-7 rounded-[4px] skeleton-shimmer"></div>
                  <div class="h-7 w-7 rounded-[4px] skeleton-shimmer"></div>
                </div>
              ) : (
                <div class:list={[
                  "h-3 skeleton-shimmer",
                  cIdx % 2 === 0 ? "w-24" : "w-16"
                ]}></div>
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>

  <div class="bg-surface-subtle/40 px-4 py-3 flex items-center justify-between">
    <div class="h-3 w-32 skeleton-shimmer"></div>
    <div class="flex items-center gap-1.5">
      <div class="h-7 w-7 rounded-[4px] skeleton-shimmer"></div>
      <div class="h-7 w-7 rounded-[4px] skeleton-shimmer"></div>
      <div class="h-7 w-7 rounded-[4px] skeleton-shimmer"></div>
    </div>
  </div>
</div>
