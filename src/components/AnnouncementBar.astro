---
import Icon from "./Icon.astro";

interface Props {
  id?: number | string;
  text?: string;
  linkText?: string;
  href?: string;
  isUrgent?: boolean;
}

const {
  text = "Pengumuman Pendaftaran Siswa Baru Tahun Ajaran 2026/2027 telah dibuka secara resmi.",
  linkText = "Lihat Alur & Syarat",
  href = "/pendaftaran",
  isUrgent = false,
} = Astro.props;

const badgeLabel = isUrgent ? "Penting" : "Pengumuman";
const badgeClass = isUrgent
  ? "bg-warning text-tertiary-foreground"
  : "bg-secondary text-secondary-foreground";
---

<aside
  id="site-announcement-bar"
  class="relative z-40 bg-primary text-primary-foreground px-3 sm:px-6 transition-all duration-200 overflow-hidden"
  aria-label="Pengumuman Resmi Sekolah"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-2 sm:gap-3 text-xs">
    <span
      class:list={[
        "inline-flex items-center gap-1.5 shrink-0 p-2 text-[10px] font-bold uppercase tracking-wider shadow-2xs z-10",
        badgeClass,
      ]}
    >
      <Icon name="bell" class="w-3 h-3 shrink-0" />
      <span>{badgeLabel}</span>
    </span>

    <!-- Kontainer Teks Berjalan (Marquee Lambat & Halus) -->
    <div class="relative flex-1 min-w-0 overflow-hidden mx-1 sm:mx-2">
      <!-- Gradient Fade Halus di Sisi Kiri & Kanan -->
      <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-3 sm:w-5 bg-gradient-to-r from-primary to-transparent z-10"></div>
      <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-3 sm:w-5 bg-gradient-to-l from-primary to-transparent z-10"></div>

      <div class="announcement-marquee inline-flex whitespace-nowrap">
        <span class="inline-block px-4 font-body text-xs font-medium text-primary-foreground">
          {text}
        </span>
        <span
          class="inline-block px-4 font-body text-xs font-medium text-primary-foreground"
          aria-hidden="true"
        >
          {text}
        </span>
      </div>
    </div>

    <!-- Tautan Aksi Kanan (Tetap Diam & Selalu Terlihat) -->
    {linkText && href && (
      <a
        href={href}
        class="group inline-flex items-center gap-1 text-xs font-semibold text-secondary hover:text-white shrink-0 z-10 transition-colors duration-150 underline-offset-4 hover:underline"
      >
        <span>{linkText}</span>
        <Icon
          name="arrow-right"
          class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-0.5"
        />
      </a>
    )}
  </div>
</aside>

<style>
  @keyframes announcementMarquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .announcement-marquee {
    animation: announcementMarquee 28s linear infinite;
  }

  .announcement-marquee:hover {
    animation-play-state: paused;
  }
</style>
