  <script>
    function initHeroSlider() {
      const slider = document.getElementById("hero-slider");
      if (!slider) return;

      const slides = slider.querySelectorAll(".hero-slide");
      const dots = slider.querySelectorAll(".hero-dot");
      const prevBtn = document.getElementById("hero-slider-prev");
      const nextBtn = document.getElementById("hero-slider-next");

      if (slides.length <= 1) return;

      let currentIndex = 0;
      let timer: any = null;

      function loadDeferredImages() {
        const deferredImages = slider.querySelectorAll("img[data-src]");
        deferredImages.forEach((img) => {
          const src = img.getAttribute("data-src");
          if (src) {
            img.setAttribute("src", src);
            img.removeAttribute("data-src");
          }
        });
      }

      function goToSlide(index: number) {
        loadDeferredImages();
        currentIndex = (index + slides.length) % slides.length;

        slides.forEach((slide, i) => {
          if (i === currentIndex) {
            slide.classList.remove("opacity-0", "pointer-events-none", "z-0");
            slide.classList.add("opacity-100", "pointer-events-auto", "z-10");
          } else {
            slide.classList.remove(
              "opacity-100",
              "pointer-events-auto",
              "z-10",
            );
            slide.classList.add("opacity-0", "pointer-events-none", "z-0");
          }
        });

        dots.forEach((dot, i) => {
          if (i === currentIndex) {
            dot.classList.remove("w-2", "bg-surface/40");
            dot.classList.add("w-8", "bg-surface");
          } else {
            dot.classList.remove("w-8", "bg-surface");
            dot.classList.add("w-2", "bg-surface/40");
          }
        });
      }

      function nextSlide() {
        goToSlide(currentIndex + 1);
      }

      function prevSlide() {
        goToSlide(currentIndex - 1);
      }

      function startTimer() {
        stopTimer();
        timer = setInterval(nextSlide, 5000);
      }

      function stopTimer() {
        if (timer) clearInterval(timer);
      }

      prevBtn?.addEventListener("click", () => {
        prevSlide();
        startTimer();
      });

      nextBtn?.addEventListener("click", () => {
        nextSlide();
        startTimer();
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const idx = parseInt(dot.getAttribute("data-index") || "0", 10);
          goToSlide(idx);
          startTimer();
        });
      });

      slider.addEventListener("mouseenter", stopTimer);
      slider.addEventListener("mouseleave", startTimer);

      document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") prevSlide();
        if (e.key === "ArrowRight") nextSlide();
      });

      // Unduh gambar slide berikutnya setelah LCP slide utama selesai (idle / sebelum slide berganti)
      if ("requestIdleCallback" in window) {
        (window as any).requestIdleCallback(() => loadDeferredImages(), {
          timeout: 2000,
        });
      } else {
        setTimeout(loadDeferredImages, 1500);
      }

      startTimer();
    }

    function initTeacherSlider() {
      const track = document.getElementById("teacher-slider-track");
      const prevBtn = document.getElementById("teacher-slider-prev");
      const nextBtn = document.getElementById("teacher-slider-next");
      if (!track) return;

      const totalItems = track.children.length;
      if (totalItems <= 4) return;

      const singleSetCount = Math.floor(totalItems / 3);
      let isNormalizing = false;
      let autoTimer: any = null;
      let scrollTimeout: any = null;

      function getSingleSetWidth(): number {
        if (!track || track.children.length < singleSetCount) return 0;
        const firstCard = track.children[0] as HTMLElement;
        const middleCard = track.children[singleSetCount] as HTMLElement;
        if (!firstCard || !middleCard) return 0;
        return middleCard.offsetLeft - firstCard.offsetLeft;
      }

      function setInitialPosition() {
        if (!track) return;
        const singleSetWidth = getSingleSetWidth();
        if (singleSetWidth > 0 && track.scrollLeft < singleSetWidth * 0.5) {
          track.classList.remove("scroll-smooth");
          track.style.scrollSnapType = "none";
          track.scrollLeft = singleSetWidth;
          void track.offsetWidth;
          track.classList.add("scroll-smooth");
          track.style.scrollSnapType = "";
        }
      }

      function normalizePosition() {
        if (!track || isNormalizing) return;
        const singleSetWidth = getSingleSetWidth();
        if (singleSetWidth <= 0) return;

        // If scrolled into third set, jump back to second set seamlessly
        if (track.scrollLeft >= 2 * singleSetWidth - 8) {
          isNormalizing = true;
          track.classList.remove("scroll-smooth");
          track.style.scrollSnapType = "none";
          track.scrollLeft -= singleSetWidth;
          void track.offsetWidth;
          track.classList.add("scroll-smooth");
          track.style.scrollSnapType = "";
          setTimeout(() => {
            isNormalizing = false;
          }, 60);
        }
        // If scrolled back into first set, jump forward to second set seamlessly
        else if (track.scrollLeft <= singleSetWidth * 0.4) {
          isNormalizing = true;
          track.classList.remove("scroll-smooth");
          track.style.scrollSnapType = "none";
          track.scrollLeft += singleSetWidth;
          void track.offsetWidth;
          track.classList.add("scroll-smooth");
          track.style.scrollSnapType = "";
          setTimeout(() => {
            isNormalizing = false;
          }, 60);
        }
      }

      function scrollStep(direction: number) {
        if (!track) return;
        normalizePosition();
        const firstCard = track.querySelector("a") as HTMLElement | null;
        const step = firstCard
          ? firstCard.offsetWidth + 20
          : track.clientWidth * 0.75;
        track.scrollBy({ left: direction * step, behavior: "smooth" });
      }

      function startAutoPlay() {
        stopAutoPlay();
        autoTimer = setInterval(() => {
          scrollStep(1);
        }, 3500);
      }

      function stopAutoPlay() {
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }

      prevBtn?.addEventListener("click", () => {
        scrollStep(-1);
        startAutoPlay();
      });

      nextBtn?.addEventListener("click", () => {
        scrollStep(1);
        startAutoPlay();
      });

      // Pause autoplay on mouse hover or touch interaction
      track.addEventListener("mouseenter", stopAutoPlay);
      track.addEventListener("mouseleave", startAutoPlay);
      track.addEventListener("touchstart", stopAutoPlay, { passive: true });
      track.addEventListener("touchend", startAutoPlay, { passive: true });

      track.addEventListener(
        "scroll",
        () => {
          if (scrollTimeout) clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(normalizePosition, 160);
        },
        { passive: true },
      );

      window.addEventListener(
        "resize",
        () => {
          setInitialPosition();
        },
        { passive: true },
      );

      setInitialPosition();
      setTimeout(setInitialPosition, 100);
      startAutoPlay();
    }

    function initAlumniSlider() {
      const track = document.getElementById("alumni-slider-track");
      const prevBtn = document.getElementById("alumni-slider-prev");
      const nextBtn = document.getElementById("alumni-slider-next");
      if (!track) return;

      const totalItems = track.children.length;
      if (totalItems <= 3) return;

      const singleSetCount = Math.floor(totalItems / 3);
      let isNormalizing = false;
      let autoTimer: any = null;
      let scrollTimeout: any = null;

      function getSingleSetWidth(): number {
        if (!track || track.children.length < singleSetCount) return 0;
        const firstCard = track.children[0] as HTMLElement;
        const middleCard = track.children[singleSetCount] as HTMLElement;
        if (!firstCard || !middleCard) return 0;
        return middleCard.offsetLeft - firstCard.offsetLeft;
      }

      function setInitialPosition() {
        if (!track) return;
        const singleSetWidth = getSingleSetWidth();
        if (singleSetWidth > 0 && track.scrollLeft < singleSetWidth * 0.5) {
          track.classList.remove("scroll-smooth");
          track.style.scrollSnapType = "none";
          track.scrollLeft = singleSetWidth;
          void track.offsetWidth;
          track.classList.add("scroll-smooth");
          track.style.scrollSnapType = "";
        }
      }

      function normalizePosition() {
        if (!track || isNormalizing) return;
        const singleSetWidth = getSingleSetWidth();
        if (singleSetWidth <= 0) return;

        if (track.scrollLeft >= 2 * singleSetWidth - 8) {
          isNormalizing = true;
          track.classList.remove("scroll-smooth");
          track.style.scrollSnapType = "none";
          track.scrollLeft -= singleSetWidth;
          void track.offsetWidth;
          track.classList.add("scroll-smooth");
          track.style.scrollSnapType = "";
          setTimeout(() => {
            isNormalizing = false;
          }, 60);
        } else if (track.scrollLeft <= singleSetWidth * 0.4) {
          isNormalizing = true;
          track.classList.remove("scroll-smooth");
          track.style.scrollSnapType = "none";
          track.scrollLeft += singleSetWidth;
          void track.offsetWidth;
          track.classList.add("scroll-smooth");
          track.style.scrollSnapType = "";
          setTimeout(() => {
            isNormalizing = false;
          }, 60);
        }
      }

      function scrollStep(direction: number) {
        if (!track) return;
        normalizePosition();
        const firstCard = track.querySelector("article") as HTMLElement | null;
        const step = firstCard
          ? firstCard.offsetWidth + 24
          : track.clientWidth * 0.8;
        track.scrollBy({ left: direction * step, behavior: "smooth" });
      }

      function startAutoPlay() {
        stopAutoPlay();
        autoTimer = setInterval(() => {
          scrollStep(1);
        }, 4500);
      }

      function stopAutoPlay() {
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }

      prevBtn?.addEventListener("click", () => {
        scrollStep(-1);
        startAutoPlay();
      });

      nextBtn?.addEventListener("click", () => {
        scrollStep(1);
        startAutoPlay();
      });

      const dots = document.querySelectorAll(".alumni-dot");
      const originalCount = dots.length || 1;

      function updateDots() {
        if (!track || dots.length === 0) return;
        const firstCard = track.children[0] as HTMLElement;
        const cardStep = firstCard
          ? firstCard.offsetWidth + 20
          : track.offsetWidth * 0.8;
        const currentActive =
          Math.round(track.scrollLeft / cardStep) % originalCount;

        dots.forEach((dot, idx) => {
          if (idx === currentActive) {
            dot.classList.remove("w-1.5", "bg-white/40");
            dot.classList.add("w-5", "bg-white");
          } else {
            dot.classList.remove("w-5", "bg-white");
            dot.classList.add("w-1.5", "bg-white/40");
          }
        });
      }

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const idx = parseInt(dot.getAttribute("data-index") || "0", 10);
          const singleSetWidth = getSingleSetWidth();
          const firstCard = track.children[0] as HTMLElement;
          const cardStep = firstCard
            ? firstCard.offsetWidth + 20
            : singleSetWidth / singleSetCount;
          track.scrollTo({
            left: singleSetWidth + idx * cardStep,
            behavior: "smooth",
          });
          startAutoPlay();
        });
      });

      track.addEventListener("mouseenter", stopAutoPlay);
      track.addEventListener("mouseleave", startAutoPlay);
      track.addEventListener("touchstart", stopAutoPlay, { passive: true });
      track.addEventListener("touchend", startAutoPlay, { passive: true });

      track.addEventListener(
        "scroll",
        () => {
          if (scrollTimeout) clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            normalizePosition();
            updateDots();
          }, 160);
        },
        { passive: true },
      );

      window.addEventListener(
        "resize",
        () => {
          setInitialPosition();
          updateDots();
        },
        { passive: true },
      );

      setInitialPosition();
      setTimeout(() => {
        setInitialPosition();
        updateDots();
      }, 100);
      startAutoPlay();
    }

    function initHomePartnerSlider() {
      const track = document.getElementById("home-partner-slider-track");
      const prevBtn = document.getElementById("home-partner-slider-prev");
      const nextBtn = document.getElementById("home-partner-slider-next");
      if (!track) return;

      const totalItems = track.children.length;
      if (totalItems <= 3) return;

      const singleSetCount = Math.floor(totalItems / 3);
      let isNormalizing = false;
      let autoTimer: any = null;
      let scrollTimeout: any = null;

      function getSingleSetWidth(): number {
        if (!track || track.children.length < singleSetCount) return 0;
        const firstCard = track.children[0] as HTMLElement;
        const middleCard = track.children[singleSetCount] as HTMLElement;
        if (!firstCard || !middleCard) return 0;
        return middleCard.offsetLeft - firstCard.offsetLeft;
      }

      function setInitialPosition() {
        if (!track) return;
        const singleSetWidth = getSingleSetWidth();
        if (singleSetWidth > 0 && track.scrollLeft < singleSetWidth * 0.5) {
          track.classList.remove("scroll-smooth");
          track.style.scrollSnapType = "none";
          track.scrollLeft = singleSetWidth;
          void track.offsetWidth;
          track.classList.add("scroll-smooth");
          track.style.scrollSnapType = "";
        }
      }

      function normalizePosition() {
        if (!track || isNormalizing) return;
        const singleSetWidth = getSingleSetWidth();
        if (singleSetWidth <= 0) return;

        // Scrolled into third set -> seamlessly jump back to second set without visual rewind
        if (track.scrollLeft >= 2 * singleSetWidth - 8) {
          isNormalizing = true;
          track.classList.remove("scroll-smooth");
          track.style.scrollSnapType = "none";
          track.scrollLeft -= singleSetWidth;
          void track.offsetWidth;
          track.classList.add("scroll-smooth");
          track.style.scrollSnapType = "";
          setTimeout(() => {
            isNormalizing = false;
          }, 60);
        }
        // Scrolled into first set -> seamlessly jump forward to second set
        else if (track.scrollLeft <= singleSetWidth * 0.4) {
          isNormalizing = true;
          track.classList.remove("scroll-smooth");
          track.style.scrollSnapType = "none";
          track.scrollLeft += singleSetWidth;
          void track.offsetWidth;
          track.classList.add("scroll-smooth");
          track.style.scrollSnapType = "";
          setTimeout(() => {
            isNormalizing = false;
          }, 60);
        }
      }

      function scrollStep(direction: number) {
        if (!track) return;
        normalizePosition();
        const firstCard = track.children[0] as HTMLElement | null;
        const step = firstCard
          ? firstCard.offsetWidth + 20
          : track.clientWidth * 0.75;
        track.scrollBy({ left: direction * step, behavior: "smooth" });
      }

      function startAutoPlay() {
        stopAutoPlay();
        autoTimer = setInterval(() => {
          scrollStep(1);
        }, 3200);
      }

      function stopAutoPlay() {
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }

      prevBtn?.addEventListener("click", () => {
        scrollStep(-1);
        startAutoPlay();
      });

      nextBtn?.addEventListener("click", () => {
        scrollStep(1);
        startAutoPlay();
      });

      // Mouse drag & touch drag support (smooth gesture without clicking buttons)
      let isDragging = false;
      let startX = 0;
      let startScrollLeft = 0;

      track.addEventListener("mousedown", (e) => {
        isDragging = true;
        stopAutoPlay();
        track.classList.remove("scroll-smooth");
        startX = e.pageX - track.offsetLeft;
        startScrollLeft = track.scrollLeft;
      });

      window.addEventListener("mouseup", () => {
        if (!isDragging) return;
        isDragging = false;
        track.classList.add("scroll-smooth");
        normalizePosition();
        startAutoPlay();
      });

      track.addEventListener("mousemove", (e) => {
        if (!isDragging) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.2;
        track.scrollLeft = startScrollLeft - walk;
      });

      track.addEventListener("mouseenter", stopAutoPlay);
      track.addEventListener("mouseleave", () => {
        if (!isDragging) startAutoPlay();
      });
      track.addEventListener("touchstart", stopAutoPlay, { passive: true });
      track.addEventListener("touchend", () => {
        normalizePosition();
        startAutoPlay();
      }, { passive: true });

      track.addEventListener(
        "scroll",
        () => {
          if (scrollTimeout) clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(normalizePosition, 160);
        },
        { passive: true },
      );

      window.addEventListener(
        "resize",
        () => {
          setInitialPosition();
        },
        { passive: true },
      );

      setInitialPosition();
      setTimeout(setInitialPosition, 100);
      startAutoPlay();
    }

    function initHomePage() {
      initHeroSlider();
      initTeacherSlider();
      initHomePartnerSlider();
      initAlumniSlider();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHomePage);
    } else {
      initHomePage();
    }
  </script>
</Layout>
