                }
                data-src={index > 0 ? slide.imageUrl : undefined}
                alt={slide.title}
                width="1920"
                height="1080"
                class="absolute inset-0 h-full w-full object-cover object-center"
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "low"}
