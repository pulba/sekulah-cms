// Helper membuat excerpt cuplikan untuk Beranda
function getExcerpt(text: string, maxLength: number = 240): string {
  if (!text) return "";
  const cleaned = text
    .replace(/^(Assalamu['’]alaikum[^\n]*\n+|Salam[^\n]*\n+)/i, "")
    .trim();
  const firstPara =
    cleaned.split("\n").filter((p) => p.trim().length > 0)[0] || cleaned;
  if (firstPara.length <= maxLength) return firstPara;
  return (
    firstPara
      .slice(0, maxLength)
      .trim()
      .replace(/[,\.\s]+$/, "") + "..."
  );
}

