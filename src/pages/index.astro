  .orderBy(desc(graduationTracerStats.graduationYear))
  .limit(1)
  .then((r) => r[0])
  .catch(() => null);

// Nilai default dan terminologi berbasis jenjang (SD / SMP / SMA / SMK)
const defaultTracerLabel = isSD
  ? "Lolos SMP Negeri Favorit"
  : isSMP
    ? "Lolos SMA/SMK Negeri"
    : isSMK
      ? "Terserap Kerja & Kuliah"
      : "Diterima PTN Favorit";

const defaultTracerDesc = isSD
  ? "Jalur Prestasi, Zonasi, dan Afirmasi SMP Negeri"
  : isSMP
    ? "Jalur Prestasi & Domisili SMA/SMK Negeri Favorit"
    : isSMK
      ? "Keterserapan Industri Mitra BKK dan Perguruan Tinggi"
      : "Jalur SNBP, SNBT, dan Talenta Mandiri";

const defaultTracerNotesSuffix = isSD
  ? "Jalur Prestasi & Zonasi SMP Negeri"
  : isSMP
    ? "Jalur Prestasi & Domisili SMA/SMK Negeri"
    : isSMK
      ? "Terserap Industri Mitra & PTN/PTS"
      : "Jalur SNBP, SNBT, dan Mandiri";

