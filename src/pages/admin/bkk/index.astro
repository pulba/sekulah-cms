---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import MediaPickerModal from "../../../components/MediaPickerModal.astro";
import Icon from "../../../components/Icon.astro";
import { db, bkkOpportunities, settings } from "../../../db";
import { asc, desc, eq, and, or, like, sql } from "drizzle-orm";

export const prerender = false;

// Cek tipe sekolah
const allSettings = await db.select().from(settings);
const settingMap = allSettings.reduce(
  (acc, curr) => {
    acc[curr.key] = curr.value;
    return acc;
  },
  {} as Record<string, string>,
);

const schoolType = (
  settingMap["school_type"] ||
  settingMap["school_level"] ||
  "SMA"
).toUpperCase();
const isSmk = schoolType === "SMK";

// Modul BKK & Kemitraan Industri hanya aktif untuk satuan pendidikan SMK
if (!isSmk) {
  return Astro.redirect("/admin");
}

// Query parameter filter & pagination
const currentType = Astro.url.searchParams.get("type") || "all";
const searchQuery = Astro.url.searchParams.get("q") || "";
const currentPage = Math.max(
  1,
  parseInt(Astro.url.searchParams.get("page") || "1", 10) || 1,
);
const pageSize = 10;

// Hitung total keseluruhan
const totalCount = await db
  .select({ count: sql<number>`count(*)` })
  .from(bkkOpportunities)
  .then((r) => Number(r[0]?.count || 0));

const lowonganCount = await db
  .select({ count: sql<number>`count(*)` })
  .from(bkkOpportunities)
  .where(eq(bkkOpportunities.type, "lowongan"))
  .then((r) => Number(r[0]?.count || 0));

const magangCount = await db
  .select({ count: sql<number>`count(*)` })
  .from(bkkOpportunities)
  .where(eq(bkkOpportunities.type, "magang"))
  .then((r) => Number(r[0]?.count || 0));

const mouCount = await db
  .select({ count: sql<number>`count(*)` })
  .from(bkkOpportunities)
  .where(eq(bkkOpportunities.type, "mitra_mou"))
  .then((r) => Number(r[0]?.count || 0));

// Filter conditions
const conditions: any[] = [];
if (currentType && currentType !== "all") {
  conditions.push(eq(bkkOpportunities.type, currentType as any));
}

if (searchQuery) {
  const queryPattern = `%${searchQuery.trim()}%`;
  conditions.push(
    or(
      like(bkkOpportunities.title, queryPattern),
      like(bkkOpportunities.companyName, queryPattern),
      like(bkkOpportunities.location, queryPattern),
      like(bkkOpportunities.requirements, queryPattern),
    ),
  );
}

const whereClause = conditions.length > 0 ? and(...conditions) : undefined;

const totalFiltered = await db
  .select({ count: sql<number>`count(*)` })
  .from(bkkOpportunities)
  .where(whereClause)
  .then((r) => Number(r[0]?.count || 0));

const totalPages = Math.max(1, Math.ceil(totalFiltered / pageSize));
const validPage = Math.min(currentPage, totalPages);
const offset = (validPage - 1) * pageSize;

const bkkList = await db
  .select()
  .from(bkkOpportunities)
  .where(whereClause)
  .orderBy(asc(bkkOpportunities.orderNumber), desc(bkkOpportunities.id))
  .limit(pageSize)
  .offset(offset);

function getPageUrl(p: number) {
  const params = new URLSearchParams();
  if (currentType && currentType !== "all") params.set("type", currentType);
  if (searchQuery) params.set("q", searchQuery);
  if (p > 1) params.set("page", String(p));
  const qs = params.toString();
  return `/admin/bkk${qs ? `?${qs}` : ""}`;
}
---

<AdminLayout
  title="BKK & Kemitraan Industri"
  activeNav="bkk"
  settingsMap={settingMap}
>
  <div class="space-y-6">
    <!-- Header Halaman -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6">
      <div>
        <div class="flex items-center gap-2.5">
          <h1 class="font-display text-xl font-bold tracking-tight text-heading">
            Bursa Kerja Khusus (BKK) & Mitra Industri
          </h1>
        </div>
        <p class="font-body text-xs text-muted mt-1">
          Kelola informasi lowongan kerja, program magang/PKL, dan kemitraan industri DUDI.
        </p>
      </div>

      <div class="flex items-center gap-2.5 shrink-0">
        <a
          href="/bkk"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-[38px] items-center justify-center gap-1.5 rounded-[6px] border border-border bg-surface px-3.5 font-body text-xs font-semibold text-heading transition-colors hover:bg-surface-subtle shadow-xs"
        >
          <svg
            class="h-3.5 w-3.5 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
          <span>Halaman Publik</span>
        </a>

        <button
          type="button"
          id="btn-add-bkk"
          class="inline-flex h-[38px] items-center justify-center gap-2 rounded-[6px] bg-primary px-4 font-body text-sm font-medium text-white transition-all duration-200 hover:-translate-y-[1px] hover:bg-primary-hover shadow-xs cursor-pointer"
        >
          <Icon name="plus" class="h-4 w-4" />
          <span>Peluang Baru</span>
        </button>
      </div>
    </div>

    <!-- Ringkasan Statistik (Pola B Solid Multi-Color KPI - Editorial Precision) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 *:p-4 *:rounded-[10px] *:border *:shadow-2xs">
      <div class="bg-primary border-primary text-primary-foreground">
        <span class="block font-body text-xs font-semibold text-primary-foreground">
          Total Peluang
        </span>
        <div class="mt-1 flex items-baseline gap-2">
          <span class="font-display text-2xl font-bold text-primary-foreground">
            {totalCount}
          </span>
          <span class="font-body text-xs text-primary-foreground/80">
            data terdata
          </span>
        </div>
      </div>

      <div class="bg-success border-success text-white">
        <span class="block font-body text-xs font-semibold text-white">
          Lowongan Kerja
        </span>
        <div class="mt-1 flex items-baseline gap-2">
          <span class="font-display text-2xl font-bold text-white">
            {lowonganCount}
          </span>
          <span class="font-body text-xs text-white/80">posisi loker</span>
        </div>
      </div>

      <div class="bg-secondary border-secondary text-secondary-foreground">
        <span class="block font-body text-xs font-semibold text-secondary-foreground">
          Program Magang / PKL
        </span>
        <div class="mt-1 flex items-baseline gap-2">
          <span class="font-display text-2xl font-bold text-secondary-foreground">
            {magangCount}
          </span>
          <span class="font-body text-xs text-secondary-foreground/80">
            kuota posisi
          </span>
        </div>
      </div>

      <div class="bg-warning border-warning text-white">
        <span class="block font-body text-xs font-semibold text-white">
          Mitra Industri (MoU Aktif)
        </span>
        <div class="mt-1 flex items-baseline gap-2">
          <span class="font-display text-2xl font-bold text-white">
            {mouCount}
          </span>
          <span class="font-body text-xs text-white/80">perusahaan mitra</span>
        </div>
      </div>
    </div>

    <!-- Filter Tab & Pencarian -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pt-1">
      <div
        class="inline-flex bg-surface-subtle *:px-2.5 *:py-1 *:text-[11px] *:cursor-pointer *:transition-colors *:first:rounded-l-[4px] *:last:rounded-r-[4px]"
        role="tablist"
        aria-label="Filter tipe peluang BKK"
      >
        <a
          href="/admin/bkk"
          role="tab"
          aria-selected={currentType === "all" ? "true" : "false"}
          class:list={[
            currentType === "all"
              ? "bg-primary font-semibold text-white"
              : "font-medium text-muted hover:text-heading",
          ]}
        >
          Semua ({totalCount})
        </a>
        <a
          href="/admin/bkk?type=lowongan"
          role="tab"
          aria-selected={currentType === "lowongan" ? "true" : "false"}
          class:list={[
            currentType === "lowongan"
              ? "bg-primary font-semibold text-white"
              : "font-medium text-muted hover:text-heading",
          ]}
        >
          Lowongan Kerja ({lowonganCount})
        </a>
        <a
          href="/admin/bkk?type=magang"
          role="tab"
          aria-selected={currentType === "magang" ? "true" : "false"}
          class:list={[
            currentType === "magang"
              ? "bg-primary font-semibold text-white"
              : "font-medium text-muted hover:text-heading",
          ]}
        >
          Program Magang ({magangCount})
        </a>
        <a
          href="/admin/bkk?type=mitra_mou"
          role="tab"
          aria-selected={currentType === "mitra_mou" ? "true" : "false"}
          class:list={[
            currentType === "mitra_mou"
              ? "bg-primary font-semibold text-white"
              : "font-medium text-muted hover:text-heading",
          ]}
        >
          Mitra MoU ({mouCount})
        </a>
      </div>

      <form method="GET" action="/admin/bkk" class="relative w-full md:w-64">
        {currentType !== "all" && (
          <input type="hidden" name="type" value={currentType} />
        )}
        <input
          type="text"
          name="q"
          value={searchQuery}
          placeholder="Cari posisi, mitra industri..."
          class="h-[36px] w-full rounded-[6px] border border-border bg-surface pl-8 pr-3 font-body text-xs text-heading placeholder:text-muted/60"
        />
        <Icon
          name="search"
          class="pointer-events-none absolute left-2.5 top-2.5 h-3.5 w-3.5 text-muted"
        />
      </form>
    </div>

    <!-- Tabel Data BKK -->
    <div class="rounded-[10px] border border-border bg-surface overflow-hidden shadow-hairline">
      <div class="overflow-x-auto">
        <table class="w-full text-left font-body text-xs">
          <thead class="border-b border-border bg-surface-subtle text-[11px] font-semibold uppercase tracking-wider text-muted">
            <tr>
              <th class="px-4 py-3 w-12">Logo</th>
              <th class="px-4 py-3">Peluang / Posisi</th>
              <th class="px-4 py-3">Mitra Industri</th>
              <th class="px-4 py-3">Tipe</th>
              <th class="px-4 py-3">Lokasi / Gaji</th>
              <th class="px-4 py-3">Tenggat</th>
              <th class="px-4 py-3 text-center w-20">Tampil</th>
              <th class="px-4 py-3 text-right w-24">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border text-body">
            {bkkList.length === 0 ? (
              <tr>
                <td colspan="8" class="px-4 py-12 text-center text-muted">
                  <div class="mx-auto max-w-xs space-y-2">
                    <p class="font-semibold text-heading">
                      Belum ada peluang BKK terdata
                    </p>
                    <p class="text-[11px]">
                      Silakan klik tombol "Tambah Peluang Baru" untuk
                      mempublikasikan lowongan kerja atau kemitraan industri.
                    </p>
                  </div>
                </td>
              </tr>
            ) : (
              bkkList.map((item) => (
                <tr class="hover:bg-surface-subtle transition-colors">
                  <td class="px-4 py-3">
                    <div class="h-9 w-9 rounded-[6px] border border-border bg-surface-subtle flex items-center justify-center overflow-hidden shrink-0 shadow-xs">
                      {item.companyLogo ? (
                        <img
                          src={item.companyLogo}
                          alt={item.companyName}
                          class="h-full w-full object-contain p-1"
                        />
                      ) : (
                        <span class="font-display font-bold text-xs text-primary">
                          {item.companyName.trim().charAt(0).toUpperCase()}
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="px-4 py-3 font-semibold text-heading">
                    <div class="text-xs">{item.title}</div>
                    {item.quota && (
                      <span class="text-[10px] text-muted font-normal">
                        Kuota: {item.quota}
                      </span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-heading font-medium">
                    {item.companyName}
                  </td>
                  <td class="px-4 py-3">
                    <span
                      class:list={[
                        "inline-block rounded-[4px] px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider",
                        item.type === "lowongan"
                          ? "bg-success text-white"
                          : item.type === "magang"
                            ? "bg-primary text-primary-foreground"
                            : "bg-warning text-white",
                      ]}
                    >
                      {item.type === "lowongan"
                        ? "Lowongan"
                        : item.type === "magang"
                          ? "Magang / PKL"
                          : "Mitra DUDI"}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-muted">
                    <div>{item.location}</div>
                    {item.salaryRange && (
                      <div class="text-[11px] text-heading font-mono mt-0.5">
                        {item.salaryRange}
                      </div>
                    )}
                  </td>
                  <td class="px-4 py-3 font-mono text-[11px] text-muted">
                    {item.deadline || "Terbuka"}
                  </td>
                  <td class="px-4 py-3 text-center whitespace-nowrap">
                    <button
                      type="button"
                      role="switch"
                      aria-checked={item.isActive ? "true" : "false"}
                      class:list={[
                        "btn-toggle-active relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-hidden",
                        item.isActive ? "bg-primary" : "bg-border",
                      ]}
                      data-id={item.id}
                      data-title={item.title}
                      data-active={item.isActive ? "true" : "false"}
                      title={
                        item.isActive
                          ? "Aktif (Klik untuk nonaktifkan)"
                          : "Nonaktif (Klik untuk aktifkan)"
                      }
                      aria-label={`Status publikasi ${item.title}`}
                    >
                      <span class="sr-only">
                        {item.isActive ? "Aktif" : "Nonaktif"}
                      </span>
                      <span
                        aria-hidden="true"
                        class:list={[
                          "pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow-xs ring-0 transition duration-200 ease-in-out",
                          item.isActive ? "translate-x-4" : "translate-x-0",
                        ]}
                      />
                    </button>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <div class="inline-flex items-center gap-1.5 justify-end">
                      <button
                        type="button"
                        class="btn-edit-bkk inline-flex h-7 w-7 items-center justify-center rounded-[6px] bg-primary text-white hover:bg-primary-hover transition-colors shadow-xs cursor-pointer"
                        data-item={JSON.stringify(item)}
                        title="Edit Peluang Ini"
                      >
                        <svg
                          class="h-3.5 w-3.5"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                          />
                        </svg>
                      </button>
                      <button
                        type="button"
                        class="btn-delete-bkk inline-flex h-7 w-7 items-center justify-center rounded-[6px] bg-error text-white hover:bg-error-hover transition-colors shadow-xs cursor-pointer"
                        data-id={item.id}
                        data-title={item.title}
                        title="Hapus Peluang Ini"
                      >
                        <svg
                          class="h-3.5 w-3.5"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                          />
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      {totalPages > 1 && (
        <div class="border-t border-border px-4 py-3 flex items-center justify-between text-xs text-muted">
          <span>
            Halaman {validPage} dari {totalPages} ({totalFiltered} total data)
          </span>
          <div class="flex items-center gap-1.5">
            {validPage > 1 && (
              <a
                href={getPageUrl(validPage - 1)}
                class="rounded-[4px] border border-border px-2.5 py-1 hover:bg-surface-subtle text-heading font-medium"
              >
                &larr; Sebelumnya
              </a>
            )}
            {validPage < totalPages && (
              <a
                href={getPageUrl(validPage + 1)}
                class="rounded-[4px] border border-border px-2.5 py-1 hover:bg-surface-subtle text-heading font-medium"
              >
                Selanjutnya &rarr;
              </a>
            )}
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Modal Tambah / Edit Peluang BKK -->
  <div
    id="modal-bkk"
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4"
  >
    <div class="w-full max-w-xl rounded-[12px] border border-border bg-surface p-3 sm:p-4 shadow-2xl space-y-5 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-1">
        <div>
          <h3
            id="modal-bkk-title"
            class="font-display text-base font-bold text-heading"
          >
            Tambah Peluang BKK Baru
          </h3>
          <p class="font-body text-[11px] text-muted">
            Mendukung loker, magang industri, dan MoU DUDI.
          </p>
        </div>
        <button
          type="button"
          id="btn-close-modal"
          class="text-muted hover:text-heading cursor-pointer text-xl leading-none"
        >
          &times;
        </button>
      </div>

      <form id="form-bkk" class="space-y-4 text-[10px] sm:text-xs font-body">
        <input type="hidden" id="bkk-id" value="" />

        <div class="grid grid-cols-2 sm:grid-cols-2 gap-2">
          <div class="sm:col-span-2">
            <label class="block font-semibold text-heading mb-1">
              Judul / Posisi / Program Kerjasama{" "}
              <span class="text-error">*</span>
            </label>
            <input
              type="text"
              id="bkk-title-input"
              required
              placeholder="Contoh: Teknisi Jaringan & Cloud Junior"
              class="h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 text-heading"
            />
          </div>

          <div>
            <label class="block font-semibold text-heading mb-1">
              Nama Mitra Industri (DUDI) <span class="text-error">*</span>
            </label>
            <input
              type="text"
              id="bkk-company-input"
              required
              placeholder="Contoh: PT Telkom Akses / Astra Honda"
              class="h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 text-heading"
            />
          </div>

          <div>
            <label class="block font-semibold text-heading mb-1">
              Tipe Peluang <span class="text-error">*</span>
            </label>
            <select
              id="bkk-type-input"
              class="h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 text-heading"
            >
              <option value="lowongan">Lowongan Kerja (Alumni)</option>
              <option value="magang">Program Magang / PKL (Siswa Aktif)</option>
              <option value="mitra_mou">Kemitraan Industri (MoU Resmi)</option>
            </select>
          </div>

          <div>
            <label class="block font-semibold text-heading mb-1">
              Lokasi Penempatan / Kampus <span class="text-error">*</span>
            </label>
            <input
              type="text"
              id="bkk-location-input"
              required
              placeholder="Contoh: Kawasan Industri Cikarang / Depok, Jawa Barat"
              class="h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 text-heading"
            />
          </div>

          <div>
            <label class="block font-semibold text-heading mb-1">
              Rentang Gaji / Uang Saku / No. MoU
            </label>
            <input
              type="text"
              id="bkk-salary-input"
              placeholder="Contoh: Rp 4.500.000 / MoU No. 421/2026"
              class="h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 text-heading"
            />
          </div>

          <div>
            <label class="block font-semibold text-heading mb-1">
              Batas Akhir / Masa Berlaku
            </label>
            <input
              type="date"
              id="bkk-deadline-input"
              class="h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 text-heading"
            />
          </div>

          <div>
            <label class="block font-semibold text-heading mb-1">
              Kuota Penerimaan / Status
            </label>
            <input
              type="text"
              id="bkk-quota-input"
              placeholder="Contoh: 15 Orang / MoU Aktif (5 Tahun)"
              class="h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 text-heading"
            />
          </div>
        </div>

        <div>
          <label class="block font-semibold text-heading mb-1">
            Persyaratan & Ruang Lingkup Kerjasama{" "}
            <span class="text-error">*</span>
          </label>
          <textarea
            id="bkk-requirements-input"
            rows="3"
            required
            placeholder="Kualifikasi jurusan, ruang lingkup MoU kelas industri/studi lanjut, keahlian khusus..."
            class="w-full rounded-[6px] border border-border bg-surface p-2.5 text-heading leading-relaxed"
          ></textarea>
        </div>

        <div class="grid grid-cols-1 gap-3.5">
          <div>
            <label class="block font-semibold text-heading mb-1">
              Kontak / Tautan Pendaftaran / Website
            </label>
            <input
              type="text"
              id="bkk-contact-input"
              placeholder="Nomor WA BKK, link pendaftaran, atau email"
              class="h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 text-heading"
            />
          </div>

          <div>
            <label class="block font-semibold text-heading mb-1">
              Logo Mitra / Kampus (Pustaka Media)
            </label>
            <div class="flex items-center gap-2">
              <div class="h-[38px] w-[38px] rounded-[6px] border border-border bg-surface flex items-center justify-center overflow-hidden shrink-0">
                <img
                  id="preview-bkk-logo"
                  src="/favicon.ico"
                  class="h-full w-full object-contain p-1"
                  onerror="this.src='/favicon.ico'"
                />
              </div>
              <input
                type="text"
                id="bkk-logo-input"
                placeholder="/uploads/... (Logo Mitra / Kampus)"
                class="h-[38px] flex-1 rounded-[6px] border border-border bg-surface px-3 text-heading"
              />
              <button
                type="button"
                id="btn-pick-bkk-logo"
                class="h-[38px] px-3 rounded-[6px] border border-border bg-surface hover:bg-surface-subtle font-medium text-heading shrink-0 cursor-pointer"
              >
                Pilih
              </button>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2.5 pt-4">
          <button
            type="button"
            id="btn-cancel-modal"
            class="inline-flex h-8 items-center justify-center rounded-[6px] border border-border bg-surface px-3.5 text-heading hover:bg-surface-subtle transition-colors cursor-pointer"
          >
            Batal
          </button>
          <button
            type="submit"
            id="btn-save-bkk"
            class="inline-flex h-8 items-center justify-center rounded-[6px] bg-primary px-4 font-medium text-white hover:bg-primary-hover transition-colors shadow-xs cursor-pointer"
          >
            Simpan Peluang
          </button>
        </div>
      </form>
    </div>
  </div>

  <MediaPickerModal />

  <script is:inline>
    function initBkk() {
      const modal = document.getElementById("modal-bkk");
      const modalTitle = document.getElementById("modal-bkk-title");
      const form = document.getElementById("form-bkk");
      const btnAdd = document.getElementById("btn-add-bkk");
      const btnClose = document.getElementById("btn-close-modal");
      const btnCancel = document.getElementById("btn-cancel-modal");

      const idInput = document.getElementById("bkk-id");
      const titleInput = document.getElementById("bkk-title-input");
      const companyInput = document.getElementById("bkk-company-input");
      const typeInput = document.getElementById("bkk-type-input");
      const locationInput = document.getElementById("bkk-location-input");
      const salaryInput = document.getElementById("bkk-salary-input");
      const deadlineInput = document.getElementById("bkk-deadline-input");
      const quotaInput = document.getElementById("bkk-quota-input");
      const requirementsInput = document.getElementById(
        "bkk-requirements-input",
      );
      const contactInput = document.getElementById("bkk-contact-input");
      const logoInput = document.getElementById("bkk-logo-input");
      const previewLogo = document.getElementById("preview-bkk-logo");
      const btnPickLogo = document.getElementById("btn-pick-bkk-logo");

      function updateLogoPreview(url) {
        if (previewLogo) {
          previewLogo.src = url ? url.trim() : "/favicon.ico";
        }
      }

      logoInput?.addEventListener("input", () => {
        updateLogoPreview(logoInput.value);
      });

      function openModal(item = null) {
        if (item) {
          modalTitle.innerText = "Edit Peluang BKK";
          idInput.value = item.id;
          titleInput.value = item.title || "";
          companyInput.value = item.companyName || "";
          typeInput.value = item.type || "lowongan";
          locationInput.value = item.location || "";
          salaryInput.value = item.salaryRange || "";
          deadlineInput.value = item.deadline || "";
          quotaInput.value = item.quota || "";
          requirementsInput.value = item.requirements || "";
          contactInput.value = item.contactPerson || "";
          logoInput.value = item.companyLogo || "";
          updateLogoPreview(item.companyLogo);
        } else {
          modalTitle.innerText = "Tambah Peluang BKK Baru";
          form.reset();
          idInput.value = "";
          updateLogoPreview("");
        }
        modal?.classList.remove("hidden");
      }

      function closeModal() {
        modal?.classList.add("hidden");
      }

      btnAdd?.addEventListener("click", () => openModal(null));
      btnClose?.addEventListener("click", closeModal);
      btnCancel?.addEventListener("click", closeModal);

      // Edit buttons
      document.querySelectorAll(".btn-edit-bkk").forEach((btn) => {
        btn.addEventListener("click", () => {
          try {
            const data = JSON.parse(btn.getAttribute("data-item") || "{}");
            openModal(data);
          } catch (e) {}
        });
      });

      // Toggle active status
      document.querySelectorAll(".btn-toggle-active").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.getAttribute("data-id");
          const title = btn.getAttribute("data-title") || "Peluang BKK";
          const isCurrentlyActive = btn.getAttribute("data-active") === "true";
          if (!id) return;

          btn.disabled = true;
          try {
            const res = await fetch(`/api/admin/bkk/${id}/toggle`, {
              method: "PUT",
            });
            const data = await res.json();
            if (data.success) {
              const nextActive = !isCurrentlyActive;
              btn.setAttribute("data-active", String(nextActive));
              btn.setAttribute("aria-checked", String(nextActive));
              btn.className = `btn-toggle-active relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-hidden ${nextActive ? "bg-primary" : "bg-border"}`;
              btn.setAttribute(
                "title",
                nextActive
                  ? "Aktif (Klik untuk nonaktifkan)"
                  : "Nonaktif (Klik untuk aktifkan)",
              );
              const thumb = btn.querySelector('span[aria-hidden="true"]');
              if (thumb) {
                thumb.className = `pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow-xs ring-0 transition duration-200 ease-in-out ${nextActive ? "translate-x-4" : "translate-x-0"}`;
              }
              if (typeof window.showToast === "function") {
                window.showToast(
                  `Status "${title}" berhasil diubah menjadi ${nextActive ? "Aktif" : "Nonaktif"}.`,
                  "success",
                );
              }
            } else {
              if (typeof window.showToast === "function") {
                window.showToast(
                  data.error || "Gagal mengubah status",
                  "error",
                );
              }
            }
          } catch {
            if (typeof window.showToast === "function") {
              window.showToast(
                "Gangguan jaringan saat mengubah status",
                "error",
              );
            }
          } finally {
            btn.disabled = false;
          }
        });
      });

      // Delete buttons
      document.querySelectorAll(".btn-delete-bkk").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.getAttribute("data-id");
          const title = btn.getAttribute("data-title");
          if (!id) return;

          const confirmed = await window.confirmDialog({
            title: "Hapus Peluang BKK",
            message: `Apakah Anda yakin ingin menghapus peluang "${title}"?\nTindakan ini tidak dapat dibatalkan.`,
            confirmText: "Ya, Hapus",
            cancelText: "Batal",
            type: "danger",
          });
          if (!confirmed) return;

          try {
            const res = await fetch(`/api/admin/bkk/${id}`, {
              method: "DELETE",
            });
            const data = await res.json();
            if (data.success) {
              window.showToast("Peluang BKK berhasil dihapus.", "success");
              setTimeout(() => window.location.reload(), 400);
            } else {
              window.showToast(data.error || "Gagal menghapus", "error");
            }
          } catch {
            window.showToast("Kesalahan jaringan", "error");
          }
        });
      });

      // Media Picker logo
      btnPickLogo?.addEventListener("click", () => {
        if (typeof window.openMediaPicker === "function") {
          window.openMediaPicker(
            (item) => {
              const url =
                item.fileUrl || item.mediumUrl || item.thumbnailUrl || item.url;
              if (url && logoInput) {
                logoInput.value = url;
                updateLogoPreview(url);
              }
            },
            { type: "image" },
          );
        }
      });

      // Form Submit
      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const id = idInput.value;
        const payload = {
          title: titleInput.value,
          companyName: companyInput.value,
          type: typeInput.value,
          location: locationInput.value,
          salaryRange: salaryInput.value,
          deadline: deadlineInput.value,
          quota: quotaInput.value,
          requirements: requirementsInput.value,
          contactPerson: contactInput.value,
          companyLogo: logoInput.value,
        };

        try {
          const url = id ? `/api/admin/bkk/${id}` : "/api/admin/bkk";
          const method = id ? "PUT" : "POST";

          const res = await fetch(url, {
            method,
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (data.success) {
            window.location.reload();
          } else {
            alert(data.error || "Gagal menyimpan data BKK");
          }
        } catch {
          alert("Terjadi kesalahan jaringan saat menyimpan data");
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initBkk);
    } else {
      initBkk();
    }
  </script>
</AdminLayout>
