              aria-label="Tutup"
            >
              <Icon name="close" class="h-4 w-4" />
            </button>
          </div>

          <!-- Body (Scrollable) -->
          <form
            id="form-enrollment"
            class="flex flex-col flex-1 min-h-0 overflow-hidden"
          >
            <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4 space-y-3.5">
              <input type="hidden" id="enrollment-id" />

              <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1">
                  <label
                    for="enrollment-year"
                    class="block font-body text-xs font-semibold text-heading"
                  >
                    Tahun Ajaran <span class="text-error">*</span>
                  </label>
                  <input
                    type="text"
                    id="enrollment-year"
                    required
                    class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading font-mono focus:border-primary focus:outline-none transition-colors"
                    placeholder="Contoh: 2026/2027"
                  />
                </div>
                <div class="space-y-1">
                  <label
                    for="enrollment-total"
                    class="block font-body text-xs font-semibold text-heading"
                  >
                    Total Siswa Aktif <span class="text-error">*</span>
                  </label>
                  <input
                    type="number"
                    id="enrollment-total"
                    required
                    min="1"
                    class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading font-mono focus:border-primary focus:outline-none transition-colors"
                    placeholder="1250"
                  />
                </div>
              </div>

              <div class="grid grid-cols-3 gap-2">
                <div class="space-y-1">
                  <label
                    for="enrollment-male"
                    class="block font-body text-xs font-semibold text-heading"
                  >
                    Laki-laki (L)
                  </label>
                  <input
                    type="number"
                    id="enrollment-male"
                    min="0"
                    class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading font-mono focus:border-primary focus:outline-none transition-colors"
                    placeholder="610"
                  />
                </div>
                <div class="space-y-1">
                  <label
                    for="enrollment-female"
                    class="block font-body text-xs font-semibold text-heading"
                  >
                    Perempuan (P)
                  </label>
                  <input
                    type="number"
                    id="enrollment-female"
                    min="0"
                    class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading font-mono focus:border-primary focus:outline-none transition-colors"
                    placeholder="640"
                  />
                </div>
                <div class="space-y-1">
                  <label
                    for="enrollment-rombel"
                    class="block font-body text-xs font-semibold text-heading"
                  >
                    Rombel
                  </label>
                  <input
                    type="number"
                    id="enrollment-rombel"
                    min="0"
                    class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading font-mono focus:border-primary focus:outline-none transition-colors"
                    placeholder="36"
                  />
                </div>
              </div>

              <div class="space-y-1">
                <label
                  for="enrollment-source"
                  class="block font-body text-xs font-semibold text-heading"
                >
                  Sumber Data / Cut-Off
                </label>
                <input
                  type="text"
                  id="enrollment-source"
                  class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading focus:border-primary focus:outline-none transition-colors"
                  placeholder="Dapodik Kemendikdasmen Cut-Off 31 Agustus"
                />
              </div>

              <div class="pt-1 flex items-center gap-2">
                <input
                  type="checkbox"
                  id="enrollment-active"
                  class="h-4 w-4 rounded border-border text-primary focus:ring-0 cursor-pointer"
                />
                <label
                  for="enrollment-active"
                  class="font-body text-xs font-medium text-heading cursor-pointer"
                >
                  Jadikan rujukan utama jumlah siswa aktif di beranda
                </label>
              </div>
            </div>

            <!-- Footer (Sticky) -->
            <div class="flex items-center justify-end gap-2 px-5 py-3.5 bg-surface-subtle shrink-0 border-t border-border">
              <button
                type="button"
                class="btn-close-enrollment-modal inline-flex h-[34px] items-center justify-center rounded-[6px] border border-border bg-surface px-4 font-body text-xs font-medium text-heading hover:bg-surface-subtle transition-colors cursor-pointer"
              >
                Batal
              </button>
              <button
                type="submit"
                id="btn-submit-enrollment"
                class="inline-flex h-[34px] items-center justify-center rounded-[6px] bg-primary px-4 font-body text-xs font-semibold text-white transition-all hover:bg-primary-hover shadow-xs cursor-pointer"
              >
                Simpan Rekap
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- MODAL 2: REKAP TRACER LULUSAN -->
    <div
      id="modal-tracer"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-tracer-title"
      class="fixed inset-0 z-50 hidden overflow-y-auto bg-heading/60 backdrop-blur-xs p-4 sm:p-6"
    >
      <div class="flex min-h-full items-center justify-center">
        <div class="w-full max-w-md max-h-[90dvh] flex flex-col rounded-[12px] border border-border bg-surface shadow-2xl overflow-hidden">
          <!-- Header (Sticky) -->
          <div class="flex items-center justify-between px-5 py-4 bg-surface shrink-0 border-b border-border">
            <div class="flex items-center gap-2.5">
              <h3
                id="modal-tracer-title"
                class="font-display text-sm sm:text-base font-bold text-heading"
              >
                Tambah Rekap Angkatan Kelulusan
              </h3>
            </div>
            <button
              type="button"
              class="btn-close-tracer-modal text-muted hover:text-heading p-1.5 rounded-[6px] hover:bg-surface-subtle transition-colors cursor-pointer"
              title="Tutup"
              aria-label="Tutup"
            >
              <Icon name="close" class="h-4 w-4" />
            </button>
          </div>

          <!-- Body (Scrollable) -->
          <form
            id="form-tracer"
            class="flex flex-col flex-1 min-h-0 overflow-hidden"
          >
            <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4 space-y-3.5">
              <input type="hidden" id="tracer-id" />

              <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1">
                  <label
                    for="tracer-year"
                    class="block font-body text-xs font-semibold text-heading"
                  >
                    Tahun Kelulusan <span class="text-error">*</span>
                  </label>
                  <input
                    type="text"
                    id="tracer-year"
                    required
                    class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading font-mono focus:border-primary focus:outline-none transition-colors"
                    placeholder="Contoh: 2025"
                  />
                </div>
                <div class="space-y-1">
                  <label
                    for="tracer-total"
                    class="block font-body text-xs font-semibold text-heading"
                  >
                    Total Lulusan <span class="text-error">*</span>
                  </label>
                  <input
                    type="number"
                    id="tracer-total"
                    required
                    min="1"
                    class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading font-mono focus:border-primary focus:outline-none transition-colors"
                    placeholder="Contoh: 200"
                  />
                </div>
              </div>

              <div class="grid grid-cols-3 gap-2">
                <div class="space-y-1">
                  <label
                    for="tracer-ptn"
                    class="block font-body text-xs font-semibold text-heading"
                  >
                    {tracerTerms.primaryShort} <span class="text-error">*</span>
                  </label>
                  <input
                    type="number"
                    id="tracer-ptn"
                    required
                    min="0"
                    class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading font-mono focus:border-primary focus:outline-none transition-colors"
                    placeholder="176"
                  />
                </div>
                <div class="space-y-1">
                  <label
                    for="tracer-pts"
                    class="block font-body text-xs font-semibold text-heading"
                  >
                    {tracerTerms.secondaryShort}
                  </label>
                  <input
                    type="number"
                    id="tracer-pts"
                    min="0"
                    class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading font-mono focus:border-primary focus:outline-none transition-colors"
                    placeholder="14"
                  />
                </div>
                <div class="space-y-1">
                  <label
                    for="tracer-work"
                    class="block font-body text-xs font-semibold text-heading"
                  >
                    {tracerTerms.tertiaryShort}
                  </label>
                  <input
                    type="number"
                    id="tracer-work"
                    min="0"
                    class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading font-mono focus:border-primary focus:outline-none transition-colors"
                    placeholder="10"
                  />
                </div>
              </div>

              <div class="space-y-1">
                <label
                  for="tracer-notes"
                  class="block font-body text-xs font-semibold text-heading"
                >
                  {tracerTerms.notesLabel}
                </label>
                <input
                  type="text"
                  id="tracer-notes"
                  class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading focus:border-primary focus:outline-none transition-colors"
                  placeholder={tracerTerms.notesPlaceholder}
                />
              </div>

              <div class="pt-1 flex items-center gap-2">
                <input
                  type="checkbox"
                  id="tracer-active"
                  class="h-4 w-4 rounded border-border text-primary focus:ring-0 cursor-pointer"
                />
                <label
                  for="tracer-active"
                  class="font-body text-xs font-medium text-heading cursor-pointer"
                >
                  Jadikan rujukan utama persentase PTN di beranda
                </label>
              </div>
            </div>

            <!-- Footer (Sticky) -->
            <div class="flex items-center justify-end gap-2 px-5 py-3.5 bg-surface-subtle shrink-0 border-t border-border">
              <button
                type="button"
                class="btn-close-tracer-modal inline-flex h-[34px] items-center justify-center rounded-[6px] border border-border bg-surface px-4 font-body text-xs font-medium text-heading hover:bg-surface-subtle transition-colors cursor-pointer"
              >
                Batal
              </button>
              <button
                type="submit"
                id="btn-submit-tracer"
                class="inline-flex h-[34px] items-center justify-center rounded-[6px] bg-primary px-4 font-body text-xs font-semibold text-white transition-all hover:bg-primary-hover shadow-xs cursor-pointer"
              >
                Simpan Rekap
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Client Script -->
  <script is:inline>
    function initKesiswaanPage() {
      // 1. Tab Switcher
      const tabEnrollment = document.getElementById("tab-btn-enrollment");
      const tabTracer = document.getElementById("tab-btn-tracer");
      const paneEnrollment = document.getElementById("pane-enrollment");
      const paneTracer = document.getElementById("pane-tracer");
      const banner = document.getElementById("status-banner");

      function showBanner(msg, type = "success") {
        if (window.showToast) {
          window.showToast(msg, type);
        }
        if (!banner) return;
        banner.className =
          type === "success"
            ? "rounded-lg border border-success bg-success-light p-3.5 text-xs text-success-text font-medium block"
            : "rounded-lg border border-error bg-error-light p-3.5 text-xs text-error font-medium block";
        banner.textContent = msg;
        window.scrollTo({ top: 0, behavior: "smooth" });
        setTimeout(() => banner.classList.add("hidden"), 5000);
      }

      const tabs = [
        { btn: tabEnrollment, pane: paneEnrollment },
        { btn: tabTracer, pane: paneTracer },
      ];

      function switchTab(targetIndex) {
        tabs.forEach((t, i) => {
          if (i === targetIndex) {
            t.btn?.setAttribute(
              "class",
              "main-tab-btn border-b-2 border-primary font-bold text-primary flex items-center gap-2 py-3 px-3 text-xs cursor-pointer transition-colors whitespace-nowrap",
            );
            t.pane?.classList.remove("hidden");
          } else {
            t.btn?.setAttribute(
              "class",
              "main-tab-btn border-b-2 border-transparent font-medium text-muted hover:text-heading flex items-center gap-2 py-3 px-3 text-xs cursor-pointer transition-colors whitespace-nowrap",
            );
            t.pane?.classList.add("hidden");
          }
        });

        // Toggle action buttons di header sesuai tab aktif
        const btnAddEnrollment = document.getElementById("btn-add-enrollment");
        const btnAddTracer = document.getElementById("btn-add-tracer");
        if (targetIndex === 1) {
          btnAddEnrollment?.classList.add("hidden");
          btnAddTracer?.classList.remove("hidden");
        } else {
          btnAddEnrollment?.classList.remove("hidden");
          btnAddTracer?.classList.add("hidden");
        }
      }

      tabs.forEach((t, i) => {
        t.btn?.addEventListener("click", () => switchTab(i));
      });

      // 2. Enrollment Modal & Form Handlers
      const modalEnrollment = document.getElementById("modal-enrollment");
      const formEnrollment = document.getElementById("form-enrollment");
      const enrollmentIdInput = document.getElementById("enrollment-id");
      const enrollmentYearInput = document.getElementById("enrollment-year");
      const enrollmentTotalInput = document.getElementById("enrollment-total");
      const enrollmentMaleInput = document.getElementById("enrollment-male");
      const enrollmentFemaleInput =
        document.getElementById("enrollment-female");
      const enrollmentRombelInput =
        document.getElementById("enrollment-rombel");
      const enrollmentSourceInput =
        document.getElementById("enrollment-source");
      const enrollmentActiveInput =
        document.getElementById("enrollment-active");
      const modalEnrollmentTitle = document.getElementById(
        "modal-enrollment-title",
      );

      function openEnrollmentModal() {
        modalEnrollment?.classList.remove("hidden");
      }
      function closeEnrollmentModal() {
        modalEnrollment?.classList.add("hidden");
      }

      document
        .getElementById("btn-add-enrollment")
        ?.addEventListener("click", () => {
          enrollmentIdInput.value = "";
          formEnrollment?.reset();
          if (enrollmentActiveInput) enrollmentActiveInput.checked = true;
          if (modalEnrollmentTitle)
            modalEnrollmentTitle.textContent = "Tambah Rekap Kesiswaan";
          openEnrollmentModal();
          enrollmentYearInput?.focus();
        });

      document
        .querySelectorAll(".btn-close-enrollment-modal")
        .forEach((btn) => {
          btn.addEventListener("click", closeEnrollmentModal);
        });

      document.querySelectorAll(".btn-edit-enrollment").forEach((btn) => {
        btn.addEventListener("click", () => {
          const item = JSON.parse(btn.dataset.item || "{}");
          enrollmentIdInput.value = item.id;
          enrollmentYearInput.value = item.academicYear;
          enrollmentTotalInput.value = item.totalStudents;
          enrollmentMaleInput.value = item.maleCount || "";
          enrollmentFemaleInput.value = item.femaleCount || "";
          enrollmentRombelInput.value = item.rombelCount || "";
          enrollmentSourceInput.value = item.source || "";
          if (enrollmentActiveInput)
            enrollmentActiveInput.checked = Boolean(item.isActive);
          if (modalEnrollmentTitle)
            modalEnrollmentTitle.textContent = `Edit Rekap Kesiswaan TA ${item.academicYear}`;
          openEnrollmentModal();
        });
      });

      document
        .querySelectorAll(".btn-toggle-enrollment-status")
        .forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = btn.getAttribute("data-id");
            const currentActive = btn.getAttribute("data-active") === "true";
            const nextActive = !currentActive;
            try {
              btn.disabled = true;
              const res = await fetch(`/api/admin/enrollment-stats/${id}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ isActive: nextActive }),
              });
              const data = await res.json();
              if (data.success) {
                showBanner(
                  nextActive
                    ? "Tahun ajaran berhasil diaktifkan sebagai rujukan beranda."
                    : "Tahun ajaran dinonaktifkan dari rujukan beranda.",
                );
                setTimeout(() => window.location.reload(), 500);
              } else {
                btn.disabled = false;
                alert(data.error || "Gagal mengubah status rujukan beranda");
              }
            } catch {
              btn.disabled = false;
              alert("Gagal menghubungi server");
            }
          });
        });

      document.querySelectorAll(".btn-delete-enrollment").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.dataset.id;
          const year = btn.dataset.year;
          const confirmed =
            (await window.confirmDialog?.({
              title: "Hapus Rekapitulasi Kesiswaan",
              message: `Hapus rekapitulasi kesiswaan tahun ajaran ${year}?\nTindakan ini tidak dapat dibatalkan.`,
              confirmText: "Ya, Hapus",
              cancelText: "Batal",
              type: "danger",
            })) ??
            confirm(`Hapus rekapitulasi kesiswaan tahun ajaran ${year}?`);
          if (!confirmed) return;
          try {
            const res = await fetch(`/api/admin/enrollment-stats/${id}`, {
              method: "DELETE",
            });
            const data = await res.json();
            if (data.success) {
              document.getElementById(`enrollment-row-${id}`)?.remove();
              showBanner(`Rekap kesiswaan TA ${year} berhasil dihapus.`);
            } else {
              alert(data.error || "Gagal menghapus");
            }
          } catch {
            alert("Gagal menghubungi server");
          }
        });
      });

      formEnrollment?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const id = enrollmentIdInput.value;
        const url = id
          ? `/api/admin/enrollment-stats/${id}`
          : "/api/admin/enrollment-stats";
        const method = id ? "PUT" : "POST";
        const payload = {
          academicYear: enrollmentYearInput.value,
          totalStudents: Number(enrollmentTotalInput.value),
          maleCount: enrollmentMaleInput.value
            ? Number(enrollmentMaleInput.value)
            : null,
          femaleCount: enrollmentFemaleInput.value
            ? Number(enrollmentFemaleInput.value)
            : null,
          rombelCount: enrollmentRombelInput.value
            ? Number(enrollmentRombelInput.value)
            : null,
          source: enrollmentSourceInput.value || null,
          isActive: enrollmentActiveInput.checked,
        };

        try {
          const res = await fetch(url, {
            method,
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (data.success) {
            closeEnrollmentModal();
            showBanner("Rekap kesiswaan berhasil disimpan.");
            setTimeout(() => window.location.reload(), 800);
          } else {
            alert(data.error || "Gagal menyimpan rekap");
          }
        } catch {
          alert("Gagal menghubungi server");
        }
      });

      // 3. Tracer Modal & Form Handlers
      const modalTracer = document.getElementById("modal-tracer");
      const formTracer = document.getElementById("form-tracer");
      const tracerIdInput = document.getElementById("tracer-id");
      const tracerYearInput = document.getElementById("tracer-year");
      const tracerTotalInput = document.getElementById("tracer-total");
      const tracerPtnInput = document.getElementById("tracer-ptn");
      const tracerPtsInput = document.getElementById("tracer-pts");
      const tracerWorkInput = document.getElementById("tracer-work");
      const tracerNotesInput = document.getElementById("tracer-notes");
      const tracerActiveInput = document.getElementById("tracer-active");
      const modalTracerTitle = document.getElementById("modal-tracer-title");

      function openTracerModal() {
        modalTracer?.classList.remove("hidden");
      }
      function closeTracerModal() {
        modalTracer?.classList.add("hidden");
      }

      document
        .getElementById("btn-add-tracer")
        ?.addEventListener("click", () => {
          tracerIdInput.value = "";
          formTracer?.reset();
          if (tracerActiveInput) tracerActiveInput.checked = true;
          if (modalTracerTitle)
            modalTracerTitle.textContent = "Tambah Rekap Angkatan Kelulusan";
          openTracerModal();
          tracerYearInput?.focus();
        });

      document.querySelectorAll(".btn-close-tracer-modal").forEach((btn) => {
        btn.addEventListener("click", closeTracerModal);
      });

      document.querySelectorAll(".btn-edit-tracer").forEach((btn) => {
        btn.addEventListener("click", () => {
          const item = JSON.parse(btn.dataset.item || "{}");
          tracerIdInput.value = item.id;
          tracerYearInput.value = item.graduationYear;
          tracerTotalInput.value = item.totalGraduates;
          tracerPtnInput.value = item.ptnAcceptedUnique || 0;
          tracerPtsInput.value = item.ptsAccepted || 0;
          tracerWorkInput.value =
            (item.workingCount || 0) + (item.entrepreneurCount || 0);
          tracerNotesInput.value = item.notes || "";
          if (tracerActiveInput)
            tracerActiveInput.checked = Boolean(item.isActive);
          if (modalTracerTitle)
            modalTracerTitle.textContent = `Edit Rekap Angkatan ${item.graduationYear}`;
          openTracerModal();
        });
      });

      document.querySelectorAll(".btn-toggle-tracer-status").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.getAttribute("data-id");
          const currentActive = btn.getAttribute("data-active") === "true";
          const nextActive = !currentActive;
          try {
            btn.disabled = true;
            const res = await fetch(`/api/admin/tracer-stats/${id}`, {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ isActive: nextActive }),
            });
            const data = await res.json();
            if (data.success) {
              showBanner(
                nextActive
                  ? "Data angkatan berhasil diaktifkan sebagai rujukan beranda."
                  : "Data angkatan dinonaktifkan dari rujukan beranda.",
              );
              setTimeout(() => window.location.reload(), 500);
            } else {
              btn.disabled = false;
              alert(data.error || "Gagal mengubah status rujukan beranda");
            }
          } catch {
            btn.disabled = false;
            alert("Gagal menghubungi server");
          }
        });
      });

      document.querySelectorAll(".btn-delete-tracer").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.dataset.id;
          const year = btn.dataset.year;
          const confirmed =
            (await window.confirmDialog?.({
              title: "Hapus Rekapitulasi Kelulusan",
              message: `Hapus rekapitulasi kelulusan tahun ${year}?\nTindakan ini tidak dapat dibatalkan.`,
              confirmText: "Ya, Hapus",
              cancelText: "Batal",
              type: "danger",
            })) ?? confirm(`Hapus rekapitulasi kelulusan tahun ${year}?`);
          if (!confirmed) return;
          try {
            const res = await fetch(`/api/admin/tracer-stats/${id}`, {
              method: "DELETE",
            });
            const data = await res.json();
            if (data.success) {
              document.getElementById(`tracer-row-${id}`)?.remove();
              showBanner(`Rekap angkatan ${year} berhasil dihapus.`);
            } else {
              alert(data.error || "Gagal menghapus");
            }
          } catch {
            alert("Gagal menghubungi server");
          }
        });
      });

      formTracer?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const id = tracerIdInput.value;
        const url = id
          ? `/api/admin/tracer-stats/${id}`
          : "/api/admin/tracer-stats";
        const method = id ? "PUT" : "POST";
        const payload = {
          graduationYear: tracerYearInput.value,
          totalGraduates: Number(tracerTotalInput.value),
          ptnAcceptedUnique: Number(tracerPtnInput.value),
          ptsAccepted: Number(tracerPtsInput.value || 0),
          workingCount: Number(tracerWorkInput.value || 0),
          notes: tracerNotesInput.value || null,
          isActive: tracerActiveInput.checked,
        };

        try {
          const res = await fetch(url, {
            method,
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (data.success) {
            closeTracerModal();
            showBanner("Rekap tracer kelulusan berhasil disimpan.");
            setTimeout(() => window.location.reload(), 800);
          } else {
            alert(data.error || "Gagal menyimpan rekap");
          }
        } catch {
          alert("Gagal menghubungi server");
        }
      });

      // 4. Modal Backdrop & Escape Key Handlers
      [modalEnrollment, modalTracer].forEach((m) => {
        m?.addEventListener("click", (e) => {
          const target = e.target;
          if (target === m || target?.classList?.contains("min-h-full")) {
            m.classList.add("hidden");
          }
        });
      });

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeEnrollmentModal();
          closeTracerModal();
        }
      });

      // 5. Interactive Chart Tooltip (Hover via CSS & Click / Touch via JS)
      document.querySelectorAll(".chart-col-group").forEach((col) => {
        col.addEventListener("click", (e) => {
          e.stopPropagation();
          const isCurrentActive = col.classList.contains("active-tooltip");

          document.querySelectorAll(".chart-col-group").forEach((c) => {
            c.classList.remove("active-tooltip");
          });

          if (!isCurrentActive) {
            col.classList.add("active-tooltip");
          }
        });
      });

      document.addEventListener("click", () => {
        document.querySelectorAll(".chart-col-group").forEach((c) => {
          c.classList.remove("active-tooltip");
        });
      });
    }

    document.addEventListener("DOMContentLoaded", initKesiswaanPage);
    document.addEventListener("astro:page-load", initKesiswaanPage);
  </script>

  <style>
    .chart-tooltip {
      display: none;
    }
    .chart-col-group:hover .chart-tooltip,
    .chart-col-group.active-tooltip .chart-tooltip {
      display: block !important;
    }
  </style>
</AdminLayout>
