---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import MediaPickerModal from "../../../components/MediaPickerModal.astro";
import Icon from "../../../components/Icon.astro";
import { db, settings } from "../../../db";

export const prerender = false;

// Ambil semua data profil institusi dari tabel settings
const allSettings = await db.select().from(settings);
const settingMap = allSettings.reduce(
  (acc, curr) => {
    acc[curr.key] = curr.value;
    return acc;
  },
  {} as Record<string, string>,
);

// 1. Informasi Resmi & Karakteristik Lembaga
const schoolName = settingMap["school_name"] || "SMAN 1 Unggulan";
const educationLevel = settingMap["education_level"] || "menengah_atas";

// Mapping jenjang → jenis satuan pendidikan yang sah
const SCHOOL_TYPE_MAP: Record<string, { value: string; label: string }[]> = {
  dasar: [
    { value: "SD", label: "SD (Kemendikbud)" },
    { value: "MI", label: "MI (Kemenag)" },
  ],
  menengah_pertama: [
    { value: "SMP", label: "SMP (Kemendikbud)" },
    { value: "MTs", label: "MTs (Kemenag)" },
  ],
  menengah_atas: [
    { value: "SMA", label: "SMA (Kemendikbud)" },
    { value: "MA", label: "MA (Kemenag)" },
    { value: "SMK", label: "SMK (Vokasi)" },
  ],
};

const validSchoolTypeOptions = SCHOOL_TYPE_MAP[educationLevel] || SCHOOL_TYPE_MAP["menengah_atas"];
const rawSchoolType = (settingMap["school_type"] || settingMap["school_level"] || "SMA").toUpperCase();
const isSchoolTypeValid = validSchoolTypeOptions.some((opt) => opt.value === rawSchoolType);
const schoolType = isSchoolTypeValid ? rawSchoolType : validSchoolTypeOptions[0].value;
const schoolLevel = schoolType;
const npsn = settingMap["npsn"] || "20101234";
const accreditation = settingMap["accreditation"] || "A (Unggul)";
const schoolStatus = settingMap["school_status"] || "Negeri";
const boardingAvailable = settingMap["boarding_available"] === "true";
const establishmentDecree =
  settingMap["establishment_decree"] || "420/123/DISDIK/2005";
const curriculum =
  settingMap["curriculum"] || "Kurikulum Merdeka Mandiri Berbagi";
const tagline =
  settingMap["tagline"] ||
  "Unggul dalam Riset, Santun dalam Budi Pekerti, Mandiri Berprestasi";
const admissionsLabel =
  settingMap["admissions_label"] || settingMap["ppdb_label"] || "PPDB";
const admissionsTitle = settingMap["admissions_title"] || "";
const admissionsSubtitle = settingMap["admissions_subtitle"] || "";
const ppdbUrl = settingMap["ppdb_url"] || "https://siap-ppdb.com";

// 2. Sambutan Kepala Sekolah
const principalWelcomeActive =
  settingMap["principal_welcome_active"] !== "false";
const principalName = settingMap["principal_name"] || "Dr. H. Sulaiman, M.Pd.";
const principalTitle = settingMap["principal_title"] || "Kepala Sekolah";
const principalPhoto =
  settingMap["principal_photo"] ||
  "https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=600&q=80";
const principalWelcomeQuote =
  settingMap["principal_welcome_quote"] ||
  "Selamat datang di portal resmi institusi kami. Kami berkomitmen menyelenggarakan ekosistem pendidikan berstandar tinggi yang mengintegrasikan kecakapan teknologi, kedalaman riset, dan budi pekerti luhur.";

// 3. Sejarah & Tonggak Perkembangan
const foundedYear = settingMap["founded_year"] || "1995";
const schoolHistoryP1 = settingMap["school_history_p1"] || settingMap["school_history"] || "";
const schoolHistoryP2 = settingMap["school_history_p2"] || "";
const schoolHistoryP3 = settingMap["school_history_p3"] || "";
const schoolHistoryImage =
  settingMap["school_history_image"] ||
  "https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80";
const schoolHistoryMilestones =
  settingMap["school_history_milestones"] ||
  "1995 | Peresmian pendirian dan operasional perdana satuan pendidikan.\n2012 | Perintisan kelas riset olimpiade sains dan laboratorium komputer terpadu.\n2025 | Re-akreditasi predikat A (Unggul) dengan nilai ketercapaian SPM mutu prima.";

// 4. Sekilas Profil & Video Profil Beranda
const schoolProfileActive = settingMap["school_profile_active"] !== "false";
const schoolProfileTitle =
  settingMap["school_profile_title"] ||
  "Membina Generasi Unggul, Berkarakter & Berdaya Saing Global";
const schoolProfileDesc =
  settingMap["school_profile_desc"] ||
  "SMAN 1 Unggulan mengintegrasikan kurikulum riset mutakhir, penguasaan sains dan teknologi kecerdasan buatan, serta pembinaan akhlak mulia dalam ekosistem kampus modern berstandar nasional.";
const schoolVision =
  settingMap["school_vision"] ||
  "Menjadi pusat keunggulan pendidikan yang melahirkan cendekiawan berakhlak mulia, berjiwa riset, dan kompetitif di kancah internasional.";
const schoolMission =
  settingMap["school_mission"] ||
  "1. Menyelenggarakan pembelajaran berbasis riset sains terapan dan literasi digital berstandar global.\n2. Menempa kepribadian siswa yang berintegritas, mandiri, dan peduli sesama.\n3. Memfasilitasi sarana prasarana modern berwawasan lingkungan hijau.";
const schoolVideoUrl =
  settingMap["school_video_url"] ||
  "https://www.youtube.com/watch?v=dQw4w9WgXcQ";
const schoolVideoThumbnail =
  settingMap["school_video_thumbnail"] ||
  "https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1200&q=80";
const schoolProfileCtaText =
  settingMap["school_profile_cta_text"] || "Selengkapnya Tentang Sekolah";
const schoolProfileCtaUrl = settingMap["school_profile_cta_url"] || "/profil";

// 5. Lokasi & Jam Operasional
const address =
  settingMap["address"] || "Jl. Pendidikan No. 45, Kota Pendidikan";
const city = settingMap["city"] || "Kota Jakarta Selatan";
const province = settingMap["province"] || "DKI Jakarta";
const postalCode = settingMap["postal_code"] || "12340";
const mapsEmbed =
  settingMap["maps_embed"] ||
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126922.385!2d106.78!3d-6.22!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNsKwMTMnMTIuMCJTIDEwNsKwNDYnNDguMCJF!5e0!3m2!1sid!2sid!4v1600000000000";
const operationalHours =
  settingMap["operational_hours"] || "Senin – Jumat: 07.00 – 16.00 WIB";
const operationalNotes =
  settingMap["operational_notes"] ||
  "Sabtu, Minggu & Hari Libur Nasional: Tutup";

// 6. Testimoni & Kisah Alumni Beranda
const alumniSectionActive = settingMap["alumni_section_active"] !== "false";
const alumniSectionTitle =
  settingMap["alumni_section_title"] ||
  "Kisah Inspiratif & Jejak Langkah Alumni";
const alumniSectionDesc =
  settingMap["alumni_section_desc"] ||
  "Mendengar pengalaman dan cerita sukses para lulusan yang kini berkiprah di perguruan tinggi ternama serta dunia profesional global.";

// Definisi Navigasi Tabs (Zero-Load Pattern)
const rawTab = Astro.url.searchParams.get("tab") || "identitas";
const activeTabId = rawTab.startsWith("tab-") ? rawTab : `tab-${rawTab}`;

const profileTabs = [
  { id: "tab-identitas", label: "1. Identitas & Legalitas" },
  { id: "tab-sambutan", label: "2. Sambutan Kepala Sekolah" },
  { id: "tab-sejarah", label: "3. Sejarah Sekolah" },
  { id: "tab-video", label: "4. Profil & Video Beranda" },
  { id: "tab-lokasi", label: "5. Lokasi & Operasional" },
  { id: "tab-alumni", label: "6. Testimoni Alumni" },
];
---

<AdminLayout title="Profil Sekolah" activeNav="profil" settingsMap={settingMap}>
  <div class="max-w-4xl mx-auto space-y-8 pb-20">
    <!-- Header Halaman -->
    <div
      class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6"
    >
      <div>
        <h1 class="font-display text-2xl font-bold tracking-tight text-heading">
          Profil Sekolah
        </h1>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          id="btn-header-save"
          class="inline-flex h-9 items-center justify-center gap-2 rounded-md bg-primary px-4 text-xs font-semibold text-white transition-all hover:bg-primary-hover shadow-xs cursor-pointer disabled:opacity-50"
        >
          <Icon id="btn-header-icon-save" name="save" class="h-3.5 w-3.5 text-white" />
          <svg
            id="btn-header-spinner"
            class="hidden h-3.5 w-3.5 animate-spin text-white"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <Icon id="btn-header-check" name="check" class="hidden h-3.5 w-3.5 text-white" />
          <span id="btn-header-label">Simpan Perubahan</span>
        </button>
      </div>
    </div>

    <!-- Segmented Control Tabs (Zero-Load Pattern) -->
    <div class="overflow-x-auto no-scrollbar">
      <div
        class="inline-flex bg-surface-subtle *:px-2.5 *:py-2.5 *:text-[11px] *:whitespace-nowrap *:cursor-pointer *:transition-colors *:first:rounded-l-[4px] *:last:rounded-r-[4px]"
        role="tablist"
        aria-label="Tab Pengaturan Profil Sekolah"
      >
        {
          profileTabs.map((tab) => (
            <button
              type="button"
              role="tab"
              aria-selected={activeTabId === tab.id ? "true" : "false"}
              class:list={[
                "profile-tab-btn",
                activeTabId === tab.id
                  ? "bg-primary font-semibold text-white"
                  : "font-medium text-muted hover:text-heading",
              ]}
              data-tab={tab.id}
            >
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>

    <form id="profile-form">
      <!-- TAB 1: INFORMASI RESMI & LEGALITAS -->
      <section
        id="tab-identitas"
        role="tabpanel"
        class:list={[
          "profile-tab-pane space-y-5",
          activeTabId !== "tab-identitas" && "hidden",
        ]}
      >
        <div class="pb-3">
          <div class="flex items-center gap-2">
            <span
              class="flex h-6 w-6 items-center justify-center rounded-md bg-primary-light font-display text-xs font-bold text-primary"
            >
              1
            </span>
            <h2 class="font-display text-base font-bold text-heading">
              Informasi Resmi Sekolah
            </h2>
          </div>
        </div>

        <div class="rounded-lg border border-border bg-surface p-5 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label
                for="school_name"
                class="block text-xs font-semibold text-heading"
              >
                Nama Resmi Lembaga <span class="text-error">*</span>
              </label>
              <input
                type="text"
                id="school_name"
                name="school_name"
                value={schoolName}
                required
                class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
              />
            </div>

            <div>
              <label
                for="city"
                class="block text-xs font-semibold text-heading"
              >
                Kota / Kabupaten <span class="text-error">*</span>
              </label>
              <input
                type="text"
                id="city"
                name="city"
                value={city}
                placeholder="Misal: Jakarta, Surabaya, Kab. Bogor"
                required
                class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
              />
            </div>

            <div>
              <label
                for="npsn"
                class="block text-xs font-semibold text-heading"
              >
                NPSN <span class="text-error">*</span>
              </label>
              <input
                type="text"
                id="npsn"
                name="npsn"
                value={npsn}
                required
                class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading font-mono transition-colors"
              />
            </div>
          </div>

          <!-- Karakteristik Identitas Lembaga Pendidikan -->
          <div class="pt-3 space-y-3">
            <span class="block text-xs font-bold text-heading">Karakteristik & Jenis Lembaga Pendidikan:</span>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              <!-- 1. Jenjang Pendidikan -->
              <div>
                <label for="education_level" class="block text-xs font-semibold text-heading">
                  Jenjang Pendidikan
                </label>
                <select
                  id="education_level"
                  name="education_level"
                  class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
                >
                  <option value="dasar" selected={educationLevel === "dasar"}>
                    Pendidikan Dasar (SD/MI)
                  </option>
                  <option value="menengah_pertama" selected={educationLevel === "menengah_pertama"}>
                    Menengah Pertama (SMP/MTs)
                  </option>
                  <option value="menengah_atas" selected={educationLevel === "menengah_atas"}>
                    Menengah Atas (SMA/MA/SMK)
                  </option>
                </select>
              </div>

              <!-- 2. Jenis Satuan Pendidikan (Kunci Penentu Formulir) — Difilter otomatis oleh Jenjang -->
              <div>
                <label for="school_type" class="block text-xs font-semibold text-heading">
                  Jenis Satuan Pendidikan
                </label>
                <select
                  id="school_type"
                  name="school_type"
                  data-saved-value={schoolType}
                  class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
                >
                  {
                    validSchoolTypeOptions.map((opt) => (
                      <option value={opt.value} selected={schoolType === opt.value}>
                        {opt.label}
                      </option>
                    ))
                  }
                </select>
                <!-- Sinkronisasi kompatibilitas school_level -->
                <input type="hidden" id="school_level" name="school_level" value={schoolType} />
              </div>

              <!-- 3. Status Sekolah -->
              <div>
                <label for="school_status" class="block text-xs font-semibold text-heading">
                  Status Sekolah
                </label>
                <select
                  id="school_status"
                  name="school_status"
                  class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
                >
                  <option value="Negeri" selected={schoolStatus === "Negeri"}>Negeri</option>
                  <option value="Swasta" selected={schoolStatus === "Swasta"}>Swasta</option>
                </select>
              </div>

              <!-- 4. Layanan Asrama -->
              <div>
                <label for="boarding_available" class="block text-xs font-semibold text-heading">
                  Layanan Asrama
                </label>
                <select
                  id="boarding_available"
                  name="boarding_available"
                  class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
                >
                  <option value="false" selected={!boardingAvailable}>Tidak tersedia</option>
                  <option value="true" selected={boardingAvailable}>Tersedia (Pesantren/Boarding)</option>
                </select>
              </div>
            </div>

            <!-- Widget Interaktif: Simulasi Hasil Konfigurasi -->
            <div class="rounded-md border border-primary/20 bg-primary-light p-4 space-y-2 mt-3">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-primary">
                  SIMULASI HASIL KONFIGURASI
                </span>
                <span class="text-[11px] text-muted">Contoh interaktif (belum disimpan)</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-1">
                <div class="space-y-0.5">
                  <h3 id="sim-form-title" class="font-display text-sm font-bold text-heading">
                    Formulir Pendaftaran {schoolType}
                  </h3>
                  <div class="flex flex-wrap items-center gap-3 text-xs text-muted">
                    <span>Status lembaga: <strong id="sim-status-label" class="text-heading font-medium">{schoolStatus}</strong></span>
                    <span>&bull;</span>
                    <span id="sim-boarding-label">
                      {boardingAvailable ? "Layanan asrama: Tersedia, dapat diaktifkan pada pengaturan pendaftaran" : "Layanan asrama: Tidak tersedia"}
                    </span>
                  </div>
                </div>
                <div class="text-[11px] font-mono font-medium text-primary bg-surface px-2.5 py-1 rounded-[4px] border border-primary/20 shrink-0">
                  Template Otomatis: <span id="sim-template-tag">{schoolType}</span>
                </div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
            <div>
              <label
                for="accreditation"
                class="block text-xs font-semibold text-heading"
              >
                Akreditasi
              </label>
              <input
                type="text"
                id="accreditation"
                name="accreditation"
                value={accreditation}
                class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
              />
            </div>

            <div>
              <label
                for="establishment_decree"
                class="block text-xs font-semibold text-heading"
              >
                SK Pendirian / Izin Operasional
              </label>
              <input
                type="text"
                id="establishment_decree"
                name="establishment_decree"
                value={establishmentDecree}
                class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading font-mono transition-colors"
              />
            </div>

            <div>
              <label
                for="curriculum"
                class="block text-xs font-semibold text-heading"
              >
                Kurikulum
              </label>
              <input
                type="text"
                id="curriculum"
                name="curriculum"
                value={curriculum}
                class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
              />
            </div>
          </div>

          <div>
            <label
              for="tagline"
              class="block text-xs font-semibold text-heading"
            >
              Tagline / Motto Sekolah
            </label>
            <input
              type="text"
              id="tagline"
              name="tagline"
              value={tagline}
              class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
            />
          </div>

          <div
            class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2"
          >
            <div>
              <label
                for="admissions_label"
                class="block text-xs font-semibold text-heading"
              >
                Istilah / Singkatan Pendaftaran
              </label>
              <input
                type="text"
                id="admissions_label"
                name="admissions_label"
                value={admissionsLabel}
                placeholder="Contoh: PSB, SPMB, PPDB"
                class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
              />
            </div>

            <div>
              <label
                for="admissions_title"
                class="block text-xs font-semibold text-heading"
              >
                Nama Resmi / Judul Lengkap Pendaftaran
              </label>
              <input
                type="text"
                id="admissions_title"
                name="admissions_title"
                value={admissionsTitle}
                placeholder="Contoh: SISTEM PENERIMAAN SISWA BARU / PENERIMAAN SISWA BARU"
                class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
              />
            </div>

            <div class="sm:col-span-2">
              <label
                for="admissions_subtitle"
                class="block text-xs font-semibold text-heading"
              >
                Sub-judul / Deskripsi Ajakan Halaman Pendaftaran
              </label>
              <input
                type="text"
                id="admissions_subtitle"
                name="admissions_subtitle"
                value={admissionsSubtitle}
                placeholder="Contoh: Wujudkan masa depanmu bersama kami. Daftarkan dirimu secara online untuk tahun ajaran baru."
                class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
              />
            </div>

            <div class="sm:col-span-2">
              <label
                for="ppdb_url"
                class="block text-xs font-semibold text-heading"
              >
                Tautan Pendaftaran Eksternal (Opsional)
              </label>
              <input
                type="url"
                id="ppdb_url"
                name="ppdb_url"
                value={ppdbUrl}
                placeholder="https://..."
                class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading font-mono transition-colors"
              />
            </div>
          </div>
        </div>
      </section>

      
      <!-- TAB 2: SAMBUTAN KEPALA SEKOLAH -->
      <section
        id="tab-sambutan"
        role="tabpanel"
        class:list={[
          "profile-tab-pane space-y-5",
          activeTabId !== "tab-sambutan" && "hidden",
        ]}
      >
        <div class="pb-3">
          <div class="flex items-center gap-2">
            <span
              class="flex h-6 w-6 items-center justify-center rounded-md bg-primary-light font-display text-xs font-bold text-primary"
            >
              2
            </span>
            <h2 class="font-display text-base font-bold text-heading">
              Sambutan Kepala Sekolah
            </h2>
          </div>
        </div>

        <div class="rounded-lg border border-border bg-surface p-5 space-y-5">
          <div class="flex items-center justify-between p-2.5 rounded-[6px] border border-border bg-surface-subtle">
            <div>
              <span class="block text-xs font-medium text-heading">Status Tampilan di Beranda</span>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                id="principal_welcome_active"
                name="principal_welcome_active"
                value="true"
                checked={principalWelcomeActive}
                class="sr-only peer"
              />
              <div class="w-9 h-5 bg-border rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-border after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
            </label>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label
                for="principal_name"
                class="block text-xs font-semibold text-heading"
              >
                Nama Lengkap Kepala Sekolah <span class="text-error">*</span>
              </label>
              <input
                type="text"
                id="principal_name"
                name="principal_name"
                value={principalName}
                required
                class="mt-1 h-9 w-full rounded-md border border-border bg-surface px-3 text-xs text-heading transition-colors"
              />
            </div>

            <div>
              <label
                for="principal_title"
                class="block text-xs font-semibold text-heading"
              >
                Gelar / NIP / Jabatan
              </label>
              <input
                type="text"
                id="principal_title"
                name="principal_title"
                value={principalTitle}
