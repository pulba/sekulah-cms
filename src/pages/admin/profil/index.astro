            >
              <span>Buka Menu Alumni</span>
              <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>

        </div>
      </section>
    </form>
  </div>

  <MediaPickerModal id="profile-media-picker" />

<script is:inline>
  function initAdminProfile() {
    const form = document.getElementById("profile-form");
    if (!form) return;
    const btnHeaderSave = document.getElementById("btn-header-save");
    const headerLabel = document.getElementById("btn-header-label");
    const iconSave = document.getElementById("btn-header-icon-save");
    const iconSpinner = document.getElementById("btn-header-spinner");
    const iconCheck = document.getElementById("btn-header-check");

    // Inputs & Previews
    const inputPrincipalPhoto = document.getElementById("principal_photo");
    const previewPrincipalPhoto = document.getElementById(
      "preview-principal-photo",
    );
    const btnPickPrincipalPhoto = document.getElementById(
      "btn-pick-principal-photo",
    );
    const uploadPrincipalPhoto = document.getElementById(
      "upload-principal-photo",
    );

    const inputVideoCover = document.getElementById("school_video_thumbnail");
    const previewVideoCover = document.getElementById("preview-video-cover");
    const btnPickVideoCover = document.getElementById("btn-pick-video-cover");
    const uploadVideoCover = document.getElementById("upload-video-cover");

    const inputHistoryPhoto = document.getElementById("school_history_image");
    const previewHistoryPhoto = document.getElementById("preview-history-photo");
    const btnPickHistoryPhoto = document.getElementById("btn-pick-history-photo");
    const uploadHistoryPhoto = document.getElementById("upload-history-photo");
    const btnDefaultHistoryTemplate = document.getElementById("btn-default-history-template");
    const inputFoundedYear = document.getElementById("founded_year");
    const txtHistoryP1 = document.getElementById("school_history_p1");
    const txtHistoryP2 = document.getElementById("school_history_p2");
    const txtHistoryP3 = document.getElementById("school_history_p3");
    const txtHistoryMilestones = document.getElementById("school_history_milestones");

    // Sync Photo Previews
    inputPrincipalPhoto?.addEventListener("input", () => {
      previewPrincipalPhoto.src =
        inputPrincipalPhoto.value.trim() || "/placeholder-avatar.png";
    });
    inputVideoCover?.addEventListener("input", () => {
      previewVideoCover.src =
        inputVideoCover.value.trim() || "/placeholder-cover.jpg";
    });
    inputHistoryPhoto?.addEventListener("input", () => {
      previewHistoryPhoto.src =
        inputHistoryPhoto.value.trim() || "https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80";
    });

    // === Sinkronisasi Jenjang → Jenis Satuan Pendidikan ===
    const SCHOOL_TYPE_MAP = {
      dasar: [
        { value: "SD", label: "SD (Kemendikbud)" },
        { value: "MI", label: "MI (Kemenag)" },
      ],
      menengah_pertama: [
        { value: "SMP", label: "SMP (Kemendikbud)" },
        { value: "MTs", label: "MTs (Kemenag)" },
      ],
      menengah_atas: [
        { value: "SMA", label: "SMA (Kemendikbud)" },
        { value: "MA", label: "MA (Kemenag)" },
        { value: "SMK", label: "SMK (Vokasi)" },
      ],
    };

    const selectEducationLevel = document.getElementById("education_level");
    const selectSchoolType = document.getElementById("school_type");
    const selectSchoolStatus = document.getElementById("school_status");
    const selectBoarding = document.getElementById("boarding_available");
    const hiddenSchoolLevel = document.getElementById("school_level");
    const simFormTitle = document.getElementById("sim-form-title");
    const simStatusLabel = document.getElementById("sim-status-label");
    const simBoardingLabel = document.getElementById("sim-boarding-label");
    const simTemplateTag = document.getElementById("sim-template-tag");

    // Populate school_type options filtered by education_level
    function populateSchoolTypes(preserveValue) {
      if (!selectSchoolType || !selectEducationLevel) return;
      const level = selectEducationLevel.value;
      const options = SCHOOL_TYPE_MAP[level] || SCHOOL_TYPE_MAP["menengah_atas"];
      selectSchoolType.innerHTML = "";
      let matched = false;
      options.forEach((opt) => {
        const el = document.createElement("option");
        el.value = opt.value;
        el.textContent = opt.label;
        if (preserveValue && opt.value === preserveValue) {
          el.selected = true;
          matched = true;
        }
        selectSchoolType.appendChild(el);
      });
      if (!matched && options.length > 0) {
        selectSchoolType.selectedIndex = 0;
      }
      updateSimulation();
    }

    // Initial populate: restore saved value from server
    const savedSchoolType = selectSchoolType?.getAttribute("data-saved-value") || "SMA";
    populateSchoolTypes(savedSchoolType);

    // When jenjang changes: rebuild options, auto-select first
    selectEducationLevel?.addEventListener("change", () => {
      populateSchoolTypes(null);
    });

    // Live Simulation Sync
    function updateSimulation() {
      const type = selectSchoolType ? selectSchoolType.value : "SMA";
      const status = selectSchoolStatus ? selectSchoolStatus.value : "Negeri";
      const boarding = selectBoarding ? selectBoarding.value === "true" : false;

      if (hiddenSchoolLevel) hiddenSchoolLevel.value = type;
      if (simFormTitle) simFormTitle.innerText = `Formulir Pendaftaran ${type}`;
      if (simStatusLabel) simStatusLabel.innerText = status;
      if (simBoardingLabel) {
        simBoardingLabel.innerText = boarding
          ? "Layanan asrama: Tersedia, dapat diaktifkan pada pengaturan pendaftaran"
          : "Layanan asrama: Tidak tersedia";
      }
      if (simTemplateTag) simTemplateTag.innerText = type;
    }

    selectSchoolType?.addEventListener("change", updateSimulation);
    selectSchoolStatus?.addEventListener("change", updateSimulation);
    selectBoarding?.addEventListener("change", updateSimulation);

    // Media Picker Integration
    btnPickPrincipalPhoto?.addEventListener("click", () => {
      window.openMediaPicker?.((media) => {
        if (media?.url) {
          inputPrincipalPhoto.value = media.url;
          previewPrincipalPhoto.src = media.url;
        }
      });
    });

    btnPickVideoCover?.addEventListener("click", () => {
      window.openMediaPicker?.((media) => {
        if (media?.url) {
          inputVideoCover.value = media.url;
          previewVideoCover.src = media.url;
        }
      });
    });

    btnPickHistoryPhoto?.addEventListener("click", () => {
      window.openMediaPicker?.((media) => {
        if (media?.url) {
          inputHistoryPhoto.value = media.url;
          previewHistoryPhoto.src = media.url;
        }
      });
    });

    // File Upload Handler
    async function handleUpload(file, inputEl, previewEl) {
      if (!file) return;
      const fd = new FormData();
      fd.append("file", file);
      try {
        const res = await fetch("/api/admin/media/upload", {
          method: "POST",
          body: fd,
        });
        const data = await res.json();
        if (data.success && data.media?.url) {
          inputEl.value = data.media.url;
          previewEl.src = data.media.url;
        } else {
          alert(data.error || "Gagal mengunggah berkas.");
        }
      } catch {
        alert("Terjadi kesalahan jaringan saat mengunggah gambar.");
      }
    }

    uploadPrincipalPhoto?.addEventListener("change", (e) => {
      handleUpload(
        e.target.files?.[0],
        inputPrincipalPhoto,
        previewPrincipalPhoto,
      );
    });

    uploadVideoCover?.addEventListener("change", (e) => {
      handleUpload(e.target.files?.[0], inputVideoCover, previewVideoCover);
    });

    uploadHistoryPhoto?.addEventListener("change", (e) => {
      handleUpload(e.target.files?.[0], inputHistoryPhoto, previewHistoryPhoto);
    });

    // Helper Template Sambutan Default
    const btnDefaultQuoteTemplate = document.getElementById("btn-default-quote-template");
    const txtQuote = document.getElementById("principal_welcome_quote");
    const inputSchoolName = document.getElementById("school_name");

    btnDefaultQuoteTemplate?.addEventListener("click", () => {
      const currentSchool = inputSchoolName && inputSchoolName.value ? inputSchoolName.value.trim() : "SMAN 1 Unggulan";
      const defaultText = "Assalamu’alaikum Warahmatullahi Wabarakatuh, Salam Sejahtera bagi kita semua.\n\nPuji syukur kita panjatkan ke hadirat Tuhan Yang Maha Esa atas limpahan rahmat dan karunia-Nya. Selamat datang di portal resmi " + currentSchool + ". Kami berkomitmen menyelenggarakan ekosistem pendidikan berstandar tinggi yang memadukan keunggulan akademik, riset sains, dan pembinaan budi pekerti luhur.\n\nMelalui bimbingan para pendidik yang berdedikasi serta fasilitas pembelajaran modern, kami mendampingi setiap peserta didik untuk menumbuhkan nalar kritis, integritas karakter, dan kesiapan menyongsong masa depan di era global.\n\nTerima kasih atas kepercayaan dan kemitraan harmonis yang senantiasa terjalin bersama seluruh orang tua, alumni, dan masyarakat luas. Pintu kami senantiasa terbuka untuk melangkah bersama demi kemajuan anak-anak kita.\n\nWassalamu’alaikum Warahmatullahi Wabarakatuh.";

      if (txtQuote) {
        txtQuote.value = defaultText;
        txtQuote.focus();
      }
    });

    // Helper Template Sejarah Default
    btnDefaultHistoryTemplate?.addEventListener("click", () => {
      const currentSchool = inputSchoolName && inputSchoolName.value ? inputSchoolName.value.trim() : "SMAN 1 Unggulan";
      const year = inputFoundedYear && inputFoundedYear.value ? inputFoundedYear.value.trim() : "1995";

      if (txtHistoryP1) {
        txtHistoryP1.value = "Perjalanan " + currentSchool + " bermula pada tahun " + year + " atas prakarsa para tokoh pendidikan dan dewan guru perintis untuk menghadirkan pusat pembelajaran unggulan berstandar nasional. Mengawali kiprah dengan rombongan belajar perdana, sekolah memfokuskan pembinaan pada penguasaan dasar ilmu sains dan budi pekerti disiplin.";
      }
      if (txtHistoryP2) {
        txtHistoryP2.value = "Dengan dukungan masyarakat dan komitmen berkelanjutan pemerintah daerah, sarana pembelajaran terus diperluas — mulai dari pembangunan ruang laboratorium terpadu, perpustakaan digital, hingga sarana olahraga representatif.";
      }
      if (txtHistoryP3) {
        txtHistoryP3.value = "Memasuki dekade modern, " + currentSchool + " meraih Akreditasi A (Unggul) secara beruntun dari Badan Akreditasi Nasional. Sekolah mempelopori integrasi kurikulum riset aplikatif, pemanfaatan kecerdasan buatan dalam pembelajaran, serta program pertukaran budaya. Kini, ribuan alumni almamater telah berkiprah di perguruan tinggi kedinasan, PTN terkemuka, maupun kampus bergengsi mancanegara.";
      }
      if (txtHistoryMilestones) {
        txtHistoryMilestones.value = year + " | Peresmian pendirian dan operasional perdana satuan pendidikan.\n2012 | Perintisan kelas riset olimpiade sains dan laboratorium komputer terpadu.\n2025 | Re-akreditasi predikat A (Unggul) dengan nilai ketercapaian SPM mutu prima.";
      }
    });

    // Save Form Handler
    async function saveProfile() {
      setLoading(true);

      const fd = new FormData(form);
      const payload = {};
      fd.forEach((val, key) => {
        payload[key] = String(val).trim();
      });

      // Explicitly serialize switch toggles
      ["principal_welcome_active", "school_profile_active", "alumni_section_active"].forEach((key) => {
        const el = form.elements[key];
        if (el && el.type === "checkbox") {
          payload[key] = el.checked ? "true" : "false";
        }
      });

      try {
        const res = await fetch("/api/admin/settings", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        setLoading(false);

        if (data.success) {
          iconSave?.classList.add("hidden");
          iconSpinner?.classList.add("hidden");
          iconCheck?.classList.remove("hidden");
          if (headerLabel) headerLabel.innerText = "Tersimpan";
          setTimeout(() => {
            iconCheck?.classList.add("hidden");
            iconSave?.classList.remove("hidden");
            if (headerLabel) headerLabel.innerText = "Simpan Perubahan";
          }, 2500);
        } else {
          iconSave?.classList.remove("hidden");
          iconSpinner?.classList.add("hidden");
          iconCheck?.classList.add("hidden");
          alert(data.error || "Gagal menyimpan data profil.");
        }
      } catch {
        setLoading(false);
        iconSave?.classList.remove("hidden");
        iconSpinner?.classList.add("hidden");
        iconCheck?.classList.add("hidden");
        alert("Terjadi kesalahan jaringan.");
      }
    }

    function setLoading(isLoading) {
      if (btnHeaderSave) btnHeaderSave.disabled = isLoading;
      const text = isLoading ? "Menyimpan..." : "Simpan Perubahan";
      if (headerLabel) headerLabel.innerText = text;
      if (isLoading) {
        iconSave?.classList.add("hidden");
        iconSpinner?.classList.remove("hidden");
        iconCheck?.classList.add("hidden");
      } else {
        iconSpinner?.classList.add("hidden");
      }
    }

    // Tabs Navigation (Zero-Load Pattern)
    const tabButtons = document.querySelectorAll(".profile-tab-btn");
    const tabPanes = document.querySelectorAll(".profile-tab-pane");

    function switchTab(targetId, updateHistory = true) {
      tabButtons.forEach((btn) => {
        const isActive = btn.getAttribute("data-tab") === targetId;
        btn.setAttribute("aria-selected", isActive ? "true" : "false");
        btn.className = isActive
          ? "profile-tab-btn bg-primary font-semibold text-white"
          : "profile-tab-btn font-medium text-muted hover:text-heading";
      });

      tabPanes.forEach((pane) => {
        if (pane.id === targetId) {
          pane.classList.remove("hidden");
        } else {
          pane.classList.add("hidden");
        }
      });

      if (updateHistory) {
        const cleanName = targetId.replace("tab-", "");
        const url = new URL(window.location.href);
        url.searchParams.set("tab", cleanName);
        window.history.replaceState(null, "", url.toString());
      }
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-tab");
        if (targetId) switchTab(targetId);
      });
    });

    window.addEventListener("popstate", () => {
      const params = new URLSearchParams(window.location.search);
      const tab = params.get("tab");
      if (tab) {
        const id = tab.startsWith("tab-") ? tab : `tab-${tab}`;
        if (document.getElementById(id)) switchTab(id, false);
      } else {
        switchTab("tab-identitas", false);
      }
    });

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      saveProfile();
    });

    btnHeaderSave?.addEventListener("click", () => {
      const invalidEl = form?.querySelector(":invalid");
      if (invalidEl) {
        const pane = invalidEl.closest(".profile-tab-pane");
        if (pane && pane.classList.contains("hidden")) {
          switchTab(pane.id);
        }
        form?.reportValidity();
        return;
      }
      saveProfile();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAdminProfile);
  } else {
    initAdminProfile();
  }
</script>
</AdminLayout>
