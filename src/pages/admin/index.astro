---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import {
  db,
  articles,
  agendas,
  teachers,
  registrations,
  users,
  auditLogs,
} from '../../db';
import { desc, isNull } from 'drizzle-orm';
import { getSettingsMap } from '../../utils/settingsCache';
import {
  getDefaultPpdbConfig,
  getWibDateString,
  resolvePpdbPortal,
  type PpdbFullConfig,
} from '../../utils/ppdbConfigDefaults';

export const prerender = false;

const currentUser = Astro.locals.user;
const isSuperAdmin = currentUser?.role === 'super_admin';
const todayWib = getWibDateString();

const currentHour = new Date().getHours();
const greetingTime =
  currentHour < 11 ? 'Selamat Pagi' : currentHour < 15 ? 'Selamat Siang' : currentHour < 18 ? 'Selamat Sore' : 'Selamat Malam';
const userName = currentUser?.name || 'Administrator';
const todayFormatted = new Date().toLocaleDateString('id-ID', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Ambil data settings dari in-memory cache (0ms DB roundtrip)
const settingMap = await getSettingsMap();

// Fetch data aktif dashboard via single HTTP batch pipeline (Turso) dengan proyeksi kolom selektif
let activeArticles: {
  id: number;
  title: string;
  slug: string;
  status: 'draft' | 'published';
  viewCount: number;
  createdAt: string | null;
}[] = [];
let allAgendas: {
  id: number;
  title: string;
  eventDate: string;
  isCompleted: boolean | null;
}[] = [];
let allTeachers: { id: number; isActive: boolean | null }[] = [];
let allRegistrations: {
  status: string | null;
  verificationStatus: string | null;
  selectionStatus: string | null;
}[] = [];
let allUsers: { id: string; role: 'super_admin' | 'editor'; isActive: boolean | null }[] = [];
let recentLogs: {
  id: number;
  userId: string | null;
  userEmail: string | null;
  action: string;
  entity: string;
  entityId: string | null;
  details: string | null;
  ipAddress: string | null;
  createdAt: string | null;
}[] = [];

if (isSuperAdmin) {
  const [
    bArticles,
    bAgendas,
    bTeachers,
    bRegistrations,
    bUsers,
    bLogs,
  ] = await db.batch([
    db
      .select({
        id: articles.id,
        title: articles.title,
        slug: articles.slug,
        status: articles.status,
        viewCount: articles.viewCount,
        createdAt: articles.createdAt,
      })
      .from(articles)
      .where(isNull(articles.deletedAt))
      .orderBy(desc(articles.createdAt)),
    db
      .select({
        id: agendas.id,
        title: agendas.title,
        eventDate: agendas.eventDate,
        isCompleted: agendas.isCompleted,
      })
      .from(agendas)
      .orderBy(desc(agendas.createdAt)),
    db.select({ id: teachers.id, isActive: teachers.isActive }).from(teachers),
    db
      .select({
        status: registrations.status,
        verificationStatus: registrations.verificationStatus,
        selectionStatus: registrations.selectionStatus,
      })
      .from(registrations),
    db.select({ id: users.id, role: users.role, isActive: users.isActive }).from(users),
    db.select().from(auditLogs).orderBy(desc(auditLogs.createdAt)).limit(5),
  ]);
  activeArticles = bArticles as typeof activeArticles;
  allAgendas = bAgendas as typeof allAgendas;
  allTeachers = bTeachers as typeof allTeachers;
  allRegistrations = bRegistrations as typeof allRegistrations;
  allUsers = bUsers as typeof allUsers;
  recentLogs = bLogs as typeof recentLogs;
} else {
  const [
    bArticles,
    bAgendas,
    bTeachers,
    bRegistrations,
  ] = await db.batch([
    db
      .select({
        id: articles.id,
        title: articles.title,
        slug: articles.slug,
        status: articles.status,
        viewCount: articles.viewCount,
        createdAt: articles.createdAt,
      })
      .from(articles)
      .where(isNull(articles.deletedAt))
      .orderBy(desc(articles.createdAt)),
    db
      .select({
        id: agendas.id,
        title: agendas.title,
        eventDate: agendas.eventDate,
        isCompleted: agendas.isCompleted,
      })
      .from(agendas)
      .orderBy(desc(agendas.createdAt)),
    db.select({ id: teachers.id, isActive: teachers.isActive }).from(teachers),
    db
      .select({
        status: registrations.status,
        verificationStatus: registrations.verificationStatus,
        selectionStatus: registrations.selectionStatus,
      })
      .from(registrations),
  ]);
  activeArticles = bArticles as typeof activeArticles;
  allAgendas = bAgendas as typeof allAgendas;
  allTeachers = bTeachers as typeof allTeachers;
  allRegistrations = bRegistrations as typeof allRegistrations;
}

// 1. Article & View Metrics
const publishedArticles = activeArticles.filter((a) => a.status === 'published');
const draftCount = activeArticles.filter((a) => a.status === 'draft').length;
const totalArticleViews = activeArticles.reduce((sum, a) => sum + (a.viewCount || 0), 0);
const topViewedArticles = [...publishedArticles]
  .sort((a, b) => (b.viewCount || 0) - (a.viewCount || 0))
  .slice(0, 5);
const maxArticleViews = Math.max(topViewedArticles[0]?.viewCount || 0, 1);
const topArticleTotalViews = topViewedArticles.reduce((sum, a) => sum + (a.viewCount || 0), 0);

// 2. Agenda Metrics
const upcomingAgendas = allAgendas.filter(
  (a) => !a.isCompleted && (!a.eventDate || a.eventDate >= todayWib),
);
const sortedUpcoming = [...upcomingAgendas].sort((a, b) => {
  if (!a.eventDate) return 1;
  if (!b.eventDate) return -1;
  return a.eventDate.localeCompare(b.eventDate);
});
const nextAgenda = sortedUpcoming[0];

// 3. GTK Metrics
const activeTeachersCount = allTeachers.filter((t) => t.isActive).length;

// 4. PPDB / Admissions Metrics
const schoolName = settingMap['school_name'] || 'Sekolah';
const schoolType = (settingMap['school_type'] || settingMap['school_level'] || 'SMA').toUpperCase();
const boardingAvailable = settingMap['boarding_available'] === 'true';
const admissionsLabel = settingMap['admissions_label'] || settingMap['ppdb_label'] || 'PPDB';

let ppdbConfig: PpdbFullConfig;
try {
  const parsed = settingMap['ppdb_form_config'] ? JSON.parse(settingMap['ppdb_form_config']) : null;
  ppdbConfig =
    parsed && Array.isArray(parsed.steps) && parsed.steps.length > 0
      ? parsed
      : getDefaultPpdbConfig(schoolType, schoolName, boardingAvailable);
} catch {
  ppdbConfig = getDefaultPpdbConfig(schoolType, schoolName, boardingAvailable);
}
const portalResolution = resolvePpdbPortal(ppdbConfig);

const totalRegistrations = allRegistrations.length;
const pendingVerificationCount = allRegistrations.filter(
  (r) => r.verificationStatus === 'pending',
).length;
const revisionRequiredCount = allRegistrations.filter(
  (r) => r.verificationStatus === 'revision_required',
).length;
const verifiedCount = allRegistrations.filter(
  (r) => r.verificationStatus === 'verified',
).length;
const acceptedCount = allRegistrations.filter(
  (r) => r.selectionStatus === 'accepted' || r.status === 'accepted',
).length;

// Extract first leading integer so strings like "360 Siswa Baru (10 Rombel)" parse as 360
const quotaMatch = (ppdbConfig.totalQuota || '').match(/\d+/);
const parsedTotalQuota = quotaMatch ? Number.parseInt(quotaMatch[0], 10) : 0;
const activeWaveQuota = portalResolution.activeWave?.quota || 0;
const numericQuota = parsedTotalQuota > 0 ? parsedTotalQuota : activeWaveQuota;
const quotaPercent = numericQuota > 0 ? Math.min(100, Math.round((totalRegistrations / numericQuota) * 100)) : 0;

// 5. User Metrics (Super Admin only)
const activeUsersCount = allUsers.filter((u) => u.isActive).length;
const superAdminCount = allUsers.filter((u) => u.role === 'super_admin' && u.isActive).length;
const editorCount = allUsers.filter((u) => u.role === 'editor' && u.isActive).length;

const entityLabels: Record<string, string> = {
  setting: 'Pengaturan Sekolah',
  settings: 'Pengaturan Sekolah',
  article: 'Berita & Artikel',
  articles: 'Berita & Artikel',
  teacher: 'Direktori Pendidik',
  teachers: 'Direktori Pendidik',
  agenda: 'Agenda Kegiatan',
  agendas: 'Agenda Kegiatan',
  announcement: 'Banner Pengumuman',
  announcements: 'Banner Pengumuman',
  document: 'Repositori Dokumen',
  documents: 'Repositori Dokumen',
  gallery: 'Galeri Media',
  galleries: 'Galeri Media',
  media: 'Pustaka Media',
  registration: 'Pendaftaran Siswa',
  registrations: 'Pendaftaran Siswa',
  ppdb_config: 'Konfigurasi PPDB',
  navigation: 'Navigasi Website',
  navigation_item: 'Navigasi Website',
  user: 'Pengguna & Staf',
  users: 'Pengguna & Staf',
  database: 'Basis Data',
  graduation: 'Pengumuman Kelulusan',
  bkk: 'BKK & Industri',
  mahad: "Ma'had & Tahfidz",
  student_alumni: 'Prestasi & Alumni',
};

function getEntityLabel(raw: string | null | undefined): string {
  if (!raw) return 'Sistem';
  return entityLabels[raw.toLowerCase().trim()] || raw;
}

function formatLogSummary(details: string | null | undefined): string {
  if (!details) return '-';
  const trimmed = details.trim();
  if (!trimmed.startsWith('{') && !trimmed.startsWith('[')) return trimmed;
  try {
    const parsed = JSON.parse(trimmed);
    if (Array.isArray(parsed)) return `${parsed.length} item diperbarui`;
    if (parsed && typeof parsed === 'object') {
      const entries = Object.entries(parsed).slice(0, 2);
      if (entries.length === 0) return 'Perubahan konfigurasi';
      return entries.map(([k, v]) => `${k}: ${String(v)}`).join(' • ');
    }
    return trimmed;
  } catch {
    return trimmed;
  }
}

function getActionBadgeClass(action: string): string {
  const upper = (action || '').toUpperCase();
  if (upper.includes('CREATE') || upper.includes('ADD')) return 'bg-success text-surface';
  if (upper.includes('DELETE') || upper.includes('REMOVE')) return 'bg-error text-surface';
  if (upper.includes('UPDATE') || upper.includes('EDIT')) return 'bg-primary text-surface';
  return 'bg-surface-subtle text-heading border border-border';
}

function formatDateIndo(dateStr: string | null | undefined, withTime = false): string {
  if (!dateStr) return '-';
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return String(dateStr);
    const options: Intl.DateTimeFormatOptions = {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    };
    if (withTime) {
      options.hour = '2-digit';
      options.minute = '2-digit';
    }
    const formatted = d.toLocaleDateString('id-ID', options);
    return withTime ? `${formatted} WIB` : formatted;
  } catch {
    return String(dateStr);
  }
}

const portalStatusLabel =
  portalResolution.effectiveStatus === 'opened'
    ? 'Dibuka'
    : portalResolution.effectiveStatus === 'upcoming'
      ? 'Segera Dibuka'
      : 'Ditutup';

const portalStatusBadgeClass =
  portalResolution.effectiveStatus === 'opened'
    ? 'bg-surface text-heading'
    : portalResolution.effectiveStatus === 'upcoming'
      ? 'bg-warning-light text-warning-text'
      : 'bg-surface-subtle text-muted';
---

<AdminLayout title="Dashboard" activeNav="dashboard" settingsMap={settingMap}>
  <div class="space-y-6 max-w-6xl">
    {Astro.url.searchParams.get('error') === 'unauthorized_role' && (
      <div class="rounded-[8px] border border-warning bg-warning p-3.5 text-xs font-medium text-surface flex items-center justify-between gap-4">
        <span>Akses Terbatas: Menu tersebut hanya dapat diakses oleh akun dengan peran Super Administrator.</span>
        <a href="/admin" class="text-surface hover:underline font-semibold shrink-0">Tutup</a>
      </div>
    )}

    <!-- 1. Banner Selamat Datang -->
    <div class="relative overflow-hidden p-5 sm:p-6 transition-all">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-5 relative z-10">
        <div class="space-y-1.5 min-w-0">
          
          <h1 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-heading">
            {greetingTime}, {userName}!
          </h1>

          <p class="font-body text-xs text-muted max-w-2xl leading-relaxed">
            Selamat datang di pusat kendali portal CMS {schoolName}.
          </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
          <a
            href="/admin/berita/tambah"
            class="inline-flex h-[38px] items-center justify-center gap-1.5 rounded-[6px] bg-primary px-4 font-body text-xs font-semibold text-white transition-all duration-200 hover:-translate-y-[1px] hover:bg-primary-hover hover:shadow-(--shadow-button-glow)"
          >
            <Icon name="plus" class="h-3.5 w-3.5" />
            <span>Tulis Berita</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 2. Empat Kartu KPI Utama (Token Tema global.css, Warna Solid Berbeda) -->
    <div data-admin-kpi-grid class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 *:flex *:flex-col *:justify-between *:rounded-[8px] *:border *:p-4 *:sm:p-5 *:transition-all *:duration-200">
      <a data-kpi-card href="/admin/berita" class="bg-primary border-primary text-primary-foreground hover:-translate-y-0.5 hover:bg-primary-hover hover:shadow-(--shadow-hover)">
        <div class="flex items-center justify-between gap-2">
          <span class="font-body text-xs font-semibold text-primary-foreground">Tayangan Artikel</span>
          <span class="rounded-[4px] bg-primary-foreground/15 border border-primary-foreground/25 px-2 py-0.5 text-[11px] font-semibold text-primary-foreground">
            {publishedArticles.length} terbit
          </span>
        </div>
        <div class="mt-3">
          <p data-kpi-number class="font-display text-3xl font-bold text-primary-foreground">
            {totalArticleViews.toLocaleString('id-ID')}
          </p>
          <p class="mt-1 text-[11px] font-medium opacity-85">
            {activeArticles.length} total &bull; {draftCount} draf
          </p>
        </div>
      </a>

      <a data-kpi-card href="/admin/pendaftaran/pendaftar" class="bg-success border-success text-white hover:-translate-y-0.5 hover:shadow-(--shadow-hover)">
        <div class="flex items-center justify-between gap-2">
          <span class="font-body text-xs font-semibold text-white">Pendaftar {admissionsLabel}</span>
          <span class:list={['rounded-[4px] px-2 py-0.5 text-[11px] font-semibold border', portalResolution.effectiveStatus === 'opened' ? 'bg-white/20 border-white/30 text-white' : 'bg-surface text-heading border-border']}>
            {portalStatusLabel}
          </span>
        </div>
        <div class="mt-3">
          <p data-kpi-number class="font-display text-3xl font-bold text-white">
            {totalRegistrations.toLocaleString('id-ID')}
          </p>
          <p class="mt-1 text-[11px] text-white font-medium opacity-85">
            {numericQuota > 0 ? `Kuota ${numericQuota.toLocaleString('id-ID')} calon siswa` : 'Pendaftaran aktif'}
          </p>
        </div>
      </a>

      <a data-kpi-card href="/admin/direktori" class="bg-secondary border-secondary text-secondary-foreground hover:-translate-y-0.5 hover:bg-secondary-hover hover:shadow-(--shadow-hover)">
        <div class="flex items-center justify-between gap-2">
          <span class="font-body text-xs font-semibold text-secondary-foreground">GTK Aktif</span>
          <span class="rounded-[4px] bg-secondary-foreground/15 border border-secondary-foreground/25 px-2 py-0.5 text-[11px] font-semibold text-secondary-foreground">
            Direktori
          </span>
        </div>
        <div class="mt-3">
          <p data-kpi-number class="font-display text-3xl font-bold text-secondary-foreground">
            {activeTeachersCount.toLocaleString('id-ID')}
          </p>
          <p class="mt-1 text-[11px] font-medium opacity-85">
            dari {allTeachers.length} total pendidik &amp; staf
          </p>
        </div>
      </a>

      {isSuperAdmin ? (
        <a data-kpi-card href="/admin/users" class="group bg-warning border-warning text-white hover:-translate-y-0.5">
          <div class="flex items-center justify-between gap-2">
            <span class="font-body text-xs font-semibold text-white">Pengguna CMS</span>
            <span class="rounded-[4px] bg-white/20 border border-white/30 px-2 py-0.5 text-[11px] font-semibold text-white">
              Aktif
            </span>
          </div>
          <div class="mt-3">
            <p data-kpi-number class="font-display text-3xl font-bold text-white group-hover:opacity-90 transition-opacity">
              {activeUsersCount}
            </p>
            <p class="mt-1 text-[11px] text-white font-medium opacity-85">
              {superAdminCount} Super Admin &bull; {editorCount} Editor
            </p>
          </div>
        </a>
      ) : (
        <a data-kpi-card href="/admin/agenda" class="group bg-surface-subtle border-border text-heading hover:-translate-y-0.5 hover:border-primary hover:shadow-(--shadow-hover)">
          <div class="flex items-center justify-between gap-2">
            <span class="font-body text-xs font-semibold text-muted">Agenda Mendatang</span>
            <span class="rounded-[4px] bg-primary px-2 py-0.5 text-[11px] font-semibold text-primary-foreground">
              Jadwal
            </span>
          </div>
          <div class="mt-3">
            <p data-kpi-number class="font-display text-3xl font-bold text-heading group-hover:text-primary transition-colors">
              {upcomingAgendas.length}
            </p>
            <p class="mt-1 text-[11px] text-muted font-medium">
              dari {allAgendas.length} total agenda
            </p>
          </div>
        </a>
      )}
    </div>

    <!-- 3. Agenda Terdekat (1 Baris Lega) -->
    <div class="rounded-[8px] border border-border bg-surface p-4 flex items-center justify-between gap-4">
      <div class="min-w-0 space-y-0.5">
        <span class="block font-body text-[11px] font-semibold uppercase tracking-wider text-muted">
          Agenda Sekolah Terdekat
        </span>
        {nextAgenda ? (
          <p class="text-xs font-semibold text-heading truncate" title={nextAgenda.title}>
            {nextAgenda.title} &bull; <span class="font-normal text-muted">{formatDateIndo(nextAgenda.eventDate)}</span>
          </p>
        ) : (
          <p class="text-xs text-muted">Tidak ada agenda terjadwal dalam waktu dekat.</p>
        )}
      </div>
      <a
        href="/admin/agenda"
        class="shrink-0 rounded-[6px] border border-border bg-surface-subtle px-3 py-1.5 text-[11px] font-semibold text-heading hover:border-primary hover:bg-primary hover:text-white transition-colors"
      >
        {nextAgenda ? 'Kelola Agenda' : 'Tambah Agenda'}
      </a>
    </div>

    <!-- 4. Ruang Kerja Utama: Publikasi Ber-tab (7 Kolom) & Status PPDB Real-Time (5 Kolom) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Kolom Kiri: Publikasi Sekolah (Tab: Terbaru | Terpopuler) -->
      <div class="lg:col-span-7 rounded-[8px] border border-border bg-surface p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4 border-b border-border pb-3.5">
          <div>
            <h2 class="font-display text-base font-bold text-heading">
              Publikasi &amp; Analitik Berita
            </h2>
          </div>

          <div class="flex items-center gap-2">
            <div class="inline-flex bg-surface-subtle *:px-2.5 *:py-1 *:text-[11px] *:cursor-pointer *:transition-colors *:first:rounded-l-[4px] *:last:rounded-r-[4px]" role="tablist" aria-label="Filter daftar berita">
              <button
                type="button"
                role="tab"
                aria-selected="true"
                data-article-tab="latest"
                class="article-tab-btn bg-primary font-semibold text-white"
              >
                Terbaru
              </button>
              <button
                type="button"
                role="tab"
                aria-selected="false"
                data-article-tab="top"
                class="article-tab-btn font-medium text-muted hover:text-heading"
              >
                Populer
              </button>
            </div>
          </div>
        </div>

        <!-- Panel Tab 1: Berita Terbaru -->
        <div id="panel-articles-latest">
          {activeArticles.length === 0 ? (
            <p class="py-8 text-center text-xs text-muted">Belum ada artikel berita yang dibuat.</p>
          ) : (
            <div class="divide-y divide-border *:py-3 *:flex *:items-center *:justify-between *:gap-3">
              {activeArticles.slice(0, 5).map((art) => (
                <div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                      <a
                        href={`/admin/berita/edit/${art.id}`}
                        class="font-display text-xs font-semibold text-heading hover:text-primary transition-colors truncate block"
                        title={art.title}
                      >
                        {art.title}
                      </a>
                    </div>
                  </div>

                  <div class="flex items-center gap-1.5 shrink-0 *:inline-flex *:items-center *:justify-center *:h-7 *:w-7 *:rounded-[6px] *:border *:border-border *:bg-surface *:transition-colors">
                    <a
                      href={`/admin/berita/edit/${art.id}`}
                      class="text-heading hover:border-primary hover:text-primary"
                      title="Edit Berita"
                      aria-label={`Edit berita: ${art.title}`}
                    >
                      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </a>
                    {art.status === 'published' && (
                      <a
                        href={`/berita/${art.slug}`}
                        target="_blank"
                        class="text-muted hover:text-heading hover:bg-surface-subtle"
                        title="Lihat Berita"
                        aria-label={`Lihat berita: ${art.title}`}
                      >
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Panel Tab 2: Grafik Analitik Artikel Terpopuler -->
        <div id="panel-articles-top" class="hidden">
          {topViewedArticles.length === 0 ? (
            <div class="py-10 text-center space-y-2">
              <div class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-surface-subtle text-muted mx-auto">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </div>
              <p class="text-xs text-muted">Belum ada data tayangan artikel terpublikasi.</p>
            </div>
          ) : (
            <div class="space-y-4 pt-1">
              <!-- Ringkasan Metrik Grafik -->
              <div class="flex items-center justify-between gap-3 text-xs border-b border-border/70 pb-3">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-[11px] text-muted uppercase tracking-wider">Top 5 Artikel</span>
                  <span class="text-muted/40">&bull;</span>
                  <span class="text-muted">Total: <strong class="font-mono font-semibold text-heading">{topArticleTotalViews.toLocaleString('id-ID')}</strong> tayangan</span>
                </div>
                <div class="text-muted text-[11px]">
                  Puncak: <span class="font-mono font-semibold text-primary">{maxArticleViews.toLocaleString('id-ID')}</span> views
                </div>
              </div>

              <!-- Visual Bar Chart Container -->
              <div class="rounded-[8px] border border-border bg-surface-subtle/50 p-3.5 sm:p-4">
                <div class="relative h-44 flex items-end justify-between gap-2 sm:gap-4 pt-6 pb-2 px-1">
                  <!-- Garis Skala Y-Axis -->
                  <div class="absolute inset-x-0 top-6 border-b border-dashed border-border pointer-events-none">
                    <span class="absolute right-0 -top-2 text-[9px] font-mono text-muted/70">{maxArticleViews.toLocaleString('id-ID')}</span>
                  </div>
                  <div class="absolute inset-x-0 top-[55%] border-b border-dashed border-border/60 pointer-events-none">
                    <span class="absolute right-0 -top-2 text-[9px] font-mono text-muted/70">{Math.round(maxArticleViews / 2).toLocaleString('id-ID')}</span>
                  </div>
                  <div class="absolute inset-x-0 bottom-8 border-b border-border pointer-events-none">
                    <span class="absolute right-0 -top-2 text-[9px] font-mono text-muted/70">0</span>
                  </div>

                  <!-- Kolom-Kolom Batang Grafik -->
                  {topViewedArticles.map((art, idx) => {
                    const views = art.viewCount || 0;
                    const barHeightPercent = Math.max(10, Math.round((views / maxArticleViews) * 100));
                    const isHighest = idx === 0;

                    return (
                      <a
                        href={`/admin/berita/edit/${art.id}`}
                        class="group relative flex-1 flex flex-col items-center h-full justify-end z-10 transition-transform duration-200 hover:-translate-y-0.5"
                        title={`${art.title} (${views.toLocaleString('id-ID')} tayangan)`}
                      >
                        <!-- Angka Metrik di Atas Batang -->
                        <span class="mb-1 font-mono text-[10px] sm:text-[11px] font-bold text-heading group-hover:text-primary transition-colors">
                          {views >= 1000 ? `${(views / 1000).toFixed(1)}k` : views}
                        </span>

                        <!-- Batang Kolom -->
                        <div class="w-full max-w-[42px] h-[calc(100%-48px)] flex items-end justify-center">
                          <div
                            class:list={[
                              'w-full rounded-t-[4px] transition-all duration-300',
                              isHighest
                                ? 'bg-primary group-hover:bg-primary-hover shadow-2xs'
                                : 'bg-primary/60 group-hover:bg-primary',
                            ]}
                            style={`height: ${barHeightPercent}%;`}
                          />
                        </div>

                        <!-- Label Ranking X-Axis -->
                        <div class="mt-2 text-center">
                          <span class:list={[
                            'inline-flex h-5 w-5 items-center justify-center rounded-full text-[10px] font-mono font-bold transition-colors',
                            isHighest
                              ? 'bg-primary text-primary-foreground font-semibold'
                              : 'bg-surface border border-border text-muted group-hover:border-primary group-hover:text-primary',
                          ]}>
                            #{idx + 1}
                          </span>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>

              <!-- Daftar Rincian Artikel -->
              <div class="divide-y divide-border/60 *:py-2 *:flex *:items-center *:justify-between *:gap-3 *:text-xs">
                {topViewedArticles.map((art, idx) => (
                  <div>
                    <div class="flex items-center gap-2 min-w-0">
                      <span class:list={[
                        'h-4 w-4 rounded-full flex items-center justify-center text-[9px] font-mono font-bold shrink-0',
                        idx === 0 ? 'bg-primary text-primary-foreground' : 'bg-surface-subtle text-muted border border-border',
                      ]}>
                        {idx + 1}
                      </span>
                      <a
                        href={`/admin/berita/edit/${art.id}`}
                        class="font-medium text-heading hover:text-primary transition-colors truncate"
                        title={art.title}
                      >
                        {art.title}
                      </a>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0 font-mono text-[11px]">
                      <span class="font-semibold text-heading">
                        {(art.viewCount || 0).toLocaleString('id-ID')}
                      </span>
                      <span class="text-[10px] text-muted">views</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      <!-- Kolom Kanan: Status PPDB Real-Time -->
      <div class="lg:col-span-5 rounded-[8px] border border-border bg-surface p-5 sm:p-6 space-y-5">
        <div class="w-full flex items-center justify-between border-b border-border pb-3.5">
          <div>
            <h2 class="font-display text-base font-bold text-heading">
              Status {admissionsLabel}
            </h2>
            <p class="text-[11px] text-muted">
              {portalResolution.activeWave?.name || ppdbConfig.activeWave} &bull; TA {ppdbConfig.academicYear}
            </p>
          </div>
          <a
            href="/admin/pendaftaran/pendaftar"
            class="rounded-[6px] border border-border bg-primary px-4 py-2.5 text-xs font-semibold text-white"
          >
            Data Pendaftar
          </a>
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted font-medium">Realisasi Pendaftar vs Kuota</span>
            <span class="font-mono font-semibold text-heading">
              {totalRegistrations.toLocaleString('id-ID')}
              {numericQuota > 0 ? ` / ${numericQuota.toLocaleString('id-ID')} (${quotaPercent}%)` : ''}
            </span>
          </div>
          <div class="h-2 w-full overflow-hidden rounded-full bg-surface-subtle">
            <div
              class="h-full rounded-full bg-success transition-all duration-300"
              style={`width: ${quotaPercent}%`}
            />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 *:rounded-[6px] *:border *:p-3.5 *:text-white *:transition-all *:duration-150">
          <div class="border-warning bg-warning">
            <span class="block text-[11px] font-medium text-white/90">Menunggu Verifikasi</span>
            <span class="mt-1 block font-display text-xl font-bold text-white">{pendingVerificationCount}</span>
          </div>
          <div class="border-error bg-error">
            <span class="block text-[11px] font-medium text-white/90">Perlu Revisi</span>
            <span class="mt-1 block font-display text-xl font-bold text-white">{revisionRequiredCount}</span>
          </div>
          <div class="border-primary bg-primary">
            <span class="block text-[11px] font-medium text-white/90">Terverifikasi</span>
            <span class="mt-1 block font-display text-xl font-bold text-white">{verifiedCount}</span>
          </div>
          <div class="border-success bg-success">
            <span class="block text-[11px] font-medium text-white/90">Lulus Seleksi</span>
            <span class="mt-1 block font-display text-xl font-bold text-white">{acceptedCount}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 5. Log Aktivitas Sistem (Super Admin Only) -->
    {isSuperAdmin && (
      <div class="rounded-[8px] border border-border bg-surface overflow-hidden">
        <div class="flex items-center justify-between px-5 py-3.5 border-b border-border">
          <div class="flex items-center gap-3">
            <h2 class="font-display text-sm font-bold text-heading">Log Aktivitas Sistem</h2>
            <span class="text-[11px] text-muted">5 rekam jejak terbaru</span>
          </div>
          <a href="/admin/logs" class="text-xs font-semibold text-primary hover:underline">
            Semua Log &rarr;
          </a>
        </div>

        {recentLogs.length === 0 ? (
          <p class="py-6 text-center text-xs text-muted">Belum ada catatan aktivitas sistem.</p>
        ) : (
          <div class="divide-y divide-border *:px-5 *:py-3 *:flex *:flex-col *:sm:flex-row *:sm:items-center *:justify-between *:gap-2 *:text-xs">
            {recentLogs.map((log) => {
              const summary = formatLogSummary(log.details);
              return (
                <div>
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class:list={['rounded-[4px] px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase shrink-0', getActionBadgeClass(log.action)]}>
                      {log.action}
                    </span>
                    <span class="font-semibold text-heading shrink-0">{getEntityLabel(log.entity)}</span>
                    <span class="text-muted truncate" title={summary}>
                      {summary !== '-' ? summary : (log.userEmail || 'Sistem')}
                    </span>
                  </div>
                  <div class="flex items-center gap-2 shrink-0 text-[11px] text-muted">
                    <span class="hidden md:inline truncate max-w-[180px]">{log.userEmail || 'Sistem'}</span>
                    <span class="hidden md:inline">&bull;</span>
                    <span class="font-mono">{formatDateIndo(log.createdAt, true)}</span>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    )}
  </div>

  <script is:inline>
    (function () {
      var buttons = document.querySelectorAll('[data-article-tab]');
      var panelLatest = document.getElementById('panel-articles-latest');
      var panelTop = document.getElementById('panel-articles-top');
      if (!buttons.length || !panelLatest || !panelTop) return;

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var target = btn.getAttribute('data-article-tab');
          var isLatest = target === 'latest';

          panelLatest.classList.toggle('hidden', !isLatest);
          panelTop.classList.toggle('hidden', isLatest);

          buttons.forEach(function (b) {
            var active = b === btn;
            b.setAttribute('aria-selected', active ? 'true' : 'false');
            b.classList.toggle('bg-primary', active);
            b.classList.toggle('font-semibold', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('font-medium', !active);
            b.classList.toggle('text-muted', !active);
          });
        });
      });
    })();
  </script>
</AdminLayout>
