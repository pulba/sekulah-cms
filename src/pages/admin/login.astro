---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { db, settings } from "../../db";

export const prerender = false;

// Ambil konfigurasi sekolah dari basis data
let schoolSettings: Record<string, string> = {};
try {
  const allSettings = await db.select().from(settings);
  schoolSettings = allSettings.reduce(
    (acc, curr) => {
      acc[curr.key] = curr.value;
      return acc;
    },
    {} as Record<string, string>,
  );
} catch {
  schoolSettings = {};
}

const schoolName = schoolSettings["school_name"] || "SMAN 1 Unggulan";
const logoUrl = schoolSettings["logo_url"] || "";
const schoolInitial = (schoolName.trim().charAt(0) || "S").toUpperCase();
const currentYear = new Date().getFullYear();
const loginBgImage =
  schoolSettings["login_bg_image"] ||
  schoolSettings["hero_image"] ||
  "/uploads/2026/11/1795061575645_gedung-depan.webp";

// Evaluasi pesan error dari redirect OAuth / RBAC
const urlError = Astro.url.searchParams.get("error");
let initialErrorMessage = "";
if (urlError) {
  const errorMap: Record<string, string> = {
    missing_google_config: "Kredensial Google OAuth2 belum dikonfigurasi di server.",
    csrf_failed: "Validasi keamanan CSRF gagal. Silakan coba lagi.",
    missing_code: "Kode otorisasi dari Google tidak ditemukan.",
    token_exchange_failed: "Gagal menukar kode otentikasi dengan Google.",
    firebase_auth_failed: "Autentikasi Firebase gagal. Periksa konfigurasi API Key.",
    account_disabled: "Akun Google Anda telah dinonaktifkan oleh Administrator.",
    unregistered_account: "Akun Google Anda belum terdaftar sebagai staf pengelola CMS. Sistem ini bersifat tertutup, hubungi Super Admin.",
    unauthorized_role: "Anda tidak memiliki hak akses untuk membuka halaman tersebut.",
    missing_email: "Akun Google tidak menyediakan alamat email yang valid.",
  };
  initialErrorMessage = errorMap[urlError] || `Autentikasi gagal (${urlError}). Silakan coba lagi.`;
}
---

<Layout
  title={`Masuk Administrator — ${schoolName}`}
  description={`Portal otorisasi dan sistem manajemen konten terpadu ${schoolName}.`}
  showFab={false}
>
  <div class="min-h-screen w-full flex items-center justify-center p-4 sm:p-6 lg:p-8 bg-surface-subtle">
    <!-- Card Container Split-Screen -->
    <div class="w-full max-w-4xl rounded-[16px] border border-border bg-surface shadow-xs overflow-hidden grid grid-cols-1 lg:grid-cols-12 min-h-[520px]">
      <!-- Panel Kiri: Branding & Visual Pendidikan (Desktop Only) -->
      <div class="hidden lg:flex lg:col-span-5 relative p-8 flex-col justify-between overflow-hidden bg-primary text-white">
        <!-- Visual Foto Sekolah -->
        <div class="absolute inset-0 z-0">
          <img
            src={loginBgImage}
            alt={`Kampus ${schoolName}`}
            class="h-full w-full object-cover object-center"
            width="800"
            height="1000"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-primary/90 mix-blend-multiply"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/80 to-primary/60"></div>
        </div>

        <!-- Konten Branding Kiri -->
        <div class="relative z-10 flex flex-col justify-between h-full space-y-6">
          <!-- Logo & Nama Sekolah -->
          <a href="/" class="inline-flex items-center gap-2.5">
            {logoUrl ? (
              <img
                src={logoUrl}
                alt={schoolName}
                class="h-9 w-9 rounded-[8px] object-contain"
                width="36"
                height="36"
                loading="eager"
              />
            ) : (
              <div class="flex h-9 w-9 items-center justify-center rounded-[8px] bg-white font-display font-bold text-primary text-sm shadow-xs">
                {schoolInitial}
              </div>
            )}
            <div class="flex flex-col">
              <span class="font-display text-sm font-bold tracking-tight text-white uppercase leading-tight line-clamp-1">
                {schoolName}
              </span>
              <span class="font-body text-[10px] text-white/70">
                Portal CMS
              </span>
            </div>
          </a>

          <!-- Headline & Subtitle Editorial -->
          <div class="space-y-3 my-auto">
            <h2 class="font-display text-2xl lg:text-3xl font-bold tracking-tight text-white leading-snug">
              Mengelola Pendidikan, Lebih Terintegrasi.
            </h2>
            <p class="font-body text-xs text-white/80 leading-relaxed">
              Sistem manajemen konten terpadu untuk publikasi informasi dan
              administrasi sekolah.
            </p>
          </div>

          <!-- Bottom Whitespace Placeholder -->
          <div class="text-[11px] text-white/50 font-body">
            Sistem Informasi Resmi
          </div>
        </div>
      </div>

      <!-- Panel Kanan: Form Autentikasi -->
      <div class="lg:col-span-7 p-6 sm:p-8 lg:p-10 flex flex-col justify-between bg-surface">
        <!-- Header: Mobile Brand + Navigasi Kembali -->
        <div class="flex items-center justify-between pb-4">
          <!-- Tampil di Mobile untuk Identitas Sekolah -->
          <div class="flex lg:hidden items-center gap-2">
            {logoUrl ? (
              <img
                src={logoUrl}
                alt={schoolName}
                class="h-7 w-7 rounded-[6px] object-contain bg-surface border border-border p-0.5"
                width="28"
                height="28"
              />
            ) : (
              <div class="flex h-7 w-7 items-center justify-center rounded-[6px] bg-primary font-display font-bold text-white text-xs">
                {schoolInitial}
              </div>
            )}
            <span class="font-display text-xs font-bold text-heading uppercase line-clamp-1">
              {schoolName}
            </span>
          </div>

          <!-- Tombol Kembali -->
          <a
            href="/"
            class="inline-flex items-center gap-1 font-body text-xs text-muted hover:text-heading transition-colors ml-auto"
          >
            <Icon name="chevron-left" class="h-3 w-3" />
            <span>Beranda Web</span>
          </a>
        </div>

        <!-- Konten Form Utama -->
        <div class="max-w-sm w-full mx-auto my-auto space-y-5">
          <!-- Heading -->
          <div class="space-y-1">
            <h1 class="font-display text-2xl font-bold tracking-tight text-heading">
              Selamat Datang
            </h1>
            <p class="font-body text-xs text-muted">
              Masuk ke akun administrator Anda.
            </p>
          </div>

          <!-- Error Banner -->
          <div
            id="error-banner"
            class:list={[
              "rounded-[6px] border border-error/20 bg-error-light p-3 font-body text-xs text-error-text font-medium",
              { hidden: !initialErrorMessage },
            ]}
            role="alert"
          >{initialErrorMessage}</div>

          <!-- Form Login -->
          <form id="login-form" class="space-y-4">
            <!-- Email -->
            <div class="space-y-1.5">
              <label
                for="email"
                class="block font-body text-xs font-semibold text-heading"
              >
                Email <span class="text-error">*</span>
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="nama@sekolah.sch.id"
                class="h-[40px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading placeholder:text-muted/60 transition-colors focus:border-primary focus:outline-none"
              />
            </div>

            <!-- Password + Toggle Show/Hide -->
            <div class="space-y-1.5">
              <label
                for="password"
                class="block font-body text-xs font-semibold text-heading"
              >
                Kata Sandi <span class="text-error">*</span>
              </label>
              <div class="relative">
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  autocomplete="current-password"
                  placeholder="••••••••"
                  class="h-[40px] w-full rounded-[6px] border border-border bg-surface pl-3 pr-10 font-body text-xs text-heading placeholder:text-muted/60 transition-colors focus:border-primary focus:outline-none"
                />
                <button
                  type="button"
                  id="toggle-password-btn"
                  class="absolute inset-y-0 right-0 flex items-center pr-3 text-muted hover:text-heading cursor-pointer transition-colors"
                  aria-label="Tampilkan kata sandi"
                >
                  <Icon id="eye-icon" name="eye" class="h-4 w-4" />
                  <Icon
                    id="eye-off-icon"
                    name="eye-off"
                    class="h-4 w-4 hidden"
                  />
                </button>
              </div>
            </div>

            <!-- Ingat Saya & Lupa Sandi -->
            <div class="flex items-center justify-between pt-0.5">
              <label
                for="remember-me"
                class="inline-flex items-center gap-2 cursor-pointer select-none"
              >
                <input
                  id="remember-me"
                  name="remember"
                  type="checkbox"
                  class="h-4 w-4 rounded-[4px] border-border text-primary focus:ring-0 cursor-pointer accent-primary"
                />
                <span class="font-body text-xs text-muted">Ingat saya</span>
              </label>

              <button
                type="button"
                id="forgot-password-link"
                class="font-body text-xs font-medium text-muted hover:text-heading hover:underline transition-colors cursor-pointer"
              >
                Lupa kata sandi?
              </button>
            </div>

            <!-- Tombol Masuk -->
            <button
              type="submit"
              id="submit-btn"
              class="mt-2 inline-flex h-[40px] w-full items-center justify-center gap-2 rounded-[6px] bg-primary font-body text-xs font-semibold text-white transition-all hover:bg-primary-hover hover:-translate-y-[1px] hover:shadow-(--shadow-button-glow) cursor-pointer disabled:opacity-50 disabled:pointer-events-none"
            >
              <span id="btn-text">Masuk ke Dashboard</span>
              <span id="btn-spinner" class="hidden items-center gap-2">
                <svg
                  class="h-3.5 w-3.5 animate-spin text-white"
                  viewBox="0 0 24 24"
                  fill="none"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"
                  ></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  ></path>
                </svg>
                <span>Memverifikasi...</span>
              </span>
            </button>

            <!-- Divider -->
            <div class="relative my-2.5 flex items-center justify-center">
              <div class="w-full border-t border-border"></div>
              <span class="absolute bg-surface px-2.5 font-body text-[11px] text-muted">
                atau
              </span>
            </div>

            <!-- Tombol Masuk dengan Google -->
            <button
              type="button"
              id="google-login-btn"
              class="inline-flex h-[40px] w-full items-center justify-center gap-2.5 rounded-[6px] border border-border bg-surface px-4 font-body text-xs font-medium text-heading transition-all hover:bg-surface-subtle hover:border-heading/30 cursor-pointer shadow-2xs"
            >
              <Icon name="google" class="h-4 w-4 shrink-0" />
              <span>Masuk dengan Google</span>
            </button>
          </form>
        </div>

        <!-- Footer Copyright -->
        <div class="pt-4 text-center">
          <p class="font-body text-[11px] text-muted">
            &copy; {currentYear} {schoolName}.
          </p>
        </div>
      </div>
    </div>

    <!-- Modal Informasi Lupa Kata Sandi -->
    <div
      id="forgot-modal"
      class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-heading/40 backdrop-blur-xs"
    >
      <div class="w-full max-w-sm rounded-[12px] border border-border bg-surface p-5 shadow-xl space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="font-display text-sm font-bold text-heading">
            Pemulihan Kata Sandi
          </h3>
          <button
            type="button"
            id="close-forgot-modal"
            class="text-muted hover:text-heading cursor-pointer p-1"
            aria-label="Tutup modal"
          >
            <Icon name="close" class="h-4 w-4" />
          </button>
        </div>

        <p class="font-body text-xs text-muted leading-relaxed">
          Reset kata sandi staf dan guru dilakukan oleh{" "}
          <strong class="text-heading">Super Admin IT</strong> sekolah. Silakan
          hubungi Unit IT atau Tata Usaha untuk penerbitan sandi baru.
        </p>

        <div class="pt-1 flex justify-end">
          <button
            type="button"
            id="close-forgot-modal-btn"
            class="inline-flex h-[32px] items-center justify-center rounded-[6px] bg-primary px-3 font-body text-xs font-semibold text-white hover:bg-primary-hover transition-colors cursor-pointer"
          >
            Tutup
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById("login-form") as HTMLFormElement;
    const errorBanner = document.getElementById(
      "error-banner",
    ) as HTMLDivElement;
    const submitBtn = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement;
    const btnText = document.getElementById("btn-text") as HTMLSpanElement;
    const btnSpinner = document.getElementById(
      "btn-spinner",
    ) as HTMLSpanElement;

    const emailInput = document.getElementById("email") as HTMLInputElement;
    const passwordInput = document.getElementById(
      "password",
    ) as HTMLInputElement;
    const rememberMeCheckbox = document.getElementById(
      "remember-me",
    ) as HTMLInputElement;
    const togglePasswordBtn = document.getElementById(
      "toggle-password-btn",
    ) as HTMLButtonElement;
    const eyeIcon = document.getElementById("eye-icon");
    const eyeOffIcon = document.getElementById("eye-off-icon");
    const googleLoginBtn = document.getElementById(
      "google-login-btn",
    ) as HTMLButtonElement;

    // Forgot Password Modal
    const forgotLink = document.getElementById("forgot-password-link");
    const forgotModal = document.getElementById("forgot-modal");
    const closeForgotBtn = document.getElementById("close-forgot-modal");
    const closeForgotBtn2 = document.getElementById("close-forgot-modal-btn");

    // Load saved email
    try {
      const savedEmail = localStorage.getItem("cms_remembered_email");
      if (savedEmail && emailInput) {
        emailInput.value = savedEmail;
        if (rememberMeCheckbox) rememberMeCheckbox.checked = true;
      }
    } catch {}

    // Show / Hide Password Toggle
    togglePasswordBtn?.addEventListener("click", () => {
      const isPassword = passwordInput.type === "password";
      passwordInput.type = isPassword ? "text" : "password";
      togglePasswordBtn.setAttribute(
        "aria-label",
        isPassword ? "Sembunyikan kata sandi" : "Tampilkan kata sandi",
      );
      eyeIcon?.classList.toggle("hidden", isPassword);
      eyeOffIcon?.classList.toggle("hidden", !isPassword);
    });

    // Modal Handlers
    forgotLink?.addEventListener("click", () =>
      forgotModal?.classList.remove("hidden"),
    );
    closeForgotBtn?.addEventListener("click", () =>
      forgotModal?.classList.add("hidden"),
    );
    closeForgotBtn2?.addEventListener("click", () =>
      forgotModal?.classList.add("hidden"),
    );
    forgotModal?.addEventListener("click", (e) => {
      if (e.target === forgotModal) forgotModal.classList.add("hidden");
    });

    // Google Sign-In Handler
    googleLoginBtn?.addEventListener("click", () => {
      window.location.href = "/api/auth/google";
    });

    // Form Submission
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorBanner.classList.add("hidden");
      errorBanner.innerText = "";
      submitBtn.disabled = true;
      btnText.classList.add("hidden");
      btnSpinner.classList.remove("hidden");
      btnSpinner.classList.add("flex");

      const email = emailInput?.value || "";
      const password = passwordInput?.value || "";

      // Remember me persistence
      try {
        if (rememberMeCheckbox?.checked) {
          localStorage.setItem("cms_remembered_email", email);
        } else {
          localStorage.removeItem("cms_remembered_email");
        }
      } catch {}

      try {
        const res = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, password }),
        });

        const data = await res.json();

        if (data.success) {
          window.location.href = "/admin";
        } else {
          errorBanner.innerText =
            data.error || "Autentikasi gagal. Periksa email atau sandi Anda.";
          errorBanner.classList.remove("hidden");
          submitBtn.disabled = false;
          btnText.classList.remove("hidden");
          btnSpinner.classList.add("hidden");
          btnSpinner.classList.remove("flex");
        }
      } catch {
        errorBanner.innerText = "Terjadi kesalahan jaringan. Coba lagi.";
        errorBanner.classList.remove("hidden");
        submitBtn.disabled = false;
        btnText.classList.remove("hidden");
        btnSpinner.classList.add("hidden");
        btnSpinner.classList.remove("flex");
      }
    });
  </script>
</Layout>
