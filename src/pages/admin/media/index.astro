        <!-- ==================== TAB 2: EDIT IMAGE / CROP (Screenshot 2) ==================== -->
        <div id="tab-content-crop" class="hidden space-y-4">
          <!-- Aspect Ratio Toolbar -->
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <label for="aspect-ratio-select" class="text-xs font-semibold text-heading shrink-0">Rasio Aspek:</label>
              <select
