                class="absolute cursor-move border border-primary shadow-[0_0_0_9999px_rgba(0,0,0,0.55)] top-[10%] left-[10%] w-[80%] h-[80%]"
              >
                <!-- 3x3 Rule-of-Thirds Grid (Primary dashed lines) -->
                <div class="absolute inset-0 grid grid-cols-3 grid-rows-3 pointer-events-none">
