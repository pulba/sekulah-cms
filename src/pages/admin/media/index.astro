                  <div class="border-r border-b border-dashed border-primary/70"></div>
                  <div class="border-b border-dashed border-primary/70"></div>
                  <div class="border-r border-b border-dashed border-primary/70"></div>
                  <div class="border-r border-b border-dashed border-primary/70"></div>
                  <div class="border-b border-dashed border-primary/70"></div>
                  <div class="border-r border-dashed border-primary/70"></div>
                  <div class="border-r border-dashed border-primary/70"></div>
                  <div></div>
