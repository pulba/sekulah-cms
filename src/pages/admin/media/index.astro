---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import Pagination from '../../../components/Pagination.astro';
import { db, media } from '../../../db';
import { desc, sql } from 'drizzle-orm';

export const prerender = false;

const PAGE_SIZE = 36;

// Ambil berkas awal dan hitung total berkas langsung via DB untuk SSR instan
const [totalRes, initialList] = await Promise.all([
  db.select({ count: sql<number>`count(*)` }).from(media),
  db.select().from(media).orderBy(desc(media.createdAt)).limit(PAGE_SIZE),
]);

const totalItems = Number(totalRes[0]?.count || 0);
const totalPages = Math.ceil(totalItems / PAGE_SIZE) || 1;

function getBadgeFormat(ext: string | null, mime: string | null): string {
  const e = (ext || '').toUpperCase();
  if (e === 'JPG' || e === 'JPEG') return 'JPEG';
  if (e === 'PNG') return 'PNG';
  if (e === 'WEBP') return 'WEBP';
  if (e === 'PDF') return 'PDF';
  if (e === 'MP4') return 'MP4';
  return e || 'FILE';
}
---

<AdminLayout title="Media Library" activeNav="media">
  <div class="space-y-4 max-w-7xl pb-20">
    <!-- Top Header Row (Exact match to reference screenshot) -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-1">
      <h1 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-heading">
        Media Library
      </h1>

      <div class="flex items-center gap-2.5">
        <!-- Button: + Add new folder -->
        <button
          type="button"
          id="btn-add-folder"
          class="inline-flex h-[36px] items-center gap-1.5 rounded-[6px] border border-border bg-surface px-3.5 text-xs font-semibold text-heading hover:bg-surface-subtle transition-colors shadow-2xs cursor-pointer"
        >
          <Icon name="folder" class="h-4 w-4 text-muted" />
          <span>Add new folder</span>
        </button>

        <!-- Button: Upload Files (Primary CTA) -->
        <button
          type="button"
          id="btn-open-upload"
          class="inline-flex h-[36px] items-center gap-1.5 rounded-[6px] bg-primary px-4 font-body text-xs font-semibold text-white shadow-xs transition-colors hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary cursor-pointer"
        >
          <Icon name="upload" class="h-4 w-4 text-white" />
          <span>Upload Files</span>
        </button>
      </div>
    </div>

    <!-- Filter & Toolbar Row (Exact match to reference screenshot) -->
    <div class="flex items-center justify-between gap-3 pt-0.5">
      <div class="flex items-center gap-2">
        <!-- Search Input -->
        <div class="relative w-64 sm:w-72">
          <Icon name="search" class="w-4 h-4 text-muted absolute left-3 top-2.5 pointer-events-none" />
          <input
            type="text"
            id="search-input"
            placeholder="Search by filename..."
            class="h-[36px] w-full rounded-[6px] border border-border bg-surface pl-9 pr-8 text-xs text-heading placeholder:text-muted/60 transition-colors"
          />
          <button
            type="button"
            id="btn-clear-search"
            class="hidden absolute inset-y-0 right-0 pr-2.5 flex items-center text-muted hover:text-heading cursor-pointer"
            aria-label="Clear search"
          >
            <Icon name="close" class="w-3.5 h-3.5" />
          </button>
        </div>

        <!-- Dropdown: All types ⌄ -->
        <div class="relative shrink-0">
          <button
            type="button"
            id="type-dropdown-btn"
            class="h-[36px] inline-flex items-center gap-2 rounded-[6px] border border-border bg-surface px-3 text-xs font-semibold text-heading hover:bg-surface-subtle transition-colors cursor-pointer shadow-2xs"
          >
            <span id="selected-type-label">All types</span>
            <Icon name="chevron-down" class="w-3.5 h-3.5 text-muted transition-transform duration-200" id="type-caret" />
          </button>

          <!-- Dropdown Menu (Exact match to screenshot) -->
          <div
            id="type-dropdown-menu"
            class="hidden absolute left-0 top-full mt-1.5 w-40 rounded-[8px] border border-border bg-surface shadow-xl z-30 py-1 text-xs"
          >
            <button type="button" class="type-opt-btn w-full px-3.5 py-2 text-left hover:bg-surface-subtle flex items-center justify-between font-semibold text-heading cursor-pointer" data-type="all">
              <span>All types</span>
              <span class="type-check text-heading font-bold">✓</span>
            </button>
            <button type="button" class="type-opt-btn w-full px-3.5 py-2 text-left hover:bg-surface-subtle flex items-center justify-between text-muted hover:text-heading cursor-pointer" data-type="image">
              <span>Images</span>
              <span class="type-check text-heading font-bold hidden">✓</span>
            </button>
            <button type="button" class="type-opt-btn w-full px-3.5 py-2 text-left hover:bg-surface-subtle flex items-center justify-between text-muted hover:text-heading cursor-pointer" data-type="video">
              <span>Video</span>
              <span class="type-check text-heading font-bold hidden">✓</span>
            </button>
            <button type="button" class="type-opt-btn w-full px-3.5 py-2 text-left hover:bg-surface-subtle flex items-center justify-between text-muted hover:text-heading cursor-pointer" data-type="audio">
              <span>Audio</span>
              <span class="type-check text-heading font-bold hidden">✓</span>
            </button>
            <button type="button" class="type-opt-btn w-full px-3.5 py-2 text-left hover:bg-surface-subtle flex items-center justify-between text-muted hover:text-heading cursor-pointer" data-type="document">
              <span>Documents</span>
              <span class="type-check text-heading font-bold hidden">✓</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Segmented View Toggle (Grid / List) -->
      <div class="inline-flex rounded-[8px] border border-border bg-surface-subtle p-0.5 shrink-0 *:h-[30px] *:w-[30px] *:rounded-[6px] *:flex *:items-center *:justify-center *:transition-all *:cursor-pointer">
        <button
          type="button"
          id="btn-view-grid"
          class="bg-surface text-heading shadow-2xs"
          title="Grid view"
        >
          <Icon name="grid" class="w-4 h-4" />
        </button>
        <button
          type="button"
          id="btn-view-list"
          class="text-muted hover:text-heading"
          title="List view"
        >
          <Icon name="list" class="w-4 h-4" />
        </button>
      </div>
    </div>

    <!-- Active Folder Breadcrumbs (Subtle indicator if folder active) -->
    <div id="folder-breadcrumb" class="hidden items-center gap-2 text-xs text-muted pt-1">
      <span>Folder:</span>
      <span id="active-folder-name" class="font-semibold text-heading">All Files</span>
      <button type="button" id="btn-reset-folder" class="text-primary hover:underline ml-1">
        Reset to all files
      </button>
    </div>

    <!-- Media Library Grid Container (Exact Match to Screenshot) -->
    <div id="media-container" class="min-h-[300px]">
      <!-- Grid View (4 Columns, Exactly matching reference image) -->
      <div id="media-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
        {initialList.map((item, index) => {
          const isImg = item.fileType?.startsWith('image/') || ['jpg', 'jpeg', 'png', 'webp', 'avif'].includes(item.fileExtension || '');
          const displayUrl = item.thumbnailUrl || item.mediumUrl || item.fileUrl;
          const badgeFormat = getBadgeFormat(item.fileExtension, item.fileType);
          const isAboveFold = index < 4;

          return (
            <a
              href={item.fileUrl || displayUrl}
              class="media-card group rounded-[10px] border border-border bg-surface overflow-hidden shadow-2xs hover:shadow-md transition-all cursor-pointer flex flex-col justify-between block no-underline text-inherit"
              data-id={item.id}
            >
              <!-- Image Container: Aspect 16/10 rounded image -->
              <div class="w-full aspect-[16/10] bg-surface-subtle overflow-hidden relative flex items-center justify-center">
                {isImg ? (
                  <img
                    src={displayUrl}
                    alt={item.originalName || item.fileName}
                    loading={isAboveFold ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding={isAboveFold ? "sync" : "async"}
                    class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-200"
                  />
                ) : (
                  <div class="flex flex-col items-center justify-center text-muted">
                    <span class="text-3xl mb-1">📄</span>
                  </div>
                )}
              </div>

              <!-- Bottom Row: filename on left, JPEG badge on right -->
              <div class="px-3.5 py-2.5 flex items-center justify-between gap-2 bg-surface">
                <span class="text-[11px] text-heading truncate" title={item.originalName || item.fileName}>
                  {item.originalName || item.fileName}
                </span>
                <span class="text-[10px] text-muted bg-surface-subtle px-1.5 py-0.5 rounded uppercase shrink-0 font-mono">
                  {badgeFormat}
                </span>
              </div>
            </a>
          );
        })}
      </div>

      <!-- List View -->
      <div id="media-list" class="hidden rounded-[10px] border border-border bg-surface overflow-hidden shadow-xs">
        <table class="w-full text-left font-body text-xs">
          <thead class="bg-surface-subtle text-[11px] font-semibold text-muted uppercase">
            <tr>
              <th class="py-3 px-4 w-14">Preview</th>
              <th class="py-3 px-4">Filename</th>
              <th class="py-3 px-4">Folder</th>
              <th class="py-3 px-4">Type / Size</th>
              <th class="py-3 px-4">Date</th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="media-table-body" class="divide-y divide-border"></tbody>
        </table>
      </div>

      <!-- Empty State -->
      <div
        id="empty-state"
        class="hidden flex flex-col items-center justify-center py-16 px-4 text-center rounded-[10px] border border-dashed border-border bg-surface min-h-[260px] space-y-3"
      >
        <span class="text-3xl">📂</span>
        <div>
          <h3 class="font-display text-sm font-bold text-heading">No files found</h3>
          <p class="text-xs text-muted mt-1">Upload files or adjust your search to see results.</p>
        </div>
        <button
          type="button"
          id="btn-upload-empty"
          class="inline-flex h-[36px] items-center gap-1.5 rounded-[6px] bg-primary px-4 font-body text-xs font-semibold text-white shadow-xs transition-colors hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary cursor-pointer"
        >
          <Icon name="upload" class="h-4 w-4 text-white" />
          <span>Upload Files</span>
        </button>
      </div>

      <!-- Loading State -->
      <div id="loading-state" class="hidden flex flex-col items-center justify-center py-16 text-muted">
        <svg class="animate-spin h-6 w-6 text-heading mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span class="text-xs font-mono">Loading media files...</span>
      </div>
    </div>

    <!-- Pagination Terpusat (Sesuai Standar Design System) -->
    <div id="media-pagination-container" class="rounded-[10px] border border-border bg-surface overflow-hidden shadow-2xs [&_.border-t]:border-t-0">
      <Pagination
        id="media-pagination"
        currentPage={1}
        totalPages={totalPages}
        totalItems={totalItems}
        pageSize={PAGE_SIZE}
        itemLabel="berkas media"
      />
    </div>
  </div>

  <!-- Initial SSR Data Container -->
  <script id="initial-media-data" type="application/json" set:html={JSON.stringify(initialList)}></script>

  <!-- ============================================================
       MODAL: ADD NEW FOLDER
  ============================================================ -->
  <div id="folder-modal" class="fixed inset-0 bg-heading/40 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="rounded-[10px] border border-border bg-surface p-5 shadow-2xl max-w-sm w-full space-y-4">
      <div class="flex items-center justify-between pb-3">
        <h3 class="font-display text-sm font-bold text-heading">Create new folder</h3>
        <button type="button" id="close-folder-modal-btn" class="text-muted hover:text-heading p-1 cursor-pointer" aria-label="Close modal">
          <Icon name="close" class="w-4 h-4" />
        </button>
      </div>
      <form id="folder-form" class="space-y-3.5">
        <div class="space-y-1">
          <label class="block text-xs font-semibold text-heading">Folder name</label>
          <input
            type="text"
            id="new-folder-name"
            placeholder="e.g. Foto Kegiatan 2026"
            required
            class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 text-xs text-heading transition-colors"
          />
        </div>
        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" id="cancel-folder-btn" class="h-[36px] px-4 rounded-[6px] border border-border text-xs font-medium text-heading hover:bg-surface-subtle transition-colors cursor-pointer">
            Cancel
          </button>
          <button type="submit" id="btn-submit-folder" class="inline-flex h-[36px] items-center justify-center gap-1.5 px-4 rounded-[6px] bg-primary text-white text-xs font-semibold hover:bg-primary-hover shadow-xs transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
            <Icon id="folder-save-icon" name="save" class="h-3.5 w-3.5 text-white" />
            <svg id="folder-save-spinner" class="hidden h-3.5 w-3.5 animate-spin text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <Icon id="folder-save-check" name="check" class="hidden h-3.5 w-3.5 text-white" />
            <span id="folder-save-text">Create folder</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================
       MODAL: UPLOAD FILES
  ============================================================ -->
  <div id="upload-modal" class="fixed inset-0 bg-heading/40 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="rounded-[10px] border border-border bg-surface p-6 shadow-2xl max-w-lg w-full space-y-4">
      <div class="flex items-center justify-between pb-3">
        <div>
          <h3 class="font-display text-base font-bold text-heading">Upload Files</h3>
          <p class="text-[11px] text-muted">Upload images, documents, or video to central storage.</p>
        </div>
        <button type="button" id="close-upload-modal-btn" class="text-muted hover:text-heading p-1 cursor-pointer" aria-label="Close modal">
          <Icon name="close" class="w-5 h-5" />
        </button>
      </div>

      <form id="upload-form" class="space-y-4">
        <div
          id="dropzone-area"
          class="rounded-[8px] border-2 border-dashed border-border/80 bg-surface-subtle hover:bg-surface-subtle hover:border-primary transition-all p-6 text-center cursor-pointer flex flex-col items-center justify-center gap-2 group"
        >
          <input
            type="file"
            id="file-input"
            name="file"
            multiple
            accept="image/*,video/mp4,audio/*,.pdf,.doc,.docx,.xls,.xlsx"
            class="hidden"
          />
          <div class="h-10 w-10 rounded-full bg-surface-subtle border border-border flex items-center justify-center text-primary">
            <Icon name="upload" class="w-5 h-5" />
          </div>
          <div>
            <p class="text-xs font-semibold text-heading">Click to upload or drag and drop</p>
            <p class="text-[11px] text-muted mt-0.5">JPG, PNG, WebP, PDF, MP4 (Max 15MB each)</p>
          </div>
          <div id="selected-files-list" class="hidden w-full pt-2 space-y-1 text-left"></div>
        </div>

        <div class="space-y-3">
          <div class="space-y-1">
            <label class="block text-xs font-semibold text-heading">Folder</label>
            <select
              id="upload-folder-select"
              class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 text-xs text-heading transition-colors"
            >
              <option value="Foto Kegiatan">Foto Kegiatan</option>
              <option value="Logo & Atribut">Logo & Atribut</option>
              <option value="Dokumen PPDB & Beasiswa">Dokumen Pendaftaran</option>
              <option value="Materi Pembelajaran">Materi Pembelajaran</option>
              <option value="Umum" selected>Umum</option>
            </select>
          </div>
        </div>

        <div id="upload-progress-container" class="hidden space-y-1.5 pt-2">
          <div class="flex items-center justify-between text-xs">
            <span id="upload-progress-text" class="font-medium text-heading">Uploading...</span>
            <span id="upload-progress-percent" class="font-mono text-muted">0%</span>
          </div>
          <div class="h-1.5 w-full bg-border rounded-full overflow-hidden">
            <div id="upload-progress-bar" class="h-full w-0 bg-primary transition-all duration-200"></div>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" id="btn-cancel-upload" class="h-[36px] px-4 rounded-[6px] border border-border text-xs font-medium text-heading hover:bg-surface-subtle transition-colors cursor-pointer">
            Cancel
          </button>
          <button type="submit" id="btn-submit-upload" class="inline-flex h-[36px] items-center justify-center gap-1.5 px-4 rounded-[6px] bg-primary text-white text-xs font-semibold hover:bg-primary-hover shadow-xs transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
            <Icon id="upload-save-icon" name="upload" class="h-3.5 w-3.5 text-white" />
            <svg id="upload-save-spinner" class="hidden h-3.5 w-3.5 animate-spin text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <Icon id="upload-save-check" name="check" class="hidden h-3.5 w-3.5 text-white" />
            <span id="upload-save-text">Upload</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================
       MODAL: DETAIL, EDIT / CROP IMAGE, & ASSET USAGE
  ============================================================ -->
  <div id="detail-modal" class="fixed inset-0 bg-heading/40 backdrop-blur-xs z-50 hidden flex items-center justify-center p-3 sm:p-4">
    <div class="rounded-[12px] border border-border bg-surface shadow-2xl max-w-xl w-full max-h-[92vh] flex flex-col overflow-hidden">
      <!-- Modal Header (Mirip Screenshot 1) -->
      <div class="flex items-start justify-between px-5 pt-4 bg-surface shrink-0">
        <div class="min-w-0 pr-3">
          <h3 class="font-display text-base font-bold text-heading">Media details</h3>
          <p id="detail-filename-subtitle" class="text-xs text-muted truncate mt-0.5">file.jpg</p>
        </div>
        <button type="button" id="close-detail-modal-btn" class="text-muted hover:text-heading p-1.5 rounded-md hover:bg-surface-subtle transition-colors cursor-pointer shrink-0" aria-label="Close modal">
          <Icon name="close" class="w-5 h-5" />
        </button>
      </div>

      <!-- Segmented Navigation Tabs: Details | Edit image -->
      <div class="px-5 py-2 shrink-0">
        <div class="grid grid-cols-2 gap-1 bg-surface-subtle border border-border rounded-lg text-xs font-medium">
          <button
            type="button"
            id="tab-btn-details"
            class="tab-btn flex items-center justify-center py-1.5 px-3 rounded-[6px] bg-surface text-heading font-semibold shadow-2xs transition-all cursor-pointer"
            data-tab="details"
          >
            Details
          </button>
          <button
            type="button"
            id="tab-btn-crop"
            class="tab-btn flex items-center justify-center py-1.5 px-3 rounded-[6px] text-muted hover:text-heading transition-all cursor-pointer"
            data-tab="crop"
          >
            Edit image
          </button>
        </div>
      </div>

      <!-- Modal Body Content with Scroll -->
      <div class="flex-1 overflow-y-auto p-5">
        <!-- ==================== TAB 1: DETAILS (Screenshot 1) ==================== -->
        <div id="tab-content-details" class="space-y-4">
          <!-- Image Preview -->
          <div class="relative rounded-[10px] flex items-center justify-center max-h-[200px] overflow-hidden">
            <img id="detail-preview-img" src="" alt="" class="max-h-[280px] w-auto max-w-full object-contain rounded-[6px]" />
            <div id="detail-preview-fallback" class="hidden py-14 text-center text-4xl">📄</div>
          </div>

          <!-- 2-Column Metadata Grid (Exact Match to Screenshot 1) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-1 gap-x-4 text-[11px]">
            <!-- Size -->
            <div class="flex items-center gap-2 text-muted min-w-0">
              <svg class="w-4 h-4 text-muted/80 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <rect x="3" y="4" width="18" height="16" rx="2" stroke-width="1.8" />
                <line x1="7" y1="12" x2="17" y2="12" stroke-width="1.8" />
              </svg>
              <span class="truncate">Size: <strong id="meta-size" class="font-semibold text-heading"></strong></span>
            </div>

            <!-- Dimensions -->
            <div class="flex items-center gap-2 text-muted min-w-0">
              <svg class="w-4 h-4 text-muted/80 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
              <span class="truncate">Dimensions: <strong id="meta-dimensions" class="font-semibold text-heading"></strong></span>
            </div>

            <!-- Uploaded Date -->
            <div class="flex items-center gap-2 text-muted min-w-0">
              <svg class="w-4 h-4 text-muted/80 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <rect x="3" y="4" width="18" height="18" rx="2" stroke-width="1.8" />
                <line x1="16" y1="2" x2="16" y2="6" stroke-width="1.8" />
                <line x1="8" y1="2" x2="8" y2="6" stroke-width="1.8" />
                <line x1="3" y1="10" x2="21" y2="10" stroke-width="1.8" />
              </svg>
              <span class="truncate">Uploaded: <strong id="meta-date" class="font-semibold text-heading"></strong></span>
            </div>

            <!-- Format -->
            <div class="flex items-center gap-2 text-muted min-w-0">
              <svg class="w-4 h-4 text-muted/80 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
