---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import MediaPickerModal from "../../../components/MediaPickerModal.astro";
import Icon from "../../../components/Icon.astro";
import { db, galleries } from "../../../db";
import { desc } from "drizzle-orm";

export const prerender = false;

const galleryList = await db
  .select()
  .from(galleries)
  .orderBy(desc(galleries.createdAt));
---

<AdminLayout title="Manajemen Galeri Kegiatan" activeNav="galeri">
  <div class="space-y-8 max-w-6xl">
    <div class="pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="font-display text-2xl font-bold tracking-tight text-heading">
          Galeri Kegiatan
        </h1>
        <p class="mt-1 font-body text-xs text-muted">
          Dokumentasi visual foto kegiatan sekolah.
        </p>
      </div>
      <button
        id="open-modal-btn"
        class="inline-flex h-[36px] items-center justify-center gap-1.5 rounded-[6px] bg-primary px-4 text-xs font-semibold text-white transition-all hover:bg-primary-hover shadow-xs shrink-0 cursor-pointer"
      >
        <Icon name="plus" class="h-4 w-4" />
        <span>Tambah Foto</span>
      </button>
    </div>

    <!-- Grid Kartu Media -->
    {galleryList.length === 0 ? (
      <div class="rounded-[8px] border border-border bg-surface p-12 text-center text-xs text-muted shadow-xs">
        Belum ada berkas galeri tersimpan. Klik "Tambah Media Baru" untuk
        mendokumentasikan foto kegiatan.
      </div>
    ) : (
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        id="gallery-grid"
      >
        {galleryList.map((item) => (
          <div
            class="gallery-item group rounded-[8px] border border-border bg-surface overflow-hidden shadow-xs hover:border-primary/40 transition-all flex flex-col justify-between"
            data-type={item.type}
            id={`gallery-${item.id}`}
          >
            <div>
              <div class="relative aspect-video w-full bg-surface-subtle overflow-hidden">
                <img
                  src={item.mediaUrl}
                  alt={item.caption || item.title}
                  loading="lazy"
                  class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>

              <div class="p-4 space-y-1.5">
                <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-primary">
                  {item.albumName || "Umum"}
                </span>
                <h3 class="font-display text-sm font-bold text-heading line-clamp-1">
                  {item.title}
                </h3>
                {item.caption && (
                  <p class="font-body text-xs text-muted line-clamp-2 leading-relaxed">
                    {item.caption}
                  </p>
                )}
              </div>
            </div>

            <div class="p-4 pt-0 border-t border-border/50 flex items-center justify-between text-xs">
              <span class="font-mono text-[10px] text-muted">
                {item.createdAt?.slice(0, 10)}
              </span>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  class="edit-btn font-semibold text-primary hover:underline"
                  data-item={JSON.stringify(item)}
                >
                  Edit
                </button>
                <span class="text-border">|</span>
                <button
                  type="button"
                  class="delete-btn font-semibold text-error hover:underline"
                  data-id={item.id}
                >
                  Hapus
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Slot Native Body-Level untuk Modals & Overlay Pickers -->
  <div slot="modals">
    <!-- MODAL: TAMBAH / EDIT DOKUMENTASI GALERI -->
    <div
      id="modal-backdrop"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-title"
      class="fixed inset-0 z-50 hidden overflow-y-auto bg-heading/60 backdrop-blur-xs p-4 sm:p-6"
    >
      <div class="flex min-h-full items-center justify-center">
        <div class="w-full max-w-lg max-h-[90dvh] flex flex-col rounded-[12px] border border-border bg-surface shadow-2xl overflow-hidden">
          <!-- Header Modal (Sticky) -->
          <div class="flex items-center justify-between px-5 py-4 bg-surface shrink-0 border-b border-border">
            <div class="flex items-center gap-3">
              <div class="flex h-8 w-8 items-center justify-center rounded-[6px] bg-primary/10 text-primary shrink-0">
                <Icon name="image" class="h-4 w-4" />
              </div>
              <div>
                <h3
                  id="modal-title"
                  class="font-display text-sm sm:text-base font-bold text-heading"
                >
                  Tambah Foto Dokumentasi
                </h3>
                <p class="text-[11px] text-muted">
                  Unggah atau pilih foto dokumentasi kegiatan sekolah.
                </p>
              </div>
            </div>
            <button
              id="close-modal-btn"
              type="button"
              class="text-muted hover:text-heading p-1.5 rounded-[6px] hover:bg-surface-subtle transition-colors cursor-pointer"
              title="Tutup"
              aria-label="Tutup"
            >
              <Icon name="close" class="h-4 w-4" />
            </button>
          </div>

          <!-- Form & Scrollable Body -->
          <form
            id="gallery-form"
            class="flex flex-col flex-1 min-h-0 overflow-hidden"
          >
            <div class="flex-1 min-h-0 overflow-y-auto px-5 py-4 space-y-4">
              <input type="hidden" id="edit-id" name="id" value="" />
              <input type="hidden" id="mediaUrl" name="mediaUrl" value="" />

              <!-- Judul & Album Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label
                    for="title"
                    class="block font-body text-xs font-medium text-heading mb-1"
                  >
                    Judul Dokumentasi <span class="text-error">*</span>
                  </label>
                  <input
                    id="title"
                    name="title"
                    type="text"
                    required
                    placeholder="Contoh: Upacara Hardiknas 2026"
                    class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading placeholder:text-muted focus:border-primary focus:outline-none transition-colors"
                  />
                </div>

                <div>
                  <label
                    for="albumName"
                    class="block font-body text-xs font-medium text-heading mb-1"
                  >
                    Nama Album <span class="text-muted font-normal">(Opsional)</span>
                  </label>
                  <input
                    id="albumName"
                    name="albumName"
                    type="text"
                    placeholder="Contoh: Hardiknas 2026"
                    class="h-[36px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading placeholder:text-muted focus:border-primary focus:outline-none transition-colors"
                  />
                </div>
              </div>

              <!-- Pilihan Berkas Foto (Media Library Picker) -->
              <div class="space-y-1.5">
                <label class="block font-body text-xs font-medium text-heading">
                  Berkas Foto <span class="text-error">*</span>
                </label>

                <!-- Preview Gambar Terpilih -->
                <div
                  id="image-preview-container"
                  class="hidden relative rounded-[8px] border border-border overflow-hidden bg-surface-subtle group"
                >
                  <img
                    id="image-preview"
                    src=""
                    alt="Preview Foto Kegiatan"
                    class="w-full h-44 object-cover"
                  />
                  <div class="absolute inset-0 bg-heading/60 opacity-0 group-hover:opacity-100 flex items-center justify-center gap-2 transition-opacity p-2">
                    <button
                      type="button"
                      id="btn-change-image"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-[6px] bg-primary text-white text-xs font-medium shadow-xs hover:bg-primary-hover transition-colors cursor-pointer"
                    >
                      <Icon name="image" class="h-3.5 w-3.5" />
                      <span>Ganti Foto</span>
                    </button>
                    <button
                      type="button"
                      id="btn-remove-image"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-[6px] bg-error text-white text-xs font-medium shadow-xs hover:bg-error/90 transition-colors cursor-pointer"
                    >
                      <Icon name="trash" class="h-3.5 w-3.5" />
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>

                <!-- Tombol Pilih Gambar (Empty State) -->
                <button
                  type="button"
                  id="btn-select-media"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-[6px] border border-dashed border-border bg-surface-subtle px-4 py-4 text-xs font-medium text-heading hover:bg-surface hover:border-primary/50 transition-colors cursor-pointer"
                >
                  <Icon name="image" class="h-4 w-4 text-muted" />
                  <span>Pilih Foto dari Pustaka Media</span>
                </button>
                <p class="text-[11px] text-muted">
                  Format gambar JPG, PNG, atau WebP resolusi tajam.
                </p>
              </div>

              <!-- Takarir / Aksesibilitas (Opsional) -->
              <div>
                <label
                  for="caption"
                  class="block font-body text-xs font-medium text-heading mb-1"
                >
                  Takarir / Keterangan Teks Alternatif <span class="text-muted font-normal">(Opsional)</span>
                </label>
                <textarea
                  id="caption"
                  name="caption"
                  rows="2"
                  placeholder="Keterangan singkat mengenai dokumentasi kegiatan untuk aksesibilitas dan SEO"
                  class="w-full rounded-[6px] border border-border bg-surface p-2.5 font-body text-xs text-heading placeholder:text-muted focus:border-primary focus:outline-none transition-colors"
                ></textarea>
              </div>
            </div>

            <!-- Footer Modal (Sticky) -->
            <div class="flex items-center justify-end gap-2 px-5 py-3.5 bg-surface-subtle shrink-0 border-t border-border">
              <button
                type="button"
                id="cancel-btn"
                class="inline-flex h-[34px] items-center justify-center rounded-[6px] border border-border bg-surface px-4 font-body text-xs font-medium text-heading hover:bg-surface-subtle transition-colors cursor-pointer"
              >
                Batal
              </button>
              <button
                type="submit"
                id="save-btn"
                class="inline-flex h-[34px] items-center justify-center rounded-[6px] bg-primary px-4 font-body text-xs font-semibold text-white transition-all hover:bg-primary-hover shadow-xs cursor-pointer"
              >
                Simpan Foto
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Pustaka Media Modal Component -->
    <MediaPickerModal modalId="media-picker-modal" />
  </div>

  <script>
    const modal = document.getElementById("modal-backdrop") as HTMLDivElement;
    const openBtn = document.getElementById("open-modal-btn") as HTMLButtonElement;
    const closeBtn = document.getElementById("close-modal-btn") as HTMLButtonElement;
    const cancelBtn = document.getElementById("cancel-btn") as HTMLButtonElement;
    const form = document.getElementById("gallery-form") as HTMLFormElement;
    const modalTitle = document.getElementById("modal-title") as HTMLHeadingElement;

    const editIdInput = document.getElementById("edit-id") as HTMLInputElement;
    const titleInput = document.getElementById("title") as HTMLInputElement;
    const albumNameInput = document.getElementById("albumName") as HTMLInputElement;
    const mediaUrlInput = document.getElementById("mediaUrl") as HTMLInputElement;
    const captionInput = document.getElementById("caption") as HTMLTextAreaElement;

    // Image preview & selector controls
    const imagePreviewContainer = document.getElementById("image-preview-container") as HTMLDivElement;
    const imagePreview = document.getElementById("image-preview") as HTMLImageElement;
    const btnSelectMedia = document.getElementById("btn-select-media") as HTMLButtonElement;
    const btnChangeImage = document.getElementById("btn-change-image") as HTMLButtonElement;
    const btnRemoveImage = document.getElementById("btn-remove-image") as HTMLButtonElement;

    // Helper: Set Picked Image
    function setPickedImage(url: string, alt = "") {
      if (url) {
        mediaUrlInput.value = url;
        imagePreview.src = url;
        imagePreview.alt = alt || "Foto Kegiatan";
        imagePreviewContainer.classList.remove("hidden");
        btnSelectMedia.classList.add("hidden");
      } else {
        mediaUrlInput.value = "";
        imagePreview.src = "";
        imagePreviewContainer.classList.add("hidden");
        btnSelectMedia.classList.remove("hidden");
      }
    }

    // Media Library Integration
    function openGalleryMediaPicker() {
      if (typeof (window as any).openMediaPicker === "function") {
        (window as any).openMediaPicker(
          (media: any) => {
            const url = media?.fileUrl || media?.mediumUrl || media?.url || "";
            if (url) {
              setPickedImage(url, media?.title || media?.originalName || "");
            }
          },
          { type: "image" }
        );
      } else {
        window.open("/admin/media", "_blank");
      }
    }

    btnSelectMedia?.addEventListener("click", openGalleryMediaPicker);
    btnChangeImage?.addEventListener("click", openGalleryMediaPicker);
    btnRemoveImage?.addEventListener("click", () => setPickedImage(""));

    // Reset Form
    function resetForm() {
      editIdInput.value = "";
      form.reset();
      modalTitle.innerText = "Tambah Foto Dokumentasi";
      setPickedImage("");
    }

    // Modal Visibility Control
    function openModal() {
      modal.classList.remove("hidden");
    }

    function closeModal() {
      modal.classList.add("hidden");
    }

    openBtn?.addEventListener("click", () => {
      resetForm();
      openModal();
      titleInput?.focus();
    });

    closeBtn?.addEventListener("click", closeModal);
    cancelBtn?.addEventListener("click", closeModal);

    // Close on click outside & Escape key
    modal?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target === modal || target?.classList?.contains("min-h-full")) {
        closeModal();
      }
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
        closeModal();
      }
    });

    // Handle Edit
    document.querySelectorAll(".edit-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const itemStr = (btn as HTMLElement).dataset.item;
        if (!itemStr) return;
        const item = JSON.parse(itemStr);

        editIdInput.value = item.id;
        titleInput.value = item.title || "";
        albumNameInput.value = item.albumName || "Umum";
        captionInput.value = item.caption || "";
        setPickedImage(item.mediaUrl || "");

        modalTitle.innerText = "Edit Foto Dokumentasi";
        openModal();
      });
    });

    // Handle Delete
    document.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = (btn as HTMLElement).dataset.id;
        const confirmed = await (window as any).confirmDialog({
          title: "Hapus Item Galeri",
          message:
            "Hapus item galeri ini?\nTindakan ini tidak dapat dibatalkan.",
          confirmText: "Ya, Hapus",
          cancelText: "Batal",
          type: "danger",
        });
        if (!confirmed) return;

        try {
          const res = await fetch(`/api/admin/galleries/${id}`, {
            method: "DELETE",
          });
          const result = await res.json();
          if (result.success) {
            document.getElementById(`gallery-${id}`)?.remove();
            (window as any).showToast?.(
              "Foto galeri berhasil dihapus.",
              "success"
            ) || alert("Foto galeri berhasil dihapus.");
          } else {
            (window as any).showToast?.(
              result.error || "Gagal menghapus galeri",
              "error"
            ) || alert(result.error || "Gagal menghapus galeri");
          }
        } catch {
          (window as any).showToast?.("Gagal menghubungi server.", "error") ||
            alert("Gagal menghubungi server.");
        }
      });
    });

    // Handle Form Submit
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const mediaUrl = mediaUrlInput.value.trim();
      if (!mediaUrl) {
        const msg = "Pilih foto dari Pustaka Media terlebih dahulu.";
        (window as any).showToast?.(msg, "warning") || alert(msg);
        return;
      }

      const id = editIdInput.value;
      const isEdit = Boolean(id);
      const url = isEdit
        ? `/api/admin/galleries/${id}`
        : "/api/admin/galleries";
      const method = isEdit ? "PUT" : "POST";

      const payload = {
        title: titleInput.value.trim(),
        type: "image",
        albumName: albumNameInput.value.trim() || "Umum",
        mediaUrl,
        caption: captionInput.value.trim() || null,
      };

      try {
        const res = await fetch(url, {
          method,
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (data.success) {
          closeModal();
          (window as any).showToast?.(
            isEdit ? "Foto berhasil diperbarui." : "Foto baru berhasil ditambahkan.",
            "success"
          );
          window.location.reload();
        } else {
          (window as any).showToast?.(data.error || "Gagal menyimpan foto.", "error") ||
            alert(data.error || "Gagal menyimpan foto.");
        }
      } catch {
        (window as any).showToast?.("Terjadi kesalahan jaringan.", "error") ||
          alert("Terjadi kesalahan jaringan.");
      }
    });
  </script>
</AdminLayout>
