---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import MediaPickerModal from "../../../components/MediaPickerModal.astro";
import Icon from "../../../components/Icon.astro";
import { db, settings } from "../../../db";
import {
  THEME_PRESETS,
  DEFAULT_THEME_PRESET,
  DEFAULT_THEME_MODE,
  resolveThemeConfig,
} from "../../../utils/themeSystem";

export const prerender = false;

// Ambil semua pengaturan institusi dari basis data
const allSettings = await db.select().from(settings);
const settingMap = allSettings.reduce(
  (acc, curr) => {
    acc[curr.key] = curr.value;
    return acc;
  },
  {} as Record<string, string>,
);

// 1. Identitas Visual
const schoolName = settingMap["school_name"] || "SMAN 1 UNGGULAN";
const npsn = settingMap["npsn"] || settingMap["school_npsn"] || "20101234";
const logoUrl = settingMap["logo_url"] || "";
const faviconUrl = settingMap["favicon_url"] || "/favicon.svg";
const headerShowSchoolName = settingMap["header_show_school_name"] !== "false";
const logoOrientation = settingMap["logo_orientation"] || "auto";
const resolvedTheme = resolveThemeConfig(settingMap);
const themePreset = resolvedTheme.presetId;
const primaryColor = resolvedTheme.identity.primary;
const secondaryColor = resolvedTheme.identity.secondary;
const tertiaryColor = resolvedTheme.identity.tertiary;
const themeMode = resolvedTheme.mode;

// 2. Kontak & Saluran Komunikasi
const phone = settingMap["phone"] || "(021) 555-0199";
const email = settingMap["email"] || "info@sman1unggulan.sch.id";

// 3. Media Sosial (Opsional)
const socialWhatsapp = settingMap["social_whatsapp"] || "+62 812-3456-7890";
const socialInstagram =
  settingMap["social_instagram"] || "https://instagram.com/sman1unggulan";
const socialYoutube =
  settingMap["social_youtube"] || "https://youtube.com/@sman1unggulan";
const socialFacebook =
  settingMap["social_facebook"] || "https://facebook.com/sman1unggulan";
const socialTwitter =
  settingMap["social_twitter"] || "https://x.com/sman1unggulan";
const socialTiktok = settingMap["social_tiktok"] || "";
const contactBgImage = settingMap["contact_bg_image"] || "";
---

<AdminLayout
  title="Pengaturan Sekolah"
  activeNav="pengaturan"
  settingsMap={settingMap}
>
  <div class="max-w-4xl mx-auto space-y-8 pb-24">
    <!-- Header Halaman & Aksi Simpan -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6">
      <div>
        <h1 class="font-display text-2xl font-bold tracking-tight text-heading">
          Pengaturan Sekolah
        </h1>
        <p class="mt-1 font-body text-xs text-muted">
          Kelola identitas visual website, logo, favicon, serta saluran kontak
          dan media sosial resmi.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <!-- Unsaved Changes Badge -->
        <span
          id="unsaved-badge"
          class="hidden text-[11px] font-medium text-warning-text bg-warning-light border border-warning px-2.5 py-1 rounded-[4px] animate-pulse"
        >
          Perubahan belum disimpan
        </span>

        <button
          type="button"
          id="btn-header-save"
          class="inline-flex h-9 items-center justify-center gap-2 rounded-md bg-primary px-4 text-xs font-semibold text-white transition-all hover:bg-primary-hover shadow-xs cursor-pointer disabled:opacity-75 disabled:cursor-not-allowed"
        >
          <Icon id="btn-save-icon" name="save" class="h-3.5 w-3.5 text-white" />
          <svg
            id="btn-save-spinner"
            class="hidden h-3.5 w-3.5 animate-spin text-white"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            ></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
          <Icon
            id="btn-save-check"
            name="check"
            class="hidden h-3.5 w-3.5 text-white"
          />
          <span id="btn-header-label">Simpan Perubahan</span>
        </button>
      </div>
    </div>

    <!-- Alert Feedback Banner -->
    <div
      id="status-banner"
      class="hidden rounded-lg p-3.5 text-xs font-medium"
    ></div>

    <form id="settings-form" class="space-y-8">
      <!-- Hidden Values (Tanpa input teks URL teknis di UI) -->
      <input type="hidden" id="logo_url" name="logo_url" value={logoUrl} />
      <input
        type="hidden"
        id="favicon_url"
        name="favicon_url"
        value={faviconUrl}
      />
      <input
        type="hidden"
        id="header_show_school_name"
        name="header_show_school_name"
        value={headerShowSchoolName ? "true" : "false"}
      />

      <!-- SECTION 1: IDENTITAS WEBSITE                            -->

      <section class="space-y-4">
        <div class="rounded-lg border border-border bg-surface p-5 sm:p-6 space-y-6">
          <!-- 1.1 LOGO SEKOLAH -->
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <label class="block text-xs font-semibold text-heading">
                  Logo Sekolah
                </label>
              </div>
            </div>

            <!-- Card Thumbnail & Controls -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <!-- Thumbnail Box -->
                <div class="h-16 w-20 rounded-md bg-white flex items-center justify-center overflow-hidden shrink-0 shadow-2xs p-1">
                  <img
                    id="logo-preview-img"
                    src={logoUrl || ""}
                    alt="Logo Sekolah"
                    class:list={[
                      "max-h-full max-w-full object-contain",
                      !logoUrl && "hidden",
                    ]}
                  />
                  <div
                    id="logo-preview-empty"
                    class:list={[
                      "flex flex-col items-center justify-center text-muted text-center",
                      logoUrl && "hidden",
                    ]}
                  >
                    <svg
                      class="h-6 w-6 text-muted/60"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                      ></path>
                    </svg>
                    <span class="text-[9px] font-medium mt-0.5">Kosong</span>
                  </div>
                </div>

                <!-- Info File -->
                <div>
                  <p
                    id="logo-filename"
                    class="text-xs font-semibold text-heading truncate max-w-[220px] sm:max-w-xs font-mono"
                  >
                    {logoUrl
                      ? logoUrl.split("/").pop()
                      : "Belum ada logo dipilih"}
                  </p>
                  <p class="text-[11px] text-muted mt-0.5">
                    {logoUrl
                      ? "Berkas terpasang untuk identitas sekolah"
                      : "Pilih dari media library atau unggah berkas logo baru"}
                  </p>
                </div>
              </div>

              <!-- Tombol Aksi Logo -->
              <div class="flex items-center gap-2 shrink-0">
                <button
                  type="button"
                  id="btn-pick-logo"
                  class="h-8 px-3 rounded-md border border-border bg-surface text-xs font-medium text-heading hover:bg-surface-subtle transition-colors cursor-pointer inline-flex items-center gap-1.5 shadow-2xs"
                >
                  <svg
                    class="h-3.5 w-3.5 text-muted"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                    ></path>
                  </svg>
                  <span>Pilih dari Media</span>
                </button>

                <label
                  for="upload-logo-file"
                  class="h-8 px-3 rounded-md border border-border bg-surface text-xs font-medium text-heading hover:bg-surface-subtle transition-colors cursor-pointer inline-flex items-center gap-1.5 shadow-2xs"
                >
                  <svg
                    class="h-3.5 w-3.5 text-muted"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
                    ></path>
                  </svg>
                  <span>Unggah Berkas</span>
                </label>
                <input
                  type="file"
                  id="upload-logo-file"
                  accept="image/png,image/jpeg,image/svg+xml,image/webp"
                  class="hidden"
                />

                <button
                  type="button"
                  id="btn-remove-logo"
                  class:list={[
                    "h-8 px-2.5 rounded-md text-xs font-medium text-error hover:bg-error-light transition-colors cursor-pointer",
                    !logoUrl && "hidden",
                  ]}
                >
                  Hapus
                </button>
              </div>
            </div>
          </div>

          <!-- 1.2 TAMPILAN HEADER: SWITCH & ORIENTASI LOGO -->
          <div class="pt-5 space-y-5">
            <!-- Switch Tampilkan Nama Sekolah -->
            <div class="flex items-center justify-between gap-4 bg-surface">
              <div class="space-y-0.5">
                <span class="block text-xs font-semibold text-heading">
                  Tampilkan Nama Sekolah di Header
                </span>
              </div>

              <!-- Switch Toggle -->
              <label class="relative inline-flex items-center cursor-pointer shrink-0">
                <input
                  type="checkbox"
                  id="toggle-show-school-name"
                  checked={headerShowSchoolName}
                  class="sr-only peer"
                />
                <div class="w-11 h-6 bg-border peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-border after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
              </label>
            </div>

            <!-- Orientasi Logo -->
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <div>
                  <label class="block text-xs font-semibold text-heading">
                    Orientasi Logo
                  </label>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <!-- Auto -->
                <label class="logo-orient-card p-3 rounded-lg border border-border bg-surface hover:border-primary/50 cursor-pointer flex items-start gap-2.5 transition-all">
                  <input
                    type="radio"
                    name="logo_orientation"
                    value="auto"
                    checked={logoOrientation === "auto"}
                    class="mt-0.5 text-primary cursor-pointer"
                  />
                  <div>
                    <span class="font-semibold text-xs text-heading block">
                      Otomatis
                    </span>
                    <span class="text-[11px] text-muted leading-tight">
                      Mengikuti rasio asli logo secara fleksibel (Rekomendasi).
                    </span>
                  </div>
                </label>

                <!-- Square -->
                <label class="logo-orient-card p-3 rounded-lg border border-border bg-surface hover:border-primary/50 cursor-pointer flex items-start gap-2.5 transition-all">
                  <input
                    type="radio"
                    name="logo_orientation"
                    value="square"
                    checked={logoOrientation === "square"}
                    class="mt-0.5 text-primary cursor-pointer"
                  />
                  <div>
                    <span class="font-semibold text-xs text-heading block">
                      Logo Persegi
                    </span>
                    <span class="text-[11px] text-muted leading-tight">
                      Area proporsional 1:1, cocok untuk lambang perisai atau
                      lingkaran.
                    </span>
                  </div>
                </label>

                <!-- Horizontal -->
                <label class="logo-orient-card p-3 rounded-lg border border-border bg-surface hover:border-primary/50 cursor-pointer flex items-start gap-2.5 transition-all">
                  <input
                    type="radio"
                    name="logo_orientation"
                    value="horizontal"
                    checked={logoOrientation === "horizontal"}
                    class="mt-0.5 text-primary cursor-pointer"
                  />
                  <div>
                    <span class="font-semibold text-xs text-heading block">
                      Logo Horizontal
                    </span>
                    <span class="text-[11px] text-muted leading-tight">
                      Area landscape memanjang untuk logo sekolah bertipe
                      banner.
                    </span>
                  </div>
                </label>
              </div>
            </div>
          </div>

          <!-- 1.3 LIVE PREVIEW HEADER WEBSITE -->
          <div class="border-t border-border/70 pt-5 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-bold uppercase tracking-wider text-muted">
                Preview Header Website (Langsung Berubah)
              </span>
              <span class="text-[11px] text-muted italic">
                Simulasi tampilan header publik sebelum disimpan
              </span>
            </div>

            <!-- Frame Header Mini Mockup -->
            <div class="rounded-lg border border-border bg-surface-subtle p-3 shadow-xs">
              <div
                id="mock-header"
                class="rounded-md border border-border bg-white px-4 py-3 flex items-center justify-between gap-4 transition-all"
              >
                <!-- Brand / Logo Area -->
                <div class="flex items-center gap-2.5 shrink-0">
                  <div
                    id="mock-logo-wrapper"
                    class="flex items-center justify-center shrink-0"
                  >
                    <img
                      id="mock-logo-img"
                      src={logoUrl || ""}
                      alt={schoolName}
                      class:list={[
                        "object-contain rounded-[4px] transition-all",
                        logoOrientation === "horizontal"
                          ? "h-8 max-w-[150px] w-auto"
                          : logoOrientation === "square"
                            ? "h-8 w-8"
                            : "h-8 max-w-[130px] w-auto",
                        !logoUrl && "hidden",
                      ]}
                    />
                    <div
                      id="mock-logo-placeholder"
                      class:list={[
                        "flex h-8 w-8 items-center justify-center rounded-[6px] font-display font-bold text-white text-xs shrink-0",
                        logoUrl && "hidden",
                      ]}
                      style={`background-color: ${primaryColor};`}
                    >
                      {schoolName.charAt(0) || "S"}
                    </div>
                  </div>

                  <!-- Text Nama Sekolah (Bisa sembunyi/tampil) -->
                  <div
                    id="mock-school-name-block"
                    class:list={[
                      "flex flex-col transition-all",
                      !headerShowSchoolName && "hidden",
                    ]}
                  >
                    <span class="font-display text-xs font-bold uppercase tracking-tight text-heading leading-tight">
                      {schoolName}
                    </span>
                    <span class="text-[9px] uppercase tracking-wider text-muted font-mono leading-tight">
                      NPSN: {npsn}
                    </span>
                  </div>
                </div>

                <!-- Dummy Navigasi Header Mockup -->
                <div class="hidden sm:flex items-center gap-3 text-[11px] font-medium text-muted">
                  <span class="text-heading font-semibold">Beranda</span>
                  <span>Profil</span>
                  <span>Berita</span>
                  <span>Kontak</span>
                  <span
                    id="mock-btn-ppdb"
                    class="px-2.5 py-1 rounded text-white text-[10px] font-bold uppercase tracking-wider shadow-2xs"
                    style={`background-color: ${primaryColor};`}
                  >
                    PPDB
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- 1.4 FAVICON WEBSITE -->
          <div class="border-t border-border/70 pt-5 space-y-3">
            <div>
              <label class="block text-xs font-semibold text-heading">
                Favicon Website
              </label>
              <p class="text-[11px] text-muted">
                Ikon tab browser dan bookmark peramban (format .ico, .svg, atau
                .png).
              </p>
            </div>

            <!-- Card Thumbnail Favicon -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-lg border border-border bg-surface-subtle">
              <div class="flex items-center gap-4">
                <div class="h-10 w-10 rounded-md border border-border bg-white flex items-center justify-center overflow-hidden shrink-0 shadow-2xs p-1">
                  <img
                    id="favicon-preview-img"
                    src={faviconUrl}
                    alt="Favicon"
                    class="h-6 w-6 object-contain"
                  />
                </div>

                <div>
                  <p
                    id="favicon-filename"
                    class="text-xs font-semibold text-heading truncate max-w-[220px] sm:max-w-xs font-mono"
                  >
                    {faviconUrl.split("/").pop()}
                  </p>
                  <p class="text-[11px] text-muted mt-0.5">
                    Ikon aktif pada tab peramban pengunjung
                  </p>
                </div>
              </div>

              <!-- Tombol Aksi Favicon -->
              <div class="flex items-center gap-2 shrink-0">
                <button
                  type="button"
                  id="btn-pick-favicon"
                  class="h-8 px-3 rounded-md border border-border bg-surface text-xs font-medium text-heading hover:bg-surface-subtle transition-colors cursor-pointer inline-flex items-center gap-1.5 shadow-2xs"
                >
                  <svg
                    class="h-3.5 w-3.5 text-muted"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                    ></path>
                  </svg>
                  <span>Pilih dari Media</span>
                </button>

                <label
                  for="upload-favicon-file"
                  class="h-8 px-3 rounded-md border border-border bg-surface text-xs font-medium text-heading hover:bg-surface-subtle transition-colors cursor-pointer inline-flex items-center gap-1.5 shadow-2xs"
                >
                  <svg
                    class="h-3.5 w-3.5 text-muted"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
                    ></path>
                  </svg>
                  <span>Unggah Berkas</span>
                </label>
                <input
                  type="file"
                  id="upload-favicon-file"
                  accept="image/png,image/x-icon,image/svg+xml"
                  class="hidden"
                />

                <button
                  type="button"
                  id="btn-reset-favicon"
                  class="h-8 px-2.5 rounded-md text-xs font-medium text-muted hover:text-heading transition-colors cursor-pointer"
                >
                  Reset Default
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 2: TAMPILAN & SISTEM WARNA (APPEARANCE)          -->

      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 pb-3">
          <div>
            <h2 class="font-display text-base font-semibold text-heading">
              Tampilan &amp; Sistem Warna (Appearance)
            </h2>
            <p class="mt-0.5 text-xs text-muted">
              Pilih preset tema atau atur 3 warna identitas sekolah. Sistem
              otomatis menghasilkan variasi warna antarmuka Light &amp; Dark
              Mode.
            </p>
          </div>
          <button
            type="button"
            id="btn-reset-theme"
            class="inline-flex h-8 items-center justify-center rounded-[6px] border border-border bg-surface px-3 font-body text-xs font-medium text-heading transition-colors hover:border-heading hover:bg-surface-subtle cursor-pointer shrink-0"
          >
            Reset Theme Default
          </button>
        </div>

        <input
          type="hidden"
          id="theme_preset"
          name="theme_preset"
          value={themePreset}
        />

        <div class="rounded-lg border border-border bg-surface p-5 sm:p-6 space-y-6">
          <!-- 2.1 Theme Preset -->
          <div class="space-y-2.5">
            <div class="flex items-center justify-between gap-2">
              <span class="block text-xs font-semibold text-heading">
                Theme Preset Siap Pakai
              </span>
              <span
                id="active-preset-badge"
                class="rounded-[4px] bg-surface-subtle border border-border px-2 py-0.5 font-mono text-[11px] font-medium text-muted"
              >
                {themePreset === "custom"
                  ? "Custom Colors"
                  : `Preset: ${themePreset}`}
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
              {THEME_PRESETS.map((preset) => {
                const isSelected = themePreset === preset.id;
                return (
                  <button
                    type="button"
                    class={`btn-swatch-preset p-3 rounded-[8px] border text-left cursor-pointer transition-all flex items-center gap-3 group ${
                      isSelected
                        ? "border-primary bg-primary-light/60"
                        : "border-border bg-surface hover:border-heading"
                    }`}
                    data-preset-id={preset.id}
                    data-primary={preset.identity.primary}
                    data-secondary={preset.identity.secondary}
                    data-tertiary={preset.identity.tertiary}
                  >
                    <div class="flex items-center gap-1 shrink-0">
                      <span
                        class="h-5 w-5 rounded-[4px] border border-black/10 inline-block"
                        style={`background-color: ${preset.identity.primary};`}
                        title={`Primary: ${preset.identity.primary}`}
                      ></span>
                      <span
                        class="h-5 w-5 rounded-[4px] border border-black/10 inline-block"
                        style={`background-color: ${preset.identity.secondary};`}
                        title={`Secondary: ${preset.identity.secondary}`}
                      ></span>
                      <span
                        class="h-5 w-5 rounded-[4px] border border-black/10 inline-block"
                        style={`background-color: ${preset.identity.tertiary};`}
                        title={`Tertiary: ${preset.identity.tertiary}`}
                      ></span>
                    </div>
                    <div class="min-w-0 flex-1">
                      <span class="block text-xs font-semibold text-heading group-hover:text-primary transition-colors truncate">
                        {preset.name}
                      </span>
                      <span class="block text-[11px] text-muted truncate">
                        {preset.tagline}
                      </span>
                    </div>
                  </button>
                );
              })}
            </div>
          </div>

          <!-- 2.2 Tiga Identitas Warna Sekolah -->
          <div class="pt-5 border-t border-border/70 space-y-3">
            <div>
              <span class="block text-xs font-semibold text-heading">
                Identitas Warna Sekolah (Custom Color)
              </span>
              <p class="mt-0.5 text-[11px] text-muted">
                Mengubah warna di bawah akan otomatis mengkalibrasi palet Light
                &amp; Dark Mode serta menandai tema sebagai Custom.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <!-- Primary Color -->
              <div class="space-y-1.5">
                <label
                  for="primary_color"
                  class="block text-xs font-semibold text-heading"
                >
                  Primary Color
                </label>
                <div class="flex items-center gap-2">
