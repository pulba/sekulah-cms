  <MediaPickerModal id="settings-media-picker" />

  <script is:inline>
    function initPengaturan() {
      const form = document.getElementById("settings-form");
      const banner = document.getElementById("status-banner");
      const btnHeaderSave = document.getElementById("btn-header-save");
      const headerLabel = document.getElementById("btn-header-label");
      const saveIcon = document.getElementById("btn-save-icon");
      const saveSpinner = document.getElementById("btn-save-spinner");
      const saveCheck = document.getElementById("btn-save-check");
      const unsavedBadge = document.getElementById("unsaved-badge");

      // Track Form Changes (Dirty State)
      let isFormDirty = false;
      function markFormDirty(dirty = true) {
        isFormDirty = dirty;
        if (unsavedBadge) {
          if (dirty) {
            unsavedBadge.classList.remove("hidden");
          } else {
            unsavedBadge.classList.add("hidden");
          }
        }
      }

      window.addEventListener("beforeunload", (e) => {
        if (isFormDirty) {
          e.preventDefault();
          e.returnValue = "Ada perubahan pengaturan yang belum disimpan.";
        }
      });

      // Inputs & Elements
      const logoInput = document.getElementById("logo_url");
      const logoImg = document.getElementById("logo-preview-img");
      const logoEmpty = document.getElementById("logo-preview-empty");
      const logoFilename = document.getElementById("logo-filename");
      const btnPickLogo = document.getElementById("btn-pick-logo");
      const btnRemoveLogo = document.getElementById("btn-remove-logo");
      const uploadLogoFile = document.getElementById("upload-logo-file");

      const toggleShowSchoolName = document.getElementById(
        "toggle-show-school-name",
      );
      const headerShowNameInput = document.getElementById(
        "header_show_school_name",
      );
      const orientRadios = document.querySelectorAll(
        'input[name="logo_orientation"]',
      );

      const faviconInput = document.getElementById("favicon_url");
      const faviconImg = document.getElementById("favicon-preview-img");
      const faviconFilename = document.getElementById("favicon-filename");
      const btnPickFavicon = document.getElementById("btn-pick-favicon");
      const btnResetFavicon = document.getElementById("btn-reset-favicon");
      const uploadFaviconFile = document.getElementById("upload-favicon-file");

      // Mock Elements in Preview
      const mockLogoImg = document.getElementById("mock-logo-img");
      const mockLogoPlaceholder = document.getElementById(
        "mock-logo-placeholder",
      );
      const mockSchoolNameBlock = document.getElementById(
        "mock-school-name-block",
      );
      const mockBtnPpdb = document.getElementById("mock-btn-ppdb");

      // Colors (Header preview sync)
      const primaryInput = document.getElementById("primary_color");

      // Real-time Header Preview Synchronizer
      function updateLivePreview() {
        const currentLogo = logoInput ? logoInput.value.trim() : "";
        const showName = toggleShowSchoolName
          ? toggleShowSchoolName.checked
          : true;
        let selectedOrient = "auto";
        orientRadios.forEach((r) => {
          if (r.checked) selectedOrient = r.value;
        });
        const primaryCol = primaryInput ? primaryInput.value.trim() : "#0d9488";

        // 1. Sync Logo in preview
        if (currentLogo) {
          if (mockLogoImg) {
            mockLogoImg.src = currentLogo;
            mockLogoImg.classList.remove("hidden");
            // Apply sizing per orientation
            if (selectedOrient === "horizontal") {
              mockLogoImg.className =
                "h-8 max-w-[150px] w-auto object-contain rounded-[4px] transition-all";
            } else if (selectedOrient === "square") {
              mockLogoImg.className =
                "h-8 w-8 object-contain rounded-[4px] transition-all";
            } else {
              mockLogoImg.className =
                "h-8 max-w-[130px] w-auto object-contain rounded-[4px] transition-all";
            }
          }
          if (mockLogoPlaceholder) mockLogoPlaceholder.classList.add("hidden");
        } else {
          if (mockLogoImg) mockLogoImg.classList.add("hidden");
          if (mockLogoPlaceholder) {
            mockLogoPlaceholder.classList.remove("hidden");
            mockLogoPlaceholder.style.backgroundColor = primaryCol;
          }
        }

        // 2. Sync School Name visibility
        if (mockSchoolNameBlock) {
          if (showName) {
            mockSchoolNameBlock.classList.remove("hidden");
          } else {
            mockSchoolNameBlock.classList.add("hidden");
          }
        }

        // 3. Sync Theme color on PPDB button
        if (mockBtnPpdb) {
          mockBtnPpdb.style.backgroundColor = primaryCol;
        }
      }

      // Update Logo State in Settings Card
      function applyLogoUrl(url) {
        if (logoInput) logoInput.value = url;
        if (url) {
          if (logoImg) {
            logoImg.src = url;
            logoImg.classList.remove("hidden");
          }
          if (logoEmpty) logoEmpty.classList.add("hidden");
          if (logoFilename)
            logoFilename.textContent = url.split("/").pop() || "Logo Sekolah";
          if (btnRemoveLogo) btnRemoveLogo.classList.remove("hidden");
        } else {
          if (logoImg) logoImg.classList.add("hidden");
          if (logoEmpty) logoEmpty.classList.remove("hidden");
          if (logoFilename) logoFilename.textContent = "Belum ada logo dipilih";
          if (btnRemoveLogo) btnRemoveLogo.classList.add("hidden");
        }
        markFormDirty(true);
        updateLivePreview();
      }

      // Update Favicon State in Settings Card
      function applyFaviconUrl(url) {
        if (faviconInput) faviconInput.value = url;
        if (faviconImg) faviconImg.src = url || "/favicon.svg";
        if (faviconFilename)
          faviconFilename.textContent = (url || "/favicon.svg")
            .split("/")
            .pop();
        markFormDirty(true);
      }

      // Toggle Nama Sekolah
      toggleShowSchoolName?.addEventListener("change", () => {
        if (headerShowNameInput) {
          headerShowNameInput.value = toggleShowSchoolName.checked
            ? "true"
            : "false";
        }
        markFormDirty(true);
        updateLivePreview();
      });

      // Orientasi Radio Buttons
      orientRadios.forEach((radio) => {
        radio.addEventListener("change", () => {
          markFormDirty(true);
          updateLivePreview();
        });
      });

      // Logo Buttons
      btnPickLogo?.addEventListener("click", () => {
        window.openMediaPicker?.((media) => {
          const pickedUrl =
            media?.fileUrl ||
            media?.url ||
            media?.mediumUrl ||
            (typeof media === "string" ? media : "");
          if (pickedUrl) {
            applyLogoUrl(pickedUrl);
            showBanner(
              "Logo berhasil dipilih. Klik 'Simpan Perubahan' di kanan atas untuk menyimpan.",
              "success",
            );
          }
        });
      });

      btnRemoveLogo?.addEventListener("click", () => {
        applyLogoUrl("");
        showBanner(
          "Logo berhasil dihapus dari preview. Klik 'Simpan Perubahan' di kanan atas untuk menyimpan permanen.",
          "success",
        );
      });

      // Favicon Buttons
      btnPickFavicon?.addEventListener("click", () => {
        window.openMediaPicker?.((media) => {
          const pickedUrl =
            media?.fileUrl ||
            media?.url ||
            media?.mediumUrl ||
            (typeof media === "string" ? media : "");
          if (pickedUrl) {
            applyFaviconUrl(pickedUrl);
            showBanner(
              "Favicon berhasil dipilih. Klik 'Simpan Perubahan' di kanan atas untuk menyimpan.",
              "success",
            );
          }
        });
      });

      btnResetFavicon?.addEventListener("click", () => {
        applyFaviconUrl("/favicon.svg");
        showBanner(
          "Favicon direset ke default. Klik 'Simpan Perubahan' di kanan atas untuk menyimpan.",
          "success",
        );
      });

      // Contact Hero Background Picker
      const inputContactBg = document.getElementById("contact_bg_image");
      const btnPickContactBg = document.getElementById("btn-pick-contact-bg");
      btnPickContactBg?.addEventListener("click", () => {
        window.openMediaPicker?.((media) => {
          const pickedUrl =
            media?.fileUrl ||
            media?.url ||
            media?.mediumUrl ||
            (typeof media === "string" ? media : "");
          if (pickedUrl && inputContactBg) {
            inputContactBg.value = pickedUrl;
            markFormDirty(true);
            showBanner(
              "Gambar latar kontak berhasil dipilih. Klik 'Simpan Perubahan' di kanan atas untuk menyimpan.",
              "success",
            );
          }
        });
      });

      inputContactBg?.addEventListener("input", () => {
        markFormDirty(true);
      });

      // Upload Helper
      async function uploadFile(file, onUploaded) {
        if (!file) return;
        const fd = new FormData();
        fd.append("file", file);
        try {
          const res = await fetch("/api/admin/media/upload", {
            method: "POST",
            body: fd,
          });
          const data = await res.json();
          const uploadedUrl =
            data?.media?.fileUrl ||
            data?.media?.url ||
            data?.data?.fileUrl ||
            data?.url ||
            "";
          if (data.success && uploadedUrl) {
            onUploaded(uploadedUrl);
            showBanner(
              "Berkas berhasil diunggah. Klik 'Simpan Perubahan' di kanan atas untuk menyimpan.",
              "success",
            );
          } else {
            showBanner(data.error || "Gagal mengunggah berkas.", "error");
          }
        } catch {
          showBanner("Terjadi kesalahan jaringan saat mengunggah.", "error");
        }
      }

      uploadLogoFile?.addEventListener("change", (e) => {
        uploadFile(e.target.files?.[0], (url) => {
          applyLogoUrl(url);
        });
      });

      uploadFaviconFile?.addEventListener("change", (e) => {
        uploadFile(e.target.files?.[0], (url) => {
          applyFaviconUrl(url);
        });
      });

      primaryInput?.addEventListener("input", () => {
        updateLivePreview();
      });

      // Listen to all text inputs for unsaved state
      form?.querySelectorAll("input").forEach((inp) => {
        inp.addEventListener("input", () => markFormDirty(true));
      });

      // Feedback Banner
      function showBanner(text, type) {
        banner.classList.remove("hidden");
        banner.innerText = text;
        if (type === "success") {
          banner.className =
            "rounded-lg border border-primary/20 bg-primary-light p-3.5 text-xs text-primary font-medium block";
        } else if (type === "error") {
          banner.className =
            "rounded-lg border border-error/20 bg-error-light p-3.5 text-xs text-error font-medium block";
        } else {
          banner.className =
            "rounded-lg border border-border bg-surface-subtle p-3.5 text-xs text-muted font-medium block";
        }
      }

      // Save Form Handler
      async function saveSettings() {
        banner.classList.add("hidden");
        setLoading(true);

        const fd = new FormData(form);
        const payload = {};
        fd.forEach((val, key) => {
          payload[key] = String(val).trim();
        });

        // Ensure explicit values for toggle & radios
        payload["header_show_school_name"] = toggleShowSchoolName
          ? toggleShowSchoolName.checked
            ? "true"
            : "false"
          : "true";

        try {
          const res = await fetch("/api/admin/settings", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          setLoading(false);

          if (data.success) {
            markFormDirty(false);
            showBanner("Pengaturan sekolah berhasil disimpan.", "success");
            saveIcon?.classList.add("hidden");
            saveCheck?.classList.remove("hidden");
            if (headerLabel) headerLabel.innerText = "Tersimpan";
            setTimeout(() => {
              saveCheck?.classList.add("hidden");
              saveIcon?.classList.remove("hidden");
              if (headerLabel) headerLabel.innerText = "Simpan Perubahan";
            }, 2500);
          } else {
            saveIcon?.classList.remove("hidden");
            showBanner(data.error || "Gagal menyimpan pengaturan.", "error");
          }
        } catch {
          setLoading(false);
          saveIcon?.classList.remove("hidden");
          showBanner("Terjadi kesalahan jaringan saat menyimpan.", "error");
        }
      }

      function setLoading(isLoading) {
        if (btnHeaderSave) btnHeaderSave.disabled = isLoading;
        if (isLoading) {
          saveIcon?.classList.add("hidden");
          saveSpinner?.classList.remove("hidden");
          saveCheck?.classList.add("hidden");
          if (headerLabel) headerLabel.innerText = "Menyimpan...";
        } else {
          saveSpinner?.classList.add("hidden");
        }
      }

      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        saveSettings();
      });

      btnHeaderSave?.addEventListener("click", () => {
        if (form?.reportValidity()) saveSettings();
      });

      // Initialize Preview on page load
      updateLivePreview();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPengaturan);
    } else {
      initPengaturan();
    }
  </script>

  <script>
    import {
      THEME_PRESETS,
      DEFAULT_THEME_PRESET,
      DEFAULT_THEME_MODE,
      resolveThemeConfig,
      normalizeHex,
      type ModePalette,
    } from "../../../utils/themeSystem";

    function initPengaturanTheme() {
      const presetInput = document.getElementById(
        "theme_preset",
      ) as HTMLInputElement | null;
      const presetBadge = document.getElementById("active-preset-badge");
      const presetBtns =
        document.querySelectorAll<HTMLButtonElement>(".btn-swatch-preset");
      const btnResetTheme = document.getElementById("btn-reset-theme");

      const primaryPicker = document.getElementById(
        "primary_color_picker",
      ) as HTMLInputElement | null;
      const primaryInput = document.getElementById(
        "primary_color",
      ) as HTMLInputElement | null;
      const secondaryPicker = document.getElementById(
        "secondary_color_picker",
      ) as HTMLInputElement | null;
      const secondaryInput = document.getElementById(
        "secondary_color",
      ) as HTMLInputElement | null;
      const tertiaryPicker = document.getElementById(
        "tertiary_color_picker",
      ) as HTMLInputElement | null;
      const tertiaryInput = document.getElementById(
        "tertiary_color",
      ) as HTMLInputElement | null;
      const modeRadios = document.querySelectorAll<HTMLInputElement>(
        'input[name="theme_mode"]',
      );
      const mockBtnPpdb = document.getElementById("mock-btn-ppdb");
      const mockLogoPlaceholder = document.getElementById(
        "mock-logo-placeholder",
      );

      function applyPreviewCard(prefix: "light" | "dark", p: ModePalette) {
        const canvas = document.getElementById(`preview-${prefix}-canvas`);
        const label = document.getElementById(`preview-${prefix}-label`);
        const tertiary = document.getElementById(`preview-${prefix}-tertiary`);
        const surface = document.getElementById(`preview-${prefix}-surface`);
        const heading = document.getElementById(`preview-${prefix}-heading`);
        const muted = document.getElementById(`preview-${prefix}-muted`);
        const primaryBtn = document.getElementById(`preview-${prefix}-primary`);
        const secondaryBadge = document.getElementById(
          `preview-${prefix}-secondary`,
        );

        if (canvas) {
          canvas.style.backgroundColor = p.background;
          canvas.style.borderColor = p.border;
        }
        if (label) label.style.color = p.muted;
        if (tertiary) {
          tertiary.style.backgroundColor = p.tertiary;
          tertiary.style.color = p.tertiaryForeground;
        }
        if (surface) {
          surface.style.backgroundColor = p.surface;
          surface.style.borderColor = p.border;
        }
        if (heading) heading.style.color = p.heading;
        if (muted) muted.style.color = p.muted;
        if (primaryBtn) {
          primaryBtn.style.backgroundColor = p.primary;
          primaryBtn.style.color = p.primaryForeground;
        }
        if (secondaryBadge) {
          secondaryBadge.style.backgroundColor = p.secondary;
          secondaryBadge.style.color = p.secondaryForeground;
        }
      }

      function updatePresetButtonsUI(activeId: string) {
        presetBtns.forEach((btn) => {
          const isMatch = btn.getAttribute("data-preset-id") === activeId;
          btn.classList.toggle("border-primary", isMatch);
          btn.classList.toggle("bg-primary-light/60", isMatch);
          btn.classList.toggle("border-border", !isMatch);
          btn.classList.toggle("bg-surface", !isMatch);
        });
        if (presetBadge) {
          presetBadge.textContent =
            activeId === "custom" ? "Custom Colors" : `Preset: ${activeId}`;
        }
      }

      function refreshAppearancePreview() {
        const pHex = normalizeHex(primaryInput?.value, "#064734");
        const sHex = normalizeHex(secondaryInput?.value, "#E0FFC2");
        const tHex = normalizeHex(tertiaryInput?.value, "#D9F45B");
        const presetVal = presetInput?.value || "custom";

        const resolved = resolveThemeConfig({
          theme_preset: presetVal,
          primary_color: pHex,
          secondary_color: sHex,
          tertiary_color: tHex,
        });

        if (presetInput) presetInput.value = resolved.presetId;
        updatePresetButtonsUI(resolved.presetId);
        applyPreviewCard("light", resolved.light);
        applyPreviewCard("dark", resolved.dark);

        if (mockBtnPpdb) {
          mockBtnPpdb.style.backgroundColor = resolved.light.primary;
          mockBtnPpdb.style.color = resolved.light.primaryForeground;
        }
        if (mockLogoPlaceholder) {
          mockLogoPlaceholder.style.backgroundColor = resolved.light.primary;
          mockLogoPlaceholder.style.color = resolved.light.primaryForeground;
        }
      }

      function bindColorPair(
        picker: HTMLInputElement | null,
        input: HTMLInputElement | null,
      ) {
        picker?.addEventListener("input", () => {
          if (!input) return;
          input.value = picker.value.toUpperCase();
          if (presetInput) presetInput.value = "custom";
          refreshAppearancePreview();
          input.dispatchEvent(new Event("input", { bubbles: true }));
        });

        input?.addEventListener("input", () => {
          if (/^#[0-9A-Fa-f]{6}$/.test(input.value) && picker) {
            picker.value = input.value;
          }
          if (presetInput && input.dataset.fromPreset !== "1") {
            presetInput.value = "custom";
          }
          refreshAppearancePreview();
        });
      }

      bindColorPair(primaryPicker, primaryInput);
      bindColorPair(secondaryPicker, secondaryInput);
      bindColorPair(tertiaryPicker, tertiaryInput);

      function applyIdentityToInputs(
        presetId: string,
        p: string,
        s: string,
        t: string,
      ) {
        if (presetInput) presetInput.value = presetId;
        if (primaryInput) primaryInput.value = p.toUpperCase();
        if (primaryPicker) primaryPicker.value = p;
        if (secondaryInput) secondaryInput.value = s.toUpperCase();
        if (secondaryPicker) secondaryPicker.value = s;
        if (tertiaryInput) tertiaryInput.value = t.toUpperCase();
        if (tertiaryPicker) tertiaryPicker.value = t;

        refreshAppearancePreview();
        if (primaryInput) {
          primaryInput.dataset.fromPreset = "1";
          primaryInput.dispatchEvent(new Event("input", { bubbles: true }));
          delete primaryInput.dataset.fromPreset;
        }
      }

      presetBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-preset-id") || "custom";
          const p = btn.getAttribute("data-primary");
          const s = btn.getAttribute("data-secondary");
          const t = btn.getAttribute("data-tertiary");
          if (p && s && t) {
            applyIdentityToInputs(id, p, s, t);
          }
        });
      });

      btnResetTheme?.addEventListener("click", () => {
        const def =
          THEME_PRESETS.find((x) => x.id === DEFAULT_THEME_PRESET) ||
          THEME_PRESETS[0];
        modeRadios.forEach((r) => {
          r.checked = r.value === DEFAULT_THEME_MODE;
        });
        applyIdentityToInputs(
          def.id,
          def.identity.primary,
          def.identity.secondary,
          def.identity.tertiary,
        );
      });

      refreshAppearancePreview();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPengaturanTheme);
    } else {
      initPengaturanTheme();
    }
  </script>
</AdminLayout>
