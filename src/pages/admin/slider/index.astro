---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import MediaPickerModal from "../../../components/MediaPickerModal.astro";
import Icon from "../../../components/Icon.astro";
import { db, heroSlides, navigationItems } from "../../../db";
import { asc, desc } from "drizzle-orm";

// 1. Data Banner Slider Hero
const slidesList = await db
  .select()
  .from(heroSlides)
  .orderBy(asc(heroSlides.orderNumber), asc(heroSlides.id))
  .catch(() => []);

// 2. Data Navigasi Website
const navList = await db
  .select()
  .from(navigationItems)
  .orderBy(asc(navigationItems.sortOrder), asc(navigationItems.createdAt))
  .catch(() => []);

// Bangun struktur hierarki navigasi (Top-Level & Submenu)
const topLevelNav = navList.filter((item) => !item.parentId);
const subNavMap = new Map<string, typeof navList>();
navList.forEach((item) => {
  if (item.parentId) {
    if (!subNavMap.has(item.parentId)) {
      subNavMap.set(item.parentId, []);
    }
    subNavMap.get(item.parentId)!.push(item);
  }
});

// Urutkan submenu berdasarkan sortOrder
subNavMap.forEach((children) => {
  children.sort((a, b) => a.sortOrder - b.sortOrder);
});

const dropdownItems = topLevelNav.filter((i) => i.type === "dropdown");
---

<AdminLayout title="Pengaturan Tampilan Website" activeNav="slider">
  <div class="space-y-8 max-w-6xl">
    <!-- Header Utama Halaman -->
    <div class="border-b border-border pb-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="font-display text-2xl font-bold tracking-tight text-heading">
          Pengaturan Tampilan Website
        </h1>
        <p class="mt-1 font-body text-xs text-muted">
          Kelola tayangan banner slider beranda dan susunan navigasi website
          sekolah.
        </p>
      </div>

      <!-- Tombol Aksi Cepat -->
      <div class="flex items-center gap-2">
        <button
          id="btn-action-slider"
          class="inline-flex h-[36px] items-center justify-center gap-1.5 rounded-[6px] border border-border bg-surface px-3.5 text-xs font-semibold text-heading hover:bg-surface-subtle shadow-xs cursor-pointer transition-colors"
        >
          <Icon name="plus" class="h-4 w-4 text-primary" />
          <span>Tambah Slide</span>
        </button>

        <button
          id="btn-action-nav"
          class="inline-flex h-[36px] items-center justify-center gap-1.5 rounded-[6px] bg-primary px-4 text-xs font-semibold text-white hover:bg-primary-hover shadow-xs cursor-pointer transition-colors"
        >
          <Icon name="plus" class="h-4 w-4" />
          <span>Tambah Menu</span>
        </button>
      </div>
    </div>

    <!-- Alert / Toast Banner Status -->
    <div
      id="status-banner"
      class="hidden rounded-[6px] p-3 text-xs font-medium transition-all"
    ></div>

    <!-- BAGIAN 1: BANNER SLIDER HERO                             -->

    <div id="panel-slider" class="space-y-6">
      <div class="rounded-[8px] border border-border bg-surface overflow-hidden shadow-xs">
        <div class="p-4 border-b border-border flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h2 class="font-display text-sm font-bold text-heading flex items-center gap-2">
              <span>Daftar Slide Banner ({slidesList.length})</span>
              <span
                id="reorder-spinner"
                class="hidden text-xs text-primary font-normal flex items-center gap-1"
              >
                <svg
                  class="animate-spin h-3.5 w-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"
                  ></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8v8H4z"
                  ></path>
                </svg>
                <span>Menyimpan urutan baru...</span>
              </span>
            </h2>
            <p class="text-[11px] text-muted">
              Gunakan ikon pegangan (grip) untuk menggeser urutan banner secara
              langsung.
            </p>
          </div>
          <span class="text-[11px] text-muted font-mono bg-surface-subtle px-2 py-1 rounded border border-border/60 self-start sm:self-auto">
            Urutan otomatis tersimpan
          </span>
        </div>

        {slidesList.length === 0 ? (
          <div class="p-12 text-center text-xs text-muted">
            Belum ada slide banner dibuat. Klik tombol "Tambah Slide Baru" untuk
            membuat tampilan banner beranda.
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left font-body text-xs" id="slider-table">
              <thead class="border-b border-border bg-surface-subtle text-[11px] font-semibold text-muted uppercase">
                <tr>
                  <th
                    class="py-3 px-3 w-10 text-center"
                    title="Geser untuk mengurutkan"
                  >
                    Pindah
                  </th>
                  <th class="py-3 px-3 w-14 text-center">Urutan</th>
                  <th class="py-3 px-4 w-36">Gambar</th>
                  <th class="py-3 px-4">Judul & Deskripsi</th>
                  <th class="py-3 px-4">Tombol Aksi (CTA)</th>
                  <th class="py-3 px-4">Status</th>
                  <th class="py-3 px-4 text-right">Tindakan</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border" id="slider-tbody">
                {slidesList.map((item, idx) => (
                  <tr
                    class="slide-row hover:bg-surface-subtle transition-colors select-none"
                    id={`row-${item.id}`}
                    data-id={item.id}
                    draggable="true"
                  >
                    <!-- Drag Handle -->
                    <td class="py-3 px-3 text-center">
                      <div
                        class="drag-handle inline-flex items-center justify-center p-1.5 rounded text-muted hover:text-heading hover:bg-surface cursor-grab active:cursor-grabbing transition-colors"
                        title="Klik dan geser untuk memindahkan posisi"
                      >
                        <svg
                          class="h-4 w-4"
                          fill="currentColor"
                          viewBox="0 0 20 20"
                        >
                          <path d="M7 2a2 2 0 100 4 2 2 0 000-4zM13 2a2 2 0 100 4 2 2 0 000-4zM7 8a2 2 0 100 4 2 2 0 000-4zM13 8a2 2 0 100 4 2 2 0 000-4zM7 14a2 2 0 100 4 2 2 0 000-4zM13 14a2 2 0 100 4 2 2 0 000-4z" />
                        </svg>
                      </div>
                    </td>

                    <!-- Nomor Urutan Dinamis -->
                    <td class="py-3 px-3 text-center">
                      <span class="order-badge inline-flex h-6 w-6 items-center justify-center rounded-full bg-surface-subtle border border-border text-[11px] font-mono font-bold text-heading">
                        {idx + 1}
                      </span>
                    </td>

                    <!-- Gambar Thumbnail -->
                    <td class="py-3 px-4">
                      <div class="relative h-14 w-28 overflow-hidden rounded-[4px] border border-border bg-surface-subtle group/thumb">
                        <img
                          src={item.imageUrl}
                          alt={item.title}
                          class="h-full w-full object-cover"
                          loading="lazy"
                        />
                        <a
                          href={item.imageUrl}
                          target="_blank"
                          class="absolute inset-0 bg-heading/60 opacity-0 group-hover/thumb:opacity-100 flex items-center justify-center text-white text-[10px] font-medium transition-opacity"
                        >
                          Lihat Full
                        </a>
                      </div>
                    </td>

                    <!-- Judul & Subtitle -->
                    <td class="py-3 px-4 max-w-xs">
                      {item.tagline && (
                        <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider bg-surface-subtle text-muted border border-border mb-1">
                          {item.tagline}
                        </span>
                      )}
                      <div class="font-display font-semibold text-heading truncate">
                        {item.title}
                      </div>
                      {item.subtitle ? (
                        <div class="text-[11px] text-muted line-clamp-1 mt-0.5">
                          {item.subtitle}
                        </div>
                      ) : (
                        <div class="text-[10px] text-muted/60 italic mt-0.5">
                          Tanpa subjudul
                        </div>
                      )}
                    </td>

                    <!-- Tombol Aksi (CTA) -->
                    <td class="py-3 px-4 max-w-[200px]">
                      {item.linkText && item.linkUrl ? (
                        <div class="flex flex-col gap-1">
                          <span class="inline-flex items-center gap-1 text-[11px] font-medium text-primary truncate">
                            <span class="truncate">{item.linkText}</span>
                          </span>
                          {item.linkText2 && item.linkUrl2 && (
                            <span class="inline-flex items-center gap-1 text-[10px] font-medium text-muted truncate">
                              <span class="truncate">{item.linkText2}</span>
                            </span>
                          )}
                        </div>
                      ) : (
                        <span class="text-[10px] text-muted italic">
                          Tanpa tautan
                        </span>
                      )}
                    </td>

                    <!-- Status Aktif / Nonaktif (Tombol Switch) -->
                    <td class="py-3 px-4">
                      <button
                        type="button"
                        role="switch"
                        aria-checked={item.isActive ? "true" : "false"}
                        class:list={[
                          "toggle-status-btn relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out",
                          item.isActive ? "bg-primary" : "bg-border",
                        ]}
                        data-id={item.id}
                        title={
                          item.isActive
                            ? "Aktif (Klik untuk menonaktifkan)"
                            : "Nonaktif (Klik untuk mengaktifkan)"
                        }
                        aria-label={
                          item.isActive
                            ? "Nonaktifkan slide banner"
                            : "Aktifkan slide banner"
                        }
                      >
                        <span class="sr-only">
                          {item.isActive ? "Aktif" : "Nonaktif"}
                        </span>
                        <span
                          aria-hidden="true"
                          class:list={[
                            "pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow-xs ring-0 transition duration-200 ease-in-out",
                            item.isActive ? "translate-x-4" : "translate-x-0",
                          ]}
                        />
                      </button>
                    </td>

                    <!-- Tombol Tindakan (Icon Saja) -->
                    <td class="py-3 px-4 text-right whitespace-nowrap">
                      <div class="inline-flex items-center gap-1.5 *:inline-flex *:h-7 *:w-7 *:items-center *:justify-center *:rounded-[6px] *:border *:transition-colors *:cursor-pointer">
                        <button
                          type="button"
                          class="edit-btn border-border bg-surface text-muted hover:text-primary hover:border-primary/40 hover:bg-surface-subtle shadow-2xs"
                          data-slide={JSON.stringify(item)}
                          title="Edit slide banner"
                          aria-label="Edit slide banner"
                        >
                          <Icon
                            name="edit"
                            class="h-3.5 w-3.5 pointer-events-none"
                          />
                        </button>
                        <button
                          type="button"
                          class="delete-btn border-border bg-surface text-muted hover:text-error hover:border-error/40 hover:bg-error-light shadow-2xs"
                          data-id={item.id}
                          data-title={item.title}
                          title="Hapus slide banner"
                          aria-label="Hapus slide banner"
                        >
                          <Icon
                            name="trash"
                            class="h-3.5 w-3.5 pointer-events-none"
                          />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>

    <!-- BAGIAN 2: NAVIGASI WEBSITE DINAMIS (Navbar)              -->

    <div id="panel-navigation" class="space-y-6">
      <!-- Ringkasan Info & Kontrol Navigasi -->
      <div class="rounded-[8px] border border-border bg-surface p-4 sm:p-5 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-border/80 pb-3">
          <div>
            <h2 class="font-display text-sm font-bold text-heading">
              Menu Navbar Website
            </h2>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono text-muted bg-surface-subtle border border-border px-2.5 py-1 rounded">
              {topLevelNav.length} menu utama &bull; {dropdownItems.length}{" "}
              dropdown
            </span>
            <button
              id="btn-reset-nav-defaults"
              type="button"
              class="inline-flex h-7 items-center justify-center gap-1 rounded border border-border bg-surface px-2.5 text-[11px] font-medium text-muted hover:text-heading hover:bg-surface-subtle transition-colors cursor-pointer"
              title="Kembalikan struktur menu ke konfigurasi standar sekolah"
            >
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                />
              </svg>
              <span>Reset Standar</span>
            </button>
          </div>
        </div>

        <!-- Daftar Menu Rapi & Tenang (UI Bersih Tanpa Badge Berlebih) -->
        <div class="mt-4 space-y-2" id="nav-hierarchy-container">
          {topLevelNav.length === 0 ? (
            <div class="p-8 text-center text-xs text-muted">
              Belum ada item navigasi. Klik "Tambah Menu" atau "Reset Standar"
              untuk memuat susunan menu.
            </div>
          ) : (
            topLevelNav.map((topItem, topIdx) => {
              const children = subNavMap.get(topItem.id) || [];
              const isDropdown = topItem.type === "dropdown";

              return (
                <div
                  class="nav-tree-item rounded-[6px] border border-border bg-surface transition-all hover:border-primary shadow-2xs select-none"
                  id={`nav-item-${topItem.id}`}
                  data-id={topItem.id}
                  data-type={topItem.type}
                  draggable="true"
                >
                  <!-- Baris Menu Utama (Parent / Top-Level) -->
                  <div class="nav-tree-header p-2.5 sm:px-3.5 flex items-center justify-between gap-3 bg-surface rounded-[6px]">
                    <div class="flex items-center gap-2.5 min-w-0 flex-1">
                      <!-- Drag Handle Hierarki -->
                      <span
                        class="nav-drag-handle inline-flex items-center justify-center p-1 rounded text-muted hover:text-heading hover:bg-surface-subtle cursor-grab active:cursor-grabbing transition-colors shrink-0"
                        title="Klik dan geser untuk memindahkan posisi atau hierarki menu"
                      >
                        <svg
                          class="h-4 w-4 pointer-events-none"
                          fill="currentColor"
                          viewBox="0 0 20 20"
                        >
                          <path d="M7 2a2 2 0 100 4 2 2 0 000-4zM13 2a2 2 0 100 4 2 2 0 000-4zM7 8a2 2 0 100 4 2 2 0 000-4zM13 8a2 2 0 100 4 2 2 0 000-4zM7 14a2 2 0 100 4 2 2 0 000-4zM13 14a2 2 0 100 4 2 2 0 000-4z" />
                        </svg>
                      </span>

                      <!-- Nama Menu, Tipe Netral, dan URL (Informasi Utama) -->
                      <div class="min-w-0 flex items-center gap-2 flex-wrap">
                        <span class="font-display text-xs font-semibold text-heading truncate">
                          {topItem.label}
                        </span>

                        <!-- Tipe Sebagai Teks Netral (Bukan Badge Mencolok) -->
                        <span class="text-[11px] text-muted">
                          {isDropdown
                            ? `· Dropdown (${children.length} submenu)`
                            : "· Halaman"}
                        </span>

                        <!-- URL / Tautan Tujuan -->
                        {!isDropdown && (
                          <span class="text-[11px] text-muted font-mono truncate max-w-xs">
                            {topItem.href || "/"}
                          </span>
                        )}

                        {topItem.openInNewTab && (
                          <span
                            class="text-[10px] text-muted font-mono"
                            title="Buka di tab baru"
                          >
                            ↗
                          </span>
                        )}
                      </div>
                    </div>

                    <!-- Sisi Kanan: Tombol + Submenu, Status Halus, dan Menu Tindakan Tiga Titik -->
                    <div class="flex items-center gap-2 shrink-0">
                      <!-- Tombol Tambah Submenu Khusus Dropdown -->
                      {isDropdown && (
                        <button
                          type="button"
                          class="btn-add-submenu inline-flex h-6 px-2 items-center justify-center rounded text-[11px] font-medium text-primary hover:bg-primary-light transition-colors cursor-pointer"
                          data-parent-id={topItem.id}
                          data-parent-name={topItem.label}
                          title={`Tambah submenu ke dalam ${topItem.label}`}
                        >
                          + Submenu
                        </button>
                      )}

                      <!-- Status Aktif / Nonaktif (Switch Toggle) -->
                      <button
                        type="button"
                        role="switch"
                        aria-checked={topItem.isActive ? "true" : "false"}
                        class:list={[
                          "toggle-nav-status-btn relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out",
                          topItem.isActive ? "bg-primary" : "bg-border",
                        ]}
                        data-id={topItem.id}
                        title={
                          topItem.isActive
                            ? "Aktif (Klik untuk menonaktifkan)"
                            : "Nonaktif (Klik untuk mengaktifkan)"
                        }
                        aria-label={
                          topItem.isActive
                            ? "Nonaktifkan menu"
                            : "Aktifkan menu"
                        }
                      >
                        <span class="sr-only">
                          {topItem.isActive ? "Aktif" : "Nonaktif"}
                        </span>
                        <span
                          aria-hidden="true"
                          class:list={[
                            "pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow-xs ring-0 transition duration-200 ease-in-out",
                            topItem.isActive
                              ? "translate-x-4"
                              : "translate-x-0",
                          ]}
                        />
                      </button>

                      <!-- Tombol Tindakan Menu: Edit & Hapus (Icon Saja) -->
                      <div class="inline-flex items-center gap-1.5 *:inline-flex *:h-6.5 *:w-6.5 *:items-center *:justify-center *:rounded-[6px] *:border *:transition-colors *:cursor-pointer">
                        <button
                          type="button"
                          class="btn-edit-nav border-border bg-surface text-muted hover:text-primary hover:border-primary/40 hover:bg-surface-subtle shadow-2xs"
                          data-item={JSON.stringify(topItem)}
                          title={`Edit menu "${topItem.label}"`}
                          aria-label={`Edit menu ${topItem.label}`}
                        >
                          <Icon
                            name="edit"
                            class="h-3.5 w-3.5 pointer-events-none"
                          />
                        </button>
                        <button
                          type="button"
                          class="btn-delete-nav border-border bg-surface text-muted hover:text-error hover:border-error/40 hover:bg-error-light shadow-2xs"
                          data-id={topItem.id}
                          data-name={topItem.label}
                          title={`Hapus menu "${topItem.label}"`}
                          aria-label={`Hapus menu ${topItem.label}`}
                        >
                          <Icon
                            name="trash"
                            class="h-3.5 w-3.5 pointer-events-none"
                          />
                        </button>
                      </div>
                    </div>
                  </div>

                  <!-- Wadah Submenu (Indentasi Halus Tanpa Nomor Dominan) -->
                  {isDropdown && (
                    <div
                      class="nav-submenu-container border-t border-border/60 bg-surface-subtle pl-7 pr-3 sm:pr-3.5 py-1.5 space-y-1 min-h-[38px] transition-all rounded-b-[6px]"
                      data-parent-id={topItem.id}
                    >
                      <div class="nav-empty-placeholder hidden only:block py-1 text-[11px] text-muted italic pointer-events-none">
                        Belum ada submenu. Tarik menu ke sini atau gunakan
                        tombol "+ Submenu" di atas.
                      </div>
                      {children.map((childItem, childIdx) => (
                        <div
                          class="nav-child-item flex items-center justify-between gap-3 p-1.5 px-2 rounded border border-border/60 bg-surface hover:border-primary transition-colors select-none"
                          id={`nav-child-${childItem.id}`}
                          data-id={childItem.id}
                          data-parent-id={topItem.id}
                          data-type={childItem.type}
                          draggable="true"
                        >
                          <div class="flex items-center gap-2 min-w-0 flex-1">
                            <!-- Drag Handle Submenu -->
                            <span
                              class="nav-child-drag-handle inline-flex items-center justify-center p-0.5 rounded text-muted hover:text-heading hover:bg-surface-subtle cursor-grab active:cursor-grabbing transition-colors shrink-0"
                              title="Klik dan geser untuk memindahkan posisi atau hierarki submenu"
                            >
                              <svg
                                class="h-3.5 w-3.5 pointer-events-none"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                              >
                                <path d="M7 2a2 2 0 100 4 2 2 0 000-4zM13 2a2 2 0 100 4 2 2 0 000-4zM7 8a2 2 0 100 4 2 2 0 000-4zM13 8a2 2 0 100 4 2 2 0 000-4zM7 14a2 2 0 100 4 2 2 0 000-4zM13 14a2 2 0 100 4 2 2 0 000-4z" />
                              </svg>
                            </span>

                            <span class="text-xs font-medium text-heading truncate">
                              {childItem.label}
                            </span>
                            <span class="text-[11px] text-muted font-mono truncate">
                              {childItem.href || "#"}
                            </span>
                          </div>

                          <div class="flex items-center gap-1.5 shrink-0">
                            <!-- Status Aktif / Nonaktif Submenu (Switch Toggle) -->
                            <button
                              type="button"
                              role="switch"
                              aria-checked={
                                childItem.isActive ? "true" : "false"
                              }
                              class:list={[
                                "toggle-nav-status-btn relative inline-flex h-4.5 w-8 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out",
                                childItem.isActive ? "bg-primary" : "bg-border",
                              ]}
                              data-id={childItem.id}
                              title={
                                childItem.isActive
                                  ? "Aktif (Klik untuk menonaktifkan)"
                                  : "Nonaktif (Klik untuk mengaktifkan)"
                              }
                              aria-label={
                                childItem.isActive
                                  ? "Nonaktifkan submenu"
                                  : "Aktifkan submenu"
                              }
                            >
                              <span class="sr-only">
                                {childItem.isActive ? "Aktif" : "Nonaktif"}
                              </span>
                              <span
                                aria-hidden="true"
                                class:list={[
                                  "pointer-events-none inline-block h-3.5 w-3.5 transform rounded-full bg-white shadow-xs ring-0 transition duration-200 ease-in-out",
                                  childItem.isActive
                                    ? "translate-x-3.5"
                                    : "translate-x-0",
                                ]}
                              />
                            </button>

                            <div class="inline-flex items-center gap-1 *:inline-flex *:h-5.5 *:w-5.5 *:items-center *:justify-center *:rounded-[4px] *:border *:transition-colors *:cursor-pointer">
                              <button
                                type="button"
                                class="btn-edit-nav border-border bg-surface text-muted hover:text-primary hover:border-primary/40 hover:bg-surface-subtle shadow-2xs"
                                data-item={JSON.stringify(childItem)}
                                title={`Edit submenu "${childItem.label}"`}
                                aria-label={`Edit submenu ${childItem.label}`}
                              >
                                <Icon
                                  name="edit"
                                  class="h-3 w-3 pointer-events-none"
                                />
                              </button>
                              <button
                                type="button"
                                class="btn-delete-nav border-border bg-surface text-muted hover:text-error hover:border-error/40 hover:bg-error-light shadow-2xs"
                                data-id={childItem.id}
                                data-name={childItem.label}
                                title={`Hapus submenu "${childItem.label}"`}
                                aria-label={`Hapus submenu ${childItem.label}`}
                              >
                                <Icon
                                  name="trash"
                                  class="h-3 w-3 pointer-events-none"
                                />
                              </button>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              );
            })
          )}
        </div>
      </div>
    </div>
  </div>

