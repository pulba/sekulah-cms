            id="submit-nav-btn"
            class="inline-flex h-[36px] items-center justify-center gap-1.5 rounded-[6px] bg-primary px-5 font-body text-xs font-semibold text-primary-foreground hover:bg-primary-hover shadow-xs transition-colors cursor-pointer"
          >
            <Icon name="save" class="h-3.5 w-3.5" />
            <span>Simpan Menu</span>
          </button>
        </div>
      </form>
      </div>
    </div>
  </div>

  <MediaPickerModal modalId="media-picker-modal" />

  <script>
    const btnActionSlider = document.getElementById("btn-action-slider");
    const btnActionNav = document.getElementById("btn-action-nav");

    // Toast / Status banner
    const statusBanner = document.getElementById("status-banner");
    function showStatus(
      message: string,
      type: "success" | "error" = "success",
    ) {
      if (!statusBanner) return;
      statusBanner.textContent = message;
      statusBanner.className = `rounded-[6px] p-3 text-xs font-medium transition-all ${
        type === "success"
          ? "bg-success-light text-success-text border border-success"
          : "bg-error-light text-error-text border border-error"
      }`;
      statusBanner.classList.remove("hidden");
      setTimeout(() => {
        statusBanner?.classList.add("hidden");
      }, 4500);
    }

    // ========================================================
    // 2. BANNER SLIDER HERO LOGIC
    // ========================================================
    const slideModal = document.getElementById("slide-modal");
    const slideForm = document.getElementById("slide-form") as HTMLFormElement;
    const slideIdInput = document.getElementById(
      "slide-id",
    ) as HTMLInputElement;
    const slideOrderInput = document.getElementById(
      "slide-order",
    ) as HTMLInputElement;
    const taglineInput = document.getElementById(
      "slide-tagline",
    ) as HTMLInputElement;
    const titleInput = document.getElementById(
      "slide-title",
    ) as HTMLInputElement;
    const subtitleInput = document.getElementById(
      "slide-subtitle",
    ) as HTMLTextAreaElement;
    const imageUrlInput = document.getElementById(
      "slide-image-url",
    ) as HTMLInputElement;
    const linkTextInput = document.getElementById(
      "slide-link-text",
    ) as HTMLInputElement;
    const linkUrlInput = document.getElementById(
      "slide-link-url",
    ) as HTMLInputElement;
    const linkText2Input = document.getElementById(
      "slide-link-text2",
    ) as HTMLInputElement;
    const linkUrl2Input = document.getElementById(
      "slide-link-url2",
    ) as HTMLInputElement;
    const activeCheckbox = document.getElementById(
      "slide-is-active",
    ) as HTMLInputElement;
    const slideModalTitle = document.getElementById("modal-title");
    const submitSlideBtn = document.getElementById(
      "submit-slide-btn",
    ) as HTMLButtonElement;

    const imagePickedContainer = document.getElementById(
      "image-picked-container",
    );
    const imagePickedPreview = document.getElementById(
      "image-picked-preview",
    ) as HTMLImageElement;
    const btnOpenMediaPicker = document.getElementById("btn-open-media-picker");
    const btnChangeImage = document.getElementById("btn-change-image");
    const btnRemoveImage = document.getElementById("btn-remove-image");

    function setPickedSlideImage(url: string, alt = "") {
      if (
        !imageUrlInput ||
        !imagePickedContainer ||
        !imagePickedPreview ||
        !btnOpenMediaPicker
      )
        return;
      if (url) {
        imageUrlInput.value = url;
        imagePickedPreview.src = url;
        imagePickedPreview.alt = alt || "Banner Hero";
        imagePickedContainer.classList.remove("hidden");
        btnOpenMediaPicker.classList.add("hidden");
      } else {
        imageUrlInput.value = "";
        imagePickedPreview.src = "";
        imagePickedContainer.classList.add("hidden");
        btnOpenMediaPicker.classList.remove("hidden");
      }
    }

    function openSliderMediaPicker() {
      if ((window as any).openMediaPicker) {
        (window as any).openMediaPicker((media: any) => {
          const fileUrl = media?.fileUrl || media?.url || media?.mediumUrl;
          if (fileUrl) {
            setPickedSlideImage(
              fileUrl,
              media?.title || media?.originalName || "",
            );
          }
        });
      }
    }

    btnOpenMediaPicker?.addEventListener("click", openSliderMediaPicker);
    btnChangeImage?.addEventListener("click", openSliderMediaPicker);
    btnRemoveImage?.addEventListener("click", () => setPickedSlideImage(""));

    btnActionSlider?.addEventListener("click", () => {
      slideForm?.reset();
      if (slideIdInput) slideIdInput.value = "";
      if (slideOrderInput) slideOrderInput.value = "";
      if (taglineInput) taglineInput.value = "";
      if (slideModalTitle)
        slideModalTitle.innerText = "Tambah Slide Banner Hero";
      if (activeCheckbox) activeCheckbox.checked = true;
      setPickedSlideImage("");
      slideModal?.classList.remove("hidden");
      titleInput?.focus();
    });

    function closeSlideModal() {
      slideModal?.classList.add("hidden");
    }

    document
      .getElementById("close-modal-btn")
      ?.addEventListener("click", closeSlideModal);
    document
      .getElementById("cancel-modal-btn")
      ?.addEventListener("click", closeSlideModal);

    slideModal?.addEventListener("click", (e) => {
      if (
        e.target === slideModal ||
        (e.target as HTMLElement)?.classList?.contains("min-h-full")
      ) {
        closeSlideModal();
      }
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !slideModal?.classList.contains("hidden")) {
        closeSlideModal();
      }
    });

    // Edit slide
    document.querySelectorAll(".edit-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const data = JSON.parse(btn.getAttribute("data-slide") || "{}");
        if (slideIdInput) slideIdInput.value = data.id || "";
        if (slideOrderInput)
          slideOrderInput.value =
            data.orderNumber !== undefined && data.orderNumber !== null
              ? String(data.orderNumber)
              : "";
        if (taglineInput) taglineInput.value = data.tagline || "";
        if (titleInput) titleInput.value = data.title || "";
        if (subtitleInput) subtitleInput.value = data.subtitle || "";
        setPickedSlideImage(data.imageUrl || "", data.title || "");
        if (linkUrlInput) linkUrlInput.value = data.linkUrl || "";
        if (linkTextInput) linkTextInput.value = data.linkText || "";
        if (linkUrl2Input) linkUrl2Input.value = data.linkUrl2 || "";
        if (linkText2Input) linkText2Input.value = data.linkText2 || "";
        if (activeCheckbox) activeCheckbox.checked = Boolean(data.isActive);
        if (slideModalTitle)
          slideModalTitle.innerText = "Edit Slide Banner Hero";
        slideModal?.classList.remove("hidden");
        titleInput?.focus();
      });
    });

    // Toggle slider status
    document.querySelectorAll(".toggle-status-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-id");
        if (!id) return;
        try {
          const res = await fetch(`/api/admin/sliders/${id}/toggle`, {
            method: "PUT",
          });
          const json = await res.json();
          if (json.success) {
            window.location.reload();
          } else {
            showStatus(json.error || "Gagal mengubah status slide", "error");
          }
        } catch {
          showStatus("Koneksi server gagal", "error");
        }
      });
    });

    // Delete slider
    document.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-id");
        const title = btn.getAttribute("data-title");
        const confirmed = await (window as any).confirmDialog({
          title: "Hapus Slide Banner",
          message: `Hapus slide banner "${title}"?\nTindakan ini tidak dapat dibatalkan.`,
          confirmText: "Ya, Hapus",
          cancelText: "Batal",
          type: "danger",
        });
        if (!confirmed) return;
        try {
          const res = await fetch(`/api/admin/sliders/${id}`, {
            method: "DELETE",
          });
          const json = await res.json();
          if (json.success) {
            window.location.reload();
          } else {
            showStatus(json.error || "Gagal menghapus slide", "error");
          }
        } catch {
          showStatus("Koneksi server gagal", "error");
        }
      });
    });

    // Submit Slider Form
    slideForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!imageUrlInput.value.trim()) {
        alert("Pilih gambar banner terlebih dahulu");
        openSliderMediaPicker();
        return;
      }

      submitSlideBtn.disabled = true;
      submitSlideBtn.innerText = "Menyimpan...";

      const id = slideIdInput.value.trim();
      const orderVal = slideOrderInput?.value.trim();
      const payload: any = {
        tagline: taglineInput ? taglineInput.value.trim() : "",
        title: titleInput.value.trim(),
        subtitle: subtitleInput.value.trim(),
        imageUrl: imageUrlInput.value.trim(),
        linkUrl: linkUrlInput.value.trim(),
        linkText: linkTextInput.value.trim(),
        linkUrl2: linkUrl2Input.value.trim(),
        linkText2: linkText2Input.value.trim(),
        isActive: activeCheckbox.checked,
      };

      if (orderVal && !isNaN(Number(orderVal)) && Number(orderVal) > 0) {
        payload.orderNumber = Number(orderVal);
      }

      const url = id ? `/api/admin/sliders/${id}` : "/api/admin/sliders";
      const method = id ? "PUT" : "POST";

      try {
        const res = await fetch(url, {
          method,
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (json.success) {
          window.location.reload();
        } else {
          showStatus(json.error || "Gagal menyimpan slide", "error");
          submitSlideBtn.disabled = false;
          submitSlideBtn.innerText = "Simpan Slide";
        }
      } catch {
        showStatus("Koneksi server gagal", "error");
        submitSlideBtn.disabled = false;
        submitSlideBtn.innerText = "Simpan Slide";
      }
    });

    // Slider Drag and drop reordering
    const sliderTableBody = document.getElementById("slider-tbody");
    const reorderSpinner = document.getElementById("reorder-spinner");
    if (sliderTableBody) {
      let draggedRow: HTMLElement | null = null;
      let initialOrderIds: string[] = [];

      function getSliderRowIds(): string[] {
        return Array.from(sliderTableBody.querySelectorAll(".slide-row"))
          .map((r) => r.getAttribute("data-id") || "")
          .filter(Boolean);
      }

      function updateSliderOrderBadges() {
        const rows = sliderTableBody.querySelectorAll(".slide-row");
        rows.forEach((row, i) => {
          const badge = row.querySelector(".order-badge");
          if (badge) badge.textContent = String(i + 1);
        });
      }

      sliderTableBody.addEventListener("dragstart", (e: DragEvent) => {
        const target = (e.target as HTMLElement).closest(
          ".slide-row",
        ) as HTMLElement;
        if (!target) return;
        draggedRow = target;
        initialOrderIds = getSliderRowIds();
        draggedRow.classList.add("opacity-40", "bg-primary-light");
      });

      sliderTableBody.addEventListener("dragover", (e: DragEvent) => {
        e.preventDefault();
        if (!draggedRow) return;
        const targetRow = (e.target as HTMLElement).closest(
          ".slide-row",
        ) as HTMLElement;
        if (!targetRow || targetRow === draggedRow) return;
        const bounding = targetRow.getBoundingClientRect();
        const offset = e.clientY - bounding.top;
        if (offset > bounding.height / 2) {
          targetRow.after(draggedRow);
        } else {
          targetRow.before(draggedRow);
        }
      });

      sliderTableBody.addEventListener("dragend", async () => {
        if (!draggedRow) return;
        draggedRow.classList.remove("opacity-40", "bg-primary-light");
        draggedRow = null;

        const newOrderIds = getSliderRowIds();
        if (JSON.stringify(initialOrderIds) === JSON.stringify(newOrderIds))
          return;

        updateSliderOrderBadges();
        reorderSpinner?.classList.remove("hidden");
        try {
          const res = await fetch("/api/admin/sliders/reorder", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ids: newOrderIds }),
          });
          const json = await res.json();
          reorderSpinner?.classList.add("hidden");
          if (json.success) {
            showStatus("Urutan banner slider berhasil disimpan", "success");
          } else {
            showStatus(json.error || "Gagal menyimpan urutan", "error");
          }
        } catch {
          reorderSpinner?.classList.add("hidden");
          showStatus("Koneksi server gagal", "error");
        }
      });
    }

    // ========================================================
    // 3. NAVIGASI WEBSITE DINAMIS LOGIC
    // ========================================================
    const navModal = document.getElementById("nav-modal");
    const navForm = document.getElementById("nav-form") as HTMLFormElement;
    const navItemIdInput = document.getElementById(
      "nav-item-id",
    ) as HTMLInputElement;
    const navLabelInput = document.getElementById(
      "nav-label",
    ) as HTMLInputElement;
    const navParentSelect = document.getElementById(
      "nav-parent-id",
    ) as HTMLSelectElement;
    const navPresetSelect = document.getElementById(
      "nav-preset-select",
    ) as HTMLSelectElement;
    const navHrefInput = document.getElementById(
      "nav-href",
    ) as HTMLInputElement;
    const navIsActiveInput = document.getElementById(
      "nav-is-active",
    ) as HTMLInputElement;
    const navNewTabInput = document.getElementById(
      "nav-new-tab",
    ) as HTMLInputElement;
    const navModalTitle = document.getElementById("nav-modal-title");
    const submitNavBtn = document.getElementById(
      "submit-nav-btn",
    ) as HTMLButtonElement;

    const radioTypePage = document.getElementById(
      "radio-type-page",
    ) as HTMLInputElement;
    const radioTypeDropdown = document.getElementById(
      "radio-type-dropdown",
    ) as HTMLInputElement;
    const typeOptPage = document.getElementById("type-opt-page");
    const typeOptDropdown = document.getElementById("type-opt-dropdown");

    const radioDestInternal = document.getElementById(
      "radio-dest-internal",
    ) as HTMLInputElement;
    const radioDestExternal = document.getElementById(
      "radio-dest-external",
    ) as HTMLInputElement;
    const tabDestInternal = document.getElementById("tab-dest-internal");
    const tabDestExternal = document.getElementById("tab-dest-external");
    const destInternalBox = document.getElementById("dest-internal-box");
    const destExternalBox = document.getElementById("dest-external-box");

    const wrapperNavParent = document.getElementById("wrapper-nav-parent");
    const wrapperNavDest = document.getElementById("wrapper-nav-destination");
    const wrapperDropdownInfo = document.getElementById(
      "wrapper-dropdown-info",
    );
    const wrapperNewTab = document.getElementById("wrapper-new-tab");

    const tabVisAll = document.getElementById("tab-vis-all");
    const tabVisDesktop = document.getElementById("tab-vis-desktop");
    const tabVisMobile = document.getElementById("tab-vis-mobile");

    // Ganti tipe menu (Halaman vs Dropdown)
    function setNavType(type: "page" | "dropdown") {
      if (type === "dropdown") {
        radioTypeDropdown.checked = true;
        radioTypePage.checked = false;
        typeOptDropdown?.classList.add(
          "border-primary",
          "bg-surface",
          "shadow-xs",
        );
        typeOptDropdown?.classList.remove("border-transparent");
        typeOptPage?.classList.remove(
          "border-primary",
          "bg-surface",
          "shadow-xs",
        );
        typeOptPage?.classList.add("border-transparent");

        wrapperNavDest?.classList.add("hidden");
        wrapperNavParent?.classList.add("hidden");
        wrapperDropdownInfo?.classList.remove("hidden");
        wrapperNewTab?.classList.add("hidden");
        if (navParentSelect) navParentSelect.value = "";
      } else {
        radioTypePage.checked = true;
        radioTypeDropdown.checked = false;
        typeOptPage?.classList.add("border-primary", "bg-surface", "shadow-xs");
        typeOptPage?.classList.remove("border-transparent");
        typeOptDropdown?.classList.remove(
          "border-primary",
          "bg-surface",
          "shadow-xs",
        );
        typeOptDropdown?.classList.add("border-transparent");

        wrapperNavDest?.classList.remove("hidden");
        wrapperNavParent?.classList.remove("hidden");
        wrapperDropdownInfo?.classList.add("hidden");
        wrapperNewTab?.classList.remove("hidden");
      }
    }

    radioTypePage?.addEventListener("change", () => setNavType("page"));
    radioTypeDropdown?.addEventListener("change", () => setNavType("dropdown"));

    // Ganti sumber tujuan (Halaman Internal vs URL Eksternal)
    function setDestSource(source: "internal" | "external") {
      if (source === "external") {
        radioDestExternal.checked = true;
        radioDestInternal.checked = false;
        tabDestExternal?.classList.add(
          "bg-surface",
          "text-heading",
          "shadow-xs",
        );
        tabDestExternal?.classList.remove("text-muted");
        tabDestInternal?.classList.remove(
          "bg-surface",
          "text-heading",
          "shadow-xs",
        );
        tabDestInternal?.classList.add("text-muted");

        destInternalBox?.classList.add("hidden");
        destExternalBox?.classList.remove("hidden");
        navHrefInput?.focus();
      } else {
        radioDestInternal.checked = true;
        radioDestExternal.checked = false;
        tabDestInternal?.classList.add(
          "bg-surface",
          "text-heading",
          "shadow-xs",
        );
        tabDestInternal?.classList.remove("text-muted");
        tabDestExternal?.classList.remove(
          "bg-surface",
          "text-heading",
          "shadow-xs",
        );
        tabDestExternal?.classList.add("text-muted");

        destInternalBox?.classList.remove("hidden");
        destExternalBox?.classList.add("hidden");
      }
    }

    tabDestInternal?.addEventListener("click", () => setDestSource("internal"));
    tabDestExternal?.addEventListener("click", () => setDestSource("external"));

    // Ganti visibilitas perangkat
    function setVisibility(val: "all" | "desktop" | "mobile") {
      const radio = document.getElementById(`vis-${val}`) as HTMLInputElement;
      if (radio) radio.checked = true;

      [
        { id: "all", el: tabVisAll },
        { id: "desktop", el: tabVisDesktop },
        { id: "mobile", el: tabVisMobile },
      ].forEach((item) => {
        if (item.id === val) {
          item.el?.classList.add("bg-surface", "text-heading", "shadow-xs");
          item.el?.classList.remove("text-muted");
        } else {
          item.el?.classList.remove("bg-surface", "text-heading", "shadow-xs");
          item.el?.classList.add("text-muted");
        }
      });
    }

    tabVisAll?.addEventListener("click", () => setVisibility("all"));
    tabVisDesktop?.addEventListener("click", () => setVisibility("desktop"));
    tabVisMobile?.addEventListener("click", () => setVisibility("mobile"));

    // Cegah siklus / parent ke dirinya sendiri
    function filterParentOptions(currentId = "") {
      if (!navParentSelect) return;
      Array.from(navParentSelect.options).forEach((opt) => {
        const parentIdAttr = opt.getAttribute("data-parent-id");
        if (currentId && parentIdAttr === currentId) {
          opt.disabled = true;
          opt.hidden = true;
        } else {
          opt.disabled = false;
          opt.hidden = false;
        }
      });
    }

    // Auto-fill dari Preset Halaman Internal
    navPresetSelect?.addEventListener("change", () => {
      if (navPresetSelect.value) {
        navHrefInput.value = navPresetSelect.value;
        if (!navLabelInput.value.trim()) {
          const text =
            navPresetSelect.options[navPresetSelect.selectedIndex]?.text || "";
          navLabelInput.value = text.split(" (")[0].trim();
        }
      }
    });

    // Dirty check saat form diubah
    let initialNavSnapshot = "";

    function getNavFormSnapshot(): string {
      const visVal =
        (
          document.querySelector(
            'input[name="visibility"]:checked',
          ) as HTMLInputElement
        )?.value || "all";
      return JSON.stringify({
        id: navItemIdInput.value,
        label: navLabelInput.value.trim(),
        type: radioTypeDropdown.checked ? "dropdown" : "page",
        destSource: radioDestExternal.checked ? "external" : "internal",
        preset: navPresetSelect.value,
        href: navHrefInput.value.trim(),
        parent: navParentSelect.value,
        vis: visVal,
        isActive: navIsActiveInput.checked,
        newTab: navNewTabInput.checked,
      });
    }

    async function closeNavModalGraceful() {
      if (navModal?.classList.contains("hidden")) return;
      if (getNavFormSnapshot() !== initialNavSnapshot) {
        const confirmed = await (window as any).confirmDialog({
          title: "Perubahan Belum Disimpan",
          message: "Buang perubahan navigasi yang belum disimpan?",
          confirmText: "Buang Perubahan",
          cancelText: "Batal",
          type: "warning",
        });
        if (!confirmed) return;
      }
      navModal?.classList.add("hidden");
    }

    document
      .getElementById("close-nav-modal-btn")
      ?.addEventListener("click", closeNavModalGraceful);
    document
      .getElementById("cancel-nav-modal-btn")
      ?.addEventListener("click", closeNavModalGraceful);

    navModal?.addEventListener("click", (e) => {
      if (
        e.target === navModal ||
        (e.target as HTMLElement)?.classList?.contains("min-h-full")
      ) {
        closeNavModalGraceful();
      }
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !navModal?.classList.contains("hidden")) {
        closeNavModalGraceful();
      }
    });

    // Buka Modal Tambah Menu
    function openNavModalCreate(parentId = "", parentName = "") {
      navForm.reset();
      navItemIdInput.value = "";
      filterParentOptions("");

      if (navModalTitle) {
        navModalTitle.innerText = parentId
          ? `Tambah Submenu untuk "${parentName}"`
          : "Tambah Menu Navigasi";
      }

      setNavType("page");
      setDestSource("internal");
      setVisibility("all");
      navIsActiveInput.checked = true;
      navNewTabInput.checked = false;
      navPresetSelect.value = "";
      navHrefInput.value = "";

      if (parentId && navParentSelect) {
        navParentSelect.value = parentId;
      } else if (navParentSelect) {
        navParentSelect.value = "";
      }

      initialNavSnapshot = getNavFormSnapshot();
      navModal?.classList.remove("hidden");
      navLabelInput.focus();
    }

    btnActionNav?.addEventListener("click", () => openNavModalCreate());

    // Tombol tambah submenu
    document.querySelectorAll(".btn-add-submenu").forEach((btn) => {
      btn.addEventListener("click", () => {
        const parentId = btn.getAttribute("data-parent-id") || "";
        const parentName = btn.getAttribute("data-parent-name") || "";
        openNavModalCreate(parentId, parentName);
      });
    });

    // Edit menu navigasi
    document.querySelectorAll(".btn-edit-nav").forEach((btn) => {
      btn.addEventListener("click", () => {
        const data = JSON.parse(btn.getAttribute("data-item") || "{}");
        navForm.reset();
        navItemIdInput.value = data.id || "";
        navLabelInput.value = data.label || "";
        filterParentOptions(data.id || "");

        if (navParentSelect) {
          navParentSelect.value = data.parentId || "";
        }

        if (data.type === "dropdown") {
          setNavType("dropdown");
          setDestSource("internal");
          navHrefInput.value = "";
          navPresetSelect.value = "";
        } else {
          setNavType("page");
          // Deteksi apakah href cocok dengan preset internal
          const presetMatch = Array.from(navPresetSelect.options).some(
            (o) => o.value && o.value === data.href,
          );
          if (presetMatch) {
            setDestSource("internal");
            navPresetSelect.value = data.href || "";
            navHrefInput.value = data.href || "";
          } else {
            setDestSource("external");
            navPresetSelect.value = "";
            navHrefInput.value = data.href || "";
          }
        }

        navIsActiveInput.checked = Boolean(data.isActive !== false);
        navNewTabInput.checked = Boolean(data.openInNewTab);

        if (data.showDesktop && !data.showMobile) {
          setVisibility("desktop");
        } else if (!data.showDesktop && data.showMobile) {
          setVisibility("mobile");
        } else {
          setVisibility("all");
        }

        if (navModalTitle) {
          navModalTitle.innerText = `Edit Menu: ${data.label}`;
        }

        initialNavSnapshot = getNavFormSnapshot();
        navModal?.classList.remove("hidden");
        navLabelInput.focus();
      });
    });

    // Toggle status menu navigasi
    document.querySelectorAll(".toggle-nav-status-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-id");
        if (!id) return;
        try {
          const res = await fetch(`/api/admin/navigation/${id}/toggle`, {
            method: "PUT",
          });
          const json = await res.json();
          if (json.success) {
            window.location.reload();
          } else {
            showStatus(json.error || "Gagal mengubah status", "error");
          }
        } catch {
          showStatus("Koneksi server gagal", "error");
        }
      });
    });

    // Hapus menu navigasi
    document.querySelectorAll(".btn-delete-nav").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-id");
        const name = btn.getAttribute("data-name");
        const confirmed = await (window as any).confirmDialog({
          title: "Hapus Menu Navigasi",
          message: `Hapus menu "${name}"?\nJika ini adalah dropdown, seluruh submenu di dalamnya juga akan terhapus.`,
          confirmText: "Ya, Hapus Menu",
          cancelText: "Batal",
          type: "danger",
        });
        if (!confirmed) return;

        try {
          const res = await fetch(`/api/admin/navigation/${id}`, {
            method: "DELETE",
          });
          const json = await res.json();
          if (json.success) {
            window.location.reload();
          } else {
            showStatus(json.error || "Gagal menghapus menu", "error");
          }
        } catch {
          showStatus("Koneksi server gagal", "error");
        }
      });
    });

    // Submit Nav Form (Tambah / Edit)
    navForm?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const id = navItemIdInput.value.trim();
      const type = radioTypeDropdown.checked ? "dropdown" : "page";
      const destSource = radioDestExternal.checked ? "external" : "internal";
      const visVal =
        (
          document.querySelector(
            'input[name="visibility"]:checked',
          ) as HTMLInputElement
        )?.value || "all";

      let finalHref: string | null = null;
      let finalParentId: string | null = null;
      let finalOpenInNewTab = false;

      if (type === "page") {
        if (destSource === "internal") {
          finalHref = navPresetSelect.value.trim();
          if (!finalHref) {
            showStatus("Silakan pilih salah satu Halaman Internal", "error");
            navPresetSelect.focus();
            return;
          }
        } else {
          finalHref = navHrefInput.value.trim();
          if (!finalHref) {
            showStatus("Silakan masukkan URL Eksternal / Khusus", "error");
            navHrefInput.focus();
            return;
          }
        }

        finalParentId = navParentSelect.value.trim() || null;
        finalOpenInNewTab = navNewTabInput.checked;
      }

      submitNavBtn.disabled = true;
      submitNavBtn.innerText = "Menyimpan...";

      const payload = {
        label: navLabelInput.value.trim(),
        type,
        href: finalHref,
        parentId: finalParentId,
        isActive: navIsActiveInput.checked,
        showDesktop: visVal !== "mobile",
        showMobile: visVal !== "desktop",
        openInNewTab: finalOpenInNewTab,
      };

      const url = id ? `/api/admin/navigation/${id}` : "/api/admin/navigation";
      const method = id ? "PUT" : "POST";

      try {
        const res = await fetch(url, {
          method,
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (json.success) {
          window.location.reload();
        } else {
          showStatus(json.error || "Gagal menyimpan menu navigasi", "error");
          submitNavBtn.disabled = false;
          submitNavBtn.innerText = "Simpan Menu";
        }
      } catch {
        showStatus("Koneksi server gagal", "error");
        submitNavBtn.disabled = false;
        submitNavBtn.innerText = "Simpan Menu";
      }
    });

    // Reordering Nav Items (Up / Down & Drag-and-Drop)
    const navContainer = document.getElementById("nav-hierarchy-container");

    // Snapshot function to read current hierarchical state from DOM
    function getCurrentNavSnapshot(): {
      id: string;
      parentId: string | null;
      sortOrder: number;
    }[] {
      if (!navContainer) return [];
      const snapshot: {
        id: string;
        parentId: string | null;
        sortOrder: number;
      }[] = [];

      // Direct items inside navContainer are top-level items (parentId = null)
      const topElements = Array.from(navContainer.children).filter(
        (el) => el instanceof HTMLElement && el.hasAttribute("data-id"),
      ) as HTMLElement[];

      topElements.forEach((el, idx) => {
        const id = el.getAttribute("data-id");
        if (id) {
          snapshot.push({ id, parentId: null, sortOrder: idx });
        }
      });

      // Submenu items inside each .nav-submenu-container
      const subContainers = Array.from(
        navContainer.querySelectorAll(".nav-submenu-container"),
      ) as HTMLElement[];
      subContainers.forEach((sub) => {
        const pId = sub.getAttribute("data-parent-id");
        if (!pId) return;
        const childElements = Array.from(sub.children).filter(
          (el) => el instanceof HTMLElement && el.hasAttribute("data-id"),
        ) as HTMLElement[];

        childElements.forEach((child, cIdx) => {
          const cId = child.getAttribute("data-id");
          if (cId) {
            snapshot.push({ id: cId, parentId: pId, sortOrder: cIdx });
          }
        });
      });

      return snapshot;
    }

    // Drag and drop reordering & cross-level hierarchy for Nav Items
    if (navContainer) {
      let draggedElement: HTMLElement | null = null;
      let draggedType: string = "page";
      let initialSnapshot: {
        id: string;
        parentId: string | null;
        sortOrder: number;
      }[] = [];

      navContainer.addEventListener("dragstart", (e: DragEvent) => {
        const target = e.target as HTMLElement;

        // Jangan drag jika mengklik tombol interaktif, tautan, atau form field
        if (target.closest("button, a, input, select, textarea")) {
          e.preventDefault();
          return;
        }

        // Jika klik di area kosong submenu, jangan drag dropdown induknya
        if (
          target.closest(".nav-submenu-container") &&
          !target.closest(".nav-child-item")
        ) {
          e.preventDefault();
          return;
        }

        // 1. Cek apakah yang di-drag adalah item submenu
        const childTarget = target.closest(
          ".nav-child-item",
        ) as HTMLElement | null;
        if (childTarget) {
          e.stopPropagation();
          draggedElement = childTarget;
          draggedType = childTarget.getAttribute("data-type") || "page";
          initialSnapshot = getCurrentNavSnapshot();

          setTimeout(() => {
            if (draggedElement) {
              draggedElement.classList.add(
                "opacity-40",
                "ring-2",
                "ring-primary",
                "bg-primary-light/40",
              );
            }
          }, 0);
          return;
        }

        // 2. Cek apakah yang di-drag adalah menu utama (top-level)
        const topTarget = target.closest(
          ".nav-tree-item",
        ) as HTMLElement | null;
        if (topTarget) {
          draggedElement = topTarget;
          draggedType = topTarget.getAttribute("data-type") || "page";
          initialSnapshot = getCurrentNavSnapshot();

          setTimeout(() => {
            if (draggedElement) {
              draggedElement.classList.add(
                "opacity-40",
                "ring-2",
                "ring-primary",
                "bg-primary-light/40",
              );
            }
          }, 0);
        }
      });

      navContainer.addEventListener("dragover", (e: DragEvent) => {
        e.preventDefault();
        if (!draggedElement) return;

        const target = e.target as HTMLElement;
        const submenuContainer = target.closest(
          ".nav-submenu-container",
        ) as HTMLElement | null;

        // Dropdown tidak boleh menjadi anak di dalam dropdown lain (hanya reorder di level utama)
        if (draggedType === "dropdown") {
          const targetTop = target.closest(
            ".nav-tree-item",
          ) as HTMLElement | null;
          if (!targetTop || targetTop === draggedElement) return;

          const header =
            (targetTop.querySelector(".nav-tree-header") as HTMLElement) ||
            targetTop;
          const rect = header.getBoundingClientRect();
          const midY = rect.top + rect.height / 2;

          if (e.clientY < midY) {
            if (targetTop.previousElementSibling === draggedElement) return;
            targetTop.before(draggedElement);
          } else {
            if (targetTop.nextElementSibling === draggedElement) return;
            targetTop.after(draggedElement);
          }
          return;
        }

        // Item Non-Dropdown (dapat masuk ke submenu ATAU menjadi menu utama):
        // A. Jika di-drag ke atas wadah submenu:
        if (submenuContainer) {
          if (draggedElement.contains(submenuContainer)) return;

          // Beri sorotan visual pada dropdown tujuan
          document.querySelectorAll(".nav-submenu-container").forEach((s) => {
            if (s === submenuContainer) {
              s.classList.add(
                "ring-2",
                "ring-primary/40",
                "bg-primary-light/20",
              );
            } else {
              s.classList.remove(
                "ring-2",
                "ring-primary/40",
                "bg-primary-light/20",
              );
            }
          });

          const targetChild = target.closest(
            ".nav-child-item",
          ) as HTMLElement | null;
          if (targetChild && targetChild !== draggedElement) {
            const rect = targetChild.getBoundingClientRect();
            const midY = rect.top + rect.height / 2;
            if (e.clientY < midY) {
              if (targetChild.previousElementSibling === draggedElement) return;
              targetChild.before(draggedElement);
            } else {
              if (targetChild.nextElementSibling === draggedElement) return;
              targetChild.after(draggedElement);
            }
          } else if (!targetChild) {
            if (submenuContainer.lastElementChild !== draggedElement) {
              submenuContainer.appendChild(draggedElement);
            }
          }
          return;
        }

        // Bersihkan sorotan jika kursor keluar dari submenu
        document.querySelectorAll(".nav-submenu-container").forEach((s) => {
          s.classList.remove(
            "ring-2",
            "ring-primary/40",
            "bg-primary-light/20",
          );
        });

        // B. Jika di-drag ke area menu utama (top-level):
        const targetTop = target.closest(
          ".nav-tree-item",
        ) as HTMLElement | null;
        if (targetTop && targetTop !== draggedElement) {
          const header =
            (targetTop.querySelector(".nav-tree-header") as HTMLElement) ||
            targetTop;
          const rect = header.getBoundingClientRect();
          const midY = rect.top + rect.height / 2;

          if (e.clientY < midY) {
            if (targetTop.previousElementSibling === draggedElement) return;
            targetTop.before(draggedElement);
          } else {
            if (targetTop.nextElementSibling === draggedElement) return;
            targetTop.after(draggedElement);
          }
          return;
        }

        // C. Jika di-drag ke bagian paling bawah kontainer utama
        if (
          target === navContainer &&
          navContainer.lastElementChild !== draggedElement
        ) {
          navContainer.appendChild(draggedElement);
        }
      });

      navContainer.addEventListener("dragend", async () => {
        if (!draggedElement) return;

        const el = draggedElement;
        el.classList.remove(
          "opacity-40",
          "ring-2",
          "ring-primary",
          "bg-primary-light/40",
        );
        draggedElement = null;

        // Bersihkan semua sorotan submenu
        document.querySelectorAll(".nav-submenu-container").forEach((s) => {
          s.classList.remove(
            "ring-2",
            "ring-primary/40",
            "bg-primary-light/20",
          );
        });

        const newSnapshot = getCurrentNavSnapshot();

        // Periksa apakah ada perubahan struktur / urutan
        const isChanged =
          JSON.stringify(initialSnapshot) !== JSON.stringify(newSnapshot);
        if (!isChanged) return;

        // Periksa apakah ada item yang berubah induk (promosi / demosi / pindah dropdown)
        const parentChanged = newSnapshot.some((newItem) => {
          const oldItem = initialSnapshot.find((o) => o.id === newItem.id);
          return !oldItem || oldItem.parentId !== newItem.parentId;
        });

        const payload = newSnapshot.map((item) => ({
          id: item.id,
          sortOrder: item.sortOrder,
          parentId: item.parentId,
        }));

        try {
          const res = await fetch("/api/admin/navigation/reorder", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ items: payload }),
          });
          const json = await res.json();
          if (json.success) {
            showStatus(
              parentChanged
                ? "Struktur menu dan submenu berhasil diperbarui"
                : "Urutan menu berhasil disimpan",
              "success",
            );
            if (parentChanged) {
              setTimeout(() => {
                window.location.reload();
              }, 350);
            }
          } else {
            showStatus(json.error || "Gagal mengubah urutan", "error");
            setTimeout(() => window.location.reload(), 800);
          }
        } catch {
          showStatus("Koneksi server gagal", "error");
        }
      });
    }

    // Reset to default navigation
    document
      .getElementById("btn-reset-nav-defaults")
      ?.addEventListener("click", async () => {
        const confirmed = await (window as any).confirmDialog({
          title: "Reset Navigasi",
          message:
            "Apakah Anda yakin ingin mereset susunan menu navigasi ke konfigurasi standar sekolah? Menu yang telah dibuat akan digantikan.",
          confirmText: "Ya, Reset Navigasi",
          cancelText: "Batal",
          type: "warning",
        });
        if (!confirmed) return;
        try {
          const res = await fetch("/api/admin/navigation/reset-defaults", {
            method: "POST",
          });
          const json = await res.json();
          if (json.success) {
            window.location.reload();
          } else {
            showStatus(json.error || "Gagal mereset navigasi", "error");
          }
        } catch {
          showStatus("Koneksi server gagal", "error");
        }
      });
  </script>

  <style>
    .nav-submenu-container:has(> [data-id]) .nav-empty-placeholder {
      display: none !important;
    }
  </style>
</AdminLayout>
