          return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-surface-subtle text-body border border-border">Menunggu Berkas</span>`;
        };

        const getSelectionBadge = (sStatus) => {
          if (sStatus === "accepted") {
            return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-success-light text-success-text border border-success">Diterima</span>`;
