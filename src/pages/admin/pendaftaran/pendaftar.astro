    // ========================================================
    // RENDER PAGINATION CONTROLS
    // ========================================================
    function renderPaginationControls(pagination) {
      if (!pageNumbersContainer) return;
      const { page, totalPages: pages } = pagination;

      if (btnFirstPage) {
        btnFirstPage.disabled = page <= 1;
        btnFirstPage.onclick = () => loadApplicants(1, currentLimit);
      }
      if (btnPrevPage) {
        btnPrevPage.disabled = page <= 1;
        btnPrevPage.onclick = () => loadApplicants(page - 1, currentLimit);
      }
      if (btnNextPage) {
        btnNextPage.disabled = page >= pages;
        btnNextPage.onclick = () => loadApplicants(page + 1, currentLimit);
      }
      if (btnLastPage) {
        btnLastPage.disabled = page >= pages;
        btnLastPage.onclick = () => loadApplicants(pages, currentLimit);
      }

      // Generate page number buttons
      pageNumbersContainer.innerHTML = "";

      let pageNumbers = [];
      if (pages <= 7) {
        for (let i = 1; i <= pages; i++) pageNumbers.push(i);
      } else {
        if (page <= 4) {
          pageNumbers = [1, 2, 3, 4, 5, "...", pages];
        } else if (page >= pages - 3) {
          pageNumbers = [
            1,
            "...",
            pages - 4,
            pages - 3,
            pages - 2,
            pages - 1,
            pages,
          ];
        } else {
          pageNumbers = [1, "...", page - 1, page, page + 1, "...", pages];
        }
      }

      pageNumbers.forEach((p) => {
        if (p === "...") {
          const span = document.createElement("span");
          span.className = "px-1.5 text-muted text-xs select-none";
          span.textContent = "...";
          pageNumbersContainer.appendChild(span);
        } else {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.textContent = String(p);
          const isActive = p === page;
          btn.className = `border ${
            isActive
              ? "bg-primary text-white border-primary shadow-xs"
              : "border-border bg-surface text-heading hover:bg-surface-subtle"
          }`;
          btn.onclick = () => loadApplicants(Number(p), currentLimit);
          pageNumbersContainer.appendChild(btn);
        }
      });
    }

    // ========================================================
    // STAT CARDS CLICK EVENTS (FILTER STATUS LANGSUNG)
    // ========================================================
    statCards.forEach((card) => {
      card.addEventListener("click", () => {
        const filterVal = card.getAttribute("data-filter") || "";
        if (statusFilter) {
          statusFilter.value = filterVal;
        }
        loadApplicants(1, currentLimit);
      });
    });

    // ========================================================
    // MODAL A4 PREVIEW & EXPORT PDF CONTROLLER
    // ========================================================
    async function openA4Modal(id) {
      if (!modalA4 || !a4SheetContainer) return;
      modalA4.classList.remove("hidden");
      a4SheetContainer.innerHTML = `<div class="py-16 text-center text-muted">Mengambil data lengkap calon siswa untuk lembar A4...</div>`;

      try {
        const res = await fetch(`/api/admin/ppdb/registrations/${id}`);
        const result = await res.json();
        if (!result.success || !result.data) {
          a4SheetContainer.innerHTML = `<div class="p-6 rounded text-error-text bg-error-light">Data pendaftar tidak ditemukan.</div>`;
          return;
        }

        const s = result.data;
        currentViewingStudent = s;

        if (a4ModalSubtitle) {
          a4ModalSubtitle.textContent = `${s.registrationNumber} • ${s.fullName} (${s.wave || "Gelombang 1"})`;
        }
        if (linkA4Standalone) {
          linkA4Standalone.href = `/admin/pendaftaran/cetak?id=${s.id}`;
        }

        const a4CredCode = document.getElementById("a4-credential-code");
        const btnCopyA4 = document.getElementById("btn-copy-a4-credential");
        if (a4CredCode) a4CredCode.textContent = s.verificationCode || "-";
        if (btnCopyA4) {
          btnCopyA4.onclick = () => {
            if (s.verificationCode) {
              navigator.clipboard.writeText(s.verificationCode);
              const label = btnCopyA4.querySelector(".copy-label") || btnCopyA4;
              label.textContent = "Tersalin!";
              btnCopyA4.classList.add("bg-primary", "text-white", "border-primary");
              setTimeout(() => {
                label.textContent = "Salin Kode";
                btnCopyA4.classList.remove("bg-primary", "text-white", "border-primary");
              }, 2000);
            }
          };
        }

        // Render Lembar A4
        renderA4Sheet(s, schoolMeta);
      } catch (err) {
        a4SheetContainer.innerHTML = `<div class="p-6 rounded text-error-text bg-error-light">Gangguan jaringan saat memuat data lembar A4.</div>`;
      }
    }

