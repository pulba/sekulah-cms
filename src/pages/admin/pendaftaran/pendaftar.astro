              <div>
                <p class="text-muted">Calon Peserta Didik / Orang Tua Wali,</p>
                <div class="h-12"></div>
                <p class="font-bold underline text-heading uppercase">(${s.fullName})</p>
                <p class="text-[7.5pt] text-muted">Tanda Tangan &amp; Nama Terang</p>
              </div>

              <div>
                <p class="text-muted">${school.schoolCity}, ${currentDateStr}</p>
                <p class="text-muted font-medium">Panitia Penerimaan / Verifikator Pendaftaran,</p>
                <div class="h-12 flex items-center justify-center">
                  <span class="inline-block border border-dashed border-border text-muted text-[7.5pt] px-3 py-0.5 rounded">
                    Cap / Stempel Resmi
                  </span>
                </div>
                <p class="font-bold underline text-heading uppercase">PANITIA PENDAFTARAN SISWA BARU</p>
                <p class="text-[7.5pt] text-muted font-mono">NIP/ID: ${s.verifiedBy || "PANITIA-VERIFIED"}</p>
