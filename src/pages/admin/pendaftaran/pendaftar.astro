<!-- Client State Initialization: Data Profil Sekolah untuk Lembar Kop Surat A4 -->
<script
  is:inline
  define:vars={{
    schoolInfo: {
      schoolName,
      schoolType,
      schoolStatus,
      npsn,
      schoolAddress,
      schoolCity,
      schoolProvince,
      schoolPostal,
      schoolPhone,
      schoolEmail,
      schoolWebsite,
      logoUrl,
      principalName,
      academicYear,
      ministryTitle,
      subMinistryTitle,
    },
  }}
>
  window.__SCHOOL_INFO__ = schoolInfo;
</script>

<script is:inline>
  function initPendaftar() {
    // XSS Prevention: Escape all user-provided data before innerHTML interpolation
    function escapeHtml(str) {
      if (str === null || str === undefined) return "";
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    const schoolMeta = window.__SCHOOL_INFO__ || {};

    const searchInput = document.getElementById("applicant-search");
    const btnClearSearch = document.getElementById("btn-clear-search");
    const waveFilter = document.getElementById("applicant-wave-filter");
    const statusFilter = document.getElementById("applicant-status-filter");
    const btnRefresh = document.getElementById("btn-refresh-applicants");
    const btnResetFilters = document.getElementById("btn-reset-filters");
    const tableBody = document.getElementById("applicant-table-body");
    const banner = document.getElementById("status-banner");
    const badgeTotalHeader = document.getElementById("badge-total-header");

    // Stat cards for direct filtering
    const statCards = document.querySelectorAll(".stat-card");

    // Export button
    const btnExportExcel = document.getElementById("btn-export-excel");
    const exportExcelLabel = document.getElementById("export-excel-label");

    // Pagination elements
    const paginationLimit = document.getElementById("pagination-limit");
    const paginationInfo = document.getElementById("pagination-info");
    const btnFirstPage = document.getElementById("btn-first-page");
    const btnPrevPage = document.getElementById("btn-prev-page");
    const btnNextPage = document.getElementById("btn-next-page");
    const btnLastPage = document.getElementById("btn-last-page");
    const pageNumbersContainer = document.getElementById(
      "page-numbers-container",
    );

    // Verification Modal elements
    const modalDetail = document.getElementById("modal-applicant-detail");
    const modalDetailStudentName = document.getElementById("modal-detail-student-name");
    const modalDetailRegNumber = document.getElementById("modal-detail-reg-number");
    const modalHeaderStatusBadge = document.getElementById("modal-header-status-badge");
    const modalDetailAccessCode = document.getElementById("modal-detail-access-code");
    const btnCopyModalCode = document.getElementById("btn-copy-modal-code");
    const modalDetailContent = document.getElementById("applicant-detail-content");
    const modalDetailDocumentsList = document.getElementById("modal-detail-documents-list");
    const btnToggleStudentDetails = document.getElementById("btn-toggle-student-details");
    const studentDetailsWrapper = document.getElementById("student-details-wrapper");
    const unsavedChangesBadge = document.getElementById("unsaved-changes-badge");
    const btnCloseDetailModal = document.getElementById("btn-close-detail-modal");
    const btnCancelVerify = document.getElementById("btn-cancel-verify");
    const formVerify = document.getElementById("form-verify-applicant");
    const verifyApplicantId = document.getElementById("verify-applicant-id");
    const verifyRevisionNotes = document.getElementById("verify-revision-notes");
    const verifyNotes = document.getElementById("verify-notes");
    const btnOpenA4FromDetail = document.getElementById("btn-open-a4-from-detail");
    let isFormDirty = false;
    let isStudentDetailsExpanded = true;

    // A4 Preview Modal elements
    const modalA4 = document.getElementById("modal-a4-preview");
    const a4ModalSubtitle = document.getElementById("a4-modal-subtitle");
    const a4SheetContainer = document.getElementById("a4-sheet-container");
    const btnCloseA4Modal = document.getElementById("btn-close-a4-modal");
    const btnA4Print = document.getElementById("btn-a4-print");
    const linkA4Standalone = document.getElementById("link-a4-standalone");

    let currentPage = 1;
    let currentLimit = 15;
    let totalPages = 1;
    let searchTimer = null;
    let currentViewingStudent = null;

    function showBanner(message, type = "success") {
      if (!banner) return;
      banner.className = `rounded-lg p-3.5 text-xs font-medium ${
        type === "success"
          ? "border border-success/30 bg-success-light text-success-text"
          : "border border-error/30 bg-error-light text-error-text"
      }`;
      banner.textContent = message;
      banner.classList.remove("hidden");
      setTimeout(() => banner.classList.add("hidden"), 5000);
    }

    // Theme maps for 5 contrasting stat cards (solid semantic tokens dari global.css, darkmode sinkron)
    const cardThemes = {
      "": {
        base: "stat-card bg-primary text-primary-foreground hover:bg-primary-hover",
        active: "stat-card bg-primary text-primary-foreground shadow-md",
      },
      submitted: {
        base: "stat-card bg-warning text-white hover:bg-warning-hover",
        active: "stat-card bg-warning text-white shadow-md",
      },
      verified: {
        base: "stat-card bg-secondary text-secondary-foreground hover:bg-secondary-hover",
        active: "stat-card bg-secondary text-secondary-foreground shadow-md",
      },
      accepted: {
        base: "stat-card bg-success text-white hover:bg-success-hover",
        active: "stat-card bg-success text-white shadow-md",
      },
      rejected: {
        base: "stat-card bg-error text-white hover:bg-error-hover",
        active: "stat-card bg-error text-white shadow-md",
      },
    };

    // Update active highlight on stat cards
    function updateStatCardHighlights(activeStatus) {
      statCards.forEach((card) => {
        const cardFilter = card.getAttribute("data-filter") || "";
        const theme = cardThemes[cardFilter];
        if (!theme) return;
        const isActive =
          cardFilter === activeStatus || (cardFilter === "" && !activeStatus);
        card.className = isActive ? theme.active : theme.base;
      });
    }

    // Update export button href to match current filters
    function updateExportUrl(q, wave, status) {
      if (!btnExportExcel) return;
      const params = new URLSearchParams();
      if (q) params.set("q", q);
      if (wave) params.set("wave", wave);
      if (status) params.set("status", status);

      const qs = params.toString();
      btnExportExcel.href = qs
        ? `/api/admin/ppdb/export?${qs}`
        : "/api/admin/ppdb/export";

      if (exportExcelLabel) {
        exportExcelLabel.textContent = qs
          ? "Ekspor Terfilter (.xlsx)"
          : "Ekspor Excel (.xlsx)";
      }

      // Toggle Reset Filter button
      if (btnResetFilters) {
        if (q || wave || status) {
          btnResetFilters.classList.remove("hidden");
        } else {
          btnResetFilters.classList.add("hidden");
        }
      }

      // Toggle clear search button
      if (btnClearSearch) {
        if (q) {
          btnClearSearch.classList.remove("hidden");
        } else {
          btnClearSearch.classList.add("hidden");
        }
      }
    }

    // ========================================================
    // LOAD APPLICANTS & RENDER PAGINATION
    // ========================================================
    async function loadApplicants(page = 1, limit = currentLimit) {
      if (!tableBody) return;
      currentPage = page;
      currentLimit = limit;
      tableBody.innerHTML = `<tr><td colspan="6" class="py-12 text-center text-muted">Memuat data pendaftar terbaru...</td></tr>`;

      const q = searchInput?.value.trim() || "";
      const wave = waveFilter?.value || "";
      const status = statusFilter?.value || "";

      updateExportUrl(q, wave, status);
      updateStatCardHighlights(status);

      const params = new URLSearchParams();
      params.set("page", String(page));
      params.set("limit", String(limit));
      if (q) params.set("q", q);
      if (wave) params.set("wave", wave);
      if (status) params.set("status", status);

      try {
        const res = await fetch(
          `/api/admin/ppdb/registrations?${params.toString()}`,
        );
        const result = await res.json();

        if (!result.success) {
          tableBody.innerHTML = `<tr><td colspan="6" class="py-12 text-center text-error">${result.error || "Gagal memuat data."}</td></tr>`;
          return;
        }

        // Update stats counter
        if (result.stats) {
          const sTotal = document.getElementById("stat-total");
          const sSub = document.getElementById("stat-submitted");
          const sVer = document.getElementById("stat-verified");
          const sAcc = document.getElementById("stat-accepted");
          const sRej = document.getElementById("stat-rejected");

          if (sTotal) sTotal.textContent = String(result.stats.total || 0);
          if (sSub) sSub.textContent = String(result.stats.submitted || 0);
          if (sVer) sVer.textContent = String(result.stats.verified || 0);
          if (sAcc) sAcc.textContent = String(result.stats.accepted || 0);
          if (sRej) sRej.textContent = String(result.stats.rejected || 0);
          if (badgeTotalHeader)
            badgeTotalHeader.textContent = `${result.stats.total || 0} Siswa`;
        }

        // Update pagination UI
        if (result.pagination) {
          totalPages = result.pagination.totalPages || 1;
          const totalRecords = result.pagination.total || 0;
          const startRecord = totalRecords > 0 ? (page - 1) * limit + 1 : 0;
          const endRecord = Math.min(page * limit, totalRecords);

          if (paginationInfo) {
            paginationInfo.textContent = `Menampilkan ${startRecord} – ${endRecord} dari ${totalRecords} calon siswa (Halaman ${page} dari ${totalPages})`;
          }
          if (paginationLimit) {
            paginationLimit.value = String(limit);
          }

          renderPaginationControls(result.pagination);
        }

        const items = result.data || [];
        if (items.length === 0) {
