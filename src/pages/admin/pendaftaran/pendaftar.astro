            <div class="border-t border-border pt-1.5 flex items-center justify-between text-[7pt] text-muted font-mono">
              <span>Dicetak otomatis dari Sistem Pendaftaran ${school.schoolName} &bull; ID: ${s.id}</span>
              <span>Lembar Resmi A4 &bull; Halaman 1 dari 1</span>
            </div>
          </div>
        </div>
      `;
    }

    function closeA4Modal() {
      if (modalA4) modalA4.classList.add("hidden");
    }

    btnCloseA4Modal?.addEventListener("click", closeA4Modal);

    btnA4Print?.addEventListener("click", () => {
      if (!currentViewingStudent) return;
      window.open(
        `/admin/pendaftaran/cetak?id=${currentViewingStudent.id}&print=true`,
        "_blank",
      );
    });

    // ========================================================
    // ========================================================
    // MODAL DETAIL VERIFIKASI STATUS & KEPUTUSAN SELEKSI
    // ========================================================
    function markFormDirty(dirty = true) {
      isFormDirty = dirty;
      if (unsavedChangesBadge) {
        if (dirty) {
          unsavedChangesBadge.classList.remove("hidden");
        } else {
          unsavedChangesBadge.classList.add("hidden");
        }
      }
    }

    // Attach dirty-check listeners to form inputs
    formVerify?.querySelectorAll("input, textarea").forEach((el) => {
      el.addEventListener("change", () => markFormDirty(true));
      el.addEventListener("input", () => markFormDirty(true));
    });

    async function openDetailModal(id) {
      if (!modalDetail) return;
      modalDetail.classList.remove("hidden");
      markFormDirty(false);

      if (modalDetailContent) {
        modalDetailContent.innerHTML = `<div class="py-6 text-center text-muted">Mengambil data lengkap calon siswa...</div>`;
      }
      if (modalDetailDocumentsList) {
        modalDetailDocumentsList.innerHTML = `<tr><td colspan="3" class="py-4 text-center text-muted">Memuat daftar dokumen...</td></tr>`;
      }

      try {
        const res = await fetch(`/api/admin/ppdb/registrations/${id}`);
        const result = await res.json();
        if (!result.success || !result.data) {
          if (modalDetailContent) {
            modalDetailContent.innerHTML = `<div class="p-4 rounded text-error-text bg-error-light">Data tidak ditemukan.</div>`;
          }
          return;
        }

        const s = result.data;
        currentViewingStudent = s;

        // 1. Header Metadata & Kode Akses
        if (modalDetailStudentName) {
          modalDetailStudentName.textContent = s.fullName;
        }
        if (modalDetailRegNumber) {
          modalDetailRegNumber.textContent = `${s.registrationNumber} • ${s.academicYear} • ${s.wave || "Gelombang 1"} • Jalur: ${s.admissionPath}`;
        }
        if (modalHeaderStatusBadge) {
          const statusText = s.status === "accepted" ? "Diterima" : s.status === "rejected" ? "Tidak Diterima" : s.status === "verified" ? "Berkas Sah" : "Menunggu";
          const statusClass = s.status === "accepted" ? "bg-success-light text-success-text border-success" : s.status === "rejected" ? "bg-error-light text-error-text border-error" : s.status === "verified" ? "bg-primary-light text-primary border-primary" : "bg-surface-subtle text-muted border-border";
          modalHeaderStatusBadge.className = `inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border ${statusClass}`;
          modalHeaderStatusBadge.textContent = statusText;
        }
        if (modalDetailAccessCode) {
          modalDetailAccessCode.textContent = s.verificationCode || "-";
        }

        if (verifyApplicantId) verifyApplicantId.value = s.id;
        if (verifyNotes) verifyNotes.value = s.notes || "";
        if (verifyRevisionNotes) verifyRevisionNotes.value = s.revisionNotes || "";

        // Form Radios
        const verRadios = document.querySelectorAll('input[name="verification_status"]');
        verRadios.forEach((r) => {
          r.checked = r.value === (s.verificationStatus || (s.status === "verified" ? "verified" : "pending"));
        });

        const selRadios = document.querySelectorAll('input[name="selection_status"]');
        selRadios.forEach((r) => {
          r.checked = r.value === (s.selectionStatus || (s.status === "accepted" ? "accepted" : s.status === "rejected" ? "rejected" : "not_announced"));
        });

        // 2. Render Bagian 1: Data Calon Siswa (2 Kolom Bersih, Tanpa Kotak Berulang)
        if (modalDetailContent) {
          modalDetailContent.innerHTML = `
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
              <div>
                <span class="text-muted text-[11px] block">Nama Lengkap</span>
                <span class="font-semibold text-heading text-xs">${escapeHtml(s.fullName)}</span>
              </div>
              <div>
                <span class="text-muted text-[11px] block">NIK • NISN</span>
                <span class="font-mono text-heading text-xs">${escapeHtml(s.nik)} • ${escapeHtml(s.nisn || "-")}</span>
              </div>
              <div>
                <span class="text-muted text-[11px] block">Jenis Kelamin &amp; Agama</span>
                <span class="text-heading text-xs">${s.gender === "L" ? "Laki-laki" : "Perempuan"} • ${escapeHtml(s.religion)}</span>
              </div>
              <div>
                <span class="text-muted text-[11px] block">Tempat, Tanggal Lahir</span>
                <span class="text-heading text-xs">${escapeHtml(s.birthPlace)}, ${escapeHtml(s.birthDate)}</span>
              </div>
              <div>
                <span class="text-muted text-[11px] block">Asal Sekolah</span>
                <span class="text-heading text-xs">${escapeHtml(s.prevSchool)}</span>
              </div>
              <div>
                <span class="text-muted text-[11px] block">Kontak WhatsApp Calon Siswa</span>
                <span class="font-mono text-primary text-xs font-semibold">${escapeHtml(s.phoneStudent)}</span>
              </div>
              <div>
                <span class="text-muted text-[11px] block">Orang Tua (Ayah / Ibu)</span>
                <span class="text-heading text-xs">${escapeHtml(s.fatherName)} • ${escapeHtml(s.motherName)}</span>
              </div>
              <div>
                <span class="text-muted text-[11px] block">Pekerjaan Orang Tua</span>
                <span class="text-heading text-xs">${escapeHtml(s.fatherJob || "-")} / ${escapeHtml(s.motherJob || "-")}</span>
              </div>
              <div class="sm:col-span-2">
                <span class="text-muted text-[11px] block">Alamat Domisili</span>
                <span class="text-heading text-xs leading-relaxed">${escapeHtml(s.address)}, ${escapeHtml(s.village)}, Kec. ${escapeHtml(s.district)}, ${escapeHtml(s.city)}</span>
              </div>
              <div class="sm:col-span-2 pt-2 border-t border-border flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px]">
                <span class="text-muted">Jalur: <strong class="text-heading font-semibold">${escapeHtml(s.admissionPath)}</strong></span>
                <span class="text-muted">Satuan: <strong class="text-heading font-semibold">${escapeHtml(s.schoolType)}</strong></span>
                <span class="text-muted">Asrama: <strong class="text-heading font-semibold">${s.isBoarding ? "Ya" : "Tidak"}</strong></span>
                ${s.majorChoice1 ? `<span class="text-muted">Jurusan: <strong class="text-heading font-semibold">${escapeHtml(s.majorChoice1)}</strong></span>` : ""}
              </div>
            </div>
          `;
        }

        // 3. Render Bagian 2: Checklist Dokumen Persyaratan
        if (modalDetailDocumentsList) {
          const docItems = [
            { name: "Kartu Keluarga (KK)", url: s.fileKk, req: true },
            { name: "Akta Kelahiran", url: s.fileAkta, req: true },
            { name: "Surat Keterangan Lulus (SKL) / Rapor", url: s.fileSkl, req: true },
            { name: "Dokumen Pendukung / Prestasi", url: s.fileAdditional, req: false },
          ];

          modalDetailDocumentsList.innerHTML = docItems
            .map((doc) => {
              const hasFile = Boolean(doc.url);
              const statusBadge = hasFile
                ? `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-success-light text-success-text border border-success">Terunggah</span>`
                : `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-surface-subtle text-muted border border-border">${doc.req ? "Belum Diunggah" : "Tidak Ada"}</span>`;
              const actionBtn = hasFile
                ? `<a href="${doc.url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-primary hover:underline font-semibold text-xs">
                     <span>Buka Berkas</span>
                     <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                     </svg>
                   </a>`
                : `<span class="text-muted text-xs">-</span>`;

              return `
                <tr class="hover:bg-surface-subtle transition-colors">
                  <td class="py-2.5 px-3.5">
                    <span class="font-medium text-heading text-xs">${doc.name}</span>
                    ${doc.req ? '<span class="text-error text-xs ml-0.5 font-bold">*</span>' : '<span class="text-[10px] text-muted ml-1">(opsional)</span>'}
                  </td>
                  <td class="py-2.5 px-3.5 text-center">${statusBadge}</td>
                  <td class="py-2.5 px-3.5 text-right">${actionBtn}</td>
                </tr>
              `;
            })
            .join("");
        }

        markFormDirty(false);
      } catch (err) {
        if (modalDetailContent) {
          modalDetailContent.innerHTML = `<div class="p-4 rounded text-error-text bg-error-light">Gangguan saat memuat detail pendaftar.</div>`;
        }
      }
    }

    async function closeDetailModal(force = false) {
      if (!force && isFormDirty) {
        const confirmed = await window.confirmDialog({
          title: "Perubahan Belum Disimpan",
          message: "Ada perubahan yang belum disimpan. Tetap keluar dari verifikasi calon siswa ini?",
          confirmText: "Keluar Tanpa Simpan",
          cancelText: "Lanjut Edit",
          type: "warning",
        });
        if (!confirmed) return;
      }
      if (modalDetail) modalDetail.classList.add("hidden");
      markFormDirty(false);
    }

    btnCloseDetailModal?.addEventListener("click", () => closeDetailModal());
    btnCancelVerify?.addEventListener("click", () => closeDetailModal());

    btnCopyModalCode?.addEventListener("click", () => {
      if (!currentViewingStudent?.verificationCode) return;
      navigator.clipboard.writeText(currentViewingStudent.verificationCode);
      btnCopyModalCode.textContent = "Tersalin!";
      setTimeout(() => {
        if (btnCopyModalCode) btnCopyModalCode.textContent = "Salin";
      }, 2000);
    });

    btnToggleStudentDetails?.addEventListener("click", () => {
      isStudentDetailsExpanded = !isStudentDetailsExpanded;
      if (studentDetailsWrapper) {
        studentDetailsWrapper.classList.toggle("hidden", !isStudentDetailsExpanded);
      }
      if (btnToggleStudentDetails) {
        btnToggleStudentDetails.textContent = isStudentDetailsExpanded ? "Sembunyikan" : "Tampilkan";
      }
    });

    btnOpenA4FromDetail?.addEventListener("click", () => {
      if (!currentViewingStudent) return;
      closeDetailModal(true);
      openA4Modal(currentViewingStudent.id);
    });

    // Form Submit Verifikasi
    formVerify?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const id = verifyApplicantId?.value;
      if (!id || !currentViewingStudent) return;

      const checkedVerRadio = document.querySelector(
        'input[name="verification_status"]:checked',
      );
      const verificationStatus = checkedVerRadio
        ? checkedVerRadio.value
        : "pending";

      const checkedSelRadio = document.querySelector(
        'input[name="selection_status"]:checked',
      );
      const selectionStatus = checkedSelRadio
        ? checkedSelRadio.value
        : "not_announced";

      const revisionNotes = verifyRevisionNotes?.value || "";
      const notes = verifyNotes?.value || "";

      // UX Guard: Validasi sebelum penetapan status kelulusan diterima / ditolak
      const initialSelStatus = currentViewingStudent.selectionStatus || "not_announced";
      if (selectionStatus !== initialSelStatus && (selectionStatus === "accepted" || selectionStatus === "rejected")) {
        const statusName = selectionStatus === "accepted" ? "DITERIMA" : "TIDAK DITERIMA";
        const confirmed = await window.confirmDialog({
          title: "Konfirmasi Keputusan Seleksi",
          message: `Apakah Anda yakin ingin menetapkan keputusan "${statusName}" untuk siswa:\n${currentViewingStudent.fullName} (${currentViewingStudent.registrationNumber})?\n\nPastikan verifikasi berkas dan kuota penerimaan telah diperiksa dengan seksama.`,
          confirmText: `Tetapkan ${statusName}`,
          cancelText: "Periksa Kembali",
          type: selectionStatus === "accepted" ? "info" : "danger",
        });
        if (!confirmed) return;
      }

      let legacyStatus = "submitted";
      if (selectionStatus === "accepted") legacyStatus = "accepted";
      else if (selectionStatus === "rejected") legacyStatus = "rejected";
      else if (verificationStatus === "verified") legacyStatus = "verified";

      const btnSubmit = document.getElementById("btn-submit-verify");
      if (btnSubmit) {
        btnSubmit.disabled = true;
        btnSubmit.textContent = "Menyimpan...";
      }

      try {
        const res = await fetch(`/api/admin/ppdb/registrations/${id}/status`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            status: legacyStatus,
            verificationStatus,
            selectionStatus,
            revisionNotes,
            notes,
          }),
        });

        const data = await res.json();
        if (btnSubmit) {
          btnSubmit.disabled = false;
          btnSubmit.textContent = "Simpan Keputusan";
        }

        if (data.success) {
          markFormDirty(false);
          closeDetailModal(true);
          showBanner(
            "Status verifikasi berkas & keputusan seleksi berhasil diperbarui!",
            "success",
          );
          loadApplicants(currentPage, currentLimit);
        } else {
          alert(data.error || "Gagal memperbarui status.");
        }
      } catch (err) {
        if (btnSubmit) {
          btnSubmit.disabled = false;
          btnSubmit.textContent = "Simpan Keputusan";
        }
        alert("Gangguan jaringan saat memproses verifikasi.");
      }
    });

    // Limit selector event
    paginationLimit?.addEventListener("change", (e) => {
      const newLimit = Number(e.target.value) || 15;
      loadApplicants(1, newLimit);
    });

    // Event filter & search
    searchInput?.addEventListener("input", () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        loadApplicants(1, currentLimit);
      }, 350);
    });

    btnClearSearch?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      loadApplicants(1, currentLimit);
    });

    waveFilter?.addEventListener("change", () =>
      loadApplicants(1, currentLimit),
    );
    statusFilter?.addEventListener("change", () => {
      updateStatCardHighlights(statusFilter.value);
      loadApplicants(1, currentLimit);
    });
    btnRefresh?.addEventListener("click", () =>
      loadApplicants(currentPage, currentLimit),
    );

    btnResetFilters?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      if (waveFilter) waveFilter.value = "";
      if (statusFilter) statusFilter.value = "";
      updateStatCardHighlights("");
      loadApplicants(1, currentLimit);
    });

    // Load awal
    loadApplicants(1, 15);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPendaftar);
  } else {
    initPendaftar();
  }
</script>
</AdminLayout>
