          <!-- BAGIAN IV: PERSYARATAN BERKAS & DOKUMEN -->
          <div class="space-y-0.5">
            <div class="text-[8.5pt] font-bold uppercase bg-surface-subtle px-2.5 py-1 border border-border text-heading">
              IV. CHECKLIST KELENGKAPAN &amp; VERIFIKASI PERSYARATAN BERKAS
            </div>
            <table class="w-full text-[8pt] border border-border border-collapse">
              <thead class="bg-surface-subtle text-heading font-semibold border-b border-border">
