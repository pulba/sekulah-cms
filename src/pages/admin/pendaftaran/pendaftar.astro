        tableBody.querySelectorAll(".btn-detail-applicant").forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = btn.getAttribute("data-id");
            if (id) openDetailModal(id);
          });
        });

        tableBody.querySelectorAll(".btn-delete-applicant").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = btn.getAttribute("data-id");
            const name = btn.getAttribute("data-name") || "Calon Siswa";
            const reg = btn.getAttribute("data-reg") || "";
            if (!id) return;

            const confirmed = await window.confirmDialog({
              title: "Hapus Data Calon Siswa",
              message: `Nama: ${name}\nNo. Registrasi: ${reg}\n\nPERINGATAN: Tindakan ini permanen. Seluruh berkas dan data pendaftaran siswa ini akan dihapus dari sistem.`,
              confirmText: "Hapus Permanen",
              cancelText: "Batal",
              type: "danger",
            });
            if (!confirmed) return;

            try {
              btn.disabled = true;
              btn.innerHTML = `<span class="inline-block animate-spin">&#9696;</span>`;
              const res = await fetch(`/api/admin/ppdb/registrations/${id}`, {
                method: "DELETE",
              });
              const result = await res.json();
              if (result.success) {
                showBanner(
                  `Data calon siswa "${name}" (${reg}) berhasil dihapus.`,
