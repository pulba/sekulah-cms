                <tr>
                  <td class="py-1.5 px-2.5 font-medium text-muted bg-surface-subtle border-r border-border">Alamat Tempat Tinggal</td>
                  <td class="py-1.5 px-2.5 text-heading" colspan="3">
                    ${escapeHtml(s.address)} ${s.rtRw ? `RT/RW ${escapeHtml(s.rtRw)}` : ""}, Kel/Desa ${escapeHtml(s.village)}, Kec. ${escapeHtml(s.district)}, ${escapeHtml(s.city)}, Prov. ${escapeHtml(s.province || school.schoolProvince)} ${s.postalCode ? `(${escapeHtml(s.postalCode)})` : ""}
                  </td>
