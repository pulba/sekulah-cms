                  <td class="py-1.5 px-2.5 text-center border-r border-border font-bold">
                    ${s.fileKk ? '<span class="text-success-text">&#10003; TERUNGGAH</span>' : '<span class="text-muted">&#10007; BELUM ADA</span>'}
                  </td>
                  <td class="py-1.5 px-2.5 text-center border-r border-border font-mono text-[7.5pt]">
                    ${s.fileKk ? `<a href="${s.fileKk}" target="_blank" class="text-primary hover:text-primary-hover underline font-semibold">Buka Dokumen &rarr;</a>` : '<span class="text-muted">-</span>'}
                  </td>
                  <td class="py-1.5 px-2.5 text-center font-bold text-heading">
                    ${s.fileKk ? "&#10003; Lengkap" : "&nbsp; Tidak Lengkap"}
                  </td>
                </tr>
                <tr>
                  <td class="py-1.5 px-2.5 text-center border-r border-border text-heading">2</td>
                  <td class="py-1.5 px-2.5 border-r border-border font-semibold text-heading">Akta Kelahiran Calon Siswa</td>
                  <td class="py-1.5 px-2.5 text-center border-r border-border font-bold">
                    ${s.fileAkta ? '<span class="text-success-text">&#10003; TERUNGGAH</span>' : '<span class="text-muted">&#10007; BELUM ADA</span>'}
                  </td>
                  <td class="py-1.5 px-2.5 text-center border-r border-border font-mono text-[7.5pt]">
                    ${s.fileAkta ? `<a href="${s.fileAkta}" target="_blank" class="text-primary hover:text-primary-hover underline font-semibold">Buka Dokumen &rarr;</a>` : '<span class="text-muted">-</span>'}
                  </td>
                  <td class="py-1.5 px-2.5 text-center font-bold text-heading">
                    ${s.fileAkta ? "&#10003; Lengkap" : "&nbsp; Tidak Lengkap"}
                  </td>
                </tr>
                <tr>
                  <td class="py-1.5 px-2.5 text-center border-r border-border text-heading">3</td>
                  <td class="py-1.5 px-2.5 border-r border-border font-semibold text-heading">Surat Keterangan Lulus (SKL) / Ijazah</td>
                  <td class="py-1.5 px-2.5 text-center border-r border-border font-bold">
                    ${s.fileSkl ? '<span class="text-success-text">&#10003; TERUNGGAH</span>' : '<span class="text-muted">&#10007; BELUM ADA</span>'}
                  </td>
                  <td class="py-1.5 px-2.5 text-center border-r border-border font-mono text-[7.5pt]">
                    ${s.fileSkl ? `<a href="${s.fileSkl}" target="_blank" class="text-primary hover:text-primary-hover underline font-semibold">Buka Dokumen &rarr;</a>` : '<span class="text-muted">-</span>'}
                  </td>
                  <td class="py-1.5 px-2.5 text-center font-bold text-heading">
                    ${s.fileSkl ? "&#10003; Lengkap" : "&nbsp; Tidak Lengkap"}
                  </td>
                </tr>
                <tr>
                  <td class="py-1.5 px-2.5 text-center border-r border-border text-heading">4</td>
                  <td class="py-1.5 px-2.5 border-r border-border font-semibold text-heading">Dokumen Pendukung (Rapor / Tahfidz / Buta Warna)</td>
                  <td class="py-1.5 px-2.5 text-center border-r border-border font-bold">
                    ${s.fileAdditional ? '<span class="text-success-text">&#10003; TERUNGGAH</span>' : '<span class="text-muted">&#10007; BELUM ADA</span>'}
                  </td>
                  <td class="py-1.5 px-2.5 text-center border-r border-border font-mono text-[7.5pt]">
                    ${s.fileAdditional ? `<a href="${s.fileAdditional}" target="_blank" class="text-primary hover:text-primary-hover underline font-semibold">Buka Dokumen &rarr;</a>` : '<span class="text-muted">-</span>'}
                  </td>
                  <td class="py-1.5 px-2.5 text-center font-bold text-heading">
                    ${s.fileAdditional ? "&#10003; Lengkap" : "&nbsp; Opsional"}
                  </td>
                </tr>
              </tbody>
            </table>

            <!-- Catatan Panitia Verifikasi -->
            <div class="border border-border p-2 text-[7.5pt] rounded bg-surface-subtle mt-1">
              <span class="font-bold text-heading">Catatan Panitia Verifikasi / Alasan:</span>
              <span class="text-muted ml-1 italic">${s.notes || "Seluruh berkas persyaratan telah dicatat ke dalam sistem pendaftaran resmi."}</span>
