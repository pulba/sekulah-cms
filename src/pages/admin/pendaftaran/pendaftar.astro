---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Icon from "../../../components/Icon.astro";
import { db, settings, registrations } from "../../../db";
import { sql, desc } from "drizzle-orm";
import {
  getDefaultPpdbConfig,
  type PpdbFullConfig,
} from "../../../utils/ppdbConfigDefaults";

export const prerender = false;

// 1. Ambil data profil sekolah dan konfigurasi PPDB
const allSettings = await db.select().from(settings);
const settingMap = allSettings.reduce(
  (acc, curr) => {
    acc[curr.key] = curr.value;
    return acc;
  },
  {} as Record<string, string>,
);

const schoolName = settingMap["school_name"] || "SMAN 1 Unggulan";
const academicYear = settingMap["ppdb_year"] || "2026/2027";
const schoolType = (
  settingMap["school_type"] ||
  settingMap["school_level"] ||
  "SMA"
).toUpperCase();
const schoolStatus = settingMap["school_status"] || "Negeri";
const npsn = settingMap["npsn"] || settingMap["school_npsn"] || "20108921";
const schoolAddress = settingMap["address"] || "Jl. Pendidikan No. 45";
const schoolCity = settingMap["city"] || "Kota Jakarta Selatan";
const schoolProvince = settingMap["province"] || "DKI Jakarta";
const schoolPostal = settingMap["postal_code"] || "12340";
const schoolPhone = settingMap["phone"] || "(021) 555-0199";
const schoolEmail = settingMap["email"] || "info@sekolah.sch.id";
const schoolWebsite =
  settingMap["website"] || settingMap["school_website"] || "www.sekolah.sch.id";
const logoUrl = settingMap["logo_url"] || "";
const principalName = settingMap["principal_name"] || "Dr. H. Sulaiman, M.Pd.";

const isMadrasah = ["MA", "MTS", "MI"].includes(schoolType);
const isVocational = schoolType === "SMK";
const ministryTitle = isMadrasah
  ? "KEMENTERIAN AGAMA REPUBLIK INDONESIA"
  : isVocational
    ? "KEMENTERIAN PENDIDIKAN, KEBUDAYAAN, RISET DAN TEKNOLOGI"
    : "PEMERINTAH DAERAH PROVINSI / KEMENTERIAN PENDIDIKAN";
const subMinistryTitle = isMadrasah
  ? "KANTOR KEMENTERIAN AGAMA KABUPATEN/KOTA"
  : "DINAS PENDIDIKAN DAN KEBUDAYAAN";

// 2. Ambil daftar gelombang untuk filter
let wavesList: string[] = ["Gelombang 1", "Gelombang 2", "Gelombang 3"];
if (settingMap["ppdb_form_config"]) {
  try {
    const parsed = JSON.parse(settingMap["ppdb_form_config"]);
    if (parsed.waves && Array.isArray(parsed.waves)) {
      wavesList = parsed.waves.map((w: any) => w.name);
    }
  } catch {}
}

// 3. Statistik awal dari database
const statsTotal = await db
  .select({ count: sql<number>`count(*)` })
  .from(registrations)
  .then((r) => Number(r[0]?.count || 0));
const statsSubmitted = await db
  .select({ count: sql<number>`count(*)` })
  .from(registrations)
  .where(sql`${registrations.status} = 'submitted'`)
  .then((r) => Number(r[0]?.count || 0));
const statsVerified = await db
  .select({ count: sql<number>`count(*)` })
  .from(registrations)
  .where(sql`${registrations.status} = 'verified'`)
  .then((r) => Number(r[0]?.count || 0));
const statsAccepted = await db
  .select({ count: sql<number>`count(*)` })
  .from(registrations)
  .where(sql`${registrations.status} = 'accepted'`)
  .then((r) => Number(r[0]?.count || 0));
const statsRejected = await db
  .select({ count: sql<number>`count(*)` })
  .from(registrations)
  .where(sql`${registrations.status} = 'rejected'`)
  .then((r) => Number(r[0]?.count || 0));
---

<AdminLayout title="Data Pendaftar" activeNav="pendaftar" settingsMap={settingMap}>
  <div class="max-w-6xl mx-auto space-y-6 pb-24 font-body text-body">
    
    <!-- HEADER HALAMAN & AKSI SEKUNDER                           -->
    
    <div
      class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-5"
    >
      <div>
        <div class="flex items-center gap-2.5">
          <h1
            class="font-display text-2xl font-bold tracking-tight text-heading"
          >
            Data Pendaftar
          </h1>
        </div>
        <p class="mt-1 font-body text-xs text-muted">
          Pusat verifikasi pendaftaran tahun ajaran {academicYear}.
        </p>
      </div>

      <!-- Aksi Sekunder Header -->
      <div class="flex flex-wrap items-center gap-2 shrink-0 *:inline-flex *:h-9 *:items-center *:justify-center *:gap-1.5 *:rounded-[6px] *:border *:border-border *:bg-surface *:text-xs *:transition-colors *:shadow-xs">
        <!-- Pengaturan Pendaftaran (Aksi Sekunder) -->
        <a
          href="/admin/pendaftaran"
          class="px-3 font-medium text-muted hover:text-heading hover:bg-surface-subtle"
          title="Buka Pusat Pengaturan Pendaftaran"
        >
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>Pengaturan Pendaftaran</span>
        </a>

        <!-- Ekspor Data Excel (Mengikuti Filter yang Aktif) -->
        <a
          id="btn-export-excel"
          href="/api/admin/ppdb/export"
          target="_blank"
          class="px-3.5 font-semibold text-heading hover:bg-surface-subtle"
          title="Unduh data pendaftar dalam format Excel (.xlsx)"
        >
          <svg
            class="h-3.5 w-3.5 text-success"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          <span id="export-excel-label">Ekspor Excel (.xlsx)</span>
        </a>
      </div>
    </div>

    <!-- Alert Feedback Banner -->
    <div id="status-banner" class="hidden rounded-lg p-3.5 text-xs font-medium">
    </div>

    
    <!-- 5 KARTU STATISTIK (KONTRAS WARNA TIAP KATEGORI - TANPA BORDER) -->
    
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5 *:text-left *:rounded-lg *:p-4 *:transition-all *:cursor-pointer *:shadow-xs">
      <!-- Data Pendaftar (Calon Siswa) / Total -->
      <button
        type="button"
        id="card-stat-all"
        class="stat-card bg-primary text-primary-foreground hover:bg-primary-hover shadow-md"
        data-filter=""
        title="Klik untuk melihat seluruh calon siswa"
      >
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold">Data Pendaftar</span>
        </div>
        <div
          id="stat-total"
          class="font-display text-2xl sm:text-3xl font-bold mt-1"
        >
          {statsTotal}
        </div>
      </button>

      <!-- Menunggu Verifikasi -->
      <button
        type="button"
        id="card-stat-submitted"
        class="stat-card bg-warning text-white hover:bg-warning-hover"
        data-filter="submitted"
        title="Klik untuk menyaring calon siswa yang menunggu verifikasi"
      >
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold">Menunggu Verifikasi</span>
        </div>
        <div
          id="stat-submitted"
          class="font-display text-2xl sm:text-3xl font-bold mt-1"
        >
          {statsSubmitted}
        </div>
      </button>

      <!-- Berkas Terverifikasi -->
      <button
        type="button"
        id="card-stat-verified"
        class="stat-card bg-secondary text-secondary-foreground hover:bg-secondary-hover"
        data-filter="verified"
        title="Klik untuk menyaring berkas yang sudah sah terverifikasi"
      >
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold">Berkas Terverifikasi</span>
        </div>
        <div
          id="stat-verified"
          class="font-display text-2xl sm:text-3xl font-bold mt-1"
        >
          {statsVerified}
        </div>
      </button>

      <!-- Diterima Resmi -->
      <button
        type="button"
        id="card-stat-accepted"
        class="stat-card bg-success text-white hover:bg-success-hover"
        data-filter="accepted"
        title="Klik untuk menyaring calon siswa yang telah diterima resmi"
      >
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold">Diterima Resmi</span>
        </div>
        <div
          id="stat-accepted"
          class="font-display text-2xl sm:text-3xl font-bold mt-1"
        >
          {statsAccepted}
        </div>
      </button>

      <!-- Tidak Diterima -->
      <button
        type="button"
        id="card-stat-rejected"
        class="stat-card bg-error text-white hover:bg-error-hover"
        data-filter="rejected"
        title="Klik untuk menyaring calon siswa yang tidak diterima"
      >
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold">Tidak Diterima</span>
        </div>
        <div
          id="stat-rejected"
          class="font-display text-2xl sm:text-3xl font-bold mt-1"
        >
          {statsRejected}
        </div>
      </button>
    </div>

    
    <!-- TOOLBAR FILTER (SATU BARIS RAPI, SEGAR DIBUAT SEKUNDER) -->
    
    <div
      class="rounded-lg border border-border bg-surface p-3 sm:p-4 shadow-xs"
    >
      <div
        class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5"
      >
        <!-- Input Pencarian (Fleksibel) -->
        <div class="relative flex-1 min-w-[200px]">
          <input
            type="text"
            id="applicant-search"
            placeholder="Cari nama, NIK, NISN, no reg..."
            class="h-9 w-full rounded-[6px] border border-border bg-surface pl-8 pr-8 text-xs text-heading placeholder:text-muted/60"
          />
          <Icon name="search" class="h-4 w-4 text-muted absolute left-2.5 top-2.5 pointer-events-none" />
          <button
            type="button"
            id="btn-clear-search"
            class="hidden absolute right-2.5 top-2.5 text-muted hover:text-heading cursor-pointer text-xs"
            title="Hapus pencarian"
          >
            &times;
          </button>
        </div>

        <!-- Filter Gelombang -->
        <div class="w-full sm:w-44 shrink-0">
          <select
            id="applicant-wave-filter"
            class="h-9 w-full rounded-[6px] border border-border bg-surface px-3 text-xs text-heading cursor-pointer"
          >
            <option value="">Semua Gelombang</option>
            {wavesList.map((w) => <option value={w}>{w}</option>)}
          </select>
        </div>

        <!-- Filter Status Seleksi -->
        <div class="w-full sm:w-48 shrink-0">
          <select
            id="applicant-status-filter"
            class="h-9 w-full rounded-[6px] border border-border bg-surface px-3 text-xs text-heading cursor-pointer"
          >
            <option value="">Semua Status</option>
            <option value="submitted">Menunggu Verifikasi</option>
            <option value="verified">Berkas Terverifikasi</option>
            <option value="accepted">Diterima Resmi</option>
            <option value="rejected">Ditolak / Tidak Lolos</option>
          </select>
        </div>

        <!-- Tombol Segarkan (Sekunder Ringkas) -->
        <div class="flex items-center gap-1.5 shrink-0 self-end sm:self-auto">
          <button
            type="button"
            id="btn-refresh-applicants"
            class="h-9 w-9 inline-flex items-center justify-center rounded-[6px] border border-border bg-surface text-muted hover:text-heading hover:bg-surface-subtle transition-colors cursor-pointer shadow-xs"
            title="Segarkan Data Pendaftar"
            aria-label="Segarkan Data"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path>
            </svg>
          </button>

          <!-- Tombol Reset Filter (Hanya tampil saat filter aktif) -->
          <button
            type="button"
            id="btn-reset-filters"
            class="hidden h-9 px-2.5 rounded-[6px] border border-border bg-surface text-[11px] font-medium text-muted hover:text-heading hover:bg-surface-subtle transition-colors cursor-pointer"
            title="Kembalikan semua filter ke awal"
          >
            Reset Filter
          </button>
        </div>
      </div>
    </div>

    
    <!-- TABEL DATA PENDAFTAR (KETERBACAAN JERNIH, LEBAR AKSI)    -->
    
    <div
      class="rounded-lg border border-border bg-surface overflow-hidden shadow-xs"
    >
      <div class="overflow-x-auto">
        <table class="w-full text-left font-body text-xs">
          <thead
            class="border-b border-border bg-surface-subtle text-[11px] font-semibold uppercase tracking-wider text-muted"
          >
            <tr class="*:py-3 *:px-4 *:last:text-right">
              <th>Calon Siswa</th>
              <th>No. Registrasi</th>
              <th>Jalur &amp; Asal Sekolah</th>
              <th>Tanggal &amp; Kontak</th>
              <th>Status</th>
              <th class="min-w-[210px]">Aksi</th>
            </tr>
          </thead>
          <tbody id="applicant-table-body" class="divide-y divide-border">
            <tr>
              <td colspan="6" class="py-12 text-center text-muted">
                Memuat data pendaftar terbaru...
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination Toolbar Lengkap & Terukur -->
      <div
        class="flex flex-col sm:flex-row items-center justify-between gap-3 p-4 border-t border-border bg-surface-subtle text-xs text-muted"
      >
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[11px] text-muted">Baris:</span>
          <select
            id="pagination-limit"
            class="h-8 rounded-[5px] border border-border bg-surface px-2.5 text-xs font-semibold text-heading cursor-pointer"
          >
            <option value="10">10</option>
            <option value="15" selected>15</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
          <span id="pagination-info" class="font-medium text-heading ml-1"
            >Menampilkan 0 pendaftar</span
          >
        </div>

        <!-- Tombol Navigasi Halaman -->
        <div class="flex items-center gap-1 *:h-8 *:px-2.5 *:rounded-[5px] *:border *:border-border *:bg-surface *:text-xs *:font-medium *:text-heading *:transition-colors" id="pagination-controls-wrapper">
          <button
            type="button"
            id="btn-first-page"
            class="hover:bg-surface-subtle disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
            title="Halaman Pertama"
            disabled
          >
            &laquo;
          </button>
          <button
            type="button"
            id="btn-prev-page"
            class="hover:bg-surface-subtle disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
            title="Halaman Sebelumnya"
            disabled
          >
            &lsaquo;
          </button>

          <!-- Dynamic Numbered Page Buttons -->
          <div id="page-numbers-container" class="flex items-center gap-1 *:h-8 *:min-w-[32px] *:px-2 *:rounded-[5px] *:text-xs *:font-semibold *:cursor-pointer *:transition-colors">
          </div>

          <button
            type="button"
            id="btn-next-page"
            class="hover:bg-surface-subtle disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
            title="Halaman Berikutnya"
            disabled
          >
            &rsaquo;
          </button>
          <button
            type="button"
            id="btn-last-page"
            class="hover:bg-surface-subtle disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
            title="Halaman Terakhir"
            disabled
          >
            &raquo;
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 1: PRATINJAU LEMBAR FORMULIR A4 & PERSYARATAN DOKUMEN -->
  
  <div
    id="modal-a4-preview"
    role="dialog"
    aria-modal="true"
    aria-label="Pratinjau Formulir A4"
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-2 sm:p-4 backdrop-blur-xs overflow-hidden"
  >
    <div
      class="max-w-5xl w-full h-[92vh] max-h-[92vh] rounded-[12px] border border-border bg-surface shadow-2xl flex flex-col overflow-hidden"
    >
      <!-- Modal Header (Fixed / Non-scrollable) -->
      <div
        class="flex items-center justify-between px-4 sm:px-6 py-3.5 border-b border-border bg-surface shrink-0"
      >
        <div class="flex items-center gap-3 min-w-0">
          <div class="h-8 w-8 rounded-[6px] bg-primary-light text-primary flex items-center justify-center shrink-0">
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
          </div>
          <div class="min-w-0">
            <h3 class="font-display text-sm sm:text-base font-bold text-heading leading-tight truncate">
              Lembar Formulir Pendaftaran A4
            </h3>
            <p id="a4-modal-subtitle" class="font-mono text-xs text-muted truncate mt-0.5">
              -
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0 *:inline-flex *:h-8 *:items-center *:justify-center *:gap-1.5 *:rounded-[6px] *:px-3 *:text-xs *:font-medium *:shadow-xs *:transition-colors *:whitespace-nowrap">
          <!-- Tombol Cetak PDF (Aksi Utama) -->
          <button
            type="button"
            id="btn-a4-print"
            class="bg-primary text-white hover:bg-primary-hover cursor-pointer"
            title="Cetak Dokumen Formulir A4"
          >
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"
              ></path>
            </svg>
            <span>Cetak PDF</span>
          </button>

          <!-- Tombol Buka Tab Baru (Aksi Sekunder) -->
          <a
            id="link-a4-standalone"
            href="#"
            target="_blank"
            class="border border-border bg-surface text-heading hover:bg-surface-subtle"
            title="Buka Dokumen di Tab Baru"
          >
            <svg
              class="h-3.5 w-3.5 text-muted"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
            <span class="hidden sm:inline">Buka Tab Baru</span>
          </a>

          <!-- Tombol Tutup -->
          <button
            type="button"
            id="btn-close-a4-modal"
            class="!w-8 !px-0 text-muted hover:text-heading hover:bg-surface-subtle text-lg font-bold cursor-pointer !shadow-none"
            title="Tutup Modal"
          >
            &times;
          </button>
        </div>
      </div>

      <!-- Bar Informasi Kode Akses Verifikasi (Neutral Surface dengan Aksen Primary) -->
      <div
        id="a4-credential-banner"
        class="px-4 sm:px-6 py-2.5 bg-surface border-b border-border flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 text-xs shrink-0"
      >
        <div class="flex flex-wrap items-center gap-2 min-w-0">
          <span class="font-semibold text-heading">Kode Akses Verifikasi</span>
          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-surface-subtle text-muted border border-border">
            Informasi
          </span>
          <span class="text-[11px] text-muted hidden sm:inline">
            &bull; Berikan kode ini kepada calon siswa jika diperlukan untuk verifikasi.
          </span>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <strong
            id="a4-credential-code"
            class="font-mono text-xs px-2.5 py-1 rounded-[6px] bg-surface-subtle border border-border text-primary font-bold tracking-wider shadow-2xs select-all"
          >-</strong>
          <button
            type="button"
            id="btn-copy-a4-credential"
            class="inline-flex items-center gap-1.5 h-7 px-2.5 rounded-[6px] border border-border bg-surface text-heading font-medium text-[11px] hover:bg-primary hover:text-white hover:border-primary cursor-pointer shadow-2xs transition-colors shrink-0"
            title="Salin Kode Akses"
          >
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
