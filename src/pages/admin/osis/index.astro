      const form = document.getElementById("form-osis");
      const banner = document.getElementById("status-banner");
      const unsavedBadge = document.getElementById("unsaved-badge");
      const btnHeaderSave = document.getElementById("btn-header-save");
      const headerSaveText = document.getElementById("header-save-text");
      const directFileInput = document.getElementById("direct-file-input");

      let isDirty = false;
      function markDirty() {
        if (!isDirty) {
          isDirty = true;
          unsavedBadge?.classList.remove("hidden");
        }
      }

      // Peringatan saat meninggalkan halaman dengan perubahan belum tersimpan
      window.addEventListener("beforeunload", (e) => {
        if (isDirty) {
          e.preventDefault();
          e.returnValue = "Ada perubahan data yang belum disimpan.";
        }
      });

      form?.querySelectorAll("input, select, textarea").forEach((el) => {
        el.addEventListener("input", markDirty);
        el.addEventListener("change", markDirty);
      });

      // ==========================================
      // 1. NAVIGASI SECTIONS INTERAKTIF (01 - 06)
      // ==========================================
      const tabNavCards = document.querySelectorAll(".tab-nav-card");
      const tabPanes = document.querySelectorAll(".tab-pane");

      tabNavCards.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetId = btn.getAttribute("data-tab-target");
          if (!targetId) return;

          tabNavCards.forEach((b) => {
            b.className =
              "tab-nav-card text-left p-3 rounded-[8px] border transition-all cursor-pointer bg-surface border-border text-heading hover:bg-surface-subtle";
            const badge = b.querySelector(".tab-card-badge");
            if (badge)
              badge.className =
                "tab-card-badge font-mono text-[10px] font-bold px-1.5 py-0.5 rounded-[4px] bg-surface-subtle border border-border text-muted";
            const desc = b.querySelector(".tab-card-desc");
            if (desc)
              desc.className =
                "tab-card-desc font-body text-[11px] leading-tight mt-1 text-muted line-clamp-1";
          });

          btn.className =
            "tab-nav-card active text-left p-3 rounded-[8px] border transition-all cursor-pointer bg-primary border-primary text-white shadow-xs";
          const activeBadge = btn.querySelector(".tab-card-badge");
          if (activeBadge)
            activeBadge.className =
              "tab-card-badge font-mono text-[10px] font-bold px-1.5 py-0.5 rounded-[4px] bg-surface text-heading";
          const activeDesc = btn.querySelector(".tab-card-desc");
          if (activeDesc)
            activeDesc.className =
              "tab-card-desc font-body text-[11px] leading-tight mt-1 text-white/80 line-clamp-1";

          tabPanes.forEach((pane) => {
            if (pane.id === targetId) {
              pane.classList.remove("hidden");
            } else {
              pane.classList.add("hidden");
            }
          });
        });
      });

      // Toggle otomatis pesan peringatan status nonaktif via switch toggle
      const inputOrgActive = document.getElementById("student_org_active");
      const btnToggleOrgActive = document.getElementById(
        "btn-toggle-org-active",
      );
      const thumbOrgActive = document.getElementById("thumb-org-active");
      const labelOrgActive = document.getElementById("label-org-active");
      const noticeOrgInactive = document.getElementById("notice-org-inactive");

      btnToggleOrgActive?.addEventListener("click", () => {
        const isCurrentlyActive = inputOrgActive?.value !== "false";
        const nextActive = !isCurrentlyActive;
        if (inputOrgActive)
          inputOrgActive.value = nextActive ? "true" : "false";

        btnToggleOrgActive.setAttribute("aria-checked", String(nextActive));
        btnToggleOrgActive.className = `relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-hidden ${nextActive ? "bg-primary" : "bg-border"}`;

        if (thumbOrgActive) {
          thumbOrgActive.className = `pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow-xs ring-0 transition duration-200 ease-in-out ${nextActive ? "translate-x-4" : "translate-x-0"}`;
        }

        if (labelOrgActive) {
          labelOrgActive.textContent = nextActive
            ? "Aktif (Dapat Diakses Publik)"
            : "Nonaktif (Disembunyikan)";
        }

        if (nextActive) {
          noticeOrgInactive?.classList.add("hidden");
        } else {
          noticeOrgInactive?.classList.remove("hidden");
        }

        markDirty();
      });

      // ==========================================
      // 2. HELPER STATUS BANNER
      // ==========================================
      function showBanner(message, type) {
        if (!banner) return;
        banner.classList.remove("hidden");
        banner.innerText = message;
        if (type === "success") {
          banner.className =
            "rounded-[8px] border border-primary/20 bg-primary-light p-3.5 text-xs text-primary font-medium block";
        } else if (type === "error") {
          banner.className =
            "rounded-[8px] border border-error/20 bg-error-light p-3.5 text-xs text-error-text font-medium block";
        } else {
          banner.className =
            "rounded-[8px] border border-border bg-surface-subtle p-3.5 text-xs text-muted font-medium block";
        }
        banner.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }

      function setLoading(isLoading) {
        if (btnHeaderSave) btnHeaderSave.disabled = isLoading;
        const text = isLoading ? "Menyimpan..." : "Simpan Perubahan";
        if (headerSaveText) headerSaveText.innerText = text;
      }

      // ==========================================
      // 3. FOTO & LOGO DENGAN MEDIA PICKER
      // ==========================================
      document.querySelectorAll(".btn-pick-image").forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetInputId = btn.getAttribute("data-target-input");
          const previewImgId = btn.getAttribute("data-preview-img");
          if (typeof window.openMediaPicker === "function") {
            window.openMediaPicker(
              (item) => {
                const url =
                  item.fileUrl ||
                  item.mediumUrl ||
                  item.thumbnailUrl ||
                  item.url;
                if (url && targetInputId) {
                  const input = document.getElementById(targetInputId);
                  if (input) input.value = url;
                  if (previewImgId) {
                    const preview = document.getElementById(previewImgId);
                    if (preview) preview.src = url;
                  }
                  markDirty();
                }
              },
              { type: "image" },
            );
          }
        });
      });

      document.querySelectorAll(".btn-clear-image").forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetInputId = btn.getAttribute("data-target-input");
          const previewImgId = btn.getAttribute("data-preview-img");
          const defaultImg =
            btn.getAttribute("data-default-img") || "/favicon.svg";

          if (targetInputId) {
            const input = document.getElementById(targetInputId);
            if (input) input.value = "";
          }
          if (previewImgId) {
            const preview = document.getElementById(previewImgId);
            if (preview) preview.src = defaultImg;
          }
          markDirty();
        });
      });

      // ==========================================
      // 4. MODAL EDITOR PENGURUS & PEMBINA (POLA KONSISTEN)
      // ==========================================
      const officialModal = document.getElementById("official-edit-modal");
      const modalRoleTitle = document.getElementById(
        "modal-official-role-title",
      );
      const modalOfficialKey = document.getElementById("modal-official-key");
      const modalNameInput = document.getElementById(
        "modal-official-name-input",
      );
      const modalTitleInput = document.getElementById(
        "modal-official-title-input",
      );
      const modalAdvisorTitleContainer = document.getElementById(
        "modal-advisor-title-container",
      );
      const modalPreviewImg = document.getElementById(
        "modal-official-preview-img",
      );
      const modalPhotoUrlInput = document.getElementById(
        "modal-official-photo-url",
      );
      const btnModalPickPhoto = document.getElementById("btn-modal-pick-photo");
      const btnModalClearPhoto = document.getElementById(
        "btn-modal-clear-photo",
      );
      const btnCloseOfficialModal = document.getElementById(
        "btn-close-official-modal",
      );
      const btnCancelOfficialModal = document.getElementById(
        "btn-cancel-official-modal",
      );
      const btnSaveOfficialModal = document.getElementById(
        "btn-save-official-modal",
      );

      function openOfficialEditor(key) {
        if (!key) return;
        modalOfficialKey.value = key;
        const row = document.querySelector(`tr[data-official-key="${key}"]`);
        const roleLabel =
          row?.querySelector(".official-row-role")?.innerText || "Pengurus";
        modalRoleTitle.innerText = `Edit Data ${roleLabel}`;

        let nameVal = "";
        let titleVal = "";
        let photoVal = "";

        if (key === "advisor") {
          nameVal = document.getElementById("student_org_advisor")?.value || "";
          titleVal =
            document.getElementById("student_org_advisor_title")?.value || "";
          photoVal =
            document.getElementById("student_org_advisor_photo")?.value || "";
          modalAdvisorTitleContainer?.classList.remove("hidden");
        } else if (key === "leader") {
          nameVal = document.getElementById("student_org_leader")?.value || "";
          photoVal =
            document.getElementById("student_org_leader_photo")?.value || "";
          modalAdvisorTitleContainer?.classList.add("hidden");
        } else if (key === "deputy") {
          nameVal = document.getElementById("student_org_deputy")?.value || "";
          photoVal =
            document.getElementById("student_org_deputy_photo")?.value || "";
          modalAdvisorTitleContainer?.classList.add("hidden");
        } else if (key === "secretary") {
          nameVal =
            document.getElementById("student_org_secretary")?.value || "";
          photoVal =
            document.getElementById("student_org_secretary_photo")?.value || "";
          modalAdvisorTitleContainer?.classList.add("hidden");
        } else if (key === "treasurer") {
          nameVal =
            document.getElementById("student_org_treasurer")?.value || "";
          photoVal =
            document.getElementById("student_org_treasurer_photo")?.value || "";
          modalAdvisorTitleContainer?.classList.add("hidden");
        }

        modalNameInput.value = nameVal;
        if (modalTitleInput) modalTitleInput.value = titleVal;
        modalPhotoUrlInput.value = photoVal;
        modalPreviewImg.src = photoVal || "/favicon.svg";

        officialModal?.classList.remove("hidden");
        modalNameInput?.focus();
      }

      document.querySelectorAll(".official-table-row").forEach((row) => {
        row.addEventListener("click", (e) => {
          if (
            e.target.closest(".btn-delete-official") ||
            e.target.closest(".btn-edit-official")
          )
            return;
          const key = row.getAttribute("data-official-key");
          if (key) openOfficialEditor(key);
        });
      });

      document.querySelectorAll(".btn-edit-official").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const key = btn.getAttribute("data-key");
          if (key) openOfficialEditor(key);
        });
      });

      document.querySelectorAll(".btn-delete-official").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const key = btn.getAttribute("data-key");
          const roleLabel = btn.getAttribute("data-role-name") || "Pengurus";
          if (!key) return;

          const confirmed = await window.confirmDialog({
            title: "Kosongkan Pengurus",
            message: `Hapus dan kosongkan data untuk ${roleLabel}?`,
            confirmText: "Hapus",
            cancelText: "Batal",
            type: "danger",
          });
          if (!confirmed) return;

          if (key === "advisor") {
            const inName = document.getElementById("student_org_advisor");
            const inPhoto = document.getElementById(
              "student_org_advisor_photo",
            );
            if (inName) inName.value = "";
            if (inPhoto) inPhoto.value = "";
          } else if (key === "leader") {
            const inName = document.getElementById("student_org_leader");
            const inPhoto = document.getElementById("student_org_leader_photo");
            if (inName) inName.value = "";
            if (inPhoto) inPhoto.value = "";
          } else if (key === "deputy") {
            const inName = document.getElementById("student_org_deputy");
            const inPhoto = document.getElementById("student_org_deputy_photo");
            if (inName) inName.value = "";
            if (inPhoto) inPhoto.value = "";
          } else if (key === "secretary") {
            const inName = document.getElementById("student_org_secretary");
            const inPhoto = document.getElementById(
              "student_org_secretary_photo",
            );
            if (inName) inName.value = "";
            if (inPhoto) inPhoto.value = "";
          } else if (key === "treasurer") {
            const inName = document.getElementById("student_org_treasurer");
            const inPhoto = document.getElementById(
              "student_org_treasurer_photo",
            );
            if (inName) inName.value = "";
            if (inPhoto) inPhoto.value = "";
          }

          const row = document.querySelector(`tr[data-official-key="${key}"]`);
          if (row) {
            const nameEl = row.querySelector(".official-row-name");
            if (nameEl) nameEl.innerText = "Belum ditentukan";

            const imgContainer = row.querySelector("td div");
            if (imgContainer) {
              imgContainer.innerHTML = `<span class="official-row-initial font-display font-bold text-xs text-muted">-</span>`;
            }
          }

          markDirty();
        });
      });

      function closeOfficialModal() {
        officialModal?.classList.add("hidden");
      }

      btnCloseOfficialModal?.addEventListener("click", closeOfficialModal);
      btnCancelOfficialModal?.addEventListener("click", closeOfficialModal);

      // Tutup modal jika klik di backdrop luar
      officialModal?.addEventListener("click", (e) => {
        if (e.target === officialModal || e.target?.classList?.contains("min-h-full")) {
          closeOfficialModal();
        }
      });

      // Tutup modal saat tombol Escape ditekan
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !officialModal?.classList.contains("hidden")) {
          closeOfficialModal();
        }
      });

      btnModalPickPhoto?.addEventListener("click", () => {
        if (typeof window.openMediaPicker === "function") {
          window.openMediaPicker(
            (item) => {
              const url =
                item.fileUrl || item.mediumUrl || item.thumbnailUrl || item.url;
              if (url) {
                modalPhotoUrlInput.value = url;
                modalPreviewImg.src = url;
              }
            },
            { type: "image" },
          );
        }
      });

      btnModalClearPhoto?.addEventListener("click", () => {
        modalPhotoUrlInput.value = "";
        modalPreviewImg.src = "/favicon.svg";
      });

      btnSaveOfficialModal?.addEventListener("click", () => {
        const key = modalOfficialKey.value;
        const newName = modalNameInput.value.trim();
        const newTitle = modalTitleInput?.value.trim() || "";
        const newPhoto = modalPhotoUrlInput.value.trim();

        if (!newName) {
          alert("Nama pejabat wajib diisi.");
          modalNameInput.focus();
          return;
        }

        const row = document.querySelector(`tr[data-official-key="${key}"]`);
        if (row) {
          const nameEl = row.querySelector(".official-row-name");
          if (nameEl) nameEl.innerText = newName;

          const imgContainer = row.querySelector("td div");
          if (newPhoto) {
            imgContainer.innerHTML = `<img src="${newPhoto}" alt="${newName}" class="official-row-img h-full w-full object-cover" />`;
          } else {
            imgContainer.innerHTML = `<span class="official-row-initial font-display font-bold text-xs text-primary">${newName.charAt(0).toUpperCase()}</span>`;
          }

          if (key === "advisor" && newTitle) {
            const titleEl = row.querySelector(".official-row-title");
            if (titleEl) titleEl.innerText = newTitle;
          }
        }

        if (key === "advisor") {
          const inName = document.getElementById("student_org_advisor");
          const inTitle = document.getElementById("student_org_advisor_title");
          const inPhoto = document.getElementById("student_org_advisor_photo");
          if (inName) inName.value = newName;
          if (inTitle) inTitle.value = newTitle;
          if (inPhoto) inPhoto.value = newPhoto;
        } else if (key === "leader") {
          const inName = document.getElementById("student_org_leader");
          const inPhoto = document.getElementById("student_org_leader_photo");
          if (inName) inName.value = newName;
          if (inPhoto) inPhoto.value = newPhoto;
        } else if (key === "deputy") {
          const inName = document.getElementById("student_org_deputy");
          const inPhoto = document.getElementById("student_org_deputy_photo");
          if (inName) inName.value = newName;
          if (inPhoto) inPhoto.value = newPhoto;
        } else if (key === "secretary") {
          const inName = document.getElementById("student_org_secretary");
          const inPhoto = document.getElementById(
            "student_org_secretary_photo",
          );
          if (inName) inName.value = newName;
          if (inPhoto) inPhoto.value = newPhoto;
        } else if (key === "treasurer") {
          const inName = document.getElementById("student_org_treasurer");
          const inPhoto = document.getElementById(
            "student_org_treasurer_photo",
          );
          if (inName) inName.value = newName;
          if (inPhoto) inPhoto.value = newPhoto;
        }

        markDirty();
        closeOfficialModal();
      });

      // ==========================================
      // 5. ACCORDION SEKBID & ANGGOTA DINAMIS (CHIPS)
      // ==========================================
      const deptAccordion = document.getElementById("departments-accordion");
      const btnAddDept = document.getElementById("btn-add-dept");
      const hiddenDeptsInput = document.getElementById(
        "student_org_departments",
      );

      function serializeDepartments() {
        if (!deptAccordion || !hiddenDeptsInput) return;
        const items = deptAccordion.querySelectorAll(".dept-accordion-item");
        const list = [];
        items.forEach((item) => {
          const name =
            item.querySelector(".dept-input-name")?.value.trim() || "";
          const lead =
            item.querySelector(".dept-input-lead")?.value.trim() || "";
          const proker =
            item.querySelector(".dept-input-proker")?.value.trim() || "";

          const chips = item.querySelectorAll(".dept-member-chip .chip-text");
          const members = Array.from(chips)
            .map((c) => c.innerText.trim())
            .filter(Boolean);

          if (name || lead || members.length > 0 || proker) {
            list.push({ name, lead, members, proker });
          }
        });
        hiddenDeptsInput.value = JSON.stringify(list);
      }

      function initAccordionItem(item) {
        const headerBtn = item.querySelector(".dept-accordion-header");
        const body = item.querySelector(".dept-accordion-body");
        const chevron = item.querySelector(".dept-chevron");
        const btnDelete = item.querySelector(".btn-delete-dept-row");

        const inputName = item.querySelector(".dept-input-name");
        const inputLead = item.querySelector(".dept-input-lead");
        const inputProker = item.querySelector(".dept-input-proker");
        const summaryTitle = item.querySelector(".dept-summary-title");
        const metaLead = item.querySelector(".dept-meta-lead");
        const metaCount = item.querySelector(".dept-meta-count");

        const chipsContainer = item.querySelector(".dept-chips-container");
        const inputNewMember = item.querySelector(".dept-input-new-member");
        const btnAddChip = item.querySelector(".btn-add-chip-manual");

        // Toggle accordion (Single-open: otomatis tutup bidang lain yang terbuka)
        headerBtn?.addEventListener("click", (e) => {
          if (e.target.closest(".btn-delete-dept-row")) return;
          const isClosed = body.classList.contains("hidden");
          if (isClosed) {
            // Tutup seluruh accordion lain terlebih dahulu
            deptAccordion
              ?.querySelectorAll(".dept-accordion-item")
              .forEach((otherItem) => {
                if (otherItem !== item) {
                  otherItem
                    .querySelector(".dept-accordion-body")
                    ?.classList.add("hidden");
                  otherItem
                    .querySelector(".dept-chevron")
                    ?.classList.remove("rotate-180");
                }
              });
            body.classList.remove("hidden");
            chevron?.classList.add("rotate-180");
          } else {
            body.classList.add("hidden");
            chevron?.classList.remove("rotate-180");
          }
        });

        // Update header summary saat input berubah
        inputName?.addEventListener("input", () => {
          if (summaryTitle)
            summaryTitle.innerText = inputName.value.trim() || "Nama Bidang";
          markDirty();
        });
        inputLead?.addEventListener("input", () => {
          if (metaLead)
            metaLead.innerText = inputLead.value.trim() || "Belum ditentukan";
          markDirty();
        });
        inputProker?.addEventListener("input", markDirty);

        // Tambah anggota chip
        function addMemberChip() {
          const val = inputNewMember.value.trim();
          if (!val) return;
          const chip = document.createElement("span");
          chip.className =
            "dept-member-chip inline-flex items-center gap-1.5 rounded-[4px] bg-surface-subtle border border-border px-2.5 py-1 text-xs text-heading font-medium";
          chip.innerHTML = `<span class="chip-text">${val}</span><button type="button" class="btn-remove-chip text-muted hover:text-error text-xs cursor-pointer font-bold leading-none">&times;</button>`;
          chipsContainer.appendChild(chip);
          inputNewMember.value = "";
          updateMemberCount();
          markDirty();
        }

        btnAddChip?.addEventListener("click", addMemberChip);
        inputNewMember?.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            addMemberChip();
          }
        });

        // Hapus chip
        chipsContainer?.addEventListener("click", (e) => {
          if (e.target.closest(".btn-remove-chip")) {
            e.target.closest(".dept-member-chip")?.remove();
            updateMemberCount();
            markDirty();
          }
        });

        function updateMemberCount() {
          const count =
            chipsContainer.querySelectorAll(".dept-member-chip").length;
          if (metaCount) metaCount.innerText = `${count} Anggota`;
        }

        // Hapus bidang
        btnDelete?.addEventListener("click", async (e) => {
          e.stopPropagation();
          if (deptAccordion.children.length > 1) {
            const confirmed = await window.confirmDialog({
              title: "Hapus Bidang Organisasi",
              message: "Hapus bidang ini beserta seluruh datanya?",
              confirmText: "Hapus Bidang",
              cancelText: "Batal",
              type: "danger",
            });
            if (!confirmed) return;

            item.remove();
            reindexAccordion();
            markDirty();
          } else {
            alert("Minimal sediakan 1 bidang organisasi.");
          }
        });
      }

      function reindexAccordion() {
        deptAccordion
          ?.querySelectorAll(".dept-accordion-item")
          .forEach((item, idx) => {
            const badge = item.querySelector(".dept-badge-index");
            if (badge)
              badge.innerText = `Bidang ${String(idx + 1).padStart(2, "0")}`;
          });
      }

      deptAccordion
        ?.querySelectorAll(".dept-accordion-item")
        .forEach((item) => initAccordionItem(item));

      btnAddDept?.addEventListener("click", () => {
        const idx = deptAccordion.children.length;
        const item = document.createElement("div");
        item.className =
          "dept-accordion-item rounded-[8px] border border-border bg-surface overflow-hidden shadow-xs transition-all";
        item.innerHTML = `
        <button type="button" class="dept-accordion-header w-full flex items-center justify-between p-4 text-left hover:bg-surface-subtle transition-colors cursor-pointer">
          <div class="flex items-center gap-3 min-w-0">
            <span class="dept-badge-index font-mono text-xs font-bold text-primary shrink-0">
              Bidang ${String(idx + 1).padStart(2, "0")}
            </span>
            <div class="min-w-0">
              <h3 class="dept-summary-title font-display text-sm font-bold text-heading truncate">
                Bidang Baru #${idx + 1}
              </h3>
              <p class="dept-summary-meta font-body text-xs text-muted truncate mt-0.5">
                Koordinator: <span class="dept-meta-lead font-medium text-heading">Belum ditentukan</span> &bull; <span class="dept-meta-count">0 Anggota</span>
              </p>
            </div>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <span class="btn-delete-dept-row text-xs text-error hover:underline p-1 cursor-pointer" title="Hapus Bidang Ini">Hapus</span>
            <svg class="dept-chevron h-4 w-4 text-muted transition-transform duration-200 rotate-180"><use href="#icon-chevron-down"></use></svg>
          </div>
        </button>
        <div class="dept-accordion-body border-t border-border p-4 bg-surface-subtle space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div>
              <label class="block font-body text-xs font-semibold text-heading mb-1">Nama Seksi Bidang</label>
              <input type="text"placeholder="Nama Bidang Baru"class="dept-input-name h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading"/>
            </div>
            <div>
              <label class="block font-body text-xs font-semibold text-heading mb-1">Koordinator / Ketua Bidang</label>
              <input type="text"placeholder="Nama Koordinator"class="dept-input-lead h-[38px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading"/>
            </div>
          </div>
          <div>
            <label class="block font-body text-xs font-semibold text-heading mb-1.5">Anggota Bidang (Daftar Dinamis)</label>
            <div class="rounded-[6px] border border-border bg-surface p-3 space-y-2.5">
              <div class="dept-chips-container flex flex-wrap items-center gap-1.5"></div>
              <div class="flex items-center gap-2 pt-1">
                <input type="text"placeholder="Ketik nama anggota & kelas lalu tekan Enter..."class="dept-input-new-member h-[34px] flex-1 rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading"/>
                <button type="button" class="btn-add-chip-manual inline-flex h-[34px] items-center justify-center rounded-[6px] border border-border bg-surface px-3 text-xs font-medium text-heading hover:bg-surface-subtle transition-colors cursor-pointer shrink-0">+ Tambah</button>
              </div>
            </div>
          </div>
          <div>
            <label class="block font-body text-xs font-semibold text-heading mb-1">Program Kerja Unggulan</label>
            <textarea rows="2"placeholder="Daftar kegiatan unggulan bidang ini..."class="dept-input-proker w-full rounded-[6px] border border-border bg-surface p-2.5 font-body text-xs text-heading leading-relaxed"></textarea>
          </div>
        </div>
      `;
        // Tutup accordion lain saat menambahkan bidang baru
        deptAccordion
          ?.querySelectorAll(".dept-accordion-item")
          .forEach((otherItem) => {
            otherItem
              .querySelector(".dept-accordion-body")
              ?.classList.add("hidden");
            otherItem
              .querySelector(".dept-chevron")
              ?.classList.remove("rotate-180");
          });
        deptAccordion.appendChild(item);
        initAccordionItem(item);
        markDirty();
        item.querySelector(".dept-input-name")?.focus();
      });

      // ==========================================
      // 6. SINKRONISASI TIPE ORGANISASI (OSIS vs OSIM)
      // ==========================================
      const selectOrgType = document.getElementById("student_org_type");
      const inputOrgName = document.getElementById("student_org_name");
      const defaultOrgTypeVal = "{defaultOrgType}";

      selectOrgType?.addEventListener("change", () => {
        const typeVal = selectOrgType.value;
        const targetType = typeVal === "auto" ? defaultOrgTypeVal : typeVal;
        if (inputOrgName) {
          if (targetType === "OSIM") {
            inputOrgName.value = inputOrgName.value.replace(
              /\bOSIS\b/gi,
              "OSIM",
            );
          } else if (targetType === "OSIS") {
            inputOrgName.value = inputOrgName.value.replace(
              /\bOSIM\b/gi,
              "OSIS",
            );
          }
        }
        markDirty();
      });

      // ==========================================
      // 7. SIMPAN FORM SECARA TERPADU
      // ==========================================
      async function saveOsis() {
        serializeDepartments();
        setLoading(true);

        const fd = new FormData(form);
        const payload = {};
        fd.forEach((val, key) => {
          payload[key] = String(val).trim();
        });

        const selectedType = payload["student_org_type"] || "auto";
        const resolvedTarget =
          selectedType === "auto" ? defaultOrgTypeVal : selectedType;
        if (selectedType !== "auto") {
          payload["student_org_label"] = selectedType;
        }
        if (resolvedTarget === "OSIM" && payload["student_org_name"]) {
          payload["student_org_name"] = payload["student_org_name"].replace(
            /\bOSIS\b/gi,
            "OSIM",
          );
        } else if (resolvedTarget === "OSIS" && payload["student_org_name"]) {
          payload["student_org_name"] = payload["student_org_name"].replace(
            /\bOSIM\b/gi,
            "OSIS",
          );
        }

        // Validasi format email jika diisi
        const email = payload["student_org_email"];
        if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showBanner(
            "Format email resmi organisasi tidak valid (contoh: osis@sekolah.sch.id).",
            "error",
          );
          setLoading(false);
          return;
        }

        try {
          const res = await fetch("/api/admin/settings", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          setLoading(false);

          if (data.success) {
            isDirty = false;
            unsavedBadge?.classList.add("hidden");
            showBanner(
              "Semua perubahan konfigurasi organisasi berhasil disimpan.",
              "success",
            );
            if (headerSaveText) headerSaveText.innerText = "Tersimpan";
            setTimeout(() => {
              if (headerSaveText) headerSaveText.innerText = "Simpan Perubahan";
            }, 2500);
          } else {
            showBanner(
              data.error || "Gagal menyimpan konfigurasi organisasi.",
              "error",
            );
          }
        } catch (err) {
          setLoading(false);
          showBanner("Terjadi gangguan jaringan saat menyimpan data.", "error");
        }
      }

      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        saveOsis();
      });

      btnHeaderSave?.addEventListener("click", () => {
        if (form?.reportValidity()) saveOsis();
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initOsis);
    } else {
      initOsis();
    }
  </script>
</AdminLayout>
