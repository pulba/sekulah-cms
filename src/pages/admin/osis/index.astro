---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import MediaPickerModal from "../../../components/MediaPickerModal.astro";
import Icon from "../../../components/Icon.astro";
import { db, settings } from "../../../db";

export const prerender = false;

// 1. Ambil seluruh konfigurasi dari tabel settings
const allSettings = await db.select().from(settings);
const settingMap = allSettings.reduce(
  (acc, curr) => {
    acc[curr.key] = curr.value;
    return acc;
  },
  {} as Record<string, string>,
);

// 2. Identifikasi Lembaga & Karakteristik Organisasi
const schoolName = settingMap["school_name"] || "SMAN 1 Unggulan";
const schoolType = (
  settingMap["school_type"] ||
  settingMap["school_level"] ||
  "SMA"
).toUpperCase();
const isMadrasah = ["MA", "MTS", "MI"].includes(schoolType);

// Tipe organisasi default: OSIM untuk madrasah, OSIS untuk sekolah negeri/umum
const defaultOrgType = isMadrasah ? "OSIM" : "OSIS";
const orgTypeSetting = settingMap["student_org_type"] || "auto";
const resolvedOrgType =
  orgTypeSetting === "auto" ? defaultOrgType : orgTypeSetting;

const orgFullName =
  resolvedOrgType === "OSIM"
    ? "Organisasi Santri / Siswa Intra Madrasah (OSIM)"
    : "Organisasi Siswa Intra Sekolah (OSIS)";

// Konfigurasi Field Organisasi
const rawOrgName =
  settingMap["student_org_name"] || `${resolvedOrgType} ${schoolName}`;
const orgName =
  resolvedOrgType === "OSIM"
    ? rawOrgName.replace(/^OSIS\b/i, "OSIM")
    : resolvedOrgType === "OSIS"
      ? rawOrgName.replace(/^OSIM\b/i, "OSIS")
      : rawOrgName;

const orgPeriod = settingMap["student_org_period"] || "2025/2026";
const orgTagline =
  settingMap["student_org_tagline"] ||
  "Bersinergi, Berkarakter, dan Berintegritas Memimpin Perubahan";
const orgLogo = settingMap["student_org_logo"] || "";
const orgBanner = settingMap["student_org_banner"] || "";
const orgIsActive = settingMap["student_org_active"] !== "false";

// Struktur Pengurus Inti (BPH) & Pembina dengan Foto
const advisorName =
  settingMap["student_org_advisor"] || "Drs. H. Mulyadi, M.Pd.";
const rawAdvisorTitle =
  settingMap["student_org_advisor_title"] ||
  `Pembina ${resolvedOrgType} & Waka Kesiswaan`;
const advisorTitle =
  resolvedOrgType === "OSIM"
    ? rawAdvisorTitle.replace(/\bOSIS\b/g, "OSIM")
    : resolvedOrgType === "OSIS"
      ? rawAdvisorTitle.replace(/\bOSIM\b/g, "OSIS")
      : rawAdvisorTitle;
const advisorPhoto = settingMap["student_org_advisor_photo"] || "";

const leaderName = settingMap["student_org_leader"] || "Muhammad Zaki Pratama";
const leaderPhoto = settingMap["student_org_leader_photo"] || "";

const deputyLeaderName = settingMap["student_org_deputy"] || "Alya Khairunnisa";
const deputyLeaderPhoto = settingMap["student_org_deputy_photo"] || "";

const secretaryName = settingMap["student_org_secretary"] || "Nadia Rahmawati";
const secretaryPhoto = settingMap["student_org_secretary_photo"] || "";

const treasurerName = settingMap["student_org_treasurer"] || "Rizky Ramadhan";
const treasurerPhoto = settingMap["student_org_treasurer_photo"] || "";

// Visi & Misi
const orgVision =
  settingMap["student_org_vision"] ||
  "Mewujudkan wadah kesiswaan yang aspiratif, berakhlak mulia, berprestasi dalam sains dan teknologi, serta berjiwa kepemimpinan responsif di era global.";
const orgMission =
  settingMap["student_org_mission"] ||
  "1. Menumbuhkan ketakwaan dan keteladanan akhlak dalam setiap kegiatan kesiswaan.\n2. Mengakomodasi dan memperjuangkan aspirasi siswa secara demokratis dan transparan.\n3. Mengembangkan kreativitas, literasi riset digital, dan minat bakat keolahragaan maupun seni.\n4. Menjalin kemitraan positif antarsekolah dan organisasi kepemudaan daerah.";

// Seksi Bidang (Sekbid) / Departemen dengan Anggota & Proker per Sekbid
const defaultDepartments = [
  {
    name: "Keagamaan dan Budi Pekerti",
    lead: "Fathur Rahman",
    members: [
      "Ahmad Fauzi (XI-1)",
      "Siti Aisyah (X-3)",
      "Bilal Ramadhan (XI-4)",
      "Nurul Hidayah (X-2)",
    ],
    proker:
      "Peringatan Hari Besar Keagamaan, Gerakan Infak Jum'at, Pembiasaan Doa & Kajian Harian",
  },
  {
    name: "Kepemimpinan, Kedisiplinan & Bela Negara",
    lead: "Dimas Anggara",
    members: [
      "Rizky Pratama (XI-2)",
      "Nadia Safitri (X-1)",
      "Danu Wijaya (XI-5)",
    ],
    proker:
      "Latihan Dasar Kepemimpinan Siswa (LDKS), Pasukan Pengibar Bendera, Apel Disiplin Kampus",
  },
  {
    name: "Akademik, Riset Ilmiah & Teknologi",
    lead: "Zahra Salsabila",
    members: [
      "Alif Hidayatullah (XI-3)",
      "Kayla Putri (X-5)",
      "Farhan Maulana (XI-1)",
    ],
    proker:
      "Klinik Olimpiade Sains & KIR, Pelatihan Literasi Media & Koding, Science Fair Tahunan",
  },
  {
    name: "Apresiasi Seni Budaya & Olahraga",
    lead: "Bagus Setiawan",
    members: [
      "Dina Mariana (XI-4)",
      "Gilang Ramadhan (X-2)",
      "Rendi Saputra (XI-3)",
    ],
    proker:
      "Pekan Olahraga Antar Kelas (Classmeeting), Pensi Pentas Kreativitas Siswa, Liga Futsal & Basket",
  },
  {
    name: "Hubungan Masyarakat & Publikasi Digital",
    lead: "Tiara Anindya",
    members: [
      "Salma Nabila (XI-2)",
      "Hendra Kusuma (X-4)",
      "Naufal Zaki (X-1)",
    ],
    proker:
      "Pengelolaan Media Sosial Resmi, Buletin Cetak/Digital Warta Siswa, Dokumentasi Multimedia Kegiatan",
  },
];

let departmentsList: any[] = defaultDepartments;
try {
  if (settingMap["student_org_departments"]) {
    const parsed = JSON.parse(settingMap["student_org_departments"]);
    if (Array.isArray(parsed) && parsed.length > 0) {
      departmentsList = parsed.map((dept: any) => {
        let members = dept.members;
        if (typeof members === "string") {
          members = members
            .split(",")
            .map((s: string) => s.trim())
            .filter(Boolean);
        } else if (!Array.isArray(members)) {
          members = [];
        }
        return {
          name: dept.name || "",
          lead: dept.lead || "",
          members,
          proker: dept.proker || "",
        };
      });
    }
  }
} catch {
  departmentsList = defaultDepartments;
}

// Media Sosial & Kontak
const orgInstagram = settingMap["student_org_instagram"] || "";
const orgTiktok = settingMap["student_org_tiktok"] || "";
const orgYoutube = settingMap["student_org_youtube"] || "";
const orgEmail = settingMap["student_org_email"] || "";

// Daftar Pengurus Harian & Pembina Terpadu
const staffOfficials = [
  {
    id: "advisor",
    roleKey: "advisor",
    roleName: "Guru Pembina Kesiswaan",
    name: advisorName,
    title: advisorTitle,
    photo: advisorPhoto,
    nameInputId: "student_org_advisor",
    titleInputId: "student_org_advisor_title",
    photoInputId: "student_org_advisor_photo",
  },
  {
    id: "leader",
    roleKey: "leader",
    roleName: "Ketua Umum",
    name: leaderName,
    title: `Ketua Umum ${resolvedOrgType}`,
    photo: leaderPhoto,
    nameInputId: "student_org_leader",
    titleInputId: "",
    photoInputId: "student_org_leader_photo",
  },
  {
    id: "deputy",
    roleKey: "deputy",
    roleName: "Wakil Ketua Umum",
    name: deputyLeaderName,
    title: "Koordinator Program & Lapangan",
    photo: deputyLeaderPhoto,
    nameInputId: "student_org_deputy",
    titleInputId: "",
    photoInputId: "student_org_deputy_photo",
  },
  {
    id: "secretary",
    roleKey: "secretary",
    roleName: "Sekretaris Umum",
    name: secretaryName,
    title: "Administrasi & Persuratan",
    photo: secretaryPhoto,
    nameInputId: "student_org_secretary",
    titleInputId: "",
    photoInputId: "student_org_secretary_photo",
  },
  {
    id: "treasurer",
    roleKey: "treasurer",
    roleName: "Bendahara Umum",
    name: treasurerName,
    title: "Pengelolaan Anggaran & Keuangan",
    photo: treasurerPhoto,
    nameInputId: "student_org_treasurer",
    titleInputId: "",
    photoInputId: "student_org_treasurer_photo",
  },
];
---

<AdminLayout
  title={`Manajemen ${resolvedOrgType}`}
  activeNav="osis"
  settingsMap={settingMap}
>
  <div class="space-y-6 max-w-5xl">
    <!-- Header Halaman & Action Bar Kontekstual -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5">
      <div>
        <div class="flex items-center gap-2.5">
          <h1 class="font-display text-xl font-bold tracking-tight text-heading">
            Manajemen {resolvedOrgType}
          </h1>
          <!-- Indikator Perubahan Belum Disimpan -->
          <span
            id="unsaved-badge"
            class="hidden rounded-[4px] bg-warning-light px-2 py-0.5 font-body text-[11px] font-semibold text-warning-text border border-warning animate-pulse"
          >
            Perubahan belum disimpan
          </span>
        </div>
        <p class="font-body text-xs text-muted mt-1 leading-relaxed">
          Kelola profil, pengurus, bidang, dan program kerja {orgFullName}.
        </p>
      </div>

      <div class="flex items-center gap-2.5 shrink-0">
        <a
          href="/osis"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-[38px] items-center justify-center gap-1.5 rounded-[6px] border border-border bg-surface px-3.5 font-body text-xs font-semibold text-heading transition-colors hover:bg-surface-subtle shadow-xs"
        >
          <svg
            class="h-3.5 w-3.5 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
          <span>Halaman Publik</span>
        </a>
        <button
          type="button"
          id="btn-header-save"
          class="inline-flex h-[38px] items-center justify-center gap-2 rounded-[6px] bg-primary px-4 font-body text-sm font-medium text-white transition-all duration-200 hover:-translate-y-[1px] hover:bg-primary-hover hover:shadow-(--shadow-button-glow) cursor-pointer"
        >
          <Icon name="save" class="h-3.5 w-3.5" />
          <span id="header-save-text">Simpan Perubahan</span>
        </button>
      </div>
    </div>

    <!-- Alert / Banner Feedback -->
    <div
      id="status-banner"
      class="hidden rounded-[8px] p-3.5 text-xs font-medium"
    ></div>

    <!-- File Input Tersembunyi untuk Direct Upload -->
    <input type="file" id="direct-file-input" accept="image/*" class="hidden" />

    <!-- Form Utama Konfigurasi -->
    <form id="form-osis" class="space-y-6">
      <!-- Navigasi Section Interaktif (01 s/d 06) Sesuai Rekomendasi Struktur -->
      <nav
        class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5"
        aria-label="Navigasi Bagian Manajemen"
      >
        <button
          type="button"
          data-tab-target="section-identity"
          class="tab-nav-card active text-left p-3 rounded-[8px] border transition-all cursor-pointer bg-primary border-primary text-white shadow-xs"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="tab-card-badge font-mono text-[10px] font-bold px-1.5 py-0.5 rounded-[4px] bg-surface text-heading">
              01
            </span>
          </div>
          <div class="tab-card-title font-display text-xs font-bold leading-snug">
            Identitas organisasi
          </div>
          <div class="tab-card-desc font-body text-[11px] leading-tight mt-1 text-white/80 line-clamp-1">
            Nama, slogan, periode
          </div>
        </button>

        <button
          type="button"
          data-tab-target="section-media"
          class="tab-nav-card text-left p-3 rounded-[8px] border transition-all cursor-pointer bg-surface border-border text-heading hover:bg-surface-subtle"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="tab-card-badge font-mono text-[10px] font-bold px-1.5 py-0.5 rounded-[4px] bg-surface-subtle border border-border text-muted">
              02
            </span>
          </div>
          <div class="tab-card-title font-display text-xs font-bold leading-snug">
            Logo & dokumentasi
          </div>
          <div class="tab-card-desc font-body text-[11px] leading-tight mt-1 text-muted line-clamp-1">
            Logo dan foto bersama
          </div>
        </button>

        <button
          type="button"
          data-tab-target="section-officials"
          class="tab-nav-card text-left p-3 rounded-[8px] border transition-all cursor-pointer bg-surface border-border text-heading hover:bg-surface-subtle"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="tab-card-badge font-mono text-[10px] font-bold px-1.5 py-0.5 rounded-[4px] bg-surface-subtle border border-border text-muted">
              03
            </span>
          </div>
          <div class="tab-card-title font-display text-xs font-bold leading-snug">
            Pengurus & pembina
          </div>
          <div class="tab-card-desc font-body text-[11px] leading-tight mt-1 text-muted line-clamp-1">
            Guru pembina & pengurus
          </div>
        </button>

        <button
          type="button"
          data-tab-target="section-vision"
          class="tab-nav-card text-left p-3 rounded-[8px] border transition-all cursor-pointer bg-surface border-border text-heading hover:bg-surface-subtle"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="tab-card-badge font-mono text-[10px] font-bold px-1.5 py-0.5 rounded-[4px] bg-surface-subtle border border-border text-muted">
              04
            </span>
          </div>
          <div class="tab-card-title font-display text-xs font-bold leading-snug">
            Visi dan misi
          </div>
          <div class="tab-card-desc font-body text-[11px] leading-tight mt-1 text-muted line-clamp-1">
            Arah & tujuan organisasi
          </div>
        </button>

        <button
          type="button"
          data-tab-target="section-departments"
          class="tab-nav-card text-left p-3 rounded-[8px] border transition-all cursor-pointer bg-surface border-border text-heading hover:bg-surface-subtle"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="tab-card-badge font-mono text-[10px] font-bold px-1.5 py-0.5 rounded-[4px] bg-surface-subtle border border-border text-muted">
              05
            </span>
          </div>
          <div class="tab-card-title font-display text-xs font-bold leading-snug">
            Bidang & proker
          </div>
          <div class="tab-card-desc font-body text-[11px] leading-tight mt-1 text-muted line-clamp-1">
            Koordinator, anggota, proker
          </div>
        </button>

        <button
          type="button"
          data-tab-target="section-social"
          class="tab-nav-card text-left p-3 rounded-[8px] border transition-all cursor-pointer bg-surface border-border text-heading hover:bg-surface-subtle"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="tab-card-badge font-mono text-[10px] font-bold px-1.5 py-0.5 rounded-[4px] bg-surface-subtle border border-border text-muted">
              06
            </span>
          </div>
          <div class="tab-card-title font-display text-xs font-bold leading-snug">
            Media sosial & kontak
          </div>
          <div class="tab-card-desc font-body text-[11px] leading-tight mt-1 text-muted line-clamp-1">
            Kanal komunikasi resmi
          </div>
        </button>
      </nav>

      <!-- SECTION 01: IDENTITAS ORGANISASI -->
      <section
        id="section-identity"
        class="tab-pane rounded-[12px] border border-border bg-surface p-6 space-y-5 shadow-hairline"
      >
        <div class="pb-3 flex items-center justify-between">
          <div>
            <h2 class="font-display text-sm font-bold text-heading">
              01. Identitas & Nomenklatur Lembaga
            </h2>
          </div>
          <span class="font-mono text-[11px] text-muted">ID: student_org</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label
              for="student_org_type"
              class="block font-body text-xs font-semibold text-heading mb-1.5"
            >
              Nomenklatur Organisasi
            </label>
            <select
              id="student_org_type"
              name="student_org_type"
              class="h-[40px] w-full rounded-[6px] border border-border bg-surface px-3 font-body text-xs text-heading transition-colors"
            >
              <option value="auto" selected={orgTypeSetting === "auto"}>
                Otomatis ({defaultOrgType} -{" "}
                {isMadrasah ? "Madrasah" : "Sekolah Umum"})
              </option>
              <option value="OSIS" selected={orgTypeSetting === "OSIS"}>
                OSIS (Sekolah Umum / Negeri)
              </option>
              <option value="OSIM" selected={orgTypeSetting === "OSIM"}>
                OSIM (Madrasah Kemenag)
              </option>
            </select>
            <p class="font-body text-[11px] text-muted mt-1">
              Mengatur label di sidebar dan portal publik.
            </p>
          </div>

          <div>
            <label
              for="student_org_name"
              class="block font-body text-xs font-semibold text-heading mb-1.5"
            >
              Nama Lengkap Organisasi <span class="text-error">*</span>
            </label>
            <input
              id="student_org_name"
              name="student_org_name"
              type="text"
              required
              value={orgName}
              placeholder="Contoh: OSIM SMAN 1 Unggulan"
              class="h-[40px] w-full rounded-[6px] border border-border bg-surface px-3.5 font-body text-xs text-heading placeholder:text-muted/60 transition-colors"
            />
          </div>

          <div>
            <label
              for="student_org_period"
              class="block font-body text-xs font-semibold text-heading mb-1.5"
            >
              Periode / Masa Bakti <span class="text-error">*</span>
            </label>
            <input
              id="student_org_period"
              name="student_org_period"
              type="text"
              required
              value={orgPeriod}
              placeholder="Contoh: 2025/2026"
              class="h-[40px] w-full rounded-[6px] border border-border bg-surface px-3.5 font-body text-xs text-heading placeholder:text-muted/60 transition-colors"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="md:col-span-3">
            <label
              for="student_org_tagline"
              class="block font-body text-xs font-semibold text-heading mb-1.5"
            >
              Slogan / Tagline
            </label>
            <input
              id="student_org_tagline"
              name="student_org_tagline"
              type="text"
              value={orgTagline}
              placeholder="Contoh: Bersinergi, Berkarakter, dan Berintegritas Memimpin Perubahan"
              class="h-[40px] w-full rounded-[6px] border border-border bg-surface px-3.5 font-body text-xs text-heading placeholder:text-muted/60 transition-colors"
            />
          </div>

          <div>
            <label class="block font-body text-xs font-semibold text-heading mb-1.5">
              Status Halaman Publik
            </label>
            <div class="flex items-center gap-3 h-[40px]">
              <input
                type="hidden"
                id="student_org_active"
                name="student_org_active"
                value={orgIsActive ? "true" : "false"}
              />
              <button
                type="button"
                id="btn-toggle-org-active"
                role="switch"
                aria-checked={orgIsActive ? "true" : "false"}
                class:list={[
                  "relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-hidden",
                  orgIsActive ? "bg-primary" : "bg-border",
                ]}
                aria-label="Status visibilitas halaman publik OSIS"
              >
                <span class="sr-only">Status Halaman Publik OSIS</span>
                <span
                  aria-hidden="true"
                  id="thumb-org-active"
                  class:list={[
                    "pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow-xs ring-0 transition duration-200 ease-in-out",
                    orgIsActive ? "translate-x-4" : "translate-x-0",
                  ]}
                />
              </button>
              <span
                id="label-org-active"
                class="font-body text-xs font-medium text-body"
              >
                {orgIsActive
                  ? "Aktif (Dapat Diakses Publik)"
                  : "Nonaktif (Disembunyikan)"}
              </span>
            </div>
          </div>
        </div>

        <div
          id="notice-org-inactive"
          class={`rounded-[8px] border border-border bg-surface-subtle p-3 text-xs text-muted flex items-center gap-2 ${orgIsActive ? "hidden" : ""}`}
        >
          <span>ℹ️</span>
          <span>
            Data tetap tersimpan aman di CMS, namun halaman website publik
            disembunyikan untuk sementara.
          </span>
        </div>
      </section>

      <!-- SECTION 02: LOGO & DOKUMENTASI BANNER -->
      <section
        id="section-media"
        class="tab-pane hidden rounded-[12px] border border-border bg-surface p-6 space-y-5 shadow-hairline"
      >
        <div class="pb-3">
          <h2 class="font-display text-sm font-bold text-heading">
            02. Lambang & Dokumentasi Utama
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Card Logo -->
          <div class="rounded-[8px] border border-border p-5 bg-surface-subtle space-y-4">
            <span class="block font-body text-xs font-bold text-heading">
              Logo Resmi {resolvedOrgType}
            </span>
            <div class="flex items-center gap-4">
              <div class="h-20 w-20 rounded-[8px] border border-border bg-surface flex items-center justify-center overflow-hidden shrink-0 shadow-xs">
                <img
                  id="preview-org-logo"
                  src={orgLogo || "/favicon.svg"}
                  alt="Logo"
                  class="h-full w-full object-contain p-2"
                  onerror="this.src='/favicon.svg'"
                />
              </div>
              <input
                type="hidden"
                id="student_org_logo"
                name="student_org_logo"
                value={orgLogo}
              />

              <div class="space-y-2 flex-1">
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    class="btn-pick-image inline-flex h-8 items-center justify-center rounded-[6px] bg-primary text-white px-3 text-xs font-medium hover:bg-primary-hover transition-colors cursor-pointer shadow-xs"
                    data-target-input="student_org_logo"
                    data-preview-img="preview-org-logo"
                    data-default-img="/favicon.svg"
                  >
                    Ganti Logo
                  </button>
                  <button
                    type="button"
                    class="btn-clear-image text-xs text-error hover:underline cursor-pointer"
                    data-target-input="student_org_logo"
                    data-preview-img="preview-org-logo"
                    data-default-img="/favicon.svg"
                  >
                    Hapus
                  </button>
