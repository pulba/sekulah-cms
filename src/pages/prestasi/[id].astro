---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import Icon from "../../components/Icon.astro";
import { db, studentsAlumni, settings } from "../../db";
import { fallbackAchievements } from "../../utils/fallbackAchievements";
import { eq, and, ne, desc } from "drizzle-orm";

export const prerender = false;

const { id } = Astro.params;
const achievementId = parseInt(id || "", 10);

if (!achievementId || isNaN(achievementId)) {
  return Astro.redirect("/prestasi");
}

// Ambil detail data prestasi dari database atau fallback
const rawAchievement = await db
  .select()
  .from(studentsAlumni)
  .where(
    and(
      eq(studentsAlumni.id, achievementId),
      eq(studentsAlumni.type, "achievement"),
      eq(studentsAlumni.isPublicConsent, true),
    ),
  )
  .then((rows) => rows[0])
  .catch(() => null);

const achievement =
  rawAchievement || fallbackAchievements.find((f) => f.id === achievementId);

if (!achievement) {
  return Astro.redirect("/404");
}

// Ambil prestasi lainnya untuk rekomendasi di bagian bawah
const rawOtherAchievements = await db
  .select()
  .from(studentsAlumni)
  .where(
    and(
      eq(studentsAlumni.type, "achievement"),
      eq(studentsAlumni.isPublicConsent, true),
      ne(studentsAlumni.id, achievement.id),
    ),
  )
  .orderBy(desc(studentsAlumni.year), desc(studentsAlumni.id))
  .limit(2)
  .catch(() => []);

const otherAchievements =
  rawOtherAchievements.length > 0
    ? rawOtherAchievements
    : fallbackAchievements.filter((f) => f.id !== achievement.id).slice(0, 2);

// Ambil info nama sekolah
let schoolName = "SMAN 1 UNGGULAN";
try {
  const schoolSetting = await db
    .select()
    .from(settings)
    .where(eq(settings.key, "school_name"))
    .then((r) => r[0]);
  if (schoolSetting?.value) schoolName = schoolSetting.value;
} catch {}
---

<Layout
  title={`${achievement.title} — Capaian Siswa ${schoolName}`}
  description={achievement.description ||
    `Dokumentasi prestasi ${achievement.title} yang diraih oleh ${achievement.name} dari ${schoolName}.`}
  image={achievement.photoUrl || undefined}
>
  <Header currentPath="/prestasi" />

  <main class="flex-1 py-10 sm:py-14 bg-background">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <Breadcrumb
        class="mb-8"
        items={[
          { label: "Beranda", href: "/" },
          { label: "Prestasi", href: "/prestasi" },
          { label: achievement.title },
        ]}
      />

      <!-- Header Judul & Meta Prestasi -->
      <article class="space-y-8">
        <header class="pb-6 space-y-4">
          <h1
            class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-heading leading-tight"
          >
            {achievement.title}
          </h1>

          <div class="flex flex-col justify-between gap-3 pt-1">
            <div class="flex items-center gap-2 text-sm text-body/80">
              <span>Penerima:</span>
              <span class="font-semibold text-heading">{achievement.name}</span>
            </div>

            <ShareButtons
              title={`${achievement.title} — ${schoolName}`}
              url={Astro.url.href}
              ariaLabel="Bagikan prestasi ke media sosial"
            />
          </div>
        </header>

        <!-- Foto Dokumentasi Utama -->
        {
          achievement.photoUrl && (
            <figure class="rounded-[8px] overflow-hidden border border-border bg-surface-subtle shadow-xs">
              <div class="relative aspect-[16/9] sm:aspect-[21/9] w-full overflow-hidden">
                <img
                  src={achievement.photoUrl}
                  alt={achievement.title}
                  width="1200"
                  height="675"
                  class="w-full h-full object-cover"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            </figure>
          )
        }

        <!-- Detail Konten & Informasi Ringkas -->
        <div
          class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10 pt-4 items-start"
        >
          <!-- Narasi Lengkap Prestasi -->
          <div class="lg:col-span-2 space-y-5">
            <h2 class="font-display text-lg sm:text-xl font-bold text-heading">
              Deskripsi & Makna Pencapaian
            </h2>
            <div
              class="space-y-4 max-w-prose font-body text-[15px] sm:text-base text-body leading-relaxed"
            >
              {
                achievement.description ? (
                  <p class="whitespace-pre-line text-body leading-relaxed">
                    {achievement.description}
                  </p>
                ) : (
                  <p class="text-body/85">
                    Pencapaian ini diraih melalui kompetisi ketat dan menjadi
                    bukti nyata atas dedikasi, kerja keras, serta bimbingan para
                    guru pembina di sekolah.
                  </p>
                )
              }
              <p class="text-body/90 leading-relaxed">
                Keluarga besar {schoolName} menyampaikan selamat dan apresiasi setinggi-tingginya
                kepada {achievement.name} atas capaian gemilang ini. Semoga prestasi
                ini terus menginspirasi rekan-rekan peserta didik lainnya dalam menorehkan
                prestasi berintegritas.
              </p>
            </div>
          </div>

          <!-- Single Card Sidebar Metadata -->
          <aside class="lg:col-span-1">
            <div
              class="rounded-[8px] border border-border bg-surface-subtle p-5 space-y-4"
            >
              <h3
                class="font-display text-xs font-bold text-heading uppercase tracking-wider pb-1"
              >
                Ringkasan Prestasi
              </h3>

              <dl class="space-y-3.5 text-xs">
                <div>
                  <dt class="text-body/75 font-medium">
                    Penyelenggara / Lembaga
                  </dt>
                  <dd class="mt-0.5 font-semibold text-heading">
                    {achievement.organization || "Kompetisi Resmi"}
                  </dd>
                </div>
                <div>
                  <dt class="text-body/75 font-medium">Tahun Perolehan</dt>
                  <dd class="mt-0.5 font-mono font-bold text-primary">
                    {achievement.year}
                  </dd>
                </div>
                <div>
                  <dt class="text-body/75 font-medium">Status Verifikasi</dt>
                  <dd
                    class="mt-1 inline-flex items-center gap-1.5 font-medium text-success-text"
                  >
                    <Icon
                      name="check"
                      class="w-3.5 h-3.5 text-success shrink-0"
                    />
                    <span>Terverifikasi Institusi</span>
                  </dd>
                </div>
              </dl>
            </div>
          </aside>
        </div>
      </article>

      <!-- Bagian Prestasi Lainnya (Jika ada) -->
      {
        otherAchievements.length > 0 && (
          <section class="mt-14 space-y-6">
            <div class="flex items-center justify-between">
              <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-primary">
                  Eksplorasi Capaian
                </div>
                <h2 class="mt-1 font-display text-xl sm:text-2xl font-bold text-heading">
                  Prestasi Siswa Lainnya
                </h2>
              </div>
              <a
                href="/prestasi"
                class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline"
              >
                <span>Lihat Semua</span>
                <Icon name="chevron-right" class="h-3 w-3" />
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {otherAchievements.map((item) => (
                <a
                  href={`/prestasi/${item.id}`}
                  aria-label={item.title}
                  class="group rounded-[10px] border border-border bg-surface overflow-hidden flex flex-col justify-between transition-all duration-200 hover:-translate-y-0.5 hover:shadow-(--shadow-hover)"
                >
                  <div>
                    <div class="relative aspect-[16/10] w-full overflow-hidden bg-surface-subtle">
                      {item.photoUrl ? (
                        <img
                          src={item.photoUrl}
                          alt={item.title}
                          width="400"
                          height="250"
                          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                          loading="lazy"
                        />
                      ) : (
                        <div class="flex h-full w-full items-center justify-center bg-surface-subtle text-muted">
                          <Icon name="trophy" class="h-10 w-10 text-primary/40" />
                        </div>
                      )}
                    </div>

                    <div class="p-5 space-y-2">
                      <div class="flex items-center gap-2 text-xs">
                        <span class="font-mono font-bold text-primary">
                          {item.year}
                        </span>
                        <span class="text-body/40">&bull;</span>
                        <span class="font-medium text-body/75 truncate">
                          {item.organization || "Prestasi Unggulan"}
                        </span>
                      </div>

                      <h3 class="font-display text-base font-bold text-heading leading-snug group-hover:text-primary transition-colors line-clamp-2">
                        {item.title}
                      </h3>
                    </div>
                  </div>

                  <div class="px-5 py-3.5 bg-surface-subtle flex items-center justify-between gap-3 text-xs">
                    <div class="min-w-0 flex-1 flex items-center gap-2 text-body/75">
                      <Icon name="user" class="w-4 h-4 text-primary shrink-0" />
                      <span class="font-semibold text-heading truncate">
                        {item.name}
                      </span>
                    </div>
                    <span class="inline-flex items-center gap-1 font-semibold text-primary shrink-0 group-hover:translate-x-0.5 transition-transform">
                      <span>Detail</span>
                      <Icon name="chevron-right" class="h-3 w-3" />
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </main>

  <Footer />
</Layout>
