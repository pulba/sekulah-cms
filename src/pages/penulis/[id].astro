---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Icon from "../../components/Icon.astro";
import Pagination from "../../components/Pagination.astro";
import { db, articles, categories, users, settings } from "../../db";
import { eq, desc, and, isNull, sql } from "drizzle-orm";

export const prerender = false;

const { id } = Astro.params;
const authorId = (id || "").trim();

if (!authorId) {
  return Astro.redirect("/berita");
}

const rawPage = Math.max(1, parseInt(Astro.url.searchParams.get("page") || "1", 10) || 1);
const pageSize = 8;

const [author, rawAuthorArticles, schoolSetting] = await Promise.all([
  db
    .select({
      id: users.id,
      name: users.name,
      role: users.role,
      avatarUrl: users.avatarUrl,
    })
    .from(users)
    .where(eq(users.id, authorId))
    .limit(1)
    .then((res) => res[0] || null)
    .catch(() => null),
  db
    .select({
      id: articles.id,
      slug: articles.slug,
      title: articles.title,
      summary: articles.summary,
      coverImage: articles.coverImage,
      publishedAt: articles.publishedAt,
      viewCount: articles.viewCount,
      categoryName: categories.name,
      categorySlug: categories.slug,
    })
    .from(articles)
    .leftJoin(categories, eq(articles.categoryId, categories.id))
    .where(
      and(
        eq(articles.authorId, authorId),
        eq(articles.status, "published"),
        isNull(articles.deletedAt),
        sql`${articles.publishedAt} <= ${new Date().toISOString()}`
      )
    )
    .orderBy(desc(articles.publishedAt))
    .catch(() => []),
  db
    .select({ value: settings.value })
    .from(settings)
    .where(eq(settings.key, "school_name"))
    .then((r) => r[0])
    .catch(() => null),
]);

if (!author) {
  Astro.response.status = 404;
}

const schoolName = schoolSetting?.value || "SMAN 1 UNGGULAN";
const validArticles = rawAuthorArticles.filter((a) => Boolean(a.slug));

const totalArticlesCount = validArticles.length;
const totalViews = validArticles.reduce((sum, a) => sum + (a.viewCount || 0), 0);
const totalPages = Math.max(1, Math.ceil(totalArticlesCount / pageSize));
const currentPage = Math.min(rawPage, totalPages);
const startIndex = (currentPage - 1) * pageSize;
const paginatedArticles = validArticles.slice(startIndex, startIndex + pageSize);

const roleLabel = author?.role === "super_admin" ? "Redaksi Utama" : "Kontributor Redaksi";
const defaultCover =
  "https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80";
---

<Layout
  title={author ? `${author.name} — Penulis di ${schoolName}` : `Penulis Tidak Ditemukan — ${schoolName}`}
  description={author ? `Arsip artikel dan publikasi yang ditulis oleh ${author.name} di ${schoolName}.` : "Halaman profil penulis tidak ditemukan."}
>
  <Header currentPath="/berita" />

  <main class="flex-1 py-8 sm:py-12 bg-background">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-8">
      <Breadcrumb
        class="mb-0"
        items={[
          { label: "Beranda", href: "/" },
          { label: "Berita", href: "/berita" },
          { label: author ? author.name : "Penulis" },
        ]}
      />

      {!author ? (
        <div class="rounded-[12px] border border-border bg-surface p-12 text-center">
          <h1 class="font-display text-2xl font-bold text-heading">Penulis Tidak Ditemukan</h1>
          <p class="mt-2 text-xs sm:text-sm text-muted">
            Profil penulis yang Anda cari tidak tersedia atau telah dihapus.
          </p>
          <a
            href="/berita"
            class="mt-6 inline-flex h-9 items-center justify-center gap-1.5 rounded-[6px] bg-primary px-4 font-body text-xs sm:text-sm font-semibold text-white shadow-xs transition-all duration-200 hover:-translate-y-[1px] hover:bg-primary-hover hover:shadow-(--shadow-button-glow)"
          >
            <Icon name="chevron-left" class="h-3.5 w-3.5" />
            <span>Kembali ke Berita</span>
          </a>
        </div>
      ) : (
        <>
          <!-- Author Profile Header -->
          <section class="rounded-[12px] border border-border bg-surface p-6 sm:p-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
              <div class="flex items-center gap-4 sm:gap-5">
                {author.avatarUrl ? (
                  <img
                    src={author.avatarUrl}
                    alt={author.name}
                    class="h-16 w-16 sm:h-20 sm:w-20 rounded-full object-cover border border-border shrink-0"
                  />
                ) : (
                  <div class="flex h-16 w-16 sm:h-20 sm:w-20 shrink-0 items-center justify-center rounded-full border border-border bg-primary-light font-display text-2xl sm:text-3xl font-bold text-primary">
                    {author.name.charAt(0).toUpperCase()}
                  </div>
                )}

                <div class="space-y-1">
                  <span class="inline-block rounded-[4px] bg-primary-light border border-primary/20 px-2.5 py-0.5 font-body text-[10px] font-semibold uppercase tracking-wider text-primary">
                    {roleLabel}
                  </span>
                  <h1 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-heading">
                    {author.name}
                  </h1>
                  <p class="font-body text-xs sm:text-sm text-muted">
                    Kontributor berita dan publikasi resmi {schoolName}.
                  </p>
                </div>
              </div>

              <div class="flex items-center gap-6 sm:border-l sm:border-border sm:pl-6 shrink-0">
                <div>
                  <span class="block font-mono text-lg sm:text-xl font-bold text-heading">
                    {totalArticlesCount}
                  </span>
                  <span class="font-body text-[11px] text-muted uppercase tracking-wider">
                    Artikel
                  </span>
                </div>
                <div>
                  <span class="block font-mono text-lg sm:text-xl font-bold text-heading">
                    {totalViews.toLocaleString("id-ID")}
                  </span>
                  <span class="font-body text-[11px] text-muted uppercase tracking-wider">
                    Pembaca
                  </span>
                </div>
              </div>
            </div>
          </section>

          <!-- Author Articles List -->
          <section class="space-y-6">
            <div class="flex items-center justify-between pb-1">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 bg-primary rounded-[2px]" />
                <h2 class="font-display text-base sm:text-lg font-bold uppercase tracking-wider text-heading">
                  Artikel oleh {author.name}
                </h2>
              </div>
              <span class="font-mono text-xs text-muted">{totalArticlesCount} Publikasi</span>
            </div>

            {paginatedArticles.length === 0 ? (
              <div class="rounded-[12px] border border-border bg-surface p-12 text-center">
                <p class="font-display text-base font-bold text-heading">Belum ada artikel yang dipublikasikan</p>
                <p class="mt-1 text-xs text-muted">Penulis ini belum memiliki publikasi aktif.</p>
              </div>
            ) : (
              <div class="space-y-4">
                {paginatedArticles.map((article) => (
                  <article class="group rounded-[10px] border border-border bg-surface p-4 sm:p-5 flex flex-col sm:flex-row gap-4 sm:gap-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-(--shadow-hover)">
                    <a
                      href={`/berita/${article.slug}`}
                      class="w-full sm:w-48 md:w-56 aspect-[16/10] overflow-hidden rounded-[8px] bg-surface-subtle shrink-0 block"
                    >
                      <img
                        src={article.coverImage || defaultCover}
                        alt={article.title}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                        loading="lazy"
                      />
                    </a>

                    <div class="flex-1 flex flex-col justify-between py-0.5">
                      <div>
                        <div class="mb-2">
                          {article.categorySlug ? (
                            <a
                              href={`/berita?kategori=${article.categorySlug}`}
                              class="inline-block rounded-[4px] bg-primary-light border border-primary/20 px-2 py-0.5 text-[10px] font-semibold text-primary uppercase transition-colors hover:bg-primary hover:text-white"
                            >
                              {article.categoryName}
                            </a>
                          ) : (
                            <span class="inline-block rounded-[4px] bg-primary-light border border-primary/20 px-2 py-0.5 text-[10px] font-semibold text-primary uppercase">
                              {article.categoryName || "Umum"}
                            </span>
                          )}
                        </div>

                        <h3 class="font-display text-base sm:text-lg font-bold text-heading leading-snug group-hover:text-primary transition-colors">
                          <a href={`/berita/${article.slug}`}>
                            {article.title}
                          </a>
                        </h3>

                        <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-muted font-body">
                          {article.summary}
                        </p>
                      </div>

                      <div class="mt-3 flex items-center gap-3 text-[11px] text-muted font-mono">
                        <time>
                          {article.publishedAt
                            ? new Date(article.publishedAt).toLocaleDateString("id-ID", {
                                day: "numeric",
                                month: "short",
                                year: "numeric",
                              })
                            : "-"}
                        </time>
                        <span>&bull;</span>
                        <span>{(article.viewCount || 0).toLocaleString("id-ID")} views</span>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            )}

            {totalPages > 1 && (
              <Pagination
                currentPage={currentPage}
                totalPages={totalPages}
                totalItems={totalArticlesCount}
                pageSize={pageSize}
                itemLabel="artikel"
                getPageUrl={(p) => `?page=${p}`}
                class="rounded-[10px] border border-border shadow-xs mt-6"
              />
            )}
          </section>
        </>
      )}
    </div>
  </main>

  <Footer />
</Layout>

