---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { db, settings } from "../db";
import {
  getDefaultPpdbConfig,
  resolvePpdbPortal,
  getWibDateString,
  type PpdbFullConfig,
  type FormStep,
  type FormField,
  type RequiredDocument,
  type RegistrationWave,
} from "../utils/ppdbConfigDefaults";

// 1. Ambil data profil sekolah dan konfigurasi PPDB dari basis data
const allSettings = await db.select().from(settings);
const schoolInfo = allSettings.reduce(
  (acc, curr) => {
    acc[curr.key] = curr.value;
    return acc;
  },
  {} as Record<string, string>,
);

const schoolName = schoolInfo["school_name"] || "SMAN 1 Unggulan";
const schoolType = (
  schoolInfo["school_type"] ||
  schoolInfo["school_level"] ||
  "SMA"
).toUpperCase();
const schoolStatus = schoolInfo["school_status"] || "Negeri";
const boardingAvailable = schoolInfo["boarding_available"] === "true";

// 2. Parse konfigurasi dinamis PPDB
let formConfig: PpdbFullConfig;
const rawConfig = schoolInfo["ppdb_form_config"];

if (rawConfig) {
  try {
    formConfig = JSON.parse(rawConfig);
    if (
      !formConfig ||
      !Array.isArray(formConfig.steps) ||
      formConfig.steps.length === 0
    ) {
      formConfig = getDefaultPpdbConfig(
        schoolType,
        schoolName,
        boardingAvailable,
      );
    }
  } catch {
    formConfig = getDefaultPpdbConfig(
      schoolType,
      schoolName,
      boardingAvailable,
    );
  }
} else {
  formConfig = getDefaultPpdbConfig(schoolType, schoolName, boardingAvailable);
}

// Pastikan gelombang (waves) terinisialisasi
if (
  !formConfig.waves ||
  !Array.isArray(formConfig.waves) ||
  formConfig.waves.length === 0
) {
  const def = getDefaultPpdbConfig(schoolType, schoolName, boardingAvailable);
  formConfig.waves = def.waves;
  formConfig.activeWave = def.activeWave || "Gelombang 1";
}

// 3. Evaluasi Status Portal dan Gelombang Aktif di Server (Asia/Jakarta WIB)
const portalResolution = resolvePpdbPortal(formConfig, new Date());
const effectiveStatus = portalResolution.effectiveStatus; // 'opened' | 'upcoming' | 'closed'
const activeWave = portalResolution.activeWave;
const nextWave = portalResolution.nextWave;
const allDisplayWaves = portalResolution.allWaves;

const ppdbYear =
  formConfig.academicYear || schoolInfo["ppdb_year"] || "2026/2027";
const admissionsLabel =
  schoolInfo["admissions_label"] ||
  schoolInfo["ppdb_label"] ||
  (["MA", "MTS", "MI"].includes(schoolType) ? "PPDBM" : "PPDB");
const ppdbAnnouncement = schoolInfo["ppdb_announcement"] || "";
const ppdbHelpdeskWa =
  schoolInfo["ppdb_helpdesk_wa"] ||
  schoolInfo["social_whatsapp"] ||
  "0812-3456-7890";

const isMadrasah = ["MA", "MTS", "MI"].includes(schoolType);
const isVocational = schoolType === "SMK";

function formatTanggalIndo(dateStr?: string) {
  if (!dateStr) return "—";
  try {
    const parts = dateStr.split("-");
    if (parts.length === 3) {
      const d = new Date(
        Number(parts[0]),
        Number(parts[1]) - 1,
        Number(parts[2]),
      );
      return d.toLocaleDateString("id-ID", {
        day: "numeric",
        month: "short",
        year: "numeric",
      });
    }
    return dateStr;
  } catch {
    return dateStr;
  }
}

const defaultAdmissionsTitle =
  admissionsLabel.toUpperCase() === "PSB"
    ? boardingAvailable
      ? "PENERIMAAN SANTRI & SISWA BARU"
      : "PENERIMAAN SISWA BARU"
    : admissionsLabel.toUpperCase() === "SPMB"
      ? "SISTEM PENERIMAAN SISWA BARU"
      : admissionsLabel.toUpperCase() === "PPDBM"
        ? "PENERIMAAN PESERTA DIDIK BARU MADRASAH"
        : admissionsLabel.toUpperCase() === "PPDB"
          ? "PENERIMAAN PESERTA DIDIK BARU"
          : `PENDAFTARAN SISWA BARU (${admissionsLabel})`;

const admissionsTitle = (
  schoolInfo["admissions_title"] ||
  (formConfig as any).admissionsTitle ||
  defaultAdmissionsTitle
).trim();
const admissionsSubtitle = (
  schoolInfo["admissions_subtitle"] ||
  (formConfig as any).admissionsSubtitle ||
  `Wujudkan masa depanmu bersama kami. Daftarkan dirimu secara online untuk tahun ajaran ${ppdbYear}.`
).trim();

// Helper untuk filter field yang valid dirender di server
function shouldRenderField(field: FormField) {
  if (!field.isActive) return false;
  if (
    field.conditionalRule === "if_boarding" &&
    (!formConfig.services.boardingEnabledInPpdb || !boardingAvailable)
  ) {
    return false;
  }
  if (field.conditionalRule === "if_smk" && !isVocational) return false;
  if (field.conditionalRule === "if_ma" && !isMadrasah) return false;
  return true;
}

// Helper untuk filter dokumen yang valid dirender di server
function shouldRenderDocument(doc: RequiredDocument) {
  if (doc.conditionalRule === "if_smk" && !isVocational) return false;
  return true;
}
---

<Layout
  title={`${admissionsTitle} (${admissionsLabel}) ${ppdbYear} — ${schoolName}`}
  description={`Formulir pendaftaran daring ${admissionsTitle.toLowerCase()} tahun ajaran ${ppdbYear} ${schoolName}.`}
>
  <Header currentPath="/pendaftaran" />

  <main class="flex-1 py-10 sm:py-14 bg-background font-body text-body">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <!-- Judul Utama Halaman Sesuai Pengaturan Institusi -->
      <div class="text-center mb-8 sm:mb-10">
        <div class="inline-flex items-center gap-2 rounded-[4px] border border-primary/25 bg-primary px-3 py-1 font-body text-xs md:text-md font-semibold text-white mb-2.5">
          <span>
            {admissionsLabel} {schoolName}
          </span>
        </div>
        <h1 class="font-display text-xl sm:text-2xl lg:text-3xl font-extrabold uppercase tracking-tight text-heading">
          {admissionsTitle} {ppdbYear}
        </h1>
        <p class="mt-1.5 text-xs text-muted font-body max-w-xl mx-auto">
          {admissionsSubtitle}
        </p>

        {ppdbAnnouncement && (
          <div class="mt-3 inline-block rounded-md border border-primary/20 bg-primary-light px-4 py-2 text-xs text-heading">
            <span class="font-semibold text-primary">Informasi:</span>{" "}
            {ppdbAnnouncement}
          </div>
        )}
      </div>

      <!-- KONDISI 1: PENDAFTARAN DITUTUP -->
      {effectiveStatus === "closed" && (
        <div class="rounded-[12px] border border-border bg-surface p-8 sm:p-12 text-center space-y-5 max-w-xl mx-auto shadow-xs">
          <div class="h-12 w-12 rounded-full bg-surface-subtle border border-border text-muted mx-auto flex items-center justify-center">
            <Icon name="lock" class="h-6 w-6 text-muted" />
          </div>
          <div class="space-y-1.5">
            <h2 class="font-display text-lg font-bold text-heading">
              Pendaftaran Saat Ini Ditutup
            </h2>
            <p class="text-xs text-muted leading-relaxed">
              {portalResolution.reason ||
                `Masa ${admissionsTitle.toLowerCase()} (${admissionsLabel}) tahun ajaran ${ppdbYear} telah berakhir atau dinonaktifkan sementara oleh pihak sekolah.`}
            </p>
          </div>
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/cek-status"
              class="w-full sm:w-auto inline-flex h-10 items-center justify-center gap-2 rounded-[4px] bg-primary px-6 text-xs font-semibold text-white hover:bg-primary-hover hover:shadow-(--shadow-hover) transition-all cursor-pointer shadow-xs"
            >
              <span>Cek Status Pendaftaran Anda</span>
            </a>
            <a
              href={`https://wa.me/${ppdbHelpdeskWa.replace(/[^0-9]/g, "")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex h-10 items-center justify-center gap-2 rounded-[4px] border border-border bg-surface px-5 text-xs font-semibold text-heading hover:bg-surface-subtle hover:border-border-hover transition-colors cursor-pointer"
            >
              <span>Hubungi Posko Helpdesk WhatsApp</span>
            </a>
            <a
              href="/"
              class="w-full sm:w-auto inline-flex h-10 items-center justify-center gap-2 rounded-[4px] border border-border bg-surface px-5 text-xs font-semibold text-muted hover:text-heading hover:bg-surface-subtle transition-colors cursor-pointer"
            >
              <span>Kembali ke Beranda</span>
            </a>
          </div>
        </div>
      )}

      <!-- KONDISI 2: SEGERA DIBUKA (COUNTDOWN & JADWAL) -->
      {effectiveStatus === "upcoming" && (
        <div class="rounded-[12px] border border-border bg-surface p-6 sm:p-10 shadow-xs max-w-3xl mx-auto space-y-8">
          <!-- Status Banner -->
          <div class="text-center space-y-2.5">
            <div class="inline-flex items-center gap-1.5 rounded-[4px] border border-warning/30 bg-warning-light px-3 py-1 font-body text-xs font-semibold text-warning-text">
              <span>Masa Sosialisasi &amp; Countdown</span>
            </div>
            <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-heading tracking-tight">
              Pendaftaran Segera Dibuka
            </h2>
            <p class="text-xs sm:text-sm text-muted font-body max-w-xl mx-auto leading-relaxed">
              {nextWave ? (
                <span>
                  <strong class="text-heading font-semibold">
                    {nextWave.name}
                  </strong>{" "}
                  dijadwalkan mulai dibuka pada{" "}
                  <strong class="text-primary font-semibold">
                    {formatTanggalIndo(nextWave.startDate)}
                  </strong>{" "}
                  pukul 00.00.00 WIB.
                </span>
              ) : (
                <span>
                  Periode pendaftaran calon siswa baru berikutnya akan segera
                  dibuka. Pantau hitung mundur di bawah.
                </span>
              )}
            </p>
          </div>

          <!-- Countdown Timer Display Box -->
          <div
            class="countdown-container rounded-[10px] border border-border bg-surface-subtle p-5 sm:p-6"
            data-target-date={
              nextWave ? `${nextWave.startDate}T00:00:00+07:00` : ""
            }
          >
            <div class="grid grid-cols-4 gap-2 sm:gap-4 text-center">
              <div class="rounded-[8px] border border-border bg-surface p-3 sm:p-4">
                <div
                  id="countdown-days"
                  class="font-mono text-2xl sm:text-4xl font-extrabold text-primary"
                >
                  00
                </div>
                <span class="font-body text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-muted mt-1 block">
                  Hari
                </span>
              </div>
              <div class="rounded-[8px] border border-border bg-surface p-3 sm:p-4">
                <div
                  id="countdown-hours"
                  class="font-mono text-2xl sm:text-4xl font-extrabold text-primary"
                >
                  00
                </div>
                <span class="font-body text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-muted mt-1 block">
                  Jam
                </span>
              </div>
              <div class="rounded-[8px] border border-border bg-surface p-3 sm:p-4">
                <div
                  id="countdown-minutes"
                  class="font-mono text-2xl sm:text-4xl font-extrabold text-primary"
                >
                  00
                </div>
                <span class="font-body text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-muted mt-1 block">
                  Menit
                </span>
              </div>
              <div class="rounded-[8px] border border-border bg-surface p-3 sm:p-4">
                <div
                  id="countdown-seconds"
                  class="font-mono text-2xl sm:text-4xl font-extrabold text-primary"
                >
                  00
                </div>
                <span class="font-body text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-muted mt-1 block">
                  Detik
                </span>
              </div>
            </div>
          </div>

          <!-- Card Formulir Belum Tersedia -->
          <div class="rounded-[10px] border border-border bg-surface p-4 flex items-start gap-3.5">
            <div class="h-9 w-9 rounded-full bg-surface-subtle border border-border flex items-center justify-center shrink-0 text-muted">
              <Icon name="info" class="h-4 w-4 text-muted" />
            </div>
            <div class="space-y-1 text-xs">
              <h3 class="font-display font-bold text-heading">
                Formulir Belum Tersedia
              </h3>
              <p class="text-muted leading-relaxed">
                Calon siswa dapat melihat informasi sekolah, persyaratan, dan
                jadwal gelombang di bawah ini. Pengiriman formulir online akan
                aktif secara otomatis pada hari pembukaan.
              </p>
            </div>
          </div>

          <!-- Jadwal Lengkap Gelombang -->
          <div class="space-y-3 pt-2">
            <h3 class="font-display text-xs font-bold uppercase tracking-wider text-heading">
              Jadwal Gelombang Pendaftaran ({ppdbYear})
            </h3>
            <div class="overflow-x-auto rounded-[8px] border border-border bg-surface">
              <table class="w-full text-left font-body text-xs">
                <thead class="border-b border-border bg-surface-subtle text-[11px] font-semibold uppercase tracking-wider text-muted">
                  <tr>
                    <th class="py-2.5 px-3">Gelombang</th>
                    <th class="py-2.5 px-3">Periode Pendaftaran</th>
                    <th class="py-2.5 px-3">Benefit</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  {allDisplayWaves.map((w) => (
                    <tr
                      class={
                        w.name === nextWave?.name ? "bg-primary-light" : ""
                      }
                    >
                      <td class="py-2.5 px-3 font-semibold text-heading">
                        {w.name}
                        {w.name === nextWave?.name && (
                          <span class="ml-1.5 rounded-[4px] bg-primary text-white px-1.5 py-0.5 text-[9px] font-semibold">
                            Berikutnya
                          </span>
                        )}
                      </td>
                      <td class="py-2.5 px-3 text-body font-mono text-[11px]">
                        {formatTanggalIndo(w.startDate)} s.d.{" "}
                        {formatTanggalIndo(w.endDate)} (23:59:59 WIB)
                      </td>
                      <td class="py-2.5 px-3 text-muted">
                        {w.benefit || w.description || "Ketentuan baku sekolah"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Tombol Helpdesk -->
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="text-xs text-muted">
              Butuh konsultasi seputar persyaratan pendaftaran?
            </div>
            <a
              href={`https://wa.me/${ppdbHelpdeskWa.replace(/[^0-9]/g, "")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-9 items-center justify-center gap-2 rounded-[4px] bg-primary px-5 text-xs font-semibold text-white hover:bg-primary-hover hover:shadow-(--shadow-hover) transition-all shadow-xs"
            >
              <Icon name="whatsapp" class="h-4 w-4" />
              <span>Hubungi Helpdesk WhatsApp</span>
            </a>
          </div>
        </div>
      )}

      <!-- KONDISI 3: BUKA PENDAFTARAN (FORM AKTIF & HERO GELOMBANG) -->
      {effectiveStatus === "opened" && (
        <>
          <!-- Hero Card Informasi Gelombang Aktif -->
          <div class="mb-8 shadow-xs relative overflow-hidden">
            <!-- Grid 3 Info: Nama Gelombang, Tanggal Dibuka, Batas Pendaftaran, Benefit -->
            <div class="grid grid-cols-1 sm:grid-cols-4 *:p-4 md:*:p-6 text-xs">
              <div class="bg-primary/80">
                <h2 class="font-display text-xl md:text-2xl font-bold text-white">
                  {activeWave?.name || "Gelombang 1"}
                </h2>
                <p class="text-xs text-white font-body mt-0.5">
                  {activeWave?.description || "Jalur Prestasi / Early Bird"}
                </p>
              </div>
              <div class="bg-surface p-3 space-y-1">
                <span class="text-muted block text-[11px] uppercase tracking-wider font-semibold">
                  Tanggal Dibuka:
                </span>
                <strong class="font-display text-sm font-bold text-heading block">
                  {formatTanggalIndo(activeWave?.startDate)}
                </strong>
                <span class="text-[11px] text-muted">Pukul 00.00.00 WIB</span>
              </div>

              <div class="bg-primary p-3 space-y-1">
                <span class="text-white block text-[11px] uppercase tracking-wider font-semibold">
                  Batas Pendaftaran:
                </span>
                <strong class="font-display text-sm font-bold text-white block">
                  {formatTanggalIndo(activeWave?.endDate)}
                </strong>
                <span class="text-[11px] text-white">
                  Hingga pukul 23.59.59 WIB
                </span>
              </div>

              <div class="bg-surface p-3 space-y-1">
                <span class="text-muted block text-[11px] uppercase tracking-wider font-semibold">
                  Benefit {activeWave?.name || "Gelombang 1"}:
                </span>
                <p class="font-body text-xs text-heading font-medium leading-relaxed">
                  {activeWave?.benefit ||
                    "Pendaftaran gelombang awal sesuai ketentuan sekolah."}
                </p>
              </div>
            </div>
          </div>
          <!-- Stepper / Multi-Step Progress Indicator (7 Langkah Dinamis) -->
          <nav
            class="mb-10 sm:mb-12 overflow-x-auto pb-4 no-scrollbar"
            aria-label="Progress Tahapan"
          >
            <div class="min-w-[680px] max-w-4xl mx-auto relative px-4">
              <!-- Connective Progress Line -->
              <div class="absolute top-5 left-10 right-10 h-[2px] bg-border -z-0">
                <div
                  id="stepper-progress-bar"
                  class="h-full bg-primary transition-all duration-300 w-[0%]"
                ></div>
              </div>

              <!-- Step Items -->
              <div class="flex items-start justify-between relative z-10">
                {formConfig.steps.map((st) => (
                  <div
                    class="step-indicator flex flex-col items-center cursor-pointer group"
                    data-step={st.step}
                  >
                    <div
                      class={`step-circle h-10 w-10 rounded-full flex items-center justify-center font-display text-sm font-semibold transition-all duration-200 ${
                        st.step === 1
                          ? "bg-primary text-white shadow-xs font-bold"
                          : "bg-surface border border-border text-muted group-hover:border-heading/40"
                      }`}
                    >
                      {st.step}
                    </div>
                    <span
                      class={`step-label mt-2 text-xs transition-colors ${
                        st.step === 1
                          ? "font-semibold text-primary pb-1 border-b-2 border-primary"
                          : "font-medium text-muted"
                      }`}
                    >
                      {st.title}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </nav>

          <!-- Section Title Label Sesuai Desain Acuan -->
          <div class="mb-4 px-1 flex items-center justify-between">
            <h2
              id="current-step-title"
              class="font-display text-sm sm:text-base font-bold uppercase tracking-wider text-primary"
            >
              PENDAFTARAN
            </h2>
            <span
              id="current-step-badge"
              class="text-[11px] font-mono text-muted bg-surface-subtle px-2.5 py-1 rounded border border-border"
            >
              Langkah 1 dari 7
            </span>
          </div>

          <!-- Main Form Container Card -->
          <form
            id="admission-wizard-form"
            class="rounded-[16px] overflow-hidden border border-border bg-surface p-6 sm:p-10 shadow-(--shadow-hairline)"
          >
            <input
              type="hidden"
              name="wave"
              value={activeWave?.name || formConfig.activeWave || "Gelombang 1"}
            />

            <!-- Render Step 1 sampai Step 5 Secara Dinamis dari Form Builder -->
            {formConfig.steps.slice(0, 5).map((st) => {
              const activeFields = st.fields
                .filter(shouldRenderField)
                .sort((a, b) => a.order - b.order);
              return (
                <div
                  id={`step-pane-${st.step}`}
                  class={`step-pane space-y-6 ${st.step === 1 ? "" : "hidden"}`}
                >
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {activeFields.map((field) => {
                      const isConditionalTahfidz =
                        field.conditionalRule === "if_tahfidz";
                      const isConditionalPrestasi =
                        field.conditionalRule === "if_prestasi";
                      const conditionalAttr = isConditionalTahfidz
                        ? "if_tahfidz"
                        : isConditionalPrestasi
                          ? "if_prestasi"
                          : undefined;

                      // Dropdown Opsi Khusus
                      let selectOptions = field.options || [];
                      if (field.id === "admission_path") {
                        selectOptions = formConfig.paths
                          .filter((p) => p.isActive)
                          .map((p) => p.name);
                        if (selectOptions.length === 0)
                          selectOptions = ["Umum", "Reguler"];
                      } else if (
                        field.id === "major_choice_1" ||
                        field.id === "major_choice_2"
                      ) {
                        if (
                          formConfig.services.majors &&
                          formConfig.services.majors.length > 0
                        ) {
                          selectOptions = formConfig.services.majors;
                        }
                      }

                      // Type Select
                      if (field.type === "select") {
                        return (
                          <div
                            class={`space-y-1.5 ${conditionalAttr ? "conditional-field hidden" : ""}`}
                            data-conditional={conditionalAttr}
                          >
                            <label
                              for={field.id}
                              class="block font-body text-xs sm:text-sm font-medium text-heading"
                            >
                              {field.label}{" "}
                              {field.required && (
                                <span class="text-error font-bold">*</span>
                              )}
                            </label>
                            <div class="relative">
                              <select
                                id={field.id}
                                name={field.id}
                                required={field.required}
                                data-originally-required={
                                  field.required ? "true" : "false"
                                }
                                class="h-[46px] w-full rounded-[8px] border border-border bg-surface px-4 pr-10 text-xs sm:text-sm text-heading appearance-none transition-colors"
                              >
                                {selectOptions.map((opt, idx) => (
                                  <option value={opt} selected={idx === 0}>
                                    {opt}
                                  </option>
                                ))}
                              </select>
                              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3.5 text-muted">
                                <Icon name="chevron-down" class="h-4 w-4" />
                              </div>
                            </div>
                            {field.helpText && (
                              <span class="text-[11px] text-muted block">
                                {field.helpText}
                              </span>
                            )}
                          </div>
                        );
                      }

                      // Type Textarea
                      if (field.type === "textarea") {
                        return (
                          <div
                            class={`space-y-1.5 md:col-span-2 ${conditionalAttr ? "conditional-field hidden" : ""}`}
                            data-conditional={conditionalAttr}
                          >
                            <label
                              for={field.id}
                              class="block font-body text-xs sm:text-sm font-medium text-heading"
                            >
                              {field.label}{" "}
                              {field.required && (
                                <span class="text-error font-bold">*</span>
                              )}
                            </label>
                            <textarea
                              id={field.id}
                              name={field.id}
                              rows="3"
                              required={field.required}
                              data-originally-required={
                                field.required ? "true" : "false"
                              }
                              placeholder={field.placeholder || ""}
                              class="w-full rounded-[8px] border border-border bg-surface p-3 text-xs sm:text-sm text-heading transition-colors"
                            ></textarea>
                            {field.helpText && (
                              <span class="text-[11px] text-muted block">
                                {field.helpText}
                              </span>
                            )}
                          </div>
                        );
                      }

                      // Type Checkbox (Layanan Asrama dsb)
                      if (field.type === "checkbox") {
                        return (
                          <div
                            class={`md:col-span-2 p-3.5 rounded-[8px] border border-secondary/30 bg-secondary-light flex items-start gap-3 ${
                              conditionalAttr ? "conditional-field hidden" : ""
                            }`}
                            data-conditional={conditionalAttr}
                          >
                            <input
                              type="checkbox"
                              id={field.id}
                              name={field.id}
                              value="true"
                              class="mt-0.5 rounded border-border text-primary cursor-pointer"
                            />
                            <div>
                              <label
                                for={field.id}
                                class="font-display text-xs sm:text-sm font-bold text-heading cursor-pointer"
                              >
                                {field.label}
                              </label>
                              {field.helpText && (
                                <p class="text-[11px] text-muted leading-relaxed mt-0.5">
                                  {field.helpText}
                                </p>
                              )}
                            </div>
                          </div>
                        );
                      }

                      // Type Date
                      if (field.type === "date") {
                        return (
                          <div
                            class={`space-y-1.5 ${conditionalAttr ? "conditional-field hidden" : ""}`}
                            data-conditional={conditionalAttr}
                          >
                            <label
                              for={field.id}
                              class="block font-body text-xs sm:text-sm font-medium text-heading"
                            >
                              {field.label}{" "}
                              {field.required && (
                                <span class="text-error font-bold">*</span>
                              )}
                            </label>
                            <input
                              type="date"
                              id={field.id}
                              name={field.id}
                              required={field.required}
                              data-originally-required={
                                field.required ? "true" : "false"
                              }
                              class="h-[46px] w-full rounded-[8px] border border-border bg-surface px-4 text-xs sm:text-sm text-heading font-mono transition-colors"
                            />
                            {field.helpText && (
                              <span class="text-[11px] text-muted block">
                                {field.helpText}
                              </span>
                            )}
                          </div>
                        );
                      }

                      // Type Text, Number, Tel, Email
                      return (
                        <div
                          class={`space-y-1.5 ${conditionalAttr ? "conditional-field hidden" : ""}`}
                          data-conditional={conditionalAttr}
                        >
                          <label
                            for={field.id}
                            class="block font-body text-xs sm:text-sm font-medium text-heading"
                          >
                            {field.label}{" "}
                            {field.required && (
                              <span class="text-error font-bold">*</span>
                            )}
                          </label>
                          <input
                            type={field.type}
                            id={field.id}
                            name={field.id}
                            required={field.required}
                            data-originally-required={
                              field.required ? "true" : "false"
                            }
                            placeholder={field.placeholder || ""}
                            pattern={
                              field.validationRule === "exact_16_digits"
                                ? "[0-9]{16}"
                                : field.validationRule === "exact_10_digits"
                                  ? "[0-9]{10}"
                                  : undefined
                            }
                            maxlength={
                              field.validationRule === "exact_16_digits"
                                ? 16
                                : field.validationRule === "exact_10_digits"
                                  ? 10
                                  : undefined
                            }
                            class="h-[46px] w-full rounded-[8px] border border-border bg-surface px-4 text-xs sm:text-sm text-heading transition-colors"
                          />
                          {field.helpText && (
                            <span class="text-[11px] text-muted block">
                              {field.helpText}
                            </span>
                          )}
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })}

            <!-- STEP 6: DOKUMEN (PERSYARATAN BERKAS)                     -->

            <div id="step-pane-6" class="step-pane space-y-6 hidden">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
