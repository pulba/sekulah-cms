                            doc.required ? "true" : "false"
                          }
                          class="doc-file-input block w-full text-xs text-muted file:mr-4 file:py-2.5 file:px-4 file:rounded-[6px] file:border-0 file:text-xs file:font-semibold file:bg-surface file:border file:border-border file:text-heading hover:file:bg-surface-subtle cursor-pointer"
                        />
                        <div
                          id={`feedback-${doc.id}`}
                          class="hidden items-center gap-1.5 pt-1 text-[11px] font-medium text-success-text"
                        >
                          <span class="inline-flex h-3.5 w-3.5 items-center justify-center rounded-full bg-success-light text-success-text text-[9px] font-bold">
                            &check;
                          </span>
                          <span id={`feedback-text-${doc.id}`}></span>
                        </div>
                        <span class="text-[11px] text-muted block leading-relaxed mt-1">
                          {doc.description} &bull; Format{" "}
                          {doc.acceptedFormats.join(" / ").toUpperCase()}, maks.{" "}
                          {doc.maxSizeMb} MB
                        </span>
                      </div>
                    );
                  })}
              </div>
            </div>

            <!-- STEP 7: KONFIRMASI & VERIFIKASI SEBELUM KIRIM            -->

