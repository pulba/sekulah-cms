                  type="button"
                  id="inline-btn-print-status"
                  class="w-full sm:w-auto inline-flex h-9 items-center justify-center gap-2 rounded-[4px] bg-primary px-4 text-xs font-semibold text-white hover:bg-primary-hover hover:shadow-(--shadow-hover) shadow-xs cursor-pointer transition-all"
                >
                  <Icon name="printer" class="h-4 w-4" />
                  <span>
                    Cetak Lembar Formulir &amp; Bukti Pendaftaran (A4)
                  </span>
                </button>

                <a
                  href={`https://wa.me/${ppdbHelpdeskWa.replace(/[^0-9]/g, "")}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full sm:w-auto inline-flex h-9 items-center justify-center gap-2 rounded-[4px] border border-border bg-surface px-4 text-xs font-medium text-heading hover:bg-surface-subtle transition-colors cursor-pointer"
                >
                  <Icon name="whatsapp" class="h-4 w-4 text-[#25D366]" />
                  <span>Hubungi Helpdesk WhatsApp</span>
                </a>
              </div>
            </div>
          </section>

          <!-- Modal Dialog Sukses Pendaftaran -->
          <div
            id="success-modal"
            class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4"
          >
            <div class="max-w-lg w-full rounded-[12px] border border-border bg-surface p-6 sm:p-7 space-y-4 text-center shadow-2xl">
              <!-- Ikon Sukses Proporsional -->
              <div class="h-11 w-11 rounded-full bg-accent-light border border-accent/20 text-accent-text mx-auto flex items-center justify-center text-xl font-bold">
                <Icon name="check" class="h-5 w-5 text-accent" />
              </div>

              <!-- Judul & Keterangan Ringkas -->
              <div class="space-y-1">
                <h3 class="font-display text-lg sm:text-xl font-bold text-heading">
                  Pendaftaran Berhasil!
                </h3>
                <p class="text-xs text-muted leading-relaxed">
                  Formulir pendaftaran daring Anda telah tersimpan resmi pada
                  sistem {admissionsLabel} {schoolName}.
                </p>
              </div>

              <!-- Blok Utama: Kredensial Pendaftaran & Tombol Salin -->
              <div class="rounded-[8px] border border-border bg-surface-subtle p-3 sm:p-4 space-y-3 text-left">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                  <!-- Nomor Registrasi -->
                  <div class="p-2.5 rounded-[6px] bg-surface border border-border flex flex-col justify-between space-y-1">
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-muted">
                      Nomor Registrasi
                    </span>
                    <div class="flex items-center justify-between gap-2">
                      <strong
                        id="modal-reg-number"
                        class="font-mono text-sm sm:text-base font-bold text-heading tracking-tight"
                      >
                        -
                      </strong>
                      <button
                        type="button"
                        id="btn-copy-modal-reg"
                        class="inline-flex items-center gap-1 h-6 px-2 rounded-[4px] border border-border bg-surface text-[11px] font-medium text-muted hover:text-heading hover:bg-surface-subtle cursor-pointer transition-colors shadow-2xs shrink-0"
                        title="Salin Nomor Registrasi"
                      >
                        Salin
                      </button>
                    </div>
                  </div>

                  <!-- Kode Akses Verifikasi -->
                  <div class="p-2.5 rounded-[6px] bg-surface border border-border flex flex-col justify-between space-y-1">
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-muted">
                      Kode Akses
                    </span>
                    <div class="flex items-center justify-between gap-2">
                      <strong
                        id="modal-ver-code"
                        class="font-mono text-sm sm:text-base font-bold text-heading tracking-tight"
                      >
                        -
                      </strong>
                      <button
                        type="button"
                        id="btn-copy-modal-code"
                        class="inline-flex items-center gap-1 h-6 px-2 rounded-[4px] border border-border bg-surface text-[11px] font-medium text-muted hover:text-heading hover:bg-surface-subtle cursor-pointer transition-colors shadow-2xs shrink-0"
                        title="Salin Kode Akses"
                      >
                        Salin
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Informasi Sekunder -->
                <div class="pt-2 grid grid-cols-3 gap-2 text-[11px]">
                  <div>
                    <span class="text-[10px] text-muted block">
                      Nama Pendaftar:
                    </span>
                    <strong
                      id="modal-student-name"
                      class="text-heading font-medium truncate block"
                    >
                      -
                    </strong>
                  </div>
                  <div>
                    <span class="text-[10px] text-muted block">
                      Jalur Masuk:
                    </span>
                    <strong
                      id="modal-path-name"
                      class="text-heading font-medium truncate block"
                    >
                      -
                    </strong>
                  </div>
                  <div>
                    <span class="text-[10px] text-muted block">Gelombang:</span>
                    <strong class="text-heading font-medium block">
                      {formConfig.activeWave || "Gelombang 1"}
                    </strong>
                  </div>
                </div>
              </div>

              <!-- Panel Informasi Netral & Ringkas -->
              <div class="rounded-[6px] p-2.5 bg-surface-subtle border border-border text-muted text-[11px] text-left flex items-center gap-2">
                <Icon name="info" class="h-4 w-4 text-muted shrink-0" />
                <span>
                  Simpan nomor registrasi dan kode akses untuk mengecek status
                  pendaftaran Anda.
                </span>
              </div>

              <!-- Tombol Aksi Berhierarki Jelas -->
              <div class="space-y-2 pt-1">
                <div class="flex flex-col sm:flex-row items-center justify-center gap-2">
                  <a
                    href="#section-cek-status"
                    onclick="document.getElementById('success-modal')?.classList.add('hidden');"
                    class="w-full sm:flex-1 inline-flex h-9 items-center justify-center gap-1.5 rounded-[4px] bg-primary px-4 text-xs font-semibold text-white hover:bg-primary-hover shadow-xs cursor-pointer transition-colors"
                  >
                    <span>Lihat Status Pendaftaran</span>
                    <Icon name="chevron-down" class="h-3.5 w-3.5" />
                  </a>
                  <button
                    type="button"
                    id="btn-modal-print-proof"
                    class="w-full sm:w-auto inline-flex h-9 items-center justify-center gap-1.5 rounded-[4px] border border-border bg-surface px-4 text-xs font-semibold text-heading hover:bg-surface-subtle cursor-pointer transition-colors"
                  >
                    <Icon name="printer" class="h-4 w-4 text-muted" />
                    <span>Cetak Formulir A4</span>
                  </button>
                </div>
                <div>
                  <a
                    href="/"
                    class="inline-block text-xs font-medium text-muted hover:text-heading transition-colors py-0.5 cursor-pointer"
                  >
                    Kembali ke Beranda
                  </a>
                </div>
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    formStepTitles: formConfig.steps.reduce(
      (acc, s) => ({ ...acc, [s.step]: s.title }),
      {},
    ),
  }}
>
  function initAdmissionPage() {
    const form = document.getElementById("admission-wizard-form");
    if (!form || form.dataset.wizardInitialized === "true") return;
    form.dataset.wizardInitialized = "true";

    let currentStep = 1;
    const totalSteps = 7;

    const stepTitles = formStepTitles || {
      1: "PENDAFTARAN",
      2: "DATA PRIBADI",
      3: "DATA AYAH",
      4: "DATA IBU",
      5: "KONTAK",
      6: "DOKUMEN",
      7: "KONFIRMASI",
    };

    const form = document.getElementById("admission-wizard-form");
    const currentStepTitle = document.getElementById("current-step-title");
    const currentStepBadge = document.getElementById("current-step-badge");
    const progressBar = document.getElementById("stepper-progress-bar");
    const stepIndicators = document.querySelectorAll(".step-indicator");
    const btnPrev = document.getElementById("btn-prev-step");
    const btnNext = document.getElementById("btn-next-step");
    const btnSubmit = document.getElementById("btn-submit-form");
    const submitLabel = document.getElementById("btn-submit-label");
    const agreementCheckbox = document.getElementById("agreement");
    const successModal = document.getElementById("success-modal");
    const errorBanner = document.getElementById("submit-error-banner");
    const pathSelect = document.getElementById("admission_path");

    // Summary Elements in Step 7
    const summaryPath = document.getElementById("summary-path");
    const summaryIdentity = document.getElementById("summary-identity");
    const summaryName = document.getElementById("summary-name");
    const summarySchool = document.getElementById("summary-school");
    const summaryParents = document.getElementById("summary-parents");
    const summaryContact = document.getElementById("summary-contact");

    // Handle Conditional Field Display based on Admission Path
    function handlePathConditions() {
      const selectedVal = (pathSelect?.value || "").toLowerCase();
      const isTahfidz =
        selectedVal.includes("tahfidz") || selectedVal.includes("al-qur");
      const isPrestasi =
        selectedVal.includes("prestasi") ||
        selectedVal.includes("kejuaraan") ||
        selectedVal.includes("lks");

      // Toggle conditional fields
      document
        .querySelectorAll('[data-conditional="if_tahfidz"]')
        .forEach((el) => {
          const inp = el.querySelector("input, select, textarea");
          if (isTahfidz) {
            el.classList.remove("hidden");
            if (inp && inp.getAttribute("data-originally-required") === "true")
              inp.required = true;
          } else {
            el.classList.add("hidden");
            if (inp) inp.required = false;
          }
        });

      document
        .querySelectorAll('[data-conditional="if_prestasi"]')
        .forEach((el) => {
          const inp = el.querySelector("input, select, textarea");
          if (isPrestasi) {
            el.classList.remove("hidden");
            if (inp && inp.getAttribute("data-originally-required") === "true")
              inp.required = true;
          } else {
            el.classList.add("hidden");
            if (inp) inp.required = false;
          }
        });

      // Toggle conditional documents
      document
        .querySelectorAll('[data-doc-rule="if_tahfidz"]')
        .forEach((el) => {
          const fileInp = el.querySelector('input[type="file"]');
          if (isTahfidz) {
            el.classList.remove("hidden");
          } else {
            el.classList.add("hidden");
            if (fileInp) {
              fileInp.value = "";
              fileInp.required = false;
            }
          }
        });

      document
        .querySelectorAll('[data-doc-rule="if_prestasi"]')
        .forEach((el) => {
          const fileInp = el.querySelector('input[type="file"]');
          if (isPrestasi) {
            el.classList.remove("hidden");
          } else {
            el.classList.add("hidden");
            if (fileInp) {
              fileInp.value = "";
              fileInp.required = false;
            }
          }
        });
    }

    pathSelect?.addEventListener("change", handlePathConditions);
    handlePathConditions();

    function renderStep(step) {
      currentStep = step;

      // 1. Update Title Label & Step Badge
      if (currentStepTitle) {
        currentStepTitle.textContent = (
          stepTitles[step] || "TAHAPAN"
        ).toUpperCase();
      }
      if (currentStepBadge) {
        currentStepBadge.textContent = `Langkah ${step} dari ${totalSteps}`;
      }

      // 2. Update Progress Bar
      if (progressBar) {
        const percent = ((step - 1) / (totalSteps - 1)) * 100;
        progressBar.style.width = `${percent}%`;
      }

      // 3. Update Stepper Badges
      stepIndicators.forEach((el) => {
        const stepNum = parseInt(el.getAttribute("data-step") || "1", 10);
        const circle = el.querySelector(".step-circle");
        const label = el.querySelector(".step-label");

        if (stepNum === step) {
          // Current Active
          if (circle) {
            circle.className =
              "step-circle h-10 w-10 rounded-full flex items-center justify-center font-display text-sm font-bold transition-all duration-200 bg-primary text-white shadow-xs";
          }
          if (label) {
            label.className =
              "step-label mt-2 text-xs font-semibold text-primary pb-1 border-b-2 border-primary transition-colors";
          }
        } else if (stepNum < step) {
          // Completed
          if (circle) {
            circle.className =
              "step-circle h-10 w-10 rounded-full flex items-center justify-center font-display text-sm font-bold transition-all duration-200 bg-primary-light text-primary border border-primary/20";
          }
          if (label) {
            label.className =
              "step-label mt-2 text-xs font-medium text-heading transition-colors";
          }
        } else {
          // Pending
          if (circle) {
            circle.className =
              "step-circle h-10 w-10 rounded-full flex items-center justify-center font-display text-sm font-semibold transition-all duration-200 bg-surface border border-border text-muted";
          }
          if (label) {
            label.className =
              "step-label mt-2 text-xs font-medium text-muted transition-colors";
          }
        }
      });

      // 4. Toggle Step Panes
      for (let i = 1; i <= totalSteps; i++) {
        const pane = document.getElementById(`step-pane-${i}`);
        if (pane) {
          if (i === step) {
            pane.classList.remove("hidden");
          } else {
            pane.classList.add("hidden");
          }
        }
      }

      // 5. Toggle Navigation Buttons (Sesuai Rumus Wizard 7 Langkah)
      const isFirstStep = step === 1;
      const isLastStep = step === totalSteps;

      const showPrevious = !isFirstStep;
      const showNext = !isLastStep;
      const showSubmit = isLastStep;

      if (btnPrev) {
        btnPrev.classList.toggle("hidden", !showPrevious);
        btnPrev.classList.toggle("inline-flex", showPrevious);
      }
      if (btnNext) {
        btnNext.classList.toggle("hidden", !showNext);
        btnNext.classList.toggle("inline-flex", showNext);
      }
      if (btnSubmit) {
        btnSubmit.classList.toggle("hidden", !showSubmit);
        btnSubmit.classList.toggle("inline-flex", showSubmit);
      }

      if (isLastStep) {
        updateSummary();
        checkFormReadiness();
      }

      // Scroll to top of form card smoothly jika bukan initial render
      if (step > 1) {
        form?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    function updateSummary() {
      const regType = document.getElementById("reg_type")?.value || "Baru";
      const path = document.getElementById("admission_path")?.value || "Umum";
      const nik = document.getElementById("nik")?.value || "-";
      const nisn = document.getElementById("nisn")?.value || "-";
      const name = document.getElementById("full_name")?.value || "-";
      const school = document.getElementById("prev_school")?.value || "-";
      const father = document.getElementById("father_name")?.value || "-";
      const mother = document.getElementById("mother_name")?.value || "-";
      const phone = document.getElementById("phone_student")?.value || "-";

      if (summaryPath) summaryPath.textContent = `${regType} / ${path}`;
      if (summaryIdentity)
        summaryIdentity.textContent = `NIK: ${nik} | NISN: ${nisn}`;
      if (summaryName) summaryName.textContent = name;
      if (summarySchool) summarySchool.textContent = school;
      if (summaryParents) summaryParents.textContent = `${father} & ${mother}`;
      if (summaryContact) summaryContact.textContent = phone;

      // Update daftar ringkasan berkas di Step 7
      const docsContainer = document.getElementById("summary-docs-list");
      if (docsContainer) {
        const docItems = [
          { id: "file_kk", label: "Kartu Keluarga (KK)", req: true },
          { id: "file_akta", label: "Akta Kelahiran", req: true },
          { id: "file_skl", label: "SKL / Ijazah", req: true },
          { id: "file_prestasi", label: "Dokumen Prestasi / KIP", req: false },
          { id: "file_tahfidz", label: "Syahadah Tahfidz", req: false },
          { id: "file_butawarna", label: "Surat Bebas Buta Warna", req: false },
        ];

        let html = "";
        docItems.forEach((d) => {
          const inp = document.getElementById(d.id);
          if (!inp || inp.closest(".hidden")) return;
          const file = inp.files && inp.files[0];
          if (file) {
            const sizeKb = (file.size / 1024).toFixed(0);
            html += `<div class="p-1.5 rounded bg-surface border border-success text-success-text flex items-center justify-between">
              <span class="truncate font-medium">${d.label}: ${file.name}</span>
              <span class="shrink-0 ml-1 text-[10px] font-bold text-success">[✓ ${sizeKb} KB]</span>
            </div>`;
          } else if (d.req) {
            html += `<div class="p-1.5 rounded bg-surface border border-error text-error-text flex items-center justify-between">
              <span class="font-medium">${d.label}</span>
              <span class="shrink-0 ml-1 text-[10px] font-bold text-error">[Belum Dipilih *]</span>
            </div>`;
          } else {
            html += `<div class="p-1.5 rounded bg-surface border border-border text-muted flex items-center justify-between">
              <span>${d.label}</span>
              <span class="shrink-0 ml-1 text-[10px]">[Opsional - Tidak Diunggah]</span>
            </div>`;
          }
        });
        docsContainer.innerHTML = html;
      }
    }

    // Periksa kelengkapan seluruh data dan aktifkan tombol "Kirim Pendaftaran ✓" HANYA ketika semua telah diisi
    function checkFormReadiness() {
      if (!btnSubmit) return;

      let isAllValid = true;
      let missingFields = [];

      for (let i = 1; i <= 6; i++) {
        const pane = document.getElementById(`step-pane-${i}`);
        if (pane) {
          const reqs = pane.querySelectorAll(
            "input[required], select[required], textarea[required]",
          );
          for (const input of reqs) {
            // Ignore hidden conditional fields
            if (input.closest(".hidden")) continue;

            if (!input.checkValidity() || !String(input.value || "").trim()) {
              isAllValid = false;
              const labelEl = pane.querySelector(`label[for="${input.id}"]`);
              const labelText = labelEl
                ? labelEl.textContent.replace("*", "").trim()
                : input.name;
              if (labelText && !missingFields.includes(labelText)) {
                missingFields.push(labelText);
              }
            }
          }
        }
      }

      const isAgreed = agreementCheckbox && agreementCheckbox.checked;
      const readinessBanner = document.getElementById("form-readiness-banner");
      const readinessIcon = document.getElementById("readiness-icon");
      const readinessText = document.getElementById("readiness-text");

      if (isAllValid && isAgreed) {
        btnSubmit.disabled = false;
        btnSubmit.classList.remove("opacity-40", "cursor-not-allowed");
        if (readinessBanner) {
          readinessBanner.className =
            "p-3.5 rounded-[8px] text-xs font-medium border border-success/30 bg-success-light text-success-text flex items-start gap-2.5";
          if (readinessIcon) readinessIcon.textContent = "✓";
          if (readinessText) {
            readinessText.innerHTML =
              "<strong>Seluruh data wajib dan berkas pendaftaran telah lengkap terisi.</strong> Tombol Kirim Pendaftaran di bawah telah aktif.";
          }
        }
      } else {
        btnSubmit.disabled = true;
        btnSubmit.classList.add("opacity-40", "cursor-not-allowed");
        if (readinessBanner) {
          readinessBanner.className =
            "p-3.5 rounded-[8px] text-xs font-medium border border-warning/40 bg-warning-light text-warning-text flex items-start gap-2.5";
          if (readinessIcon) readinessIcon.textContent = "⚠️";
          if (!isAllValid) {
            const listStr =
              missingFields.slice(0, 3).join(", ") +
              (missingFields.length > 3
                ? `, dan ${missingFields.length - 3} kolom lainnya`
                : "");
            readinessText.innerHTML = `<strong>Data belum lengkap:</strong> Mohon periksa kembali kolom wajib (${listStr}) dan pastikan terisi dengan benar.`;
          } else {
            readinessText.innerHTML =
              "<strong>Tinggal 1 langkah lagi:</strong> Silakan centang kotak pakta integritas pernyataan keabsahan di atas untuk mengaktifkan tombol Kirim Pendaftaran.";
          }
        }
      }
    }

    function validateCurrentStep() {
      const activePane = document.getElementById(`step-pane-${currentStep}`);
      if (!activePane) return true;

      const requiredInputs = activePane.querySelectorAll(
        "input[required], select[required], textarea[required]",
      );
      for (const input of requiredInputs) {
        if (input.closest(".hidden") || input.offsetParent === null) continue;
        if (!input.checkValidity() || !String(input.value || "").trim()) {
          input.reportValidity();
          input.focus();
          return false;
        }
      }
      return true;
    }

    // Event Listeners Navigasi
    btnNext?.addEventListener("click", () => {
      if (validateCurrentStep()) {
        if (currentStep < totalSteps) {
          renderStep(currentStep + 1);
        }
      }
    });

    btnPrev?.addEventListener("click", () => {
      if (currentStep > 1) {
        renderStep(currentStep - 1);
      }
    });

    // Checkbox Agreement Event
    agreementCheckbox?.addEventListener("change", () => {
      checkFormReadiness();
    });

    // Event listener input change across form
    form?.addEventListener("input", () => {
      if (currentStep === totalSteps) {
        checkFormReadiness();
      }
    });

    // Validasi instan berkas di Step 6
    const docInputs = form?.querySelectorAll(".doc-file-input");
    docInputs?.forEach((input) => {
      input.addEventListener("change", () => {
        const file = input.files && input.files[0];
        const fb = document.getElementById(`feedback-${input.id}`);
        const fbText = document.getElementById(`feedback-text-${input.id}`);

        if (file) {
          // 1. Validasi Ukuran (Maksimal 2 MB)
          if (file.size > 2 * 1024 * 1024) {
            alert(
              `Ukuran berkas "${file.name}" (${(file.size / (1024 * 1024)).toFixed(2)} MB) melebihi batas maksimal 2 MB. Silakan kompres atau pilih berkas lain.`,
            );
            input.value = "";
            if (fb) fb.classList.add("hidden");
            checkFormReadiness();
            return;
          }

          // 2. Validasi Ekstensi Berkas
          const ext = (file.name.split(".").pop() || "").toLowerCase();
          if (!["pdf", "jpg", "jpeg", "png", "webp"].includes(ext)) {
            alert(
              `Format berkas .${ext} tidak didukung. Harap unggah berkas berformat PDF, JPG, JPEG, PNG, atau WEBP.`,
            );
            input.value = "";
            if (fb) fb.classList.add("hidden");
            checkFormReadiness();
            return;
          }

          if (fb && fbText) {
            const sizeKb = (file.size / 1024).toFixed(0);
            fbText.textContent = `${file.name} (${sizeKb} KB) ✓ Berkas siap`;
            fb.classList.remove("hidden");
            fb.classList.add("inline-flex");
          }
        } else {
          if (fb) fb.classList.add("hidden");
        }
        checkFormReadiness();
      });
    });

    // Stepper header click: bebas mundur, maju hanya langkah berikutnya setelah validasi
    stepIndicators.forEach((el) => {
      el.addEventListener("click", () => {
        const targetStep = parseInt(el.getAttribute("data-step") || "1", 10);
        if (targetStep === currentStep) return;
        if (targetStep < currentStep) {
          renderStep(targetStep);
        } else if (targetStep === currentStep + 1) {
          if (validateCurrentStep()) {
            renderStep(targetStep);
          }
        }
      });
    });

    // Pengiriman Formulir Nyata ke Endpoint Aman Backend Server
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (currentStep !== totalSteps) {
        renderStep(totalSteps);
        return;
      }

      // Validasi ulang seluruh langkah 1 s.d. 6 di client sebelum submit
      for (let s = 1; s <= 6; s++) {
        const pane = document.getElementById(`step-pane-${s}`);
        if (!pane) continue;
        const reqs = pane.querySelectorAll(
          "input[required], select[required], textarea[required]",
        );
        for (const input of reqs) {
          if (input.closest(".hidden") || input.offsetParent === null) continue;
          if (!input.checkValidity() || !String(input.value || "").trim()) {
            renderStep(s);
            input.reportValidity();
            input.focus();
            return;
          }
        }
      }

      if (!agreementCheckbox || !agreementCheckbox.checked) {
        if (errorBanner) {
          errorBanner.textContent =
            "Anda wajib mencentang pernyataan keabsahan data sebelum mengirim formulir pendaftaran.";
          errorBanner.classList.remove("hidden");
        }
        return;
      }

      // Sembunyikan pesan error sebelumnya
      if (errorBanner) errorBanner.classList.add("hidden");

      // Set status tombol loading
      btnSubmit.disabled = true;
      if (submitLabel)
        submitLabel.textContent = "Mengunggah Dokumen & Menyimpan...";

      // Ekstraksi data formulir utuh (beserta File objek biner)
      const fd = new FormData(form);
      const applyBoarding = document.getElementById("apply_boarding");
      if (applyBoarding) {
        fd.set("is_boarding", applyBoarding.checked ? "true" : "false");
      }

      try {
        const res = await fetch("/api/ppdb/register", {
          method: "POST",
          headers: {
            "X-Requested-With": "XMLHttpRequest",
          },
          body: fd,
        });

        const data = await res.json();
        btnSubmit.disabled = false;
        if (submitLabel) submitLabel.textContent = "Kirim Pendaftaran";

        if (data.success) {
          const modalRegNumber = document.getElementById("modal-reg-number");
          const modalVerCode = document.getElementById("modal-ver-code");
          const modalStudentName =
            document.getElementById("modal-student-name");
          const modalPathName = document.getElementById("modal-path-name");

          if (modalRegNumber)
            modalRegNumber.textContent = data.registrationNumber;
          if (modalVerCode)
            modalVerCode.textContent = data.verificationCode || "-";
          if (modalStudentName) modalStudentName.textContent = data.studentName;
          if (modalPathName) modalPathName.textContent = data.admissionPath;

          // Isi otomatis form Cek Status di bawah agar calon siswa tidak perlu ketik ulang
          const inputRegInline = document.getElementById("inline-input-reg");
          const inputCodeInline = document.getElementById("inline-input-code");
          if (inputRegInline) inputRegInline.value = data.registrationNumber;
          if (inputCodeInline)
            inputCodeInline.value = data.verificationCode || "";

          if (successModal) {
            successModal.classList.remove("hidden");
          }
        } else {
          if (errorBanner) {
            errorBanner.textContent = `Pendaftaran Ditolak Server: ${
              data.error || "Terjadi kesalahan validasi data."
            }`;
            errorBanner.classList.remove("hidden");
            errorBanner.scrollIntoView({
              behavior: "smooth",
              block: "nearest",
            });
          } else {
            alert(data.error || "Gagal memproses pendaftaran.");
          }
          checkFormReadiness();
        }
      } catch (err) {
        btnSubmit.disabled = false;
        if (submitLabel) submitLabel.textContent = "Kirim Pendaftaran";
        if (errorBanner) {
          errorBanner.innerHTML =
            "<strong>Gangguan Jaringan:</strong> Gagal terhubung ke server institusi. Silakan periksa koneksi internet Anda dan coba lagi.";
          errorBanner.classList.remove("hidden");
        }
      }
    });

    // Inisialisasi awal formulir pada langkah 1
    renderStep(1);

    // Tombol Salin Kredensial di Modal Sukses
    const btnCopyModalReg = document.getElementById("btn-copy-modal-reg");
    const btnCopyModalCode = document.getElementById("btn-copy-modal-code");

    btnCopyModalReg?.addEventListener("click", () => {
      const reg = document
        .getElementById("modal-reg-number")
        ?.textContent?.trim();
      if (reg && reg !== "-") {
        navigator.clipboard.writeText(reg);
        btnCopyModalReg.textContent = "Tersalin!";
        setTimeout(() => {
          btnCopyModalReg.textContent = "Salin";
        }, 2000);
      }
    });

    btnCopyModalCode?.addEventListener("click", () => {
      const code = document
        .getElementById("modal-ver-code")
        ?.textContent?.trim();
      if (code && code !== "-") {
        navigator.clipboard.writeText(code);
        btnCopyModalCode.textContent = "Tersalin!";
        setTimeout(() => {
          btnCopyModalCode.textContent = "Salin";
        }, 2000);
      }
    });

    // Countdown Ticker Interaktif jika halaman berstatus upcoming
    const countdownEl = document.querySelector(".countdown-container");
    if (countdownEl) {
      const targetIso = countdownEl.getAttribute("data-target-date");
      if (targetIso) {
        const targetDate = new Date(targetIso).getTime();
        const elDays = document.getElementById("countdown-days");
        const elHours = document.getElementById("countdown-hours");
        const elMinutes = document.getElementById("countdown-minutes");
        const elSeconds = document.getElementById("countdown-seconds");

        function tick() {
          const now = Date.now();
          const diff = targetDate - now;

          if (diff <= 0) {
            if (elDays) elDays.textContent = "00";
            if (elHours) elHours.textContent = "00";
            if (elMinutes) elMinutes.textContent = "00";
            if (elSeconds) elSeconds.textContent = "00";
            return;
          }

          const days = Math.floor(diff / (1000 * 60 * 60 * 24));
          const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
          const minutes = Math.floor((diff / (1000 * 60)) % 60);
          const seconds = Math.floor((diff / 1000) % 60);

          if (elDays) elDays.textContent = String(days).padStart(2, "0");
          if (elHours) elHours.textContent = String(hours).padStart(2, "0");
          if (elMinutes)
            elMinutes.textContent = String(minutes).padStart(2, "0");
          if (elSeconds)
            elSeconds.textContent = String(seconds).padStart(2, "0");
        }

        tick();
        setInterval(tick, 1000);
      }
    }

    // ==========================================
    // LOGIKA CEK STATUS PENDAFTARAN INLINE
    // ==========================================
    const inlineForm = document.getElementById("form-check-status-inline");
    const inlineInputReg = document.getElementById("inline-input-reg");
    const inlineInputCode = document.getElementById("inline-input-code");
    const inlineErrorBanner = document.getElementById("inline-error-banner");
    const inlineBtnSubmit = document.getElementById("inline-btn-submit-check");
    const inlineResultContainer = document.getElementById(
      "inline-result-container",
    );

    const inlineResStudentName = document.getElementById(
      "inline-res-student-name",
    );
    const inlineResRegNumber = document.getElementById("inline-res-reg-number");
    const inlineResVerCode = document.getElementById("inline-res-ver-code");
    const inlineResAdmissionPath = document.getElementById(
      "inline-res-admission-path",
    );
    const inlineResWave = document.getElementById("inline-res-wave");
    const inlineResAcademicYear = document.getElementById(
      "inline-res-academic-year",
    );
    const inlineResSubmittedAt = document.getElementById(
      "inline-res-submitted-at",
    );

    const inlineBadgeRegistration = document.getElementById(
      "inline-badge-registration",
    );
    const inlineBadgeVerification = document.getElementById(
      "inline-badge-verification",
    );
    const inlineRevisionNotice = document.getElementById(
      "inline-revision-notice",
    );
    const inlineRevisionText = document.getElementById("inline-revision-text");

    const inlineBadgeSelection = document.getElementById(
      "inline-badge-selection",
    );
    const inlineScheduleNotice = document.getElementById(
      "inline-schedule-notice",
    );
    const inlineScheduleDate = document.getElementById("inline-schedule-date");

    const inlineNextTitle = document.getElementById("inline-next-title");
    const inlineNextDesc = document.getElementById("inline-next-desc");

    function formatTglIndo(isoStr) {
      if (!isoStr) return "-";
      try {
        const d = new Date(isoStr);
        return d.toLocaleDateString("id-ID", {
          day: "numeric",
          month: "long",
          year: "numeric",
        });
      } catch {
        return isoStr;
      }
    }

    inlineForm?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const registrationNumber = (inlineInputReg?.value || "")
        .trim()
        .toUpperCase();
      const verificationCode = (inlineInputCode?.value || "")
        .trim()
        .toUpperCase();

      if (!registrationNumber || !verificationCode) {
        if (inlineErrorBanner) {
          inlineErrorBanner.textContent =
            "Nomor registrasi dan kode akses verifikasi wajib diisi.";
          inlineErrorBanner.classList.remove("hidden");
        }
        return;
      }

      if (inlineErrorBanner) inlineErrorBanner.classList.add("hidden");
      if (inlineBtnSubmit) {
        inlineBtnSubmit.disabled = true;
        inlineBtnSubmit.textContent = "Memeriksa...";
      }

      try {
        const res = await fetch("/api/ppdb/check-status", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-Requested-With": "XMLHttpRequest",
          },
          body: JSON.stringify({ registrationNumber, verificationCode }),
        });

        const data = await res.json();
        if (inlineBtnSubmit) {
          inlineBtnSubmit.disabled = false;
          inlineBtnSubmit.innerHTML = `<span>Periksa Status</span> <span>&rarr;</span>`;
        }

        if (data.success && data.data) {
          const s = data.data;

          if (inlineResStudentName)
            inlineResStudentName.textContent = s.studentName;
          if (inlineResRegNumber)
            inlineResRegNumber.textContent = s.registrationNumber;
          if (inlineResVerCode)
            inlineResVerCode.textContent = s.verificationCode || "-";
          if (inlineResAdmissionPath)
            inlineResAdmissionPath.textContent = `${s.admissionPath} (${s.regType})`;
          if (inlineResWave)
            inlineResWave.textContent = s.wave || "Gelombang 1";
          if (inlineResAcademicYear)
            inlineResAcademicYear.textContent = s.academicYear;
          if (inlineResSubmittedAt)
            inlineResSubmittedAt.textContent = formatTglIndo(s.submittedAt);

          // 1. Status Registrasi
          if (inlineBadgeRegistration) {
            inlineBadgeRegistration.className =
              "inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-semibold bg-success-light text-success-text border border-success";
            inlineBadgeRegistration.textContent = "Formulir Terkirim";
          }

          // 2. Status Verifikasi Berkas
          if (inlineBadgeVerification) {
            if (s.verificationStatus === "verified") {
              inlineBadgeVerification.className =
                "inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-semibold bg-success-light text-success-text border border-success";
              inlineBadgeVerification.textContent = "Berkas Terverifikasi Sah";
              if (inlineRevisionNotice)
                inlineRevisionNotice.classList.add("hidden");
            } else if (s.verificationStatus === "revision_required") {
              inlineBadgeVerification.className =
                "inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-semibold bg-warning-light text-warning-text border border-warning";
              inlineBadgeVerification.textContent = "Perlu Perbaikan Berkas";
              if (inlineRevisionNotice) {
                inlineRevisionNotice.classList.remove("hidden");
                if (inlineRevisionText) {
                  inlineRevisionText.textContent =
                    s.revisionNotes ||
                    "Terdapat berkas yang belum memenuhi ketentuan. Silakan hubungi helpdesk panitia.";
                }
              }
            } else {
              inlineBadgeVerification.className =
                "inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-semibold bg-surface-subtle text-body border border-border";
              inlineBadgeVerification.textContent = "Menunggu Verifikasi";
              if (inlineRevisionNotice)
                inlineRevisionNotice.classList.add("hidden");
            }
          }

          // 3. Status Seleksi
          if (inlineBadgeSelection) {
            if (s.selectionStatus === "accepted") {
              inlineBadgeSelection.className =
                "inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-semibold bg-success-light text-success-text border border-success";
              inlineBadgeSelection.textContent = "Diterima (Lolos Seleksi)";
              if (inlineScheduleNotice)
                inlineScheduleNotice.classList.add("hidden");
            } else if (s.selectionStatus === "rejected") {
              inlineBadgeSelection.className =
                "inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-semibold bg-error-light text-error-text border border-error";
              inlineBadgeSelection.textContent = "Tidak Diterima";
              if (inlineScheduleNotice)
                inlineScheduleNotice.classList.add("hidden");
            } else if (s.selectionStatus === "waitlist") {
              inlineBadgeSelection.className =
                "inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-semibold bg-primary-light text-primary border border-primary";
              inlineBadgeSelection.textContent = "Daftar Tunggu / Cadangan";
              if (inlineScheduleNotice)
                inlineScheduleNotice.classList.add("hidden");
            } else {
              inlineBadgeSelection.className =
                "inline-flex items-center px-2 py-0.5 rounded-[4px] text-[11px] font-medium bg-surface-subtle text-body border border-border";
              inlineBadgeSelection.textContent = "Belum Diumumkan";
              if (inlineScheduleNotice) {
                inlineScheduleNotice.classList.remove("hidden");
                if (inlineScheduleDate) {
                  inlineScheduleDate.textContent =
                    formatTglIndo(s.announcementSchedule) ||
                    "Sesuai kalender sekolah";
                }
              }
            }
          }

          // Petunjuk Langkah Lanjutan
          if (inlineNextTitle && inlineNextDesc) {
            if (s.selectionStatus === "accepted") {
              inlineNextTitle.textContent =
                "Selamat! Anda Dinyatakan Lolos Seleksi";
              inlineNextDesc.textContent =
                "Silakan segera lakukan proses daftar ulang sesuai jadwal resmi dengan membawa cetakan bukti status ini beserta berkas fisik asli ke sekolah.";
            } else if (s.selectionStatus === "rejected") {
              inlineNextTitle.textContent = "Pemberitahuan Hasil Seleksi";
              inlineNextDesc.textContent =
                "Mohon maaf, kuota penerimaan pada jalur ini telah terpenuhi. Terima kasih atas partisipasi dan antusiasme Anda mengikuti seleksi.";
            } else if (s.selectionStatus === "waitlist") {
              inlineNextTitle.textContent =
                "Calon Siswa Cadangan (Daftar Tunggu)";
              inlineNextDesc.textContent =
                "Anda terdaftar dalam kuota cadangan. Panitia akan menghubungi Anda melalui nomor WhatsApp jika terdapat kursi pendaftaran yang mengundurkan diri.";
            } else if (s.verificationStatus === "revision_required") {
              inlineNextTitle.textContent =
                "Tindakan Diperlukan: Perbaikan Berkas";
              inlineNextDesc.textContent =
                "Panitia menemukan ketidaksesuaian dokumen. Mohon hubungi panitia melalui posko Helpdesk untuk melakukan pembaruan berkas persyaratan.";
            } else if (s.verificationStatus === "verified") {
              inlineNextTitle.textContent =
                "Berkas Sah: Menunggu Jadwal Pengumuman";
              inlineNextDesc.textContent =
                "Seluruh dokumen persyaratan Anda telah diverifikasi lengkap dan sah. Silakan menunggu rilis keputusan seleksi resmi sesuai jadwal gelombang.";
            } else {
              inlineNextTitle.textContent =
                "Formulir Diterima: Menunggu Verifikasi Dokumen";
              inlineNextDesc.textContent =
                "Data Anda telah tersimpan. Verifikator panitia sedang memeriksa keabsahan dokumen persyaratan secara bertahap.";
            }
          }

          if (inlineResultContainer) {
            inlineResultContainer.classList.remove("hidden");
            inlineResultContainer.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          }
        } else {
          if (inlineErrorBanner) {
            inlineErrorBanner.textContent =
              data.error ||
              "Nomor registrasi atau kode verifikasi tidak ditemukan.";
            inlineErrorBanner.classList.remove("hidden");
          }
          if (inlineResultContainer)
            inlineResultContainer.classList.add("hidden");
        }
      } catch (err) {
        if (inlineBtnSubmit) {
          inlineBtnSubmit.disabled = false;
          inlineBtnSubmit.innerHTML = `<span>Periksa Status</span> <span>&rarr;</span>`;
        }
        if (inlineErrorBanner) {
          inlineErrorBanner.textContent =
            "Gagal terhubung ke server institusi. Silakan periksa koneksi internet Anda.";
          inlineErrorBanner.classList.remove("hidden");
        }
      }
    });

    // Buka Lembar Formulir Pendaftaran A4 Resmi Calon Siswa (Standar Resmi Sekolah)
    const inlineBtnPrintStatus = document.getElementById(
      "inline-btn-print-status",
    );
    inlineBtnPrintStatus?.addEventListener("click", () => {
      const reg = (
        inlineInputReg?.value ||
        document.getElementById("inline-res-reg-number")?.textContent ||
        ""
      ).trim();
      const code = (
        inlineInputCode?.value ||
        document.getElementById("inline-res-ver-code")?.textContent ||
        ""
      ).trim();
      if (reg && reg !== "-" && code && code !== "-") {
        window.open(
          `/pendaftaran/cetak?reg=${encodeURIComponent(reg)}&code=${encodeURIComponent(code)}&print=true`,
          "_blank",
        );
      } else {
        alert(
          "Nomor registrasi dan kode akses verifikasi belum lengkap untuk mencetak lembar A4.",
        );
      }
    });

    const btnModalPrintProof = document.getElementById("btn-modal-print-proof");
    btnModalPrintProof?.addEventListener("click", () => {
      const reg = (
        document.getElementById("modal-reg-number")?.textContent || ""
      ).trim();
      const code = (
        document.getElementById("modal-ver-code")?.textContent || ""
      ).trim();
      if (reg && reg !== "-" && code && code !== "-") {
        window.open(
          `/pendaftaran/cetak?reg=${encodeURIComponent(reg)}&code=${encodeURIComponent(code)}&print=true`,
          "_blank",
        );
      } else {
        alert("Data registrasi belum siap untuk dicetak.");
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAdmissionPage);
  } else {
    initAdmissionPage();
  }
  document.addEventListener("astro:page-load", initAdmissionPage);
</script>
