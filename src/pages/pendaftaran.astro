                  .filter(shouldRenderDocument)
                  .map((doc) => {
                    const isConditionalTahfidz =
                      doc.conditionalRule === "if_tahfidz";
                    const isConditionalPrestasi =
                      doc.conditionalRule === "if_prestasi";
                    const conditionalAttr = isConditionalTahfidz
                      ? "if_tahfidz"
                      : isConditionalPrestasi
                        ? "if_prestasi"
                        : undefined;

                    return (
                      <div
                        class={`space-y-1.5 p-4 rounded-[10px] border border-border bg-surface-subtle ${
                          conditionalAttr ? "conditional-doc hidden" : ""
                        }`}
                        data-doc-rule={conditionalAttr}
                      >
                        <label
                          for={doc.id}
                          class="block font-body text-xs sm:text-sm font-medium text-heading"
                        >
                          {doc.name}{" "}
                          {doc.required && (
                            <span class="text-error font-bold">*</span>
                          )}
                        </label>
                        <input
                          type="file"
                          id={doc.id}
                          name={doc.id}
                          accept={doc.acceptedFormats.join(",")}
                          required={doc.required}
