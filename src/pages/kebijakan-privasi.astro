---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import { db, settings } from '../db';

let schoolSettings: Record<string, string> = {};
try {
  const allSettings = await db.select().from(settings);
  schoolSettings = allSettings.reduce(
    (acc, curr) => {
      acc[curr.key] = curr.value;
      return acc;
    },
    {} as Record<string, string>,
  );
} catch {
  schoolSettings = {};
}

const schoolName = schoolSettings['school_name'] || 'SMAN 1 UNGGULAN';
const schoolEmail = schoolSettings['email'] || 'info@sman1unggulan.sch.id';
const schoolAddress = schoolSettings['address'] || 'Jl. Pendidikan No. 45, Kota Pendidikan';
---

<Layout
  title={`Kebijakan Privasi & Perlindungan Data — ${schoolName}`}
  description="Pernyataan resmi komitmen kepatuhan perlindungan data pribadi siswa, guru, dan alumni sesuai UU PDP No. 27 Tahun 2022."
>
  <Header currentPath="/kebijakan-privasi" />

  <main class="flex-1 py-12 bg-background">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <!-- Breadcrumb -->
      <Breadcrumb
        items={[
          { label: 'Beranda', href: '/' },
          { label: 'Kebijakan Privasi' },
        ]}
      />

      <div class="rounded-[10px] border border-border bg-surface p-6 sm:p-10 shadow-xs space-y-8">
        <div class="space-y-2.5">
          <div class="inline-flex items-center gap-1.5 rounded-[4px] bg-accent-light px-2.5 py-1 text-[11px] font-semibold text-accent-text border border-accent/20">
            <Icon name="lock" class="h-3 w-3 text-accent shrink-0" />
            <span>Kepatuhan Regulasi UU PDP No. 27/2022</span>
          </div>
          <h1 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-heading">
            Kebijakan Privasi & Tata Kelola Data Pribadi
          </h1>
          <p class="font-body text-xs text-muted">
            Terakhir diperbarui: Oktober 2026 &bull; Tim Kepatuhan Informasi Publik {schoolName}
          </p>
        </div>

        <section class="space-y-2.5 font-body text-sm text-body leading-relaxed">
          <h2 class="font-display text-base font-bold text-heading">1. Komitmen Institusi</h2>
          <p>
            {schoolName} berkomitmen penuh menjaga kerahasiaan, integritas, dan keamanan informasi data pribadi (Personally Identifiable Information / PII) seluruh warga sekolah, meliputi peserta didik, calon peserta didik baru, tenaga pendidik, tenaga kependidikan, serta para alumni.
          </p>
        </section>

        <section class="space-y-2.5 font-body text-sm text-body leading-relaxed">
          <h2 class="font-display text-base font-bold text-heading">2. Jenis Data yang Dikelola</h2>
          <ul class="list-disc pl-5 space-y-2 text-muted">
            <li><strong class="text-heading font-medium">Data Dewan Guru & Tenaga Pendidik:</strong> Nama lengkap beserta gelar, Nomor Induk Pegawai (NIP), penugasan mata pelajaran, serta foto resmi yang dipublikasikan untuk transparansi pelayanan akademik.</li>
            <li><strong class="text-heading font-medium">Data Prestasi Siswa:</strong> Nama juara, jenis kejuaraan lomba, jenjang perlombaan, dan bukti sertifikat dokumentasi akademik yang dipublikasikan atas izin peserta didik/wali.</li>
            <li><strong class="text-heading font-medium">Data Tracer Study Alumni:</strong> Nama alumni, tahun kelulusan, dan institusi pendidikan tinggi atau lembaga karier yang hanya ditayangkan jika mendapat persetujuan eksplisit (*opt-in consent*).</li>
            <li><strong class="text-heading font-medium">Log Keamanan Server:</strong> Alamat IP, identitas browser, dan riwayat aktivitas autentikasi staf yang dicatat secara ketat di tabel audit internal demi audit keamanan informasi.</li>
          </ul>
        </section>

        <section class="space-y-2.5 font-body text-sm text-body leading-relaxed">
          <h2 class="font-display text-base font-bold text-heading">3. Penggunaan Cookie & Sesi</h2>
          <p>
            Portal publik {schoolName} tidak menyematkan cookie pelacak iklan komersial pihak ketiga. Cookie hanya digunakan untuk staf yang terautentikasi ke dalam CMS Administrator dengan parameter perlindungan tingkat tinggi: <code class="font-mono text-heading bg-surface-subtle px-1.5 py-0.5 rounded-[4px] border border-border/60 text-xs">HttpOnly</code>, <code class="font-mono text-heading bg-surface-subtle px-1.5 py-0.5 rounded-[4px] border border-border/60 text-xs">Secure</code>, dan <code class="font-mono text-heading bg-surface-subtle px-1.5 py-0.5 rounded-[4px] border border-border/60 text-xs">SameSite=Strict</code>.
          </p>
        </section>

        <section class="space-y-2.5 font-body text-sm text-body leading-relaxed">
          <h2 class="font-display text-base font-bold text-heading">4. Hak Subjek Data</h2>
          <p>
            Sesuai perundangan yang berlaku, setiap siswa, guru, dan alumni berhak:
          </p>
          <ul class="list-disc pl-5 space-y-1.5 text-muted">
            <li>Mengajukan permohonan pembaruan data yang tidak akurat.</li>
            <li>Menarik persetujuan publikasi data alumni atau prestasi dari portal web publik.</li>
            <li>Menyampaikan pengaduan jika menemukan indikasi pelanggaran kerahasiaan informasi pribadi.</li>
          </ul>
        </section>

        <div class="rounded-[10px] bg-surface-subtle p-5 border border-border space-y-3">
          <div class="flex items-center gap-2">
            <Icon name="info" class="h-4 w-4 text-primary shrink-0" />
            <h3 class="font-display text-sm font-semibold text-heading">Kontak Pengaduan Privasi Data</h3>
          </div>
          <div class="space-y-1.5 text-xs text-muted">
            <div class="flex items-start gap-2">
              <Icon name="mail" class="h-3.5 w-3.5 text-muted shrink-0 mt-0.5" />
              <span>Email Khusus Kepatuhan Data: <a href={`mailto:${schoolEmail}`} class="text-primary font-mono font-medium hover:text-primary-hover hover:underline transition-colors">{schoolEmail}</a></span>
            </div>
            <div class="flex items-start gap-2">
              <Icon name="map-pin" class="h-3.5 w-3.5 text-muted shrink-0 mt-0.5" />
              <span>Posko Pelayanan Informasi: Gedung Administrasi Terpadu {schoolName}, {schoolAddress}.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
