---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Icon from "../../components/Icon.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import { db, articles, categories, users, settings } from "../../db";
import { eq, ne, desc, asc, and, isNull, sql } from "drizzle-orm";
import { verifyPreviewToken } from "../../server/auth";
import { sanitizeArticleHtml } from "../../utils/sanitizeHtml";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/berita");
}

// Cek token pratinjau draf staf (jika ada)
const previewToken = Astro.url.searchParams.get("preview_token");
let isPreview = false;
if (previewToken) {
  const verified = await verifyPreviewToken(previewToken);
  if (verified && verified.slug === slug) {
    isPreview = true;
  }
}

// Kondisi filter: Draf & artikel dihapus hanya boleh tampil jika ada token preview sah
const conditions: any[] = [eq(articles.slug, slug), isNull(articles.deletedAt)];
if (!isPreview) {
  conditions.push(eq(articles.status, "published"));
  conditions.push(sql`${articles.publishedAt} <= ${new Date().toISOString()}`);
}

// Ambil konfigurasi sekolah & pendaftaran dari database
let schoolSettings: Record<string, string> = {};
try {
  const allSettings = await db.select().from(settings);
  schoolSettings = (allSettings || []).reduce(
    (acc, curr) => {
      acc[curr.key] = curr.value;
      return acc;
    },
    {} as Record<string, string>,
  );
} catch {
  schoolSettings = {};
}

// Konfigurasi Pendaftaran / PPDB Dinamis dari CMS
const admissionsLabel =
  schoolSettings["admissions_label"] || schoolSettings["ppdb_label"] || "PPDB";
const academicYear =
  schoolSettings["ppdb_year"] ||
  schoolSettings["admissions_year"] ||
  "2026/2027";
const schoolType = (
  schoolSettings["school_type"] ||
  schoolSettings["school_level"] ||
  "SMA"
).toUpperCase();
const boardingAvailable = schoolSettings["boarding_available"] === "true";

const defaultAdmissionsTitle =
  admissionsLabel.toUpperCase() === "PSB"
    ? boardingAvailable
      ? "Penerimaan Santri & Siswa Baru"
      : "Penerimaan Siswa Baru"
    : admissionsLabel.toUpperCase() === "SPMB"
      ? "Sistem Penerimaan Siswa Baru"
      : admissionsLabel.toUpperCase() === "PPDBM"
        ? "Penerimaan Peserta Didik Baru Madrasah"
        : admissionsLabel.toUpperCase() === "PPDB"
          ? "Penerimaan Peserta Didik Baru"
          : `Pendaftaran Siswa Baru (${admissionsLabel})`;

const rawAdmissionsTitle = (
  schoolSettings["admissions_title"] ||
  schoolSettings["ppdb_title"] ||
  ""
).trim();
const admissionsTitle =
  rawAdmissionsTitle || `${defaultAdmissionsTitle} TA ${academicYear}`;

const admissionsSubtitle =
  (
    schoolSettings["admissions_subtitle"] ||
    schoolSettings["ppdb_subtitle"] ||
    ""
  ).trim() ||
  "Akses alur registrasi resmi, jadwal seleksi akademik, dan persyaratan berkas secara daring.";

// Ambil artikel saat ini
const articleData = await db
  .select({
    id: articles.id,
    slug: articles.slug,
    title: articles.title,
    summary: articles.summary,
    content: articles.content,
    coverImage: articles.coverImage,
    publishedAt: articles.publishedAt,
    viewCount: articles.viewCount,
    metaTitle: articles.metaTitle,
    metaDescription: articles.metaDescription,
    categoryName: categories.name,
    categorySlug: categories.slug,
    categoryId: articles.categoryId,
    authorId: articles.authorId,
    authorName: users.name,
    status: articles.status,
  })
  .from(articles)
  .leftJoin(categories, eq(articles.categoryId, categories.id))
  .leftJoin(users, eq(articles.authorId, users.id))
  .where(and(...conditions))
  .limit(1)
  .then((res) => res[0]);

if (!articleData) {
  Astro.response.status = 404;
}

// Hitung estimasi waktu membaca
const plainText = (articleData?.content || "").replace(/<[^>]+>/g, " ");
const wordCount = plainText.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 180));

// Ambil berita terkait dalam kategori sama (atau berita terbaru jika kategori tidak ditentukan)
const relatedArticles = articleData
  ? await db
      .select({
        id: articles.id,
        slug: articles.slug,
        title: articles.title,
        coverImage: articles.coverImage,
        publishedAt: articles.publishedAt,
        categoryName: categories.name,
      })
      .from(articles)
      .leftJoin(categories, eq(articles.categoryId, categories.id))
      .where(
        and(
          ne(articles.id, articleData.id),
          eq(articles.status, "published"),
          isNull(articles.deletedAt),
          sql`${articles.publishedAt} <= ${new Date().toISOString()}`,
          articleData.categoryId
            ? eq(articles.categoryId, articleData.categoryId)
            : undefined,
        ),
      )
      .orderBy(desc(articles.publishedAt))
      .limit(3)
  : [];

// Ambil berita terpopuler (berdasarkan viewCount)
const popularArticles = articleData
  ? await db
      .select({
        id: articles.id,
        slug: articles.slug,
        title: articles.title,
        coverImage: articles.coverImage,
        viewCount: articles.viewCount,
        publishedAt: articles.publishedAt,
        categoryName: categories.name,
      })
      .from(articles)
      .leftJoin(categories, eq(articles.categoryId, categories.id))
      .where(
        and(
          ne(articles.id, articleData.id),
          eq(articles.status, "published"),
          isNull(articles.deletedAt),
          sql`${articles.publishedAt} <= ${new Date().toISOString()}`,
        ),
      )
      .orderBy(desc(articles.viewCount), desc(articles.publishedAt))
      .limit(4)
  : [];

// Ambil navigasi artikel Sebelumnya (Prev) dan Berikutnya (Next)
const [prevArticle, nextArticle] =
  articleData && articleData.publishedAt
    ? await Promise.all([
        db
          .select({
            id: articles.id,
            slug: articles.slug,
            title: articles.title,
          })
          .from(articles)
          .where(
            and(
              ne(articles.id, articleData.id),
              eq(articles.status, "published"),
              isNull(articles.deletedAt),
              sql`${articles.publishedAt} <= ${new Date().toISOString()}`,
              sql`${articles.publishedAt} < ${articleData.publishedAt}`,
            ),
          )
          .orderBy(desc(articles.publishedAt))
          .limit(1)
          .then((r) => r[0] || null),
        db
          .select({
            id: articles.id,
            slug: articles.slug,
            title: articles.title,
          })
          .from(articles)
          .where(
            and(
              ne(articles.id, articleData.id),
              eq(articles.status, "published"),
              isNull(articles.deletedAt),
              sql`${articles.publishedAt} <= ${new Date().toISOString()}`,
              sql`${articles.publishedAt} > ${articleData.publishedAt}`,
            ),
          )
          .orderBy(asc(articles.publishedAt))
          .limit(1)
          .then((r) => r[0] || null),
      ])
    : [null, null];

// Ekstrak domain situs dari email / website settings untuk lead prefix artikel berita (seperti Bola.net -)
const siteEmail = schoolSettings["email"] || "";
const emailDomain = siteEmail.includes("@")
  ? siteEmail.split("@")[1].trim()
  : "";
const rawWebsite = (
  schoolSettings["website"] ||
  schoolSettings["school_website"] ||
  ""
).trim();
let websiteDomain = "";
try {
  if (rawWebsite) {
    websiteDomain = new URL(
      rawWebsite.startsWith("http") ? rawWebsite : `https://${rawWebsite}`,
    ).hostname.replace(/^www\./, "");
  }
} catch {}

const siteDomain =
  (schoolSettings["site_domain"] || "").trim() ||
  websiteDomain ||
  emailDomain ||
  (Astro.url.hostname !== "localhost" && Astro.url.hostname !== "127.0.0.1"
    ? Astro.url.hostname.replace(/^www\./, "")
    : "sman1unggulan.sch.id");

const schoolName = schoolSettings["school_name"] || "SMAN 1 Unggulan";

// Prefix awal kalimat artikel berita (contoh: Bola.net - atau sman1unggulan.sch.id -)
const leadPrefix =
  (schoolSettings["article_lead_prefix"] || "").trim() || siteDomain;

// Sisipkan rekomendasi inline "Baca Juga" (hingga 3 artikel) setelah paragraf ke-2
const inlinePool = [...relatedArticles];
for (const pop of popularArticles) {
  if (inlinePool.length >= 3) break;
  if (!inlinePool.some((a) => a.id === pop.id)) {
    inlinePool.push(pop);
  }
}
const inlineArticles = inlinePool.slice(0, 3);
let processedContent = articleData?.content || "";

// Sisipkan prefix nama situs/domain di awal paragraf pertama artikel
if (processedContent && leadPrefix) {
  const firstPOpenRegex = /<p(?:\s+[^>]*)?>/i;
  const match = firstPOpenRegex.exec(processedContent);
  if (match) {
    const index = match.index + match[0].length;
    const afterOpen = processedContent.slice(index);
    if (!afterOpen.trimStart().startsWith("<strong")) {
      processedContent =
        processedContent.slice(0, index) +
        `<strong>${leadPrefix}</strong> &ndash; ` +
        afterOpen;
    }
  } else if (!processedContent.trimStart().startsWith("<")) {
    processedContent = `<p><strong>${leadPrefix}</strong> &ndash; ${processedContent}</p>`;
  }
}

if (inlineArticles.length > 0 && processedContent) {
  let pCount = 0;
  const pRegex = /<\/p>/gi;
  let match;
  let insertIndex = -1;

  while ((match = pRegex.exec(processedContent)) !== null) {
    pCount++;
    if (pCount === 2) {
      insertIndex = match.index + match[0].length;
      break;
    }
  }

  if (insertIndex !== -1) {
    const inlineLinks = inlineArticles
      .map(
        (item, idx) => `
          <a href="/berita/${item.slug || ""}" class="block font-display text-sm font-bold text-warning-text hover:text-warning-hover no-underline transition-colors">
            ${idx + 1}. ${item.title}
          </a>`,
      )
      .join("");
    const inlineBox = `
      <div class="not-prose my-8 rounded-[8px] border border-border p-4 bg-surface">
        <span class="text-[11px] uppercase tracking-wider text-primary">Baca Juga:</span>
        <div class="mt-2 flex flex-col gap-1.5">
          ${inlineLinks}
        </div>
      </div>
    `;
    processedContent =
      processedContent.slice(0, insertIndex) +
      inlineBox +
      processedContent.slice(insertIndex);
  }
}

// Sanitasi keamanan XSS & normalisasi tag konten artikel sebelum rendering
processedContent = sanitizeArticleHtml(processedContent);

const newsArticleSchema = articleData
  ? {
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      headline: articleData.title,
      description: articleData.summary,
      image: [
        articleData.coverImage ||
          "https://images.unsplash.com/photo-1506703719100-a0f3a48c0f86?w=1200",
      ],
      datePublished: articleData.publishedAt,
      author: [
        {
          "@type": "Person",
          name: articleData.authorName || "Redaksi SMAN 1 Unggulan",
        },
      ],
      publisher: {
        "@type": "Organization",
        name: "SMAN 1 Unggulan",
        logo: {
          "@type": "ImageObject",
          url: "https://sman1unggulan.sch.id/favicon.svg",
        },
      },
    }
  : undefined;

const shareTitle = articleData?.title || "Berita SMAN 1 Unggulan";
const shareUrl = Astro.url.href;
---

<Layout
  title={
    articleData
      ? articleData.metaTitle || `${articleData.title} — SMAN 1 Unggulan`
      : "Artikel Tidak Ditemukan"
  }
  description={
    articleData
      ? articleData.metaDescription || articleData.summary
      : "Artikel yang Anda cari tidak tersedia."
  }
  image={articleData?.coverImage}
  type="article"
  publishedTime={articleData?.publishedAt}
  author={articleData?.authorName || "Humas SMAN 1 Unggulan"}
  jsonLd={newsArticleSchema}
>
  <Header currentPath="/berita" />

  <main class="flex-1 py-8 sm:py-12 bg-background">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs Navigasi Jejak -->
      <Breadcrumb
        class="mb-2"
        items={[
          { label: "Beranda", href: "/" },
          {
            label: "Berita",
            href: articleData?.categoryName ? "/berita" : undefined,
          },
          ...(articleData?.categoryName
            ? [{ label: articleData.categoryName }]
            : []),
        ]}
      />

      {!articleData ? (
        <div class="rounded-[12px] border border-border bg-surface p-12 text-center my-12">
          <h1 class="font-display text-2xl font-bold text-heading">
            Berita Tidak Ditemukan
          </h1>
          <p class="mt-2 text-sm text-muted">
            Artikel yang Anda minta telah dipindahkan atau belum diterbitkan.
          </p>
          <a
            href="/berita"
            class="mt-6 inline-flex h-9 items-center justify-center rounded-[6px] bg-primary px-4 text-xs font-semibold text-white shadow-xs transition-all duration-200 hover:bg-primary-hover hover:shadow-(--shadow-button-glow)"
          >
            Kembali ke Semua Berita
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
          <!-- Kolom Konten Artikel (8 Kolom) -->
          <article
            id="article-content"
            data-article-id={articleData.id}
            class="lg:col-span-8"
          >
            <header class="space-y-4">
              <h1 class="font-display text-2xl sm:text-3xl lg:text-[38px] font-bold tracking-tight text-heading leading-[1.18] max-w-3xl">
                {articleData.title}
              </h1>

              <!-- Informasi Penulis & Redaksi (Bersih tanpa avatar huruf generik) -->
              <div class="pt-2 text-xs text-muted flex flex-wrap items-center gap-1.5">
                {articleData.authorId ? (
                  <a
                    href={`/penulis/${encodeURIComponent(articleData.authorId)}`}
                    class="font-semibold text-heading hover:text-primary hover:underline transition-colors"
                  >
                    {articleData.authorName || "Humas Sekolah"}
                  </a>
                ) : (
                  <strong class="font-semibold text-heading">
                    {articleData.authorName || "Humas Sekolah"}
                  </strong>
                )}
                <span>&bull;</span>
                <span class="text-muted font-medium">
                  {articleData.publishedAt
                    ? new Date(articleData.publishedAt).toLocaleDateString(
                        "id-ID",
                        { day: "numeric", month: "long", year: "numeric" },
                      )
                    : "-"}
                </span>
              </div>
            </header>

            {articleData.coverImage && (
              <figure class="my-8 overflow-hidden rounded-[12px] border border-border bg-surface-subtle shadow-xs">
                <img
                  src={articleData.coverImage}
                  alt={`${articleData.title}`}
                  width="1200"
                  height="675"
                  class="aspect-video w-full object-cover"
                  loading="eager"
                  fetchpriority="high"
                />
              </figure>
            )}

            <!-- Area Baca Artikel (Sesuai Token Desain @theme: text-body, text-heading, dsb) -->
            <div class="article-prose py-2" set:html={processedContent} />

            <!-- Bagian Penutup: Tombol Bagikan Tunggal & Navigasi Prev/Next (No ad-hoc divider) -->
            <div class="py-10 space-y-8">
              <div class="flex flex-col sm:justify-between gap-4">
                <div>
                  <p class="text-sm font-bold text-heading">
                    Bagikan Artikel Ini
                  </p>
                </div>
                <ShareButtons
                  title={shareTitle}
                  url={shareUrl}
                  shareText="Cek artikel menarik dari SMAN 1 Unggulan:"
                />
              </div>

              <!-- Navigasi Artikel Sebelumnya & Berikutnya -->
              {(prevArticle || nextArticle) && (
                <nav
                  class="grid grid-cols-1 sm:grid-cols-2 gap-4"
                  aria-label="Navigasi Artikel Sebelumnya dan Berikutnya"
                >
                  {prevArticle ? (
                    <a
                      href={`/berita/${prevArticle.slug}`}
                      class="group flex flex-col justify-between rounded-[8px] border border-border bg-surface p-4 hover:border-primary/50 hover:bg-surface-subtle transition-all"
                    >
                      <div class="flex items-center gap-1.5 text-xs font-semibold text-muted group-hover:text-primary transition-colors">
                        <Icon name="chevron-left" class="h-3.5 w-3.5" />
                        <span>Previous</span>
                      </div>
                      <p class="mt-2 font-display text-xs sm:text-sm font-bold text-heading line-clamp-2 leading-snug group-hover:text-primary transition-colors">
                        {prevArticle.title}
                      </p>
                    </a>
                  ) : (
                    <div class="hidden sm:block" />
                  )}

                  {nextArticle ? (
                    <a
                      href={`/berita/${nextArticle.slug}`}
                      class="group flex flex-col justify-between rounded-[8px] border border-border bg-surface p-4 text-right hover:border-primary/50 hover:bg-surface-subtle transition-all sm:col-start-2"
                    >
                      <div class="flex items-center justify-end gap-1.5 text-xs font-semibold text-muted group-hover:text-primary transition-colors">
                        <span>Next</span>
                        <Icon name="chevron-right" class="h-3.5 w-3.5" />
                      </div>
                      <p class="mt-2 font-display text-xs sm:text-sm font-bold text-heading line-clamp-2 leading-snug group-hover:text-primary transition-colors">
                        {nextArticle.title}
                      </p>
                    </a>
                  ) : (
                    <div class="hidden sm:block" />
                  )}
                </nav>
              )}
            </div>
          </article>

          <!-- Sidebar Kolom Kanan (4 Kolom Desktop) -->
          <aside class="lg:col-span-4 space-y-8">
            <!-- Widget Berita Terpopuler (Zero divide-y) -->
            {popularArticles.length > 0 && (
              <div class="rounded-[12px] border border-border bg-surface p-6 shadow-xs">
                <div class="flex items-center justify-between pb-3">
                  <div class="flex items-center gap-2">
                    <h3 class="font-display text-sm font-bold uppercase tracking-wider text-heading">
                      Berita Terpopuler
                    </h3>
                  </div>
                  <span class="text-[10px] font-mono text-muted">Views</span>
                </div>

                <div class="mt-3 space-y-2">
                  {popularArticles.map((pop, idx) => (
                    <a
                      href={`/berita/${pop.slug}`}
                      class="p-2 rounded-[8px] hover:bg-surface-subtle flex items-start gap-3 group transition-colors"
                    >
                      <span
                        class={`flex h-5 w-5 shrink-0 items-center justify-center rounded-[4px] font-mono text-xs font-bold ${
                          idx === 0
                            ? "bg-primary text-white"
                            : "bg-surface-subtle text-muted group-hover:bg-primary group-hover:text-white"
                        } transition-colors`}
                      >
                        {idx + 1}
                      </span>
                      <div class="min-w-0 flex-1">
                        <h4 class="font-display text-xs font-bold text-heading leading-snug group-hover:text-primary transition-colors line-clamp-2">
                          {pop.title}
                        </h4>
                        <div class="mt-1 flex items-center gap-2 text-[10px] text-muted font-mono">
                          <span>{pop.viewCount} views</span>
                          {pop.publishedAt && (
                            <>
                              <span>&bull;</span>
                              <span>
                                {new Date(pop.publishedAt).toLocaleDateString(
                                  "id-ID",
                                  { day: "numeric", month: "short" },
                                )}
                              </span>
                            </>
                          )}
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}

            <!-- Widget Berita Terkait Lainnya (Zero divide-y) -->
            {relatedArticles.length > 0 && (
              <div class="rounded-[12px] border border-border bg-surface p-6 shadow-xs">
                <h3 class="font-display text-sm font-bold uppercase tracking-wider text-heading pb-1">
                  Berita Terkait{" "}
                  {articleData.categoryName
                    ? `(${articleData.categoryName})`
                    : ""}
                </h3>

                <div class="mt-3 space-y-2">
                  {relatedArticles.map((rel) => (
                    <div class="p-2.5 rounded-[8px] hover:bg-surface-subtle group transition-colors">
                      <span class="text-[10px] font-semibold uppercase tracking-wider text-primary">
                        {rel.categoryName || "Info"}
                      </span>
                      <h4 class="mt-0.5 font-display text-xs font-bold text-heading leading-snug group-hover:text-primary transition-colors">
                        <a href={`/berita/${rel.slug}`}>{rel.title}</a>
                      </h4>
                      <p class="mt-1 font-mono text-[10px] text-muted">
                        {rel.publishedAt
                          ? new Date(rel.publishedAt).toLocaleDateString(
                              "id-ID",
                              {
                                day: "numeric",
                                month: "short",
                                year: "numeric",
                              },
                            )
                          : "-"}
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Widget Banner Pendaftaran (Dinamis dari Konfigurasi CMS) -->
            <div class="rounded-[12px] border border-border bg-surface p-5 sm:p-6 shadow-xs space-y-3">
              <span class="inline-block rounded-[4px] bg-primary-light text-primary font-bold px-2 py-0.5 text-[10px] tracking-wider uppercase border border-primary/20">
                Informasi {admissionsLabel}
              </span>
              <h4 class="font-display text-sm font-bold text-heading">
                {admissionsTitle}
              </h4>
              <p class="text-xs leading-relaxed text-muted font-body">
                {admissionsSubtitle}
              </p>
              <div class="pt-2">
                <a
                  href="/pendaftaran"
                  class="inline-flex h-11 w-full items-center justify-center gap-2 rounded-[8px] bg-primary px-5 font-display text-xs sm:text-sm font-semibold text-white shadow-xs transition-all duration-200 hover:bg-primary-hover hover:shadow-(--shadow-button-glow) group"
                >
                  <span>Lihat Informasi {admissionsLabel}</span>
                  <span class="transition-transform duration-200 group-hover:translate-x-1">
                    &rarr;
                  </span>
                </a>
              </div>
            </div>
          </aside>
        </div>
      )}
    </div>
  </main>

  <Footer />

  <script>
    // Bungkus tabel konten ke wrapper horizontal scroll responsif
    document
      .querySelectorAll(".article-prose table, .prose table")
      .forEach((table) => {
        if (!table.parentElement?.classList.contains("overflow-x-auto")) {
          const wrapper = document.createElement("div");
          wrapper.className =
            "my-6 overflow-x-auto rounded-[8px] border border-border shadow-xs";
          table.parentNode?.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        }
      });

    // Kirim view count secara asinkron & non-blocking (Anti-Bot & Anti-Spam F5)
    try {
      const artRoot = document.getElementById("article-content");
      const artId = artRoot?.getAttribute("data-article-id");
      const isDraftPreview = window.location.search.includes("preview_token");

      if (artId && !isDraftPreview) {
        const viewEndpoint = `/api/articles/${artId}/view`;
        if (navigator.sendBeacon) {
          navigator.sendBeacon(viewEndpoint);
        } else {
          fetch(viewEndpoint, { method: "POST", keepalive: true }).catch(
            () => {},
          );
        }
      }
    } catch {}
  </script>

  <style is:global>
    /* ============================================================
       Hierarki Tipografi & Media Baca Artikel (CMS Standard)
    ============================================================ */
    .article-prose {
      font-family: var(--font-body);
      font-size: clamp(0.9375rem, 0.91rem + 0.18vw, 1rem);
      line-height: 1.75;
      color: var(--color-body);
    }

    /* Headings Hierarki H1 - H6 */
    .article-prose h1 {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 1.3rem + 1vw, 1.875rem);
      font-weight: 700;
      line-height: 1.25;
      color: var(--color-heading);
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }

