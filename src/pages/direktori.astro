  <script>
    function initDirektoriPage() {
      const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
      const catButtons = document.querySelectorAll<HTMLButtonElement>(".cat-filter-btn");
      const rows = Array.from(document.querySelectorAll<HTMLElement>(".teacher-row"));
      const tableContainer = document.getElementById("teachers-table-container");
      const emptyState = document.getElementById("empty-state");
      const resetBtn = document.getElementById("btn-reset-filter");

      // Pagination elements
      const paginationWrapper = document.getElementById("pagination-wrapper");
      const pageStart = document.getElementById("page-start");
      const pageEnd = document.getElementById("page-end");
      const pageTotal = document.getElementById("page-total");
      const btnPrevPage = document.getElementById("btn-prev-page") as HTMLButtonElement | null;
      const btnNextPage = document.getElementById("btn-next-page") as HTMLButtonElement | null;
      const pageNumbers = document.getElementById("page-numbers");

      const PAGE_SIZE = 10;
      let currentPage = 1;
      let activeCategory = "all";
      let filteredRows: HTMLElement[] = [...rows];

      function renderPagination() {
        const totalItems = filteredRows.length;

        if (totalItems === 0) {
          if (paginationWrapper) paginationWrapper.classList.add("hidden");
          if (tableContainer) tableContainer.classList.add("hidden");
          return;
        }

        if (paginationWrapper) paginationWrapper.classList.remove("hidden");
        if (tableContainer) tableContainer.classList.remove("hidden");

        const totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const startIndex = (currentPage - 1) * PAGE_SIZE;
        const endIndex = Math.min(startIndex + PAGE_SIZE, totalItems);

        // Hide all rows first, then show only the items on the active page
        rows.forEach((row) => row.classList.add("hidden"));
        for (let i = startIndex; i < endIndex; i++) {
          const row = filteredRows[i];
          if (row) {
            row.classList.remove("hidden");
            const numCell = row.querySelector(".row-number");
            if (numCell) numCell.textContent = String(i + 1);

            // Re-apply zebra striping on visible rows
            if ((i - startIndex) % 2 === 1) {
              row.classList.add("bg-surface-subtle/60");
              row.classList.remove("bg-surface");
            } else {
              row.classList.add("bg-surface");
              row.classList.remove("bg-surface-subtle/60");
            }
          }
        }

        // Update range counters
        if (pageStart) pageStart.textContent = String(startIndex + 1);
        if (pageEnd) pageEnd.textContent = String(endIndex);
        if (pageTotal) pageTotal.textContent = String(totalItems);

        // Update button disabled state
        if (btnPrevPage) {
          btnPrevPage.disabled = currentPage <= 1;
        }
        if (btnNextPage) {
          btnNextPage.disabled = currentPage >= totalPages;
        }

        // Render page number buttons
        if (pageNumbers) {
          pageNumbers.innerHTML = "";
          for (let p = 1; p <= totalPages; p++) {
            const pageBtn = document.createElement("button");
            pageBtn.type = "button";
            pageBtn.textContent = String(p);
            pageBtn.setAttribute("aria-label", `Menuju halaman ${p}`);

            if (p === currentPage) {
              pageBtn.className =
                "inline-flex h-8 w-8 items-center justify-center rounded-[6px] bg-primary text-xs font-semibold text-white shadow-xs cursor-default";
            } else {
              pageBtn.className =
                "inline-flex h-8 w-8 items-center justify-center rounded-[6px] border border-border bg-surface text-xs font-medium text-heading hover:bg-surface-subtle transition-colors cursor-pointer";
              pageBtn.addEventListener("click", () => {
                currentPage = p;
                renderPagination();
                document.getElementById("teachers-table-container")?.scrollIntoView({ behavior: "smooth", block: "start" });
              });
            }
            pageNumbers.appendChild(pageBtn);
          }
        }
      }

      function applyFilter(resetPage = true) {
        if (resetPage) {
          currentPage = 1;
        }

        const query = (searchInput?.value || "").toLowerCase().trim();

        filteredRows = rows.filter((row) => {
          const name = row.getAttribute("data-name") || "";
          const subject = row.getAttribute("data-subject") || "";
          const position = row.getAttribute("data-position") || "";
          const cat = row.getAttribute("data-category") || "";

          const matchQuery =
            !query ||
            name.includes(query) ||
            subject.includes(query) ||
            position.includes(query);

          const matchCat =
            activeCategory === "all" || cat === activeCategory;

          return matchQuery && matchCat;
        });

        if (emptyState) {
          if (filteredRows.length === 0) {
            emptyState.classList.remove("hidden");
          } else {
            emptyState.classList.add("hidden");
          }
        }

        renderPagination();
      }

      // Prev / Next button listeners
      btnPrevPage?.addEventListener("click", () => {
        if (currentPage > 1) {
          currentPage--;
          renderPagination();
          document.getElementById("teachers-table-container")?.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });

      btnNextPage?.addEventListener("click", () => {
        const totalPages = Math.ceil(filteredRows.length / PAGE_SIZE);
        if (currentPage < totalPages) {
          currentPage++;
          renderPagination();
          document.getElementById("teachers-table-container")?.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });

      searchInput?.addEventListener("input", () => applyFilter(true));

      catButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          activeCategory = btn.getAttribute("data-cat") || "all";

          catButtons.forEach((b) => {
            b.classList.remove("bg-primary", "text-white", "font-semibold", "shadow-xs");
            b.classList.add("border", "border-border", "bg-surface", "text-muted", "hover:border-border-hover", "hover:text-heading", "hover:bg-surface-subtle");
          });

          btn.classList.remove("border", "border-border", "bg-surface", "text-muted", "hover:border-border-hover", "hover:text-heading", "hover:bg-surface-subtle");
          btn.classList.add("bg-primary", "text-white", "font-semibold", "shadow-xs");

          applyFilter(true);
        });
      });

      resetBtn?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        activeCategory = "all";

        catButtons.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.add("bg-primary", "text-white", "font-semibold", "shadow-xs");
            b.classList.remove("border", "border-border", "bg-surface", "text-muted", "hover:border-border-hover", "hover:text-heading", "hover:bg-surface-subtle");
          } else {
            b.classList.remove("bg-primary", "text-white", "font-semibold", "shadow-xs");
            b.classList.add("border", "border-border", "bg-surface", "text-muted", "hover:border-border-hover", "hover:text-heading", "hover:bg-surface-subtle");
          }
        });

        applyFilter(true);
      });

      // Modal Detail Interaktif (Klik Baris atau Tombol Detail)
      const modal = document.getElementById("teacher-modal");
      const modalPhoto = document.getElementById("modal-photo") as HTMLImageElement | null;
      const modalCategory = document.getElementById("modal-category");
      const modalName = document.getElementById("modal-name");
      const modalPosition = document.getElementById("modal-position");
      const modalNip = document.getElementById("modal-nip");
      const modalSubject = document.getElementById("modal-subject");
      const modalEducation = document.getElementById("modal-education");
      const closeBtn = document.getElementById("btn-close-modal");
      const closeBottomBtn = document.getElementById("btn-close-modal-bottom");

      rows.forEach((row) => {
        row.addEventListener("click", () => {
          const raw = row.getAttribute("data-teacher");
          if (!raw) return;
          try {
            const data = JSON.parse(raw);
            if (modalPhoto) {
              modalPhoto.src = data.photoUrl || "/images/default-avatar.svg";
              modalPhoto.alt = data.name;
              modalPhoto.onerror = () => {
                modalPhoto.src = "/images/default-avatar.svg";
              };
            }
            if (modalCategory) {
              modalCategory.textContent = data.category === "pimpinan" ? "Pimpinan Sekolah" : data.category === "tendik" ? "Tenaga Kependidikan" : "Guru Pengampu";
            }
            if (modalName) modalName.textContent = data.name;
            if (modalPosition) modalPosition.textContent = data.position;
            if (modalNip) modalNip.textContent = data.nip && data.nip !== "-" ? `NIP: ${data.nip}` : "Pendidik Tersertifikasi";
            if (modalSubject) modalSubject.textContent = data.subject || "-";
            if (modalEducation) modalEducation.textContent = data.education || "Pendidikan Tinggi Terakreditasi";

            modal?.classList.remove("hidden");
          } catch {}
        });
      });

      function closeModal() {
        modal?.classList.add("hidden");
      }

      closeBtn?.addEventListener("click", closeModal);
      closeBottomBtn?.addEventListener("click", closeModal);
      modal?.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
          closeModal();
        }
      });

      // Apply initial pagination state
      applyFilter(true);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initDirektoriPage);
    } else {
      initDirektoriPage();
    }
  </script>
</Layout>
