  "https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=600&q=80",
  "https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?auto=format&fit=crop&w=600&q=80",
  "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=600&q=80",
  "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=600&q=80",
  "https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=600&q=80",
  "https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=600&q=80",
  "https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?auto=format&fit=crop&w=600&q=80",
  "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=600&q=80",
];

// Susun penempatan Hero: Kepala Sekolah di posisi paling tengah, diapit Wakil Kepala Sekolah (Waka), lalu guru lainnya
const principalTeacher =
  teachersList.find(
    (t) =>
      t.position.toLowerCase().includes("kepala sekolah") &&
      !t.position.toLowerCase().includes("wakil") &&
      !t.position.toLowerCase().includes("waka"),
  ) || teachersList[0];

const wakaTeachers = teachersList.filter(
  (t) =>
    (t.position.toLowerCase().includes("wakil") ||
      t.position.toLowerCase().includes("waka")) &&
    t.id !== principalTeacher.id,
);

const otherTeachers = teachersList.filter(
  (t) =>
    t.id !== principalTeacher.id &&
    !wakaTeachers.some((w) => w.id === t.id),
);

// Slot 3 = Paling tengah (Kolom 4 Row 1) -> Kepala Sekolah
// Slot 2 = Kiri dalam (Kolom 3 Row 1) -> Waka
// Slot 4 = Kanan dalam (Kolom 5 Row 1) -> Waka
// Slot 1 = Kiri tengah (Kolom 2 Row 1) -> Waka
// Slot 5 = Kanan tengah (Kolom 6 Row 1) -> Waka
const orderedHeroList: typeof teachersList = [];
orderedHeroList[3] = principalTeacher;
orderedHeroList[2] = wakaTeachers[0] || otherTeachers[0];
orderedHeroList[4] = wakaTeachers[1] || otherTeachers[1];
orderedHeroList[1] = wakaTeachers[2] || otherTeachers[2];
orderedHeroList[5] = wakaTeachers[3] || otherTeachers[3];

const remainingWakas = wakaTeachers.slice(4);
const remainingPool = [...remainingWakas, ...otherTeachers];

orderedHeroList[0] = remainingPool.shift() || fallbackTeachers[0];
orderedHeroList[6] = remainingPool.shift() || fallbackTeachers[1];
orderedHeroList[7] = remainingPool.shift() || fallbackTeachers[2];
orderedHeroList[8] = remainingPool.shift() || fallbackTeachers[3];
orderedHeroList[9] = remainingPool.shift() || fallbackTeachers[4];
orderedHeroList[10] = remainingPool.shift() || fallbackTeachers[5];
orderedHeroList[11] = remainingPool.shift() || fallbackTeachers[6];

const heroTeachers = orderedHeroList.map((t, idx) => ({
  ...t,
  heroPhoto:
    t.photoUrl && !t.photoUrl.includes("default-avatar")
      ? t.photoUrl
      : defaultTeacherAvatars[idx % defaultTeacherAvatars.length],
}));
