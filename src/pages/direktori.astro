// Helper penentuan kategori dari posisi jika data dari CMS
function resolveCategory(position: string): string {
  const p = (position || "").toLowerCase();
  if (p.includes("kepala sekolah") || p.includes("wakil") || p.includes("waka")) {
    return "pimpinan";
  }
  if (p.includes("tata usaha") || p.includes("pustakawan") || p.includes("staf") || p.includes("laboran") || p.includes("administrasi")) {
    return "tendik";
  }
  return "guru";
}

const teachersList = rawTeachers.length > 0
  ? rawTeachers.map((t, idx) => {
      const fb = fallbackTeachers[idx % fallbackTeachers.length];
      return {
        id: t.id,
        name: t.name,
        position: t.position,
        category: (t as any).category || resolveCategory(t.position),
        subject: t.subject || "-",
        nip: t.nip || "-",
        education: fb?.education || "Pendidikan Formal Terverifikasi",
        photoUrl: t.photoUrl?.trim() || "/images/default-avatar.svg",
      };
    })
  : fallbackTeachers.map((fb) => ({
      ...fb,
      photoUrl: fb.photoUrl?.trim() || "/images/default-avatar.svg",
    }));

// Hitung data statistik nyata dari CMS
const totalStaff = teachersList.length;
const totalEducators = teachersList.filter((t) => ["guru", "pimpinan"].includes(t.category)).length;
const totalTendik = teachersList.filter((t) => t.category === "tendik").length;
const subjectSet = new Set(teachersList.map((t) => t.subject).filter((s) => s && s !== "-"));
const totalSubjects = subjectSet.size;
const subjectOptions = Array.from(subjectSet).sort();

const heroStats = [
  { value: totalEducators, label: "Tenaga Pendidik" },
  { value: totalTendik > 0 ? totalTendik : totalStaff, label: totalTendik > 0 ? "Tendik & Staf" : "Total Staf" },
  { value: "100%", label: "Berkualifikasi" },
];

const defaultTeacherAvatars = [
  "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80",
  "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80",
