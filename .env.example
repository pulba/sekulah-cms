# Database Turso SQLite
TURSO_DATABASE_URL="libsql://your-database-name.aws-ap-southeast-1.turso.io"
TURSO_AUTH_TOKEN="your-turso-jwt-auth-token"

# Google OAuth2 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Super Admin Bootstrap Owner Email
OWNER_ADMIN_EMAIL="admin@emailanda.com"

# Session Security (Cryptographic key, min 32 chars)
SESSION_SECRET="change-this-to-a-secure-random-64-character-string"

# Firebase Client & Admin Configuration
PUBLIC_FIREBASE_API_KEY="your-public-firebase-api-key"
PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Cloudflare R2 Storage (Media Kegiatan & Dokumen)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="sekulah"
R2_PUBLIC_DOMAIN="https://pub-xxxxxx.r2.dev"
